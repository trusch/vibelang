[
  {
    "name": "PlayBuf",
    "description": "Buffer playback oscillator. Plays back audio from a buffer.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "numChannels",
        "type": "float",
        "default": 1,
        "description": "Number of channels in the buffer"
      },
      {
        "name": "bufnum",
        "type": "float",
        "default": 0,
        "description": "Buffer number to play"
      },
      {
        "name": "rate",
        "type": "float",
        "default": 1,
        "description": "Playback rate (1.0 = normal speed)"
      },
      {
        "name": "trigger",
        "type": "signal",
        "default": 1,
        "description": "Trigger to start playback from beginning"
      },
      {
        "name": "startPos",
        "type": "float",
        "default": 0,
        "description": "Starting frame position in buffer"
      },
      {
        "name": "loop",
        "type": "float",
        "default": 0,
        "description": "Loop mode (0=no loop, 1=loop)"
      },
      {
        "name": "doneAction",
        "type": "float",
        "default": 0,
        "description": "Action when playback finishes"
      }
    ],
    "outputs": 1,
    "category": "Buffers",
    "functions": [
      "play_buf_ar",
      "play_buf_kr"
    ]
  },
  {
    "name": "BufRd",
    "description": "Buffer reading oscillator. Reads values from a buffer using an index.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "numChannels",
        "type": "float",
        "default": 1,
        "description": "Number of channels in the buffer"
      },
      {
        "name": "bufnum",
        "type": "float",
        "default": 0,
        "description": "Buffer number to read from"
      },
      {
        "name": "phase",
        "type": "signal",
        "default": 0,
        "description": "Read position (0 to numFrames)"
      },
      {
        "name": "loop",
        "type": "float",
        "default": 1,
        "description": "Loop mode (0=no loop, 1=loop)"
      },
      {
        "name": "interpolation",
        "type": "float",
        "default": 2,
        "description": "Interpolation type (1=none, 2=linear, 4=cubic)"
      }
    ],
    "outputs": 1,
    "category": "Buffers",
    "functions": [
      "buf_rd_ar",
      "buf_rd_kr"
    ]
  },
  {
    "name": "BufWr",
    "description": "Buffer writing oscillator. Writes values to a buffer using an index.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "inputArray",
        "type": "signal",
        "default": 0,
        "description": "Signal(s) to write to buffer"
      },
      {
        "name": "bufnum",
        "type": "float",
        "default": 0,
        "description": "Buffer number to write to"
      },
      {
        "name": "phase",
        "type": "signal",
        "default": 0,
        "description": "Write position (0 to numFrames)"
      },
      {
        "name": "loop",
        "type": "float",
        "default": 1,
        "description": "Loop mode (0=no loop, 1=loop)"
      }
    ],
    "outputs": 1,
    "category": "Buffers",
    "functions": [
      "buf_wr_ar",
      "buf_wr_kr"
    ]
  },
  {
    "name": "RecordBuf",
    "description": "Record into a buffer. Records audio into a buffer with optional looping.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "inputArray",
        "type": "signal",
        "default": 0,
        "description": "Signal(s) to record"
      },
      {
        "name": "bufnum",
        "type": "float",
        "default": 0,
        "description": "Buffer number to record into"
      },
      {
        "name": "offset",
        "type": "float",
        "default": 0,
        "description": "Starting frame offset in buffer"
      },
      {
        "name": "recLevel",
        "type": "float",
        "default": 1,
        "description": "Recording level (0 to 1)"
      },
      {
        "name": "preLevel",
        "type": "float",
        "default": 0,
        "description": "Pre-existing content level for overdubbing"
      },
      {
        "name": "run",
        "type": "float",
        "default": 1,
        "description": "Run/pause recording (1=run, 0=pause)"
      },
      {
        "name": "loop",
        "type": "float",
        "default": 1,
        "description": "Loop mode (0=no loop, 1=loop)"
      },
      {
        "name": "trigger",
        "type": "signal",
        "default": 1,
        "description": "Trigger to start recording"
      },
      {
        "name": "doneAction",
        "type": "float",
        "default": 0,
        "description": "Action when recording finishes"
      }
    ],
    "outputs": 1,
    "category": "Buffers",
    "functions": [
      "record_buf_ar",
      "record_buf_kr"
    ]
  },
