      {
        "name": "bufnum",
        "type": "float",
        "default": 0,
        "description": "Buffer number to query"
      }
    ],
    "outputs": 1,
    "category": "Buffers",
    "functions": [
      "buf_rate_scale_kr"
    ]
  },
