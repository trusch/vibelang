  {
    "name": "HOAEncoder1",
    "description": "Higher-Order Ambisonic encoder (order 1) from the SC-HOA quark by Florian Grond. Pans a mono source into a 1st-order ambisonic soundfield (4 channels, ACN/SN3D) with optional near-field spherical-wave encoding. NOTE: this manifest covers only the order-specific server UGens. The HOAEncoder.ar pseudo-UGen wrapper (which dispatches by `order` argument) is sclang-only and not included.",
    "rates": ["ar"],
    "inputs": [
      {"name": "in1", "type": "signal", "default": 0, "description": "Mono source signal to encode"},
      {"name": "gain_0", "type": "float", "default": 0, "description": "Gain in dB"},
      {"name": "radius_0", "type": "float", "default": 2.0, "description": "Source distance in metres (only relevant when plane_spherical = 1)"},
      {"name": "azimuth_0", "type": "float", "default": 0, "description": "Azimuth in radians (-pi to pi, 0 = front)"},
      {"name": "elevation_0", "type": "float", "default": 0, "description": "Elevation in radians (-pi/2 to pi/2)"},
      {"name": "plane_spherical", "type": "float", "default": 0, "description": "0 = plane wave encoding, 1 = spherical (near-field) encoding"},
      {"name": "speaker_radius_0", "type": "float", "default": 1.07, "description": "Reproduction speaker layout radius in metres"}
    ],
    "outputs": 4,
    "category": "SC-HOA"
  },
