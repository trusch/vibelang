        "default": 220.0,
        "description": "Fundamental frequency in Hz."
      },
      {
        "name": "bowpressure",
        "type": "float",
        "default": 64.0,
        "description": "Bow pressure (0..127, MIDI-style controller scale)."
      },
      {
        "name": "bowposition",
        "type": "float",
        "default": 64.0,
        "description": "Bow position along string (0..127)."
      },
      {
        "name": "vibfreq",
        "type": "float",
        "default": 64.0,
        "description": "Vibrato frequency (0..127)."
      },
      {
        "name": "vibgain",
        "type": "float",
        "default": 64.0,
        "description": "Vibrato gain (0..127)."
      },
      {
        "name": "loudness",
        "type": "float",
        "default": 64.0,
        "description": "Loudness (0..127)."
      },
      {
        "name": "trig",
        "type": "signal",
        "default": 1,
        "description": "Trigger — non-zero retriggers a noteOn at the current freq."
      }
