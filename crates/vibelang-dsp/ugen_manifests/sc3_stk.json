[
  {
    "name": "StkPluck",
    "description": "Karplus-Strong plucked-string physical model from the Stanford STK (sc3-plugins). Excites a delay-line filter loop tuned to freq with a noise burst on instantiation.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "freq",
        "type": "float",
        "default": 440.0,
        "description": "Fundamental frequency in Hz."
      },
      {
        "name": "decay",
        "type": "float",
        "default": 0.99,
        "description": "Loop decay coefficient (0..1). Closer to 1 sustains longer."
      }
    ],
    "outputs": 1,
    "category": "StkUGens"
  },
  {
    "name": "StkFlute",
    "description": "Waveguide flute physical model from the Stanford STK (sc3-plugins). Models air column with jet excitation.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "freq",
        "type": "float",
        "default": 440.0,
        "description": "Fundamental frequency in Hz."
      },
      {
        "name": "jetDelay",
        "type": "float",
        "default": 49.0,
        "description": "Jet delay in samples (controls embouchure timing)."
      },
      {
        "name": "noisegain",
        "type": "float",
        "default": 0.15,
        "description": "Breath noise gain (0..1)."
      },
      {
        "name": "jetRatio",
        "type": "float",
        "default": 0.32,
        "description": "Ratio of jet delay to bore length — affects overtone balance."
      }
    ],
    "outputs": 1,
    "category": "StkUGens"
  },
  {
    "name": "StkBowed",
    "description": "Bowed-string physical model (violin/cello-style) from the Stanford STK (sc3-plugins). Implements a slip-stick bow interaction with a waveguide string.",
