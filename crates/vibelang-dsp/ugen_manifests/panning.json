[
  {
    "name": "Pan2",
    "description": "Two channel equal power panner. Pans a mono signal to stereo with equal power distribution.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Mono input signal"
      },
      {
        "name": "pos",
        "type": "float",
        "default": 0,
        "description": "Pan position (-1=left, 0=center, 1=right)"
      },
      {
        "name": "level",
        "type": "float",
        "default": 1,
        "description": "Output level"
      }
    ],
    "outputs": 2,
    "category": "Panning",
    "functions": [
      "pan2_ar",
      "pan2_kr"
    ]
  },
