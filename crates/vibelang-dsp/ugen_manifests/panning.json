  {
    "name": "PanAz",
    "description": "Azimuth panner for multiple speakers. Equal power panning to N speakers arranged in a circle.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "numChans",
        "type": "float",
        "default": 4,
        "description": "Number of output channels"
      },
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Mono input signal"
      },
      {
        "name": "pos",
        "type": "float",
        "default": 0,
        "description": "Pan position (0 to 1=full rotation, 0=channel 0)"
      },
      {
        "name": "level",
        "type": "float",
        "default": 1,
        "description": "Output level"
      },
      {
        "name": "width",
        "type": "float",
        "default": 2,
        "description": "Width of panning envelope (1 to numChans)"
      },
      {
        "name": "orientation",
        "type": "float",
        "default": 0.5,
        "description": "Speaker arrangement orientation"
      }
    ],
    "outputs": 4,
    "category": "Panning",
    "functions": [
      "pan_az_ar",
      "pan_az_kr"
    ]
  },
