[
  {
    "name": "DWGPlucked",
    "description": "Digital waveguide physical model of a plucked-string instrument.",
    "rates": [
      "ar"
    ],
    "inputs": [
      {
        "name": "freq",
        "type": "float",
        "default": 440.0,
        "description": "Sound frequency in Hz."
      },
      {
        "name": "amp",
        "type": "float",
        "default": 0.5,
        "description": "Key pulsation strength (0..1)."
      },
      {
        "name": "gate",
        "type": "float",
        "default": 1,
        "description": "Releases synth when value changes from > 0 to 0."
      },
      {
        "name": "pos",
        "type": "float",
        "default": 0.14,
        "description": "Relative pluck position from 0 to 1."
      },
      {
        "name": "c1",
        "type": "float",
        "default": 1.0,
        "description": "Inverse of DC decay time."
      },
      {
        "name": "c3",
        "type": "float",
        "default": 30.0,
        "description": "High-frequency loss factor."
      },
      {
        "name": "inp",
        "type": "signal",
        "default": 0,
        "description": "Plucking signal — can be the first part of a plucked sample for commuted synthesis."
      },
      {
        "name": "release",
        "type": "float",
        "default": 0.1,
        "description": "Release time in seconds."
      }
    ],
    "outputs": 1,
    "category": "DWGUGens"
  },
  {
    "name": "DWGPluckedStiff",
    "description": "Digital waveguide plucked-string model with string-stiffness inharmonicity, after Rauhala & Välimäki (2006), 'Tunable dispersion filter design for piano synthesis'.",
    "rates": [
      "ar"
    ],
    "inputs": [
      {
        "name": "freq",
        "type": "float",
        "default": 440.0,
        "description": "Sound frequency in Hz."
      },
      {
        "name": "amp",
        "type": "float",
        "default": 0.5,
        "description": "Key pulsation strength (0..1)."
      },
      {
        "name": "gate",
        "type": "float",
        "default": 1,
        "description": "Releases synth when value changes from > 0 to 0."
      },
      {
        "name": "pos",
        "type": "float",
        "default": 0.14,
        "description": "Relative pluck position from 0 to 1."
      },
      {
        "name": "c1",
        "type": "float",
        "default": 1.0,
        "description": "Inverse of DC decay time."
      },
      {
        "name": "c3",
        "type": "float",
        "default": 30.0,
        "description": "High-frequency loss factor."
      },
      {
        "name": "inp",
        "type": "signal",
        "default": 0,
        "description": "Plucking signal — can be the first part of a plucked sample for commuted synthesis."
      },
      {
        "name": "release",
        "type": "float",
        "default": 0.1,
        "description": "Release time in seconds."
      },
      {
        "name": "fB",
        "type": "float",
        "default": 2.0,
        "description": "Inharmonicity factor — controls the dispersive stiffness of the string."
      }
    ],
    "outputs": 1,
    "category": "DWGUGens"
  },
  {
    "name": "DWGPlucked2",
    "description": "Digital waveguide plucked-string model with two strings coupled by the gc parameter (suitable for piano-like dual-string sympathetic excitation).",
    "rates": [
      "ar"
    ],
    "inputs": [
      {
        "name": "freq",
        "type": "float",
        "default": 440.0,
        "description": "Sound frequency in Hz."
      },
      {
        "name": "amp",
        "type": "float",
        "default": 0.5,
        "description": "Key pulsation strength (0..1)."
      },
      {
        "name": "gate",
        "type": "float",
        "default": 1,
        "description": "Releases synth when value changes from > 0 to 0."
      },
      {
        "name": "pos",
        "type": "float",
        "default": 0.14,
        "description": "Relative pluck position from 0 to 1."
      },
      {
        "name": "c1",
        "type": "float",
        "default": 1.0,
        "description": "Inverse of DC decay time."
      },
      {
        "name": "c3",
        "type": "float",
        "default": 30.0,
        "description": "High-frequency loss factor."
      },
      {
        "name": "inp",
        "type": "signal",
        "default": 0,
        "description": "Plucking signal — can be the first part of a plucked sample for commuted synthesis."
      },
      {
        "name": "release",
        "type": "float",
        "default": 0.1,
        "description": "Release time in seconds."
      },
      {
        "name": "mistune",
        "type": "float",
        "default": 1.008,
        "description": "Detuning factor for the second string relative to the first."
      },
      {
        "name": "mp",
        "type": "float",
        "default": 0.55,
        "description": "Excitation mixer between the two strings — 1 = first only, 0 = second only."
      },
      {
        "name": "gc",
        "type": "float",
        "default": 0.01,
        "description": "String coupling factor between the two strings."
      }
    ],
    "outputs": 1,
    "category": "DWGUGens"
  },
