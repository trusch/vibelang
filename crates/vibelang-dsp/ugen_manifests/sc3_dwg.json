      },
      {
        "name": "d7",
        "type": "float",
        "default": 239.0,
        "description": "Delay length in samples for resonator 7."
      },
      {
        "name": "d8",
        "type": "float",
        "default": 241.0,
        "description": "Delay length in samples for resonator 8."
      }
    ],
    "outputs": 1,
    "category": "DWGUGens"
  }
