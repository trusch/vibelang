  {
    "name": "DWGSoundBoard",
    "description": "Resonating soundboard model — a parallel bank of eight tunable delay lines with decay and damping. Used downstream of DWGPlucked / DWGBowed to give the string output a body resonance.",
    "rates": [
      "ar"
    ],
    "inputs": [
      {
        "name": "inp",
        "type": "signal",
        "default": 0,
        "description": "Input signal (typically the output of a DWGPlucked or DWGBowed UGen)."
      },
      {
        "name": "c1",
        "type": "float",
        "default": 20.0,
        "description": "Inverse of DC decay time for the soundboard resonators."
      },
      {
        "name": "c3",
        "type": "float",
        "default": 20.0,
        "description": "High-frequency loss factor for the soundboard resonators."
      },
      {
        "name": "mix",
        "type": "float",
        "default": 0.8,
        "description": "Wet/dry mix between the resonated signal and the dry input (0..1)."
      },
      {
        "name": "d1",
        "type": "float",
        "default": 199.0,
        "description": "Delay length in samples for resonator 1."
      },
      {
