  {
    "name": "DWGBowedTor",
    "description": "Digital waveguide bowed-string model that augments DWGBowed with a torsional-wave companion waveguide (mistuned, with its own decay and impedance), modelling string twist alongside transverse vibration.",
    "rates": [
      "ar"
    ],
    "inputs": [
      {
        "name": "freq",
        "type": "float",
        "default": 440.0,
        "description": "Sound frequency in Hz."
      },
      {
        "name": "velb",
        "type": "float",
        "default": 0.5,
        "description": "Bow velocity."
      },
      {
        "name": "force",
        "type": "float",
        "default": 1.0,
        "description": "Bow normal force."
      },
      {
        "name": "gate",
        "type": "float",
        "default": 1,
        "description": "Releases synth when value changes from > 0 to 0."
      },
      {
        "name": "pos",
        "type": "float",
        "default": 0.14,
        "description": "Relative bow position from 0 to 1."
      },
      {
        "name": "release",
        "type": "float",
        "default": 0.1,
        "description": "Release time in seconds."
      },
      {
        "name": "c1",
        "type": "float",
        "default": 1.0,
        "description": "Inverse of DC decay time."
      },
      {
        "name": "c3",
        "type": "float",
        "default": 3.0,
        "description": "High-frequency loss factor."
      },
      {
        "name": "impZ",
        "type": "float",
        "default": 0.55,
        "description": "String impedance."
      },
      {
        "name": "fB",
        "type": "float",
        "default": 2.0,
        "description": "Inharmonicity factor."
      },
      {
        "name": "mistune",
        "type": "float",
        "default": 5.2,
        "description": "Relative frequency of the torsional waves."
      },
      {
        "name": "c1tor",
        "type": "float",
        "default": 1.0,
        "description": "Inverse of DC decay time for the torsional wave."
      },
      {
        "name": "c3tor",
        "type": "float",
        "default": 3000.0,
