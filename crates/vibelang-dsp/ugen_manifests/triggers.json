      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Input trigger signal"
      },
      {
        "name": "dur",
        "type": "float",
        "default": 0.1,
        "description": "Delay time in seconds"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "t_delay_ar",
      "t_delay_kr"
    ]
  },
  {
    "name": "SendPeakRMS",
    "description": "Send peak and RMS values back to the client at a regular reply rate. Produces no audio output.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "sig",
        "type": "signal",
        "default": 0,
        "description": "Input signal to analyze"
      },
      {
        "name": "replyRate",
        "type": "float",
        "default": 20,
        "description": "Number of replies sent to the client per second"
      },
      {
        "name": "peakLag",
        "type": "float",
        "default": 3,
        "description": "Lag time applied to the peak value (useful for VU meters)"
      },
      {
        "name": "cmdName",
        "type": "float",
        "default": 0,
        "description": "OSC address pattern for the reply message"
      },
      {
        "name": "replyID",
        "type": "float",
        "default": -1,
        "description": "Integer reply ID, similar to SendTrig"
      }
    ],
    "outputs": 0,
    "category": "Triggers",
    "functions": [
      "send_peak_rms_ar",
      "send_peak_rms_kr"
    ]
  },
  {
    "name": "Poll",
    "description": "Print or send the current value of a UGen on each trigger. Transparently passes its input through.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "trig",
        "type": "signal",
        "default": 0,
        "description": "Trigger input; a non-positive to positive transition causes Poll to emit a value"
      },
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Signal whose current value will be polled"
      },
      {
        "name": "label",
        "type": "float",
        "default": 0,
        "description": "Label string/symbol printed alongside the polled value"
      },
      {
        "name": "trigid",
        "type": "float",
        "default": -1,
        "description": "If greater than 0, a /tr OSC message is sent back to the client"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "poll_ar",
      "poll_kr"
    ]
  }
]
