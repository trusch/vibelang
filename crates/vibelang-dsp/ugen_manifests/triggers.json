      "kr"
    ],
    "inputs": [
      {
        "name": "src",
        "type": "signal",
        "default": 0,
        "description": "UGen to monitor for done signal"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "done_kr"
    ]
  },
  {
    "name": "Free",
    "description": "When triggered, frees a node by id. Used for managing synth lifecycles in patterns.",
    "rates": [
      "kr"
    ],
    "inputs": [
      {
        "name": "trig",
        "type": "signal",
        "default": 0,
        "description": "Trigger input. Free fires when the signal crosses from non-positive to positive"
      },
      {
        "name": "id",
        "type": "float",
        "default": 0,
        "description": "Node id to be freed"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "free_kr"
    ]
  },
  {
    "name": "FreeSelf",
    "description": "Free the enclosing synth when input crosses from non-positive to positive.",
    "rates": [
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Input trigger signal. Synth is freed on a non-positive to positive transition"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "free_self_kr"
    ]
  },
  {
    "name": "FreeSelfWhenDone",
    "description": "Free the enclosing synth when the source UGen sets its 'done' flag (e.g. Line, EnvGen).",
    "rates": [
      "kr"
    ],
    "inputs": [
      {
        "name": "src",
        "type": "signal",
        "default": 0,
        "description": "UGen with a done flag to monitor (Line, EnvGen, PlayBuf, etc.)"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "free_self_when_done_kr"
    ]
  },
  {
    "name": "Pause",
    "description": "Pause/resume a node by id. When gate is 0 the node is paused; when 1 it runs.",
    "rates": [
      "kr"
    ],
    "inputs": [
      {
        "name": "gate",
        "type": "signal",
        "default": 1,
        "description": "Gate signal: 0 pauses the node, 1 resumes it"
      },
      {
        "name": "id",
        "type": "float",
        "default": 0,
        "description": "Node id to be paused/resumed"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "pause_kr"
    ]
  },
  {
    "name": "PauseSelf",
    "description": "Pause the enclosing synth when input crosses from non-positive to positive.",
    "rates": [
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Input trigger signal. Synth is paused on a non-positive to positive transition"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "pause_self_kr"
    ]
  },
  {
    "name": "PauseSelfWhenDone",
    "description": "Pause the enclosing synth when the source UGen sets its 'done' flag.",
    "rates": [
      "kr"
    ],
    "inputs": [
      {
        "name": "src",
        "type": "signal",
        "default": 0,
        "description": "UGen with a done flag to monitor"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "pause_self_when_done_kr"
    ]
  },
