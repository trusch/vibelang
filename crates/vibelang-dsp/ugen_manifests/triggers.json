      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Trigger input signal"
      },
      {
        "name": "id",
        "type": "float",
        "default": 0,
        "description": "Trigger ID number"
      },
      {
        "name": "value",
        "type": "float",
        "default": 0,
        "description": "Value to send with trigger message"
      }
    ],
    "outputs": 0,
    "category": "Triggers",
    "functions": [
      "send_trig_ar",
      "send_trig_kr"
    ]
  },
  {
    "name": "SendReply",
