[
  {
    "name": "Trig",
    "description": "Timed trigger. When triggered, outputs the trigger value for a specified duration.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Trigger input signal"
      },
      {
        "name": "dur",
        "type": "float",
        "default": 0.1,
        "description": "Duration to hold trigger value in seconds"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "trig_ar",
      "trig_kr"
    ]
  },
  {
    "name": "Trig1",
    "description": "Timed trigger that outputs 1. When triggered, outputs 1.0 for a specified duration.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Trigger input signal"
      },
      {
        "name": "dur",
        "type": "float",
        "default": 0.1,
        "description": "Duration in seconds"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "trig1_ar",
      "trig1_kr"
    ]
  },
  {
    "name": "SendTrig",
    "description": "Send a trigger message to the client. Sends OSC message when triggered.",
