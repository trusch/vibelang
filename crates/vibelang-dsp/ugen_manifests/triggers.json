        "default": 0,
        "description": "Lower threshold"
      },
      {
        "name": "hi",
        "type": "float",
        "default": 1,
        "description": "Upper threshold"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "schmidt_ar",
      "schmidt_kr"
    ]
  },
