    ]
  },
  {
    "name": "InRange",
    "description": "Test if signal is within range. Outputs 1 if lo <= in <= hi, otherwise 0.",
    "rates": [
      "ar",
      "kr",
      "ir"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Input signal to test"
      },
      {
        "name": "lo",
        "type": "float",
        "default": 0,
        "description": "Lower bound (inclusive)"
      },
      {
        "name": "hi",
        "type": "float",
        "default": 1,
        "description": "Upper bound (inclusive)"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "in_range_ar",
      "in_range_kr"
    ]
  },
  {
    "name": "InRect",
    "description": "Test if point is within rectangle. Outputs 1 if (x,y) is inside rectangle.",
    "rates": [
      "ar",
      "kr",
      "ir"
    ],
    "inputs": [
      {
        "name": "x",
        "type": "signal",
        "default": 0,
        "description": "X coordinate"
      },
      {
        "name": "y",
        "type": "signal",
        "default": 0,
        "description": "Y coordinate"
      },
      {
        "name": "rect",
        "type": "signal",
        "default": 0,
        "description": "Rectangle bounds [left, top, right, bottom]"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "in_rect_ar",
      "in_rect_kr"
    ]
  },
  {
    "name": "Changed",
