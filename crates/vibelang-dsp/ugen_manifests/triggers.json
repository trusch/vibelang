  {
    "name": "Stepper",
    "description": "Step through values. Counts up/down through a range with trigger and reset.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "trig",
        "type": "signal",
        "default": 0,
        "description": "Trigger to advance one step"
      },
      {
        "name": "reset",
        "type": "signal",
        "default": 0,
        "description": "Reset to resetval"
      },
      {
        "name": "min",
        "type": "float",
        "default": 0,
        "description": "Minimum value"
      },
      {
        "name": "max",
        "type": "float",
        "default": 7,
        "description": "Maximum value"
      },
      {
        "name": "step",
        "type": "float",
        "default": 1,
        "description": "Step size (can be negative)"
      },
      {
        "name": "resetval",
        "type": "float",
        "default": 0,
        "description": "Value to reset to"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "stepper_ar",
      "stepper_kr"
    ]
  },
