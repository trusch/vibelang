      {
        "name": "values",
        "type": "signal",
        "default": 0,
        "description": "Array of values to send"
      },
      {
        "name": "replyID",
        "type": "float",
        "default": -1,
        "description": "Reply ID number"
      }
    ],
    "outputs": 0,
    "category": "Triggers",
    "functions": [
      "send_reply_ar",
      "send_reply_kr"
    ]
  },
