      {
        "name": "b",
        "type": "signal",
        "default": 0,
        "description": "Input signal B"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "least_change_ar",
      "least_change_kr"
    ]
  },
  {
    "name": "MostChange",
    "description": "Output whichever of two inputs has changed most since the previous sample.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "a",
        "type": "signal",
        "default": 0,
        "description": "Input signal A"
      },
      {
        "name": "b",
        "type": "signal",
        "default": 0,
        "description": "Input signal B"
      }
    ],
    "outputs": 1,
    "category": "Triggers",
    "functions": [
      "most_change_ar",
      "most_change_kr"
    ]
  },
  {
    "name": "LastValue",
    "description": "Output the last value before the input changed by more than diff.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Input signal"
      },
      {
        "name": "diff",
        "type": "float",
