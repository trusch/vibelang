// kind=fx | category=granular | flavor=scatter | stereo=true | params=jitter_amount,density,grain_size,mix,level
//
// Scatter Granular Effect
//
// TGrains with per-grain random position jitter. Each grain trigger
// re-rolls a fresh random read offset around the buffer centre via
// `t_rand_kr`, so the wet output scatters fragments of the source across
// the time window — useful for chaotic textures and stutter-style ambience.
//
// Usage:
//   group.add_effect("scatter", "scatter", #{
//     jitter_amount: 0.5,
//     density: 30.0,
//     grain_size: 0.1,
//     mix: 0.5,
//     level: 1.0,
//   });
//
// Parameters:
//   jitter_amount: Range of position randomisation (0 = centred, 1 = full buffer)
//   density: Grain trigger rate in grains/sec (1 to 100)
//   grain_size: Grain duration in seconds (0.01 to 0.5)
//   mix: Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("scatter", |builder| {
    builder
        .param("jitter_amount", 0.5)
        .param("density", 30.0)
        .param("grain_size", 0.1)
        .param("mix", 0.5)
        .param("level", 1.0)
        .body(|input, jitter_amount, density, grain_size, mix, level| {
            // ~2s circular buffers, one per channel.
            let buf_l = local_buf_ir(1, 96000);
            let buf_r = local_buf_ir(1, 96000);

            record_buf_ar(input[0], buf_l, 0, 1.0, 0.0, 1.0, 1, 1, 0);
            record_buf_ar(input[1], buf_r, 0, 1.0, 0.0, 1.0, 1, 1, 0);

            // Shared grain trigger; per-side TRand re-rolls a fresh offset
            // on every rising edge, so each grain reads a different slice
            // and the two channels stay decorrelated.
            let trig = impulse_ar(density, 0.0);
            let pos_l = 0.5 + t_rand_kr(-1.0, 1.0, trig) * jitter_amount * 0.5;
            let pos_r = 0.5 + t_rand_kr(-1.0, 1.0, trig) * jitter_amount * 0.5;

            let g_l = channels(t_grains_ar(2, trig, buf_l, 1.0, pos_l, grain_size, 0.0, 0.5, 4), 2);
            let g_r = channels(t_grains_ar(2, trig, buf_r, 1.0, pos_r, grain_size, 0.0, 0.5, 4), 2);

            let wet_l = leak_dc_ar((g_l[0] + g_l[1]) * 0.5, 0.995);
            let wet_r = leak_dc_ar((g_r[0] + g_r[1]) * 0.5, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level,
            ]
        })
});
