// kind=fx | category=granular | flavor=clouds | stereo=true | params=mode,freeze,position,size,pitch,density,texture,dry_wet,spread,feedback,reverb,trigger,quality,blend,mix,level
//
// Clouds Processor Effect - Mutable Instruments Clouds wrapper
//
// Wraps the Mutable Instruments Clouds port (mi_clouds_ar) as a stereo
// granular texture processor. Defaults to GRANULAR playback mode with the
// original wrapper's old dry/wet behavior preserved through `blend` + `mix`.
//
// REQUIRES: mi-UGens plugin installed in your SuperCollider extensions.
//
// Playback modes:
//   0  granular       - classic asynchronous grain cloud
//   1  stretch        - WSOLA-style time stretch
//   2  looping_delay  - looping delay / buffer repeat
//   3  spectral       - phase-vocoder spectral smear/freeze
//
// Quality variants:
//   0  high stereo    - separate left/right Clouds cores, normal buffer
//   1  high mono      - folded mono Clouds core, normal buffer
//   2  lo-fi stereo   - separate left/right Clouds cores, 4s lo-fi buffer
//   3  lo-fi mono     - folded mono Clouds core, 4s lo-fi buffer
//
// Usage:
//   group.add_effect("clouds", "clouds_processor", #{
//     mode: 0,
//     freeze: 0,
//     position: 0.5,
//     size: 0.5,
//     pitch: 0.0,
//     density: 0.5,
//     texture: 0.5,
//     dry_wet: 0.5,
//     spread: 0.3,
//     feedback: 0.0,
//     reverb: 0.0,
//     trigger: 0,
//     quality: 0,
//     level: 1.0,
//   });
//
// Parameters:
//   mode: Playback mode (0=granular, 1=stretch, 2=looping_delay, 3=spectral)
//   freeze: Freeze the recording buffer (0/1)
//   position: Playback position in the internal 8s buffer (0 to 1)
//   size: Grain size (0 to 1)
//   pitch: Pitch shift in semitones (-24 to +24)
//   density: Grain density (0..0.5 = periodic, 0.5..1 = random; 0.5 ≈ silent)
//   texture: Grain texture / window shape (0 to 1)
//   dry_wet: Processor dry/wet mix (0.0 = dry, 1.0 = wet)
//   spread: Clouds stereo spread (0 to 1)
//   feedback: Clouds feedback amount (0 to 0.9)
//   reverb: Clouds internal reverb amount (0 to 1)
//   trigger: Single grain trigger input (0/1 or pulse)
//   quality: 0=high stereo, 1=high mono, 2=lo-fi stereo, 3=lo-fi mono
//   blend: Legacy internal Clouds dry/wet alias; kept for old patches (0 to 1)
//   mix: Legacy outer dry/wet alias; kept for old patches (0 to 1)
//   level: Output trim applied after the dry/wet mix

define_fx("clouds_processor", |builder| {
    builder
        .param("mode", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or algorithm.
        .param("freeze", 0.0) // units: trigger, range: 0..1, default: 0.0. Freeze switch; rounded values turn that mode off or on.
        .param("position", 0.5) // units: ratio, range: 0..1, default: 0.5. Position macro; higher values move the model toward its brighter or more complex side.
        .param("size", 0.5) // units: ratio, range: 0..1, default: 0.5. Size; higher values use a larger buffer, room, or grain window.
        .param("pitch", 0.0) // units: semitones, range: -48..48, default: 0.0. Pitch in MIDI-note units; higher values play higher notes.
        .param("density", 0.5) // units: normalized, range: 0..1, default: 0.5. Event density per second; higher values create more grains, dust, or impulses.
        .param("texture", 0.5) // units: ratio, range: 0..1, default: 0.5. Texture amount; higher values emphasize that named musical or electrical behavior.
        .param("dry_wet", 0.5) // units: ratio, range: 0..1, default: 0.5. Blend amount; 0 favors the first source and 1 favors the second or wet source.
        .param("spread", 0.3) // units: ratio, range: 0..1, default: 0.3. Spread width; higher values distribute energy across a wider range.
        .param("feedback", 0.0) // units: ratio, range: 0..1, default: 0.0. Feedback amount; higher gives longer repeats and can approach self-oscillation.
        .param("reverb", 0.0) // units: normalized, range: 0..1, default: 0.0. Reverb amount; higher values emphasize that named musical or electrical behavior.
        .param("trigger", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("quality", 0.0) // units: normalized, range: 0..1, default: 0.0. Quality mode; higher values choose denser or cleaner granular processing.
        .param("blend", 1.0) // units: ratio, range: 0..1, default: 1.0. Blend amount; 0 favors the first source and 1 favors the second or wet source.
        .param("mix", 0.5) // units: ratio, range: 0..1, default: 0.5. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body_map(|p| {
            let input = p.input;
            let mono = (input[0] + input[1]) * 0.5;

            let mode_i = clip(round(p.mode), 0.0, 3.0);
            let freeze_i = clip(round(p.freeze), 0.0, 1.0);
            let quality_i = clip(round(p.quality), 0.0, 3.0);
            let trigger_sig = trig1_kr(clip(p.trigger, 0.0, 1.0), 0.001);

            let pos = clip(p.position, 0.0, 1.0);
            let grain_size = clip(p.size, 0.0, 1.0);
            let pit = clip(p.pitch, -24.0, 24.0);
            let dens = clip(p.density, 0.0, 1.0);
            let tex = clip(p.texture, 0.0, 1.0);
            let clouds_dry_wet = clip(p.blend, 0.0, 1.0);
            let clouds_spread = clip(p.spread, 0.0, 1.0);
            let clouds_reverb = clip(p.reverb, 0.0, 1.0);
            let clouds_feedback = clip(p.feedback, 0.0, 0.9);
            let out_mix = clip(p.dry_wet + p.mix - 0.5, 0.0, 1.0);

            // mi_clouds_ar args: in, pit, pos, size, dens, tex, drywet,
            //   in_gain, spread, rvb, fb, freeze, mode, lofi, trig
            // `blend` remains the legacy name for Clouds' internal drywet.
            // `dry_wet` is the processor-level mix and `mix` is its old alias.
            let high_l = channels(
                mi_clouds_ar(
                    input[0], pit, pos, grain_size, dens, tex, clouds_dry_wet,
                    1.0, clouds_spread, clouds_reverb, clouds_feedback,
                    freeze_i, mode_i, 0, trigger_sig
                ),
                2
            );
            let high_r = channels(
                mi_clouds_ar(
                    input[1], pit, pos, grain_size, dens, tex, clouds_dry_wet,
                    1.0, clouds_spread, clouds_reverb, clouds_feedback,
                    freeze_i, mode_i, 0, trigger_sig
                ),
                2
            );
            let high_mono = channels(
                mi_clouds_ar(
                    mono, pit, pos, grain_size, dens, tex, clouds_dry_wet,
                    1.0, clouds_spread, clouds_reverb, clouds_feedback,
                    freeze_i, mode_i, 0, trigger_sig
                ),
                2
            );
            let lofi_l = channels(
                mi_clouds_ar(
                    input[0], pit, pos, grain_size, dens, tex, clouds_dry_wet,
                    1.0, clouds_spread, clouds_reverb, clouds_feedback,
                    freeze_i, mode_i, 1, trigger_sig
                ),
                2
            );
            let lofi_r = channels(
                mi_clouds_ar(
                    input[1], pit, pos, grain_size, dens, tex, clouds_dry_wet,
                    1.0, clouds_spread, clouds_reverb, clouds_feedback,
                    freeze_i, mode_i, 1, trigger_sig
                ),
                2
            );
            let lofi_mono = channels(
                mi_clouds_ar(
                    mono, pit, pos, grain_size, dens, tex, clouds_dry_wet,
                    1.0, clouds_spread, clouds_reverb, clouds_feedback,
                    freeze_i, mode_i, 1, trigger_sig
                ),
                2
            );

            let high_stereo_w = clip(1.0 - abs(quality_i - 0.0), 0.0, 1.0);
            let high_mono_w = clip(1.0 - abs(quality_i - 1.0), 0.0, 1.0);
            let lofi_stereo_w = clip(1.0 - abs(quality_i - 2.0), 0.0, 1.0);
            let lofi_mono_w = clip(1.0 - abs(quality_i - 3.0), 0.0, 1.0);

            let wet_l = leak_dc_ar(
                high_l[0] * high_stereo_w
                    + high_mono[0] * high_mono_w
                    + lofi_l[0] * lofi_stereo_w
                    + lofi_mono[0] * lofi_mono_w,
                0.995
            );
            let wet_r = leak_dc_ar(
                high_r[1] * high_stereo_w
                    + high_mono[1] * high_mono_w
                    + lofi_r[1] * lofi_stereo_w
                    + lofi_mono[1] * lofi_mono_w,
                0.995
            );

            [
                ((1.0 - out_mix) * input[0] + out_mix * wet_l) * p.level,
                ((1.0 - out_mix) * input[1] + out_mix * wet_r) * p.level,
            ]
        })
});

//
// # Usage: clouds_processor
//
// ```rhai
// import "stdlib/effects/granular/clouds_processor.vibe" as clouds_processor;
//
// let doc_clouds_processor = fx("doc_clouds_processor")
//     .synth("clouds_processor")
//     .param("mode", 0.0)
//     .param("freeze", 0.0)
//     .param("position", 0.5)
//     .param("size", 0.5)
//     .apply();
// ```
