// kind=fx | category=spectral | flavor=freeze | stereo=true | params=freeze,mix,level
//
// Spectral Freeze
//
// Captures the current magnitude spectrum and holds it indefinitely while
// `freeze` is high. Phases continue to evolve so the held tone keeps a natural
// shimmer rather than turning into a static loop.
//
// Usage:
//   group.add_effect("frz", "spectral_freeze", #{
//     freeze: 1.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   freeze: Gate. 0 = passthrough (magnitudes update normally),
//           > 0 = hold the current spectrum.
//   mix:    Dry/wet mix (0.0 = dry, 1.0 = wet).
//   level:  Output level trim applied after the dry/wet mix.

define_fx("spectral_freeze", |builder| {
    builder
        .param("freeze", 0.0)
        .param("mix", 1.0)
        .param("level", 1.0)
        .body(|input, freeze, mix, level| {
            // Per-channel FFT buffers (2048 frames -> ~46 ms at 44.1 kHz).
            let buf_l = local_buf_ir(1.0, 2048.0);
            let buf_r = local_buf_ir(1.0, 2048.0);

            // Analyse with 50% hop and Hann window.
            let chain_l = fft_kr(buf_l, input[0], 0.5, 1.0, 1.0, 0.0);
            let chain_r = fft_kr(buf_r, input[1], 0.5, 1.0, 1.0, 0.0);

            // Hold magnitudes when freeze > 0.
            let frozen_l = pv_mag_freeze_kr(chain_l, freeze);
            let frozen_r = pv_mag_freeze_kr(chain_r, freeze);

            // Resynthesise.
            let wet_l = ifft_ar(frozen_l, 1.0, 0.0);
            let wet_r = ifft_ar(frozen_r, 1.0, 0.0);

            // Strip DC offset that resynthesis can introduce.
            let blocked_l = leak_dc_ar(wet_l, 0.995);
            let blocked_r = leak_dc_ar(wet_r, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * blocked_l) * level,
                ((1.0 - mix) * input[1] + mix * blocked_r) * level
            ]
        })
});
