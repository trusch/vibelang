// kind=fx | category=spectral | flavor=gate | stereo=true | params=threshold,mix,level
//
// Spectral Gate
//
// Per-bin magnitude gate: passes only FFT bins whose magnitude is above
// `threshold`, zeroing the rest. Useful for cleaning up reverb tails, stripping
// quiet bleed off recordings, or carving out only the loud partials of a tone.
//
// Threshold values are raw FFT magnitudes — they scale with input level and
// FFT size, so dial in by ear. Typical useful range is 1.0 - 50.0 for normal
// program material at unity gain.
//
// Usage:
//   group.add_effect("sgate", "spectral_gate", #{
//     threshold: 5.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   threshold: Magnitude threshold; bins at or below this are zeroed.
//   mix:       Dry/wet mix (0.0 = dry, 1.0 = wet).
//   level:     Output level trim applied after the dry/wet mix.

define_fx("spectral_gate", |builder| {
    builder
        .param("threshold", 5.0) // units: linear, range: 0..20, default: 5.0. Detection threshold; higher values require a stronger signal before processing opens.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, threshold, mix, level| {
            // Per-channel FFT buffers (2048 frames -> ~46 ms at 44.1 kHz).
            let buf_l = local_buf_ir(1.0, 2048.0);
            let buf_r = local_buf_ir(1.0, 2048.0);

            // Analyse with 50% hop and Hann window.
            let chain_l = fft_kr(buf_l, input[0], 0.5, 1.0, 1.0, 0.0);
            let chain_r = fft_kr(buf_r, input[1], 0.5, 1.0, 1.0, 0.0);

            // Pass only bins above threshold.
            let gated_l = pv_mag_above_kr(chain_l, threshold);
            let gated_r = pv_mag_above_kr(chain_r, threshold);

            // Resynthesise.
            let wet_l = ifft_ar(gated_l, 1.0, 0.0);
            let wet_r = ifft_ar(gated_r, 1.0, 0.0);

            // Strip DC offset that resynthesis can introduce.
            let blocked_l = leak_dc_ar(wet_l, 0.995);
            let blocked_r = leak_dc_ar(wet_r, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * blocked_l) * level,
                ((1.0 - mix) * input[1] + mix * blocked_r) * level
            ]
        })
});

//
// # Usage: spectral_gate
//
// ```rhai
// import "stdlib/effects/spectral/spectral_gate.vibe" as spectral_gate;
//
// let doc_spectral_gate = fx("doc_spectral_gate")
//     .synth("spectral_gate")
//     .param("threshold", 5.0)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
