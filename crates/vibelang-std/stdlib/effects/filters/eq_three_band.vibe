// kind=fx | category=filter | flavor=eq_three_band | stereo=true | params=low_gain,mid_gain,high_gain,low_freq,high_freq,mix,level
//
// Three Band Equalizer
//
// Simple three-band EQ with low, mid, and high frequency control.
//
// Usage:
//   group.add_effect("eq", "eq_three_band", #{
//     low_gain: 0.0,
//     mid_gain: 0.0,
//     high_gain: 0.0,
//     low_freq: 250.0,
//     high_freq: 4000.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   low_gain:  Low frequency gain in dB (-12 to 12)
//   mid_gain:  Mid frequency gain in dB (-12 to 12)
//   high_gain: High frequency gain in dB (-12 to 12)
//   low_freq:  Low/mid crossover frequency in Hz
//   high_freq: Mid/high crossover frequency in Hz
//   mix:       Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:     Output trim applied after the dry/wet mix

define_fx("eq_three_band", |builder| {
    builder
        .param("low_gain", 0.0) // units: dB, range: -24..24, default: 0.0. Low Gain trim; higher sends more of that signal onward.
        .param("mid_gain", 0.0) // units: dB, range: -24..24, default: 0.0. Mid Gain trim; higher sends more of that signal onward.
        .param("high_gain", 0.0) // units: dB, range: -24..24, default: 0.0. High Gain trim; higher sends more of that signal onward.
        .param("low_freq", 250.0) // units: Hz, range: 20..20000, default: 250.0. Low Freq in Hz; higher values move that tone or filter point upward.
        .param("high_freq", 4000.0) // units: Hz, range: 20..20000, default: 4000.0. High Freq in Hz; higher values move that tone or filter point upward.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, low_gain, mid_gain, high_gain, low_freq, high_freq, mix, level| {
            // Process left channel
            let low_left = b_low_shelf_ar(input[0], low_freq, 1.0, low_gain);
            let mid_left = b_peak_eq_ar(low_left, (low_freq + high_freq) * 0.5, 1.0, mid_gain);
            let eq_left = b_hi_shelf_ar(mid_left, high_freq, 1.0, high_gain);

            // Process right channel
            let low_right = b_low_shelf_ar(input[1], low_freq, 1.0, low_gain);
            let mid_right = b_peak_eq_ar(low_right, (low_freq + high_freq) * 0.5, 1.0, mid_gain);
            let eq_right = b_hi_shelf_ar(mid_right, high_freq, 1.0, high_gain);

            let wet_l = leak_dc_ar(eq_left, 0.995);
            let wet_r = leak_dc_ar(eq_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: eq_three_band
//
// ```rhai
// import "stdlib/effects/filters/eq_three_band.vibe" as eq_three_band;
//
// let doc_eq_three_band = fx("doc_eq_three_band")
//     .synth("eq_three_band")
//     .param("low_gain", 0.0)
//     .param("mid_gain", 0.0)
//     .param("high_gain", 0.0)
//     .param("low_freq", 250.0)
//     .apply();
// ```
