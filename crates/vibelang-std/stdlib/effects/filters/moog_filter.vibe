// kind=fx | category=filter | flavor=moog | stereo=true | params=cutoff,resonance,mix,level
//
// Moog Ladder Filter Effect
//
// Classic 24dB/oct Moog VCF style low pass filter with self-oscillation.
//
// Usage:
//   group.add_effect("moog", "moog_filter", #{
//     cutoff: 1000.0,
//     resonance: 2.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   cutoff:    Cutoff frequency in Hz (20 to 20000)
//   resonance: Filter resonance/gain (0.0 to 4.0, values > 1.0 can self-oscillate)
//   mix:       Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:     Output trim applied after the dry/wet mix

define_fx("moog_filter", |builder| {
    builder
        .param("cutoff", 1000.0) // units: Hz, range: 20..20000, default: 1000.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
        .param("resonance", 2.5) // units: resonance, range: 0..4, default: 2.5. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, cutoff, resonance, mix, level| {
            // MoogFF - the classic Moog ladder filter
            let filtered_left = moog_ff_ar(input[0], cutoff, resonance, 0.0);
            let filtered_right = moog_ff_ar(input[1], cutoff, resonance, 0.0);

            let wet_l = leak_dc_ar(filtered_left, 0.995);
            let wet_r = leak_dc_ar(filtered_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: moog_filter
//
// ```rhai
// import "stdlib/effects/filters/moog_filter.vibe" as moog_filter;
//
// let doc_moog_filter = fx("doc_moog_filter")
//     .synth("moog_filter")
//     .param("cutoff", 1000.0)
//     .param("resonance", 2.5)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
