// kind=fx | category=filter | flavor=formant | stereo=true | params=freq,attack,decay,mix,level
//
// Formant Filter Effect
//
// Creates vowel-like resonances using formant filtering.
//
// Usage:
//   group.add_effect("formant", "formant_filter", #{
//     freq: 800.0,
//     attack: 0.01,
//     decay: 0.1,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   freq:   Formant frequency in Hz (200 to 5000)
//   attack: Attack time in seconds
//   decay:  Decay time in seconds
//   mix:    Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:  Output trim applied after the dry/wet mix

define_fx("formant_filter", |builder| {
    builder
        .param("freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("attack", 0.01) // units: seconds, range: 0..10, default: 0.01. Envelope time or level; higher values make that stage last longer or sustain higher.
        .param("decay", 0.1) // units: seconds, range: 0..10, default: 0.1. Envelope time or level; higher values make that stage last longer or sustain higher.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, freq, attack, decay, mix, level| {
            // Apply formant filtering
            let formant_left = formlet_ar(input[0], freq, attack, decay);
            let formant_right = formlet_ar(input[1], freq, attack, decay);

            let wet_l = leak_dc_ar(formant_left, 0.995);
            let wet_r = leak_dc_ar(formant_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: formant_filter
//
// ```rhai
// import "stdlib/effects/filters/formant_filter.vibe" as formant_filter;
//
// let doc_formant_filter = fx("doc_formant_filter")
//     .synth("formant_filter")
//     .param("freq", 800.0)
//     .param("attack", 0.01)
//     .param("decay", 0.1)
//     .param("mix", 1.0)
//     .apply();
// ```
