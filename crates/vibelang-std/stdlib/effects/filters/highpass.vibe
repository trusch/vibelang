// kind=fx | category=filter | flavor=highpass | stereo=true | params=cutoff,resonance,mix,level
//
// High Pass Filter Effect
//
// Cuts frequencies below the cutoff frequency using a resonant filter.
//
// Usage:
//   group.add_effect("hp", "highpass", #{
//     cutoff: 200.0,
//     resonance: 0.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   cutoff:    Cutoff frequency in Hz (20 to 20000)
//   resonance: Filter resonance (0.0 to 1.0, low values = more resonance)
//   mix:       Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:     Output trim applied after the dry/wet mix

define_fx("highpass", |builder| {
    builder
        .param("cutoff", 200.0)
        .param("resonance", 0.5)
        .param("mix", 1.0)
        .param("level", 1.0)
        .body(|input, cutoff, resonance, mix, level| {
            // RHPF provides resonant high pass filtering
            let filtered_left = rhpf_ar(input[0], cutoff, resonance);
            let filtered_right = rhpf_ar(input[1], cutoff, resonance);

            let wet_l = leak_dc_ar(filtered_left, 0.995);
            let wet_r = leak_dc_ar(filtered_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});
