// kind=fx | category=filter | flavor=highpass | stereo=true | params=cutoff,resonance,mix,level
//
// High Pass Filter Effect
//
// Cuts frequencies below the cutoff frequency using a resonant filter.
//
// Usage:
//   group.add_effect("hp", "highpass", #{
//     cutoff: 200.0,
//     resonance: 0.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   cutoff:    Cutoff frequency in Hz (20 to 20000)
//   resonance: Filter resonance (0.0 to 1.0, low values = more resonance)
//   mix:       Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:     Output trim applied after the dry/wet mix

define_fx("highpass", |builder| {
    builder
        .param("cutoff", 200.0) // units: Hz, range: 20..20000, default: 200.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
        .param("resonance", 0.5) // units: resonance, range: 0..1, default: 0.5. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, cutoff, resonance, mix, level| {
            // RHPF provides resonant high pass filtering
            let filtered_left = rhpf_ar(input[0], cutoff, resonance);
            let filtered_right = rhpf_ar(input[1], cutoff, resonance);

            let wet_l = leak_dc_ar(filtered_left, 0.995);
            let wet_r = leak_dc_ar(filtered_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: highpass
//
// ```rhai
// import "stdlib/effects/filters/highpass.vibe" as highpass;
//
// let doc_highpass = fx("doc_highpass")
//     .synth("highpass")
//     .param("cutoff", 200.0)
//     .param("resonance", 0.5)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
