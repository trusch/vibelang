// kind=fx | category=filter | flavor=resonator | stereo=true | params=freq,decay,mix,level
//
// Resonator Effect
//
// Modal resonator that adds pitched resonance.
//
// Usage:
//   group.add_effect("res", "resonator", #{
//     freq: 440.0,
//     decay: 0.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   freq:  Resonant frequency in Hz
//   decay: Resonance decay time (0.1 to 2.0)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("resonator", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("decay", 0.5) // units: seconds, range: 0..10, default: 0.5. Envelope time or level; higher values make that stage last longer or sustain higher.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, freq, decay, mix, level| {
            // Comb filter for resonance
            let delay_time = 1.0 / freq;
            let resonated_left = comb_c_ar(input[0], 0.05, delay_time, decay * 2.0);
            let resonated_right = comb_c_ar(input[1], 0.05, delay_time, decay * 2.0);

            let wet_l = leak_dc_ar(resonated_left, 0.995);
            let wet_r = leak_dc_ar(resonated_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: resonator
//
// ```rhai
// import "stdlib/effects/filters/resonator.vibe" as resonator;
//
// let doc_resonator = fx("doc_resonator")
//     .synth("resonator")
//     .param("freq", 440.0)
//     .param("decay", 0.5)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
