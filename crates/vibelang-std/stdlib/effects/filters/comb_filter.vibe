// kind=fx | category=filter | flavor=comb | stereo=true | params=freq,decay,mix,level
//
// Comb Filter Effect
//
// Creates resonances at harmonics of a fundamental frequency.
// Useful for metallic and robotic sounds.
//
// Usage:
//   group.add_effect("comb", "comb_filter", #{
//     freq: 220.0,
//     decay: 2.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   freq:  Fundamental frequency in Hz (20 to 2000)
//   decay: Decay time in seconds (0.1 to 10.0)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("comb_filter", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("decay", 2.0) // units: seconds, range: 0..10, default: 2.0. Envelope time or level; higher values make that stage last longer or sustain higher.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, freq, decay, mix, level| {
            // Calculate delay time from frequency
            let delay_time = 1.0 / freq;

            // Apply comb filter
            let combed_left = comb_l_ar(input[0], 0.1, delay_time, decay);
            let combed_right = comb_l_ar(input[1], 0.1, delay_time, decay);

            let wet_l = leak_dc_ar(combed_left, 0.995);
            let wet_r = leak_dc_ar(combed_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: comb_filter
//
// ```rhai
// import "stdlib/effects/filters/comb_filter.vibe" as comb_filter;
//
// let doc_comb_filter = fx("doc_comb_filter")
//     .synth("comb_filter")
//     .param("freq", 220.0)
//     .param("decay", 2.0)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
