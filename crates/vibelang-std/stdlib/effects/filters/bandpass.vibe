// kind=fx | category=filter | flavor=bandpass | stereo=true | params=freq,bandwidth,mix,level
//
// Band Pass Filter Effect
//
// Passes only a band of frequencies around a center frequency.
//
// Usage:
//   group.add_effect("bp", "bandpass", #{
//     freq: 1000.0,
//     bandwidth: 0.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   freq:      Center frequency in Hz
//   bandwidth: Bandwidth in octaves (reciprocal of Q)
//   mix:       Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:     Output trim applied after the dry/wet mix

define_fx("bandpass", |builder| {
    builder
        .param("freq", 1000.0) // units: Hz, range: 20..20000, default: 1000.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("bandwidth", 0.5) // units: normalized, range: 0..1, default: 0.5. Bandwidth amount; higher values emphasize that named musical or electrical behavior.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, freq, bandwidth, mix, level| {
            // BPF provides band pass filtering
            let filtered_left = bpf_ar(input[0], freq, bandwidth);
            let filtered_right = bpf_ar(input[1], freq, bandwidth);

            let wet_l = leak_dc_ar(filtered_left, 0.995);
            let wet_r = leak_dc_ar(filtered_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: bandpass
//
// ```rhai
// import "stdlib/effects/filters/bandpass.vibe" as bandpass;
//
// let doc_bandpass = fx("doc_bandpass")
//     .synth("bandpass")
//     .param("freq", 1000.0)
//     .param("bandwidth", 0.5)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
