// kind=fx | category=delay | flavor=ping_pong | stereo=true | params=time,feedback,mix,level
//
// Ping Pong Delay Effect
//
// Stereo delay where echoes bounce between left and right channels.
//
// Usage:
//   group.add_effect("ping", "ping_pong_delay", #{
//     time: 0.375,
//     feedback: 0.6,
//     mix: 0.4,
//     level: 1.0
//   });
//
// Parameters:
//   time:     Delay time in seconds (0.01 to 2.0)
//   feedback: Feedback amount (0.0 to 0.95)
//   mix:      Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:    Final output trim (1.0 = unity)

define_fx("ping_pong_delay")
    .param("time", 0.375) // units: seconds, range: 0..10, default: 0.375. Delay or segment time; higher values make repeats arrive later.
    .param("feedback", 0.6) // units: ratio, range: 0..1, default: 0.6. Feedback amount; higher gives longer repeats and can approach self-oscillation.
    .param("mix", 0.4) // units: ratio, range: 0..1, default: 0.4. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, time, feedback, mix, level| {
        // Create cross-coupled delays (left feeds right, right feeds left)
        let processed_l = delay_n_ar(input[0] + (feedback * delay_n_ar(input[1], 2.0, time)), 2.0, time);
        let processed_r = delay_n_ar(input[1] + (feedback * delay_n_ar(input[0], 2.0, time)), 2.0, time);

        let wet_l = leak_dc_ar(processed_l, 0.995);
        let wet_r = leak_dc_ar(processed_r, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: ping_pong_delay
//
// ```rhai
// import "stdlib/effects/delays/ping_pong_delay.vibe" as ping_pong_delay;
//
// let doc_ping_pong_delay = fx("doc_ping_pong_delay")
//     .synth("ping_pong_delay")
//     .param("time", 0.375)
//     .param("feedback", 0.6)
//     .param("mix", 0.4)
//     .param("level", 1.0)
//     .apply();
// ```
