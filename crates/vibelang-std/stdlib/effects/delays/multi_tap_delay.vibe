// kind=fx | category=delay | flavor=multi_tap | stereo=true | params=time,feedback,spread,filter,mix,level
//
// Multi-Tap Delay Effect
// Inspired by: Eventide H8000, Strymon Volante, vintage tape delays
//
// Multiple delay taps creating complex rhythmic patterns and textures.
// Great for ambient, dub, and rhythmic production.
//
// Usage:
//   group.add_effect("multi", "multi_tap_delay", #{
//     time: 0.375,
//     feedback: 0.4,
//     spread: 0.7,
//     filter: 0.6,
//     mix: 0.4,
//     level: 1.0
//   });
//
// Parameters:
//   time:     Base delay time in seconds (0.1 to 1.0)
//   feedback: Overall feedback amount (0.0 to 0.9)
//   spread:   Stereo spread of taps (0.0 to 1.0)
//   filter:   High frequency content (0.0 = dark, 1.0 = bright)
//   mix:      Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:    Final output trim (1.0 = unity)

define_fx("multi_tap_delay")
    .param("time", 0.375) // units: seconds, range: 0..10, default: 0.375. Delay or segment time; higher values make repeats arrive later.
    .param("feedback", 0.4) // units: ratio, range: 0..1, default: 0.4. Feedback amount; higher gives longer repeats and can approach self-oscillation.
    .param("spread", 0.7) // units: ratio, range: 0..1, default: 0.7. Spread width; higher values distribute energy across a wider range.
    .param("filter", 0.6) // units: selector, range: 0..N, default: 0.6. Selects filter mode.
    .param("mix", 0.4) // units: ratio, range: 0..1, default: 0.4. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, time, feedback, spread, filter, mix, level| {
        let mono = (input[0] + input[1]) * 0.5;

        // Six delay taps at musical intervals
        let tap1 = delay_c_ar(mono, 2.0, time * 0.25) * 0.8;      // 1/4
        let tap2 = delay_c_ar(mono, 2.0, time * 0.375) * 0.7;     // dotted 8th feel
        let tap3 = delay_c_ar(mono, 2.0, time * 0.5) * 0.6;       // 1/2
        let tap4 = delay_c_ar(mono, 2.0, time * 0.667) * 0.5;     // 2/3
        let tap5 = delay_c_ar(mono, 2.0, time * 0.75) * 0.4;      // 3/4
        let tap6 = delay_c_ar(mono, 2.0, time) * 0.5;             // full

        // Distribute taps in stereo field
        let left_taps = tap1 + tap3 * (1.0 - spread * 0.5) + tap5;
        let right_taps = tap2 + tap4 * (1.0 - spread * 0.5) + tap6;

        // Cross-feed for stereo coherence
        let cross = 0.3 * (1.0 - spread);
        let stereo_l = left_taps + right_taps * cross;
        let stereo_r = right_taps + left_taps * cross;

        // Apply feedback
        let fb_l = delay_c_ar(stereo_l * feedback, 2.0, time);
        let fb_r = delay_c_ar(stereo_r * feedback, 2.0, time);

        let total_l = stereo_l + fb_l * feedback;
        let total_r = stereo_r + fb_r * feedback;

        // Tone control
        let cutoff = 3000.0 + filter * 9000.0;
        let processed_l = lpf_ar(total_l, cutoff) * 0.7;
        let processed_r = lpf_ar(total_r, cutoff) * 0.7;

        let wet_l = leak_dc_ar(processed_l, 0.995);
        let wet_r = leak_dc_ar(processed_r, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: multi_tap_delay
//
// ```rhai
// import "stdlib/effects/delays/multi_tap_delay.vibe" as multi_tap_delay;
//
// let doc_multi_tap_delay = fx("doc_multi_tap_delay")
//     .synth("multi_tap_delay")
//     .param("time", 0.375)
//     .param("feedback", 0.4)
//     .param("spread", 0.7)
//     .param("filter", 0.6)
//     .apply();
// ```
