// kind=fx | category=modulation | flavor=flanger | stereo=true | params=rate,depth,feedback,mix,level
//
// Flanger Effect
//
// Creates a sweeping, jet-like sound using short modulated delays with feedback.
//
// Usage:
//   group.add_effect("flanger", "flanger", #{
//     rate: 0.3,
//     depth: 0.005,
//     feedback: 0.5,
//     mix: 0.3,
//     level: 1.0
//   });
//
// Parameters:
//   rate:     LFO rate in Hz (0.05 to 5.0)
//   depth:    Modulation depth in seconds (0.001 to 0.01)
//   feedback: Feedback amount (0.0 to 0.95)
//   mix:      Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:    Output trim applied after the dry/wet mix

define_fx("flanger", |builder| {
    builder
        .param("rate", 0.3) // units: Hz, range: 0..100, default: 0.3. Clock or modulation rate in Hz; higher values make motion faster.
        .param("depth", 0.005) // units: ratio, range: 0..1, default: 0.005. Modulation depth; higher values make the movement more pronounced.
        .param("feedback", 0.5) // units: ratio, range: 0..1, default: 0.5. Feedback amount; higher gives longer repeats and can approach self-oscillation.
        .param("mix", 0.3) // units: ratio, range: 0..1, default: 0.3. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, rate, depth, feedback, mix, level| {
            // LFO for modulation
            let lfo = sin_osc_ar(rate, 0.0);

            // Modulated delay time (shorter than chorus for flanger effect)
            let delay_time = 0.003 + (depth * lfo);

            // Create delayed signals with feedback
            let delayed_left = delay_c_ar(input[0] + (feedback * delay_c_ar(input[0], 0.02, delay_time)), 0.02, delay_time);
            let delayed_right = delay_c_ar(input[1] + (feedback * delay_c_ar(input[1], 0.02, delay_time)), 0.02, delay_time);

            let wet_l = leak_dc_ar(delayed_left, 0.995);
            let wet_r = leak_dc_ar(delayed_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: flanger
//
// ```rhai
// import "stdlib/effects/modulation/flanger.vibe" as flanger;
//
// let doc_flanger = fx("doc_flanger")
//     .synth("flanger")
//     .param("rate", 0.3)
//     .param("depth", 0.005)
//     .param("feedback", 0.5)
//     .param("mix", 0.3)
//     .apply();
// ```
