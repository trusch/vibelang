// kind=fx | category=modulation | flavor=rotary | stereo=true | params=rate,depth,mix,level
//
// Rotary Speaker Effect
//
// Simulates a rotating speaker (like a Leslie speaker) with Doppler and amplitude modulation.
//
// Usage:
//   group.add_effect("leslie", "rotary", #{
//     rate: 6.0,
//     depth: 0.003,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   rate:  Rotation rate in Hz (0.5 to 10.0)
//   depth: Doppler depth in seconds (0.001 to 0.01)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("rotary", |builder| {
    builder
        .param("rate", 6.0) // units: Hz, range: 0..100, default: 6.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("depth", 0.003) // units: ratio, range: 0..1, default: 0.003. Modulation depth; higher values make the movement more pronounced.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, rate, depth, mix, level| {
            // Mix to mono for effect
            let mono = (input[0] + input[1]) * 0.5;

            // LFOs for modulation (90 degrees apart for stereo)
            let lfo_left = sin_osc_ar(rate, 0.0);
            let lfo_right = sin_osc_ar(rate, 1.57);

            // Doppler effect (pitch modulation via delay)
            let delay_left = 0.005 + (depth * lfo_left);
            let delay_right = 0.005 + (depth * lfo_right);

            let doppler_left = delay_c_ar(mono, 0.1, delay_left);
            let doppler_right = delay_c_ar(mono, 0.1, delay_right);

            // Amplitude modulation (volume changes as speaker rotates)
            let amp_mod_left = 0.8 + (0.2 * lfo_left);
            let amp_mod_right = 0.8 + (0.2 * lfo_right);

            // Combine effects
            let rotated_l = doppler_left * amp_mod_left;
            let rotated_r = doppler_right * amp_mod_right;

            let wet_l = leak_dc_ar(rotated_l, 0.995);
            let wet_r = leak_dc_ar(rotated_r, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: rotary
//
// ```rhai
// import "stdlib/effects/modulation/rotary.vibe" as rotary;
//
// let doc_rotary = fx("doc_rotary")
//     .synth("rotary")
//     .param("rate", 6.0)
//     .param("depth", 0.003)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
