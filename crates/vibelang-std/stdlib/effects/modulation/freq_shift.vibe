// kind=fx | category=modulation | flavor=freq_shift | stereo=true | params=shift,mix,level
//
// Frequency Shifter Effect
//
// Shifts all frequencies by a fixed amount in Hz.
// Unlike pitch shifting, this creates inharmonic, metallic textures.
//
// Usage:
//   group.add_effect("shift", "freq_shift", #{
//     shift: 5.0,
//     mix: 0.3,
//     level: 1.0
//   });
//
// Parameters:
//   shift: Frequency shift in Hz (-500 to 500)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("freq_shift", |builder| {
    builder
        .param("shift", 5.0) // units: semitones, range: -48..48, default: 5.0. Phase shift amount; higher values offset the related output further.
        .param("mix", 0.3) // units: ratio, range: 0..1, default: 0.3. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, shift, mix, level| {
            // Ring modulation with sine wave creates frequency shifting
            // Positive shift moves frequencies up, negative moves down
            let mod_osc = sin_osc_ar(shift.abs());

            // Apply ring modulation
            let shifted_left = input[0] * mod_osc;
            let shifted_right = input[1] * mod_osc;

            // Filter to remove unwanted sidebands
            let filtered_left = lpf_ar(shifted_left, 12000.0);
            let filtered_right = lpf_ar(shifted_right, 12000.0);

            let wet_l = leak_dc_ar(filtered_left, 0.995);
            let wet_r = leak_dc_ar(filtered_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: freq_shift
//
// ```rhai
// import "stdlib/effects/modulation/freq_shift.vibe" as freq_shift;
//
// let doc_freq_shift = fx("doc_freq_shift")
//     .synth("freq_shift")
//     .param("shift", 5.0)
//     .param("mix", 0.3)
//     .param("level", 1.0)
//     .apply();
// ```
