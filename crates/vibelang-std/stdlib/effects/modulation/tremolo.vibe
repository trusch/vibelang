// kind=fx | category=modulation | flavor=tremolo | stereo=true | params=rate,depth,mix,level
//
// Tremolo Effect
//
// Amplitude modulation that creates a rhythmic volume variation.
//
// Usage:
//   group.add_effect("trem", "tremolo", #{
//     rate: 4.0,
//     depth: 0.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   rate:  Modulation rate in Hz (0.1 to 20.0)
//   depth: Modulation depth (0.0 to 1.0)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("tremolo", |builder| {
    builder
        .param("rate", 4.0) // units: Hz, range: 0..100, default: 4.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("depth", 0.5) // units: ratio, range: 0..1, default: 0.5. Modulation depth; higher values make the movement more pronounced.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, rate, depth, mix, level| {
            // LFO for amplitude modulation
            let lfo = sin_osc_ar(rate, 0.0);

            // Convert LFO from -1..1 to modulation range
            let mod = 1.0 - (depth * 0.5 * (1.0 + lfo));

            // Apply modulation to both channels
            let modulated_l = input[0] * mod;
            let modulated_r = input[1] * mod;

            let wet_l = leak_dc_ar(modulated_l, 0.995);
            let wet_r = leak_dc_ar(modulated_r, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: tremolo
//
// ```rhai
// import "stdlib/effects/modulation/tremolo.vibe" as tremolo;
//
// let doc_tremolo = fx("doc_tremolo")
//     .synth("tremolo")
//     .param("rate", 4.0)
//     .param("depth", 0.5)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
