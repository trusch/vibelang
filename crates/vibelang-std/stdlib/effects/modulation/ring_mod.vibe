// kind=fx | category=modulation | flavor=ring_mod | stereo=true | params=freq,mix,level
//
// Ring Modulator Effect
//
// Creates metallic, bell-like tones by multiplying the input with a sine wave.
//
// Usage:
//   group.add_effect("ring", "ring_mod", #{
//     freq: 440.0,
//     mix: 0.3,
//     level: 1.0
//   });
//
// Parameters:
//   freq:  Modulator frequency in Hz (20 to 5000)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("ring_mod", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("mix", 0.3) // units: ratio, range: 0..1, default: 0.3. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, freq, mix, level| {
            // Generate modulator (carrier wave)
            let modulator = sin_osc_ar(freq, 0.0);

            // Ring modulation: multiply input by modulator
            let modulated_l = input[0] * modulator;
            let modulated_r = input[1] * modulator;

            let wet_l = leak_dc_ar(modulated_l, 0.995);
            let wet_r = leak_dc_ar(modulated_r, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: ring_mod
//
// ```rhai
// import "stdlib/effects/modulation/ring_mod.vibe" as ring_mod;
//
// let doc_ring_mod = fx("doc_ring_mod")
//     .synth("ring_mod")
//     .param("freq", 440.0)
//     .param("mix", 0.3)
//     .param("level", 1.0)
//     .apply();
// ```
