// kind=fx | category=modulation | flavor=auto_pan | stereo=true | params=rate,depth,mix,level
//
// Auto Pan Effect
//
// Automatically pans the signal between left and right channels.
//
// Usage:
//   group.add_effect("pan", "auto_pan", #{
//     rate: 0.25,
//     depth: 0.8,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   rate:  Pan rate in Hz (0.05 to 10.0)
//   depth: Pan depth (0.0 to 1.0)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("auto_pan", |builder| {
    builder
        .param("rate", 0.25) // units: Hz, range: 0..100, default: 0.25. Clock or modulation rate in Hz; higher values make motion faster.
        .param("depth", 0.8) // units: ratio, range: 0..1, default: 0.8. Modulation depth; higher values make the movement more pronounced.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, rate, depth, mix, level| {
            // LFO for pan position
            let lfo = sin_osc_ar(rate, 0.0);
            let pan_pos = lfo * depth;

            // Mix to mono first, then pan
            let mono = (input[0] + input[1]) * 0.5;

            // Pan the signal and split into stereo channels
            let stereo = channels(pan2_ar(mono, pan_pos, 1.0), 2);

            let wet_l = leak_dc_ar(stereo[0], 0.995);
            let wet_r = leak_dc_ar(stereo[1], 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: auto_pan
//
// ```rhai
// import "stdlib/effects/modulation/auto_pan.vibe" as auto_pan;
//
// let doc_auto_pan = fx("doc_auto_pan")
//     .synth("auto_pan")
//     .param("rate", 0.25)
//     .param("depth", 0.8)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
