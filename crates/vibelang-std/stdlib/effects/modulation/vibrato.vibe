// kind=fx | category=modulation | flavor=vibrato | stereo=true | params=rate,depth,mix,level
//
// Vibrato Effect
//
// Pitch modulation effect that creates a vibrato sound.
//
// Usage:
//   group.add_effect("vib", "vibrato", #{
//     rate: 5.0,
//     depth: 0.002,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   rate:  Vibrato rate in Hz (1.0 to 20.0)
//   depth: Vibrato depth in seconds (0.0001 to 0.01)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("vibrato", |builder| {
    builder
        .param("rate", 5.0) // units: Hz, range: 0..100, default: 5.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("depth", 0.002) // units: ratio, range: 0..1, default: 0.002. Modulation depth; higher values make the movement more pronounced.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, rate, depth, mix, level| {
            // LFO for pitch modulation
            let lfo = sin_osc_ar(rate, 0.0);

            // Modulated delay time creates pitch variation
            let delay_time = 0.01 + (depth * lfo);

            // Apply modulated delay
            let vibrato_left = delay_c_ar(input[0], 0.1, delay_time);
            let vibrato_right = delay_c_ar(input[1], 0.1, delay_time);

            let wet_l = leak_dc_ar(vibrato_left, 0.995);
            let wet_r = leak_dc_ar(vibrato_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: vibrato
//
// ```rhai
// import "stdlib/effects/modulation/vibrato.vibe" as vibrato;
//
// let doc_vibrato = fx("doc_vibrato")
//     .synth("vibrato")
//     .param("rate", 5.0)
//     .param("depth", 0.002)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
