// kind=fx | category=distortion | flavor=vinyl | stereo=true | params=crackle,dust,wow,flutter,wear,mix,level
//
// Vinyl Record Effect
//
// Simulates the sound of a vinyl record with crackle, dust, and wow/flutter.
//
// Usage:
//   group.add_effect("vinyl", "vinyl", #{
//     crackle: 0.05,
//     dust: 0.02,
//     wow: 0.3,
//     flutter: 0.2,
//     wear: 4000.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   crackle: Crackle amount (0.0 to 0.2)
//   dust:    Dust/click amount (0.0 to 0.1)
//   wow:     Slow pitch variation (0.0 to 1.0)
//   flutter: Fast pitch variation (0.0 to 1.0)
//   wear:    Filter cutoff for record wear in Hz (2000 to 8000)
//   mix:     Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:   Output trim applied after the dry/wet mix

define_fx("vinyl", |builder| {
    builder
        .param("crackle", 0.05) // units: ratio, range: 0..1, default: 0.05. Crackle amount; higher values emphasize that named musical or electrical behavior.
        .param("dust", 0.02) // units: ratio, range: 0..1, default: 0.02. Dust amount; higher values emphasize that named musical or electrical behavior.
        .param("wow", 0.3) // units: ratio, range: 0..1, default: 0.3. Tape wow depth; higher values add slower pitch drift.
        .param("flutter", 0.2) // units: ratio, range: 0..1, default: 0.2. Tape flutter depth; higher values add faster pitch shimmer.
        .param("wear", 4000.0) // units: Hz, range: 20..20000, default: 4000.0. Wear amount; higher values emphasize that named musical or electrical behavior.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, crackle, dust, wow, flutter, wear, mix, level| {
            // Wow (slow pitch variation)
            let wow_lfo = sin_osc_ar(0.5, 0.0) * wow * 0.001;
            let flutter_lfo = sin_osc_ar(10.0, 0.0) * flutter * 0.0003;
            let pitch_var = 0.01 + wow_lfo + flutter_lfo;

            // Apply pitch variation via delay
            let warbled_left = delay_c_ar(input[0], 0.1, pitch_var);
            let warbled_right = delay_c_ar(input[1], 0.1, pitch_var);

            // Record wear (high frequency rolloff)
            let worn_left = lpf_ar(warbled_left, wear);
            let worn_right = lpf_ar(warbled_right, wear);

            // Add crackle (filtered noise)
            let crackle_sig = lpf_ar(dust2_ar(1000.0) * crackle, 8000.0);

            // Add dust pops (random impulses)
            let dust_sig = dust_ar(50.0) * dust;

            // Combine all elements
            let vinyl_left = worn_left + crackle_sig + dust_sig;
            let vinyl_right = worn_right + crackle_sig + dust_sig;

            let wet_l = leak_dc_ar(vinyl_left, 0.995);
            let wet_r = leak_dc_ar(vinyl_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: vinyl
//
// ```rhai
// import "stdlib/effects/distortion/vinyl.vibe" as vinyl;
//
// let doc_vinyl = fx("doc_vinyl")
//     .synth("vinyl")
//     .param("crackle", 0.05)
//     .param("dust", 0.02)
//     .param("wow", 0.3)
//     .param("flutter", 0.2)
//     .apply();
// ```
