// kind=fx | category=distortion | flavor=hard_clip | stereo=true | params=drive,tone,mix,level
//
// Distortion Effect
//
// Hard clipping distortion with pre and post gain control.
//
// Usage:
//   group.add_effect("dist", "distortion", #{
//     drive: 8.0,
//     tone: 5000.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   drive: Input gain/drive (1.0 to 50.0)
//   tone:  Low-pass filter cutoff after distortion (1000 to 12000 Hz)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("distortion", |builder| {
    builder
        .param("drive", 8.0) // units: gain, range: 0..20, default: 8.0. Nonlinear drive amount; higher adds harmonic distortion and compression.
        .param("tone", 5000.0) // units: Hz, range: 20..20000, default: 5000.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, drive, tone, mix, level| {
            // Large constant boost to ensure we hit tanh saturation even on quiet signals
            // drive=8 -> 800x boost, drive=20 -> 2000x boost
            let boost = 1.0;

            // Remove low-end mud and boost signal for clipping
            let driven_left = hpf_ar(input[0], 80.0) * boost * drive;
            let driven_right = hpf_ar(input[1], 80.0) * boost * drive;

            // Soft clip using tanh for amp-like behavior
            let clipped_left = driven_left.tanh();
            let clipped_right = driven_right.tanh();

            // Tone shaping to tame fizz
            let shaped_left = lpf_ar(clipped_left, tone);
            let shaped_right = lpf_ar(clipped_right, tone);

            let wet_l = leak_dc_ar(shaped_left, 0.995);
            let wet_r = leak_dc_ar(shaped_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: distortion
//
// ```rhai
// import "stdlib/effects/distortion/distortion.vibe" as distortion;
//
// let doc_distortion = fx("doc_distortion")
//     .synth("distortion")
//     .param("drive", 8.0)
//     .param("tone", 5000.0)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
