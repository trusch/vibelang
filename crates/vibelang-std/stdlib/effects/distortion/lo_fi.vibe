// kind=fx | category=distortion | flavor=lo_fi | stereo=true | params=bit_depth,sample_rate,noise,filter_freq,mix,level
//
// Lo-Fi Effect
//
// Combines multiple effects to create a lo-fi, degraded sound quality.
//
// Usage:
//   group.add_effect("lofi", "lo_fi", #{
//     bit_depth: 10.0,
//     sample_rate: 16000.0,
//     noise: 0.02,
//     filter_freq: 3500.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   bit_depth:   Bit depth reduction (4.0 to 16.0)
//   sample_rate: Sample rate reduction in Hz (4000 to 44100)
//   noise:       Noise amount (0.0 to 0.1)
//   filter_freq: Low pass filter frequency in Hz (1000 to 8000)
//   mix:         Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:       Output trim applied after the dry/wet mix

define_fx("lo_fi", |builder| {
    builder
        .param("bit_depth", 10.0) // units: bits, range: 1..24, default: 10.0. Modulation depth; higher values make the movement more pronounced.
        .param("sample_rate", 16000.0) // units: Hz, range: 1000..48000, default: 16000.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("noise", 0.02) // units: linear, range: 0..1, default: 0.02. Noise amount; higher values emphasize that named musical or electrical behavior.
        .param("filter_freq", 3500.0) // units: Hz, range: 20..20000, default: 3500.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, bit_depth, sample_rate, noise, filter_freq, mix, level| {
            // Sample rate reduction
            let rate_reduced_left = latch_ar(input[0], impulse_ar(sample_rate, 0.0));
            let rate_reduced_right = latch_ar(input[1], impulse_ar(sample_rate, 0.0));

            // Approximate bit depth reduction using drive + soft-clipping.
            // Map bit_depth (4..16) to a modest drive factor.
            let drive = 1.0 + (bit_depth / 8.0);
            let crushed_left = (rate_reduced_left * drive).tanh();
            let crushed_right = (rate_reduced_right * drive).tanh();

            // Add noise
            let noise_sig = pink_noise_ar() * noise;
            let noisy_left = crushed_left + noise_sig;
            let noisy_right = crushed_right + noise_sig;

            // Low pass filter
            let filtered_left = lpf_ar(noisy_left, filter_freq);
            let filtered_right = lpf_ar(noisy_right, filter_freq);

            // Slight distortion
            let lofi_l = (filtered_left * 1.2).tanh();
            let lofi_r = (filtered_right * 1.2).tanh();

            let wet_l = leak_dc_ar(lofi_l, 0.995);
            let wet_r = leak_dc_ar(lofi_r, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: lo_fi
//
// ```rhai
// import "stdlib/effects/distortion/lo_fi.vibe" as lo_fi;
//
// let doc_lo_fi = fx("doc_lo_fi")
//     .synth("lo_fi")
//     .param("bit_depth", 10.0)
//     .param("sample_rate", 16000.0)
//     .param("noise", 0.02)
//     .param("filter_freq", 3500.0)
//     .apply();
// ```
