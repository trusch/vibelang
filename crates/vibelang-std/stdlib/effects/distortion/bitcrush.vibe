// kind=fx | category=distortion | flavor=bitcrush | stereo=true | params=bits,sample_rate,mix,level
//
// Bitcrusher Effect
//
// Reduces bit depth and sample rate for lo-fi digital distortion.
//
// Usage:
//   group.add_effect("crush", "bitcrush", #{
//     bits: 8.0,
//     sample_rate: 8000.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   bits:        Bit depth (1.0 to 16.0)
//   sample_rate: Sample rate reduction in Hz (100 to 44100)
//   mix:         Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:       Output trim applied after the dry/wet mix

define_fx("bitcrush", |builder| {
    builder
        .param("bits", 8.0) // units: bits, range: 1..24, default: 8.0. Random shift-register bit depth; higher values make stepped CV less coarse.
        .param("sample_rate", 8000.0) // units: Hz, range: 1000..48000, default: 8000.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, bits, sample_rate, mix, level| {
            // Map bits (1..16) to a gentle drive factor.
            // We avoid using a true power function here to keep the graph stable.
            // 1.0 ≈ barely crushed, 4.0 ≈ heavy crush.
            let drive = 1.0 + (bits / 8.0);

            // Sample rate reduction using Latch
            let rate_reduced_left = latch_ar(input[0], impulse_ar(sample_rate, 0.0));
            let rate_reduced_right = latch_ar(input[1], impulse_ar(sample_rate, 0.0));

            // Bit depth reduction (approximate) by increasing drive and soft-clipping.
            let crushed_left = (rate_reduced_left * drive).tanh();
            let crushed_right = (rate_reduced_right * drive).tanh();

            let wet_l = leak_dc_ar(crushed_left, 0.995);
            let wet_r = leak_dc_ar(crushed_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: bitcrush
//
// ```rhai
// import "stdlib/effects/distortion/bitcrush.vibe" as bitcrush;
//
// let doc_bitcrush = fx("doc_bitcrush")
//     .synth("bitcrush")
//     .param("bits", 8.0)
//     .param("sample_rate", 8000.0)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
