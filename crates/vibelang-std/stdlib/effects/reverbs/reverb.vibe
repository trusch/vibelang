// kind=fx | category=reverb | flavor=freeverb | stereo=true | params=room,damp,mix,level
//
// Generic Reverb Effect
//
// Intentionally simple ("dumb") reverb wrapping the FreeVerb UGen so it is
// easy to debug. Not a studio-quality algorithm, but useful as a sanity-check
// effect and a baseline for testing the audio graph.
//
// Parameters:
//   room:  Room size (0.0 to 1.0)
//   damp:  High-frequency damping (0.0 to 1.0)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Final output trim (1.0 = unity)

define_fx("reverb")
    .param("room", 0.6) // units: ratio, range: 0..1, default: 0.6. Reverb room size; higher values make a larger, longer acoustic space.
    .param("damp", 0.4) // units: ratio, range: 0..1, default: 0.4. Damping amount; higher values shorten and darken the decay.
    .param("mix", 0.3) // units: ratio, range: 0..1, default: 0.3. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, room, damp, mix, level| {
        // Collapse to mono, run FreeVerb fully wet, then duplicate.
        let mono = (input[0] + input[1]) * 0.5;
        let wet = free_verb_ar(mono, 1.0, room, damp);

        // DC-block the wet path before the dry/wet mix
        let wet_l = leak_dc_ar(wet, 0.995);
        let wet_r = leak_dc_ar(wet, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: reverb
//
// ```rhai
// import "stdlib/effects/reverbs/reverb.vibe" as reverb;
//
// let doc_reverb = fx("doc_reverb")
//     .synth("reverb")
//     .param("room", 0.6)
//     .param("damp", 0.4)
//     .param("mix", 0.3)
//     .param("level", 1.0)
//     .apply();
// ```
