// kind=fx | category=reverb | flavor=plate | stereo=true | params=time,damp,mix,level
//
// Plate Reverb Effect
//
// Simulates a plate reverb using a chain of allpass filters for diffusion
// followed by parallel comb filters for the reverb tail. Reference
// implementation of the stdlib effects spec — see kb/stdlib-effects-spec.md.
//
// Usage:
//   group.add_effect("plate", "plate_reverb", #{
//     time: 2.0,
//     damp: 0.4,
//     mix: 0.3,
//     level: 1.0
//   });
//
// Parameters:
//   time:  Reverb time in seconds (0.5 to 10.0)
//   damp:  High frequency damping (0.0 = bright, 1.0 = dark)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Final output trim (1.0 = unity)

define_fx("plate_reverb")
    .param("time", 2.0) // units: seconds, range: 0..10, default: 2.0. Delay or segment time; higher values make repeats arrive later.
    .param("damp", 0.4) // units: ratio, range: 0..1, default: 0.4. Damping amount; higher values shorten and darken the decay.
    .param("mix", 0.3) // units: ratio, range: 0..1, default: 0.3. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, time, damp, mix, level| {
        // Mix to mono for the wet path
        let mono = (input[0] + input[1]) * 0.5;

        // Pre-delay
        let predelayed = delay_n_ar(mono, 0.1, 0.02);

        // High frequency damping
        let damped = lpf_ar(predelayed, 8000.0 * (1.0 - damp));

        // Series of allpass filters for diffusion
        let diffused = damped;
        diffused = allpass_c_ar(diffused, 0.1, 0.0297, time * 0.1);
        diffused = allpass_c_ar(diffused, 0.1, 0.0371, time * 0.1);
        diffused = allpass_c_ar(diffused, 0.1, 0.0411, time * 0.1);
        diffused = allpass_c_ar(diffused, 0.1, 0.0437, time * 0.1);

        // Parallel comb filters for reverb tail
        let comb1 = comb_l_ar(diffused, 0.2, 0.0297, time);
        let comb2 = comb_l_ar(diffused, 0.2, 0.0371, time);
        let comb3 = comb_l_ar(diffused, 0.2, 0.0411, time);
        let comb4 = comb_l_ar(diffused, 0.2, 0.0437, time);

        // Mix combs
        let reverb = (comb1 + comb2 + comb3 + comb4) * 0.25;

        // Stereo decorrelation
        let left = reverb;
        let right = delay_n_ar(reverb, 0.01, 0.005);

        // DC-block the wet path before the dry/wet mix
        let wet_l = leak_dc_ar(left, 0.995);
        let wet_r = leak_dc_ar(right, 0.995);

        // Dry/wet mix, then final level trim
        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: plate_reverb
//
// ```rhai
// import "stdlib/effects/reverbs/plate_reverb.vibe" as plate_reverb;
//
// let doc_plate_reverb = fx("doc_plate_reverb")
//     .synth("plate_reverb")
//     .param("time", 2.0)
//     .param("damp", 0.4)
//     .param("mix", 0.3)
//     .param("level", 1.0)
//     .apply();
// ```
