// kind=fx | category=reverb | flavor=shimmer | stereo=true | params=size,shimmer,pitch,decay,mix,level
//
// Shimmer Reverb Effect
// Inspired by: Strymon BigSky, Eventide Space, Brian Eno ambient productions
//
// Ethereal reverb with pitch-shifted feedback creating cascading harmonics.
// Perfect for ambient, post-rock, and cinematic soundscapes.
//
// Parameters:
//   size:    Reverb size (0.0 to 1.0)
//   shimmer: Amount of pitch-shifted feedback (0.0 to 1.0)
//   pitch:   Pitch shift interval (0.5 = octave down, 2.0 = octave up)
//   decay:   Reverb decay (0.0 to 1.0)
//   mix:     Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level:   Final output trim (1.0 = unity)

define_fx("shimmer_reverb", |builder| {
    builder
        .param("size", 0.7) // units: ratio, range: 0..1, default: 0.7. Size; higher values use a larger buffer, room, or grain window.
        .param("shimmer", 0.4) // units: ratio, range: 0..1, default: 0.4. Shimmer amount; higher values emphasize that named musical or electrical behavior.
        .param("pitch", 2.0) // units: semitones, range: -48..48, default: 2.0. Pitch in MIDI-note units; higher values play higher notes.
        .param("decay", 0.6) // units: seconds, range: 0..10, default: 0.6. Envelope time or level; higher values make that stage last longer or sustain higher.
        .param("mix", 0.4) // units: ratio, range: 0..1, default: 0.4. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, size, shimmer, pitch, decay, mix, level| {
            let mono = (input[0] + input[1]) * 0.5;

            // Main reverb
            let verb = free_verb_ar(mono, 1.0, 0.5 + size * 0.45, 0.3);

            // Pitch shifter for shimmer effect (using delay-based pitch approximation)
            let shift_time = 0.05 / pitch;
            let shifted = delay_c_ar(verb, 0.2, shift_time);

            // Feed the shifted signal back through more reverb
            let shimmer_verb = free_verb_ar(shifted * shimmer, 1.0, 0.7, 0.5);

            // Combine layers with decay
            let layer1 = verb;
            let layer2 = shimmer_verb * decay * 0.6;
            let layer3 = delay_c_ar(shimmer_verb, 0.5, 0.2) * decay * 0.4;

            let combined = layer1 + layer2 + layer3;

            // Smooth high frequencies for ethereal character
            let smoothed = lpf_ar(combined, 10000.0);

            // Add subtle modulation
            let mod_lfo = sin_osc_ar(0.3) * 0.002;
            let modulated = delay_c_ar(smoothed, 0.05, 0.02 + mod_lfo);

            // Wide stereo spread
            let left = modulated * 0.6;
            let right = delay_c_ar(modulated, 0.02, 0.007) * 0.6;

            // DC-block the wet path before the dry/wet mix
            let wet_l = leak_dc_ar(left, 0.995);
            let wet_r = leak_dc_ar(right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: shimmer_reverb
//
// ```rhai
// import "stdlib/effects/reverbs/shimmer_reverb.vibe" as shimmer_reverb;
//
// let doc_shimmer_reverb = fx("doc_shimmer_reverb")
//     .synth("shimmer_reverb")
//     .param("size", 0.7)
//     .param("shimmer", 0.4)
//     .param("pitch", 2.0)
//     .param("decay", 0.6)
//     .apply();
// ```
