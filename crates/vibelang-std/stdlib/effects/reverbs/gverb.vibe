// kind=fx | category=reverb | flavor=gverb | stereo=true | params=roomsize,revtime,damping,spread,drylevel,earlylevel,taillevel,mix,level
//
// GVerb Reverb Effect
//
// High quality reverb with early reflections and extensive controls.
//
// Usage:
//   group.add_effect("verb", "gverb", #{
//     roomsize: 50.0,
//     revtime: 3.0,
//     damping: 0.5,
//     spread: 15.0,
//     drylevel: 0.7,
//     earlylevel: 0.7,
//     taillevel: 0.5,
//     mix: 0.3,
//     level: 1.0
//   });
//
// Parameters:
//   roomsize:   Room size in meters (1 to 300)
//   revtime:    Reverberation time in seconds
//   damping:    High frequency damping (0.0 to 1.0)
//   spread:     Stereo spread (0 to 43)
//   drylevel:   Dry signal level (0.0 to 1.0)
//   earlylevel: Early reflections level (0.0 to 1.0)
//   taillevel:  Reverb tail level (0.0 to 1.0)
//   mix:        Dry/wet crossfade (0.0 = dry, 1.0 = wet)
//   level:      Output level multiplier (1.0 = unity)

define_fx("gverb", |builder| {
    builder
        .param("roomsize", 50.0) // units: meters, range: 1..300, default: 50.0. Reverb room size; higher values make a larger, longer acoustic space.
        .param("revtime", 3.0) // units: seconds, range: 0..60, default: 3.0. Reverb decay time in seconds; higher makes the tail last longer.
        .param("damping", 0.5) // units: ratio, range: 0..1, default: 0.5. High-frequency damping; higher values darken and shorten resonant tails.
        .param("spread", 15.0) // units: degrees, range: 0..45, default: 15.0. Spread width; higher values distribute energy across a wider range.
        .param("drylevel", 0.7) // units: linear, range: 0..1, default: 0.7. Dry reverb path level; higher keeps more unprocessed signal.
        .param("earlylevel", 0.7) // units: linear, range: 0..1, default: 0.7. Early-reflection level; higher makes the first room reflections louder.
        .param("taillevel", 0.5) // units: linear, range: 0..1, default: 0.5. Late reverb tail level; higher makes the diffuse tail louder.
        .param("mix", 0.3) // units: ratio, range: 0..1, default: 0.3. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, roomsize, revtime, damping, spread, drylevel, earlylevel, taillevel, mix, level| {
            // Mix to mono for the reverb input
            let mono = (input[0] + input[1]) * 0.5;

            // GVerb (stereo out).
            let wet_node = g_verb_ar(mono, roomsize, revtime, damping, 0.5, spread, drylevel, earlylevel, taillevel, 300.0);
            let wet_left = channel(wet_node, 0);
            let wet_right = channel(wet_node, 1);

            // DC-block the wet path before the dry/wet mix
            let wet_l = leak_dc_ar(wet_left, 0.995);
            let wet_r = leak_dc_ar(wet_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: gverb
//
// ```rhai
// import "stdlib/effects/reverbs/gverb.vibe" as gverb;
//
// let doc_gverb = fx("doc_gverb")
//     .synth("gverb")
//     .param("roomsize", 50.0)
//     .param("revtime", 3.0)
//     .param("damping", 0.5)
//     .param("spread", 15.0)
//     .apply();
// ```
