// kind=fx | category=dynamics | flavor=deess | stereo=true | params=freq,threshold,reduction,width,mix,level
//
// De-Esser Effect
// Inspired by: FabFilter Pro-DS, Waves DeEsser, SSL dynamics
//
// Reduces harsh sibilance (s, sh, ch sounds) in vocals and other sources.
// Essential for professional vocal processing.
//
// Usage:
//   group.add_effect("dees", "de_esser", #{
//     freq: 6000.0,
//     threshold: 0.5,
//     reduction: 0.5,
//     width: 0.5,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   freq:      Center frequency of sibilance band (3000 to 10000)
//   threshold: Detection threshold (0.0 = aggressive, 1.0 = gentle)
//   reduction: Maximum reduction amount (0.0 to 1.0)
//   width:     Detection bandwidth (0.0 = narrow, 1.0 = wide)
//   mix:       Dry/wet mix (1.0 = full wet, insert default)
//   level:     Final output trim (1.0 = unity)

define_fx("de_esser")
    .param("freq", 6000.0) // units: Hz, range: 20..20000, default: 6000.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("threshold", 0.5) // units: linear, range: 0..1, default: 0.5. Detection threshold; higher values require a stronger signal before processing opens.
    .param("reduction", 0.5) // units: dB, range: 0..60, default: 0.5. Reduction amount; higher values emphasize that named musical or electrical behavior.
    .param("width", 0.5) // units: ratio, range: 0..2, default: 0.5. Spread width; higher values distribute energy across a wider range.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, freq, threshold, reduction, width, mix, level| {
        // Extract sibilance band
        let q = 0.5 + (1.0 - width) * 1.5;
        let sib_l = rlpf_ar(hpf_ar(input[0], freq * 0.7), freq, q);
        let sib_r = rlpf_ar(hpf_ar(input[1], freq * 0.7), freq, q);

        // Detect sibilance level
        let detect_l = lag_ar(sib_l.abs(), 0.002);
        let detect_r = lag_ar(sib_r.abs(), 0.002);

        // Calculate gain reduction
        let thresh = 0.1 + threshold * 0.4;
        let over_l = (detect_l - thresh).max(0.0);
        let over_r = (detect_r - thresh).max(0.0);

        // Smooth gain reduction
        let gr_l = (1.0 - over_l * reduction * 10.0).max(0.2);
        let gr_r = (1.0 - over_r * reduction * 10.0).max(0.2);

        let smooth_gr_l = lag_ar(gr_l, 0.005);
        let smooth_gr_r = lag_ar(gr_r, 0.005);

        // Apply reduction only to sibilance band
        let reduced_sib_l = sib_l * smooth_gr_l;
        let reduced_sib_r = sib_r * smooth_gr_r;

        // Subtract original sibilance, add reduced version
        let processed_l = input[0] - sib_l + reduced_sib_l;
        let processed_r = input[1] - sib_r + reduced_sib_r;

        let wet_l = leak_dc_ar(processed_l, 0.995);
        let wet_r = leak_dc_ar(processed_r, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: de_esser
//
// ```rhai
// import "stdlib/effects/dynamics/de_esser.vibe" as de_esser;
//
// let doc_de_esser = fx("doc_de_esser")
//     .synth("de_esser")
//     .param("freq", 6000.0)
//     .param("threshold", 0.5)
//     .param("reduction", 0.5)
//     .param("width", 0.5)
//     .apply();
// ```
