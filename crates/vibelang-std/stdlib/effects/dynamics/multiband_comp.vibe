// kind=fx | category=dynamics | flavor=multiband | stereo=true | params=low_freq,high_freq,low_thresh,mid_thresh,high_thresh,ratio,attack,release,mix,level
//
// Multi-band Compressor Effect
//
// Three-band dynamics processing for precise control.
// Process lows, mids, and highs independently.
//
// Usage:
//   group.add_effect("multi", "multiband_comp", #{
//     low_freq: 200.0,
//     high_freq: 3000.0,
//     low_thresh: 0.5,
//     mid_thresh: 0.4,
//     high_thresh: 0.3,
//     ratio: 4.0,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   low_freq:    Low/mid crossover frequency (default 200 Hz)
//   high_freq:   Mid/high crossover frequency (default 3000 Hz)
//   low_thresh:  Low band threshold
//   mid_thresh:  Mid band threshold
//   high_thresh: High band threshold
//   ratio:       Compression ratio for all bands
//   attack:      Attack time in seconds
//   release:     Release time in seconds
//   mix:         Dry/wet mix (1.0 = full wet, insert default)
//   level:       Final output trim (1.0 = unity)

define_fx("multiband_comp")
    .param("low_freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Low Freq in Hz; higher values move that tone or filter point upward.
    .param("high_freq", 3000.0) // units: Hz, range: 20..20000, default: 3000.0. High Freq in Hz; higher values move that tone or filter point upward.
    .param("low_thresh", 0.5) // units: linear, range: 0..1, default: 0.5. Low Thresh amount; higher values emphasize that named musical or electrical behavior.
    .param("mid_thresh", 0.4) // units: linear, range: 0..1, default: 0.4. Mid Thresh amount; higher values emphasize that named musical or electrical behavior.
    .param("high_thresh", 0.3) // units: linear, range: 0..1, default: 0.3. High Thresh amount; higher values emphasize that named musical or electrical behavior.
    .param("ratio", 4.0) // units: ratio, range: 1..100, default: 4.0. Frequency ratio; higher values tune the related oscillator or clock upward.
    .param("attack", 0.01) // units: seconds, range: 0..10, default: 0.01. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("release", 0.1) // units: seconds, range: 0..10, default: 0.1. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, low_freq, high_freq, low_thresh, mid_thresh, high_thresh, ratio, attack, release, mix, level| {
        // Split into bands
        let low_left = lpf_ar(input[0], low_freq);
        let low_right = lpf_ar(input[1], low_freq);

        let high_left = hpf_ar(input[0], high_freq);
        let high_right = hpf_ar(input[1], high_freq);

        let mid_left = hpf_ar(lpf_ar(input[0], high_freq), low_freq);
        let mid_right = hpf_ar(lpf_ar(input[1], high_freq), low_freq);

        // Compress each band
        let comp_low_left = compander_ar(low_left, low_left, low_thresh, 1.0, 1.0/ratio, attack, release);
        let comp_low_right = compander_ar(low_right, low_right, low_thresh, 1.0, 1.0/ratio, attack, release);

        let comp_mid_left = compander_ar(mid_left, mid_left, mid_thresh, 1.0, 1.0/ratio, attack, release);
        let comp_mid_right = compander_ar(mid_right, mid_right, mid_thresh, 1.0, 1.0/ratio, attack, release);

        let comp_high_left = compander_ar(high_left, high_left, high_thresh, 1.0, 1.0/ratio, attack, release);
        let comp_high_right = compander_ar(high_right, high_right, high_thresh, 1.0, 1.0/ratio, attack, release);

        // Recombine bands
        let processed_left = comp_low_left + comp_mid_left + comp_high_left;
        let processed_right = comp_low_right + comp_mid_right + comp_high_right;

        let wet_l = leak_dc_ar(processed_left, 0.995);
        let wet_r = leak_dc_ar(processed_right, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: multiband_comp
//
// ```rhai
// import "stdlib/effects/dynamics/multiband_comp.vibe" as multiband_comp;
//
// let doc_multiband_comp = fx("doc_multiband_comp")
//     .synth("multiband_comp")
//     .param("low_freq", 200.0)
//     .param("high_freq", 3000.0)
//     .param("low_thresh", 0.5)
//     .param("mid_thresh", 0.4)
//     .apply();
// ```
