// kind=fx | category=dynamics | flavor=gate | stereo=true | params=threshold,attack,release,mix,level
//
// Noise Gate Effect
//
// Attenuates signal when it falls below a threshold, useful for cutting noise.
//
// Usage:
//   group.add_effect("gate", "gate", #{
//     threshold: 0.1,
//     attack: 0.01,
//     release: 0.1,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   threshold: Gate threshold (0.0 to 1.0)
//   attack:    Attack time in seconds
//   release:   Release time in seconds
//   mix:       Dry/wet mix (1.0 = full wet, insert default)
//   level:     Final output trim (1.0 = unity)

define_fx("gate")
    .param("threshold", 0.1) // units: linear, range: 0..1, default: 0.1. Detection threshold; higher values require a stronger signal before processing opens.
    .param("attack", 0.01) // units: seconds, range: 0..10, default: 0.01. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("release", 0.1) // units: seconds, range: 0..10, default: 0.1. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, threshold, attack, release, mix, level| {
        // Use Compander as a gate (expansion below threshold)
        let gated_left = compander_ar(input[0], input[0], threshold, 10.0, 1.0, attack, release);
        let gated_right = compander_ar(input[1], input[1], threshold, 10.0, 1.0, attack, release);

        let wet_l = leak_dc_ar(gated_left, 0.995);
        let wet_r = leak_dc_ar(gated_right, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: gate
//
// ```rhai
// import "stdlib/effects/dynamics/gate.vibe" as gate;
//
// let doc_gate = fx("doc_gate")
//     .synth("gate")
//     .param("threshold", 0.1)
//     .param("attack", 0.01)
//     .param("release", 0.1)
//     .param("mix", 1.0)
//     .apply();
// ```
