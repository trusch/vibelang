// kind=fx | category=dynamics | flavor=sidechain | stereo=true | params=threshold,ratio,attack,release,amount,mix,level
//
// Sidechain Compressor Effect
//
// Classic pumping/ducking effect triggered by amplitude follower.
// Perfect for making synths duck under kicks.
//
// Usage:
//   group.add_effect("pump", "sidechain", #{
//     threshold: 0.3,
//     ratio: 8.0,
//     attack: 0.001,
//     release: 0.15,
//     amount: 0.7,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   threshold: Trigger threshold (0.0 - 1.0)
//   ratio:     Compression ratio when triggered
//   attack:    Attack time in seconds
//   release:   Release time in seconds
//   amount:    Effect intensity (0.0 = off, 1.0 = full pump)
//   mix:       Dry/wet mix (1.0 = full wet, insert default)
//   level:     Final output trim (1.0 = unity)

define_fx("sidechain")
    .param("threshold", 0.3) // units: linear, range: 0..1, default: 0.3. Detection threshold; higher values require a stronger signal before processing opens.
    .param("ratio", 8.0) // units: ratio, range: 1..100, default: 8.0. Frequency ratio; higher values tune the related oscillator or clock upward.
    .param("attack", 0.001) // units: seconds, range: 0..10, default: 0.001. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("release", 0.15) // units: seconds, range: 0..10, default: 0.15. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("amount", 0.7) // units: normalized, range: 0..1, default: 0.7. Amount; higher values apply more of that modulation or effect.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, threshold, ratio, attack, release, amount, mix, level| {
        // Follow the input amplitude for self-ducking
        // In a real scenario you'd use a sidechain input
        let left_amp = amplitude_ar(input[0], attack, release);
        let right_amp = amplitude_ar(input[1], attack, release);
        let env = (left_amp + right_amp) * 0.5;

        // Calculate gain reduction when above threshold
        let above_thresh = env - threshold;
        let gain_reduction = 1.0 - (above_thresh.max(0.0) * (1.0 - 1.0/ratio) * amount);

        // Apply gain reduction
        let processed_l = input[0] * gain_reduction;
        let processed_r = input[1] * gain_reduction;

        let wet_l = leak_dc_ar(processed_l, 0.995);
        let wet_r = leak_dc_ar(processed_r, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: sidechain
//
// ```rhai
// import "stdlib/effects/dynamics/sidechain.vibe" as sidechain;
//
// let doc_sidechain = fx("doc_sidechain")
//     .synth("sidechain")
//     .param("threshold", 0.3)
//     .param("ratio", 8.0)
//     .param("attack", 0.001)
//     .param("release", 0.15)
//     .apply();
// ```
