// kind=fx | category=dynamics | flavor=ducking | stereo=true | params=threshold,ratio,attack,release,mix,level
//
// Ducking / Sidechain Effect
//
// Reduces volume based on input amplitude (sidechain compression).
// Note: This uses the input as both the audio and control signal.
// For true sidechain from another source, you'd need bus routing.
//
// Usage:
//   group.add_effect("duck", "ducking", #{
//     threshold: 0.3,
//     ratio: 5.0,
//     attack: 0.01,
//     release: 0.1,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   threshold: Threshold for ducking (0.0 to 1.0)
//   ratio:     Compression ratio (2.0 to 20.0)
//   attack:    Attack time in seconds
//   release:   Release time in seconds
//   mix:       Dry/wet mix (1.0 = full wet, insert default)
//   level:     Final output trim (1.0 = unity)

define_fx("ducking")
    .param("threshold", 0.3) // units: linear, range: 0..1, default: 0.3. Detection threshold; higher values require a stronger signal before processing opens.
    .param("ratio", 5.0) // units: ratio, range: 1..100, default: 5.0. Frequency ratio; higher values tune the related oscillator or clock upward.
    .param("attack", 0.01) // units: seconds, range: 0..10, default: 0.01. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("release", 0.1) // units: seconds, range: 0..10, default: 0.1. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, threshold, ratio, attack, release, mix, level| {
        // Apply compression (ducking)
        let ducked_left = compander_ar(input[0], input[0], threshold, 1.0, 1.0/ratio, attack, release);
        let ducked_right = compander_ar(input[1], input[1], threshold, 1.0, 1.0/ratio, attack, release);

        let wet_l = leak_dc_ar(ducked_left, 0.995);
        let wet_r = leak_dc_ar(ducked_right, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: ducking
//
// ```rhai
// import "stdlib/effects/dynamics/ducking.vibe" as ducking;
//
// let doc_ducking = fx("doc_ducking")
//     .synth("ducking")
//     .param("threshold", 0.3)
//     .param("ratio", 5.0)
//     .param("attack", 0.01)
//     .param("release", 0.1)
//     .apply();
// ```
