// kind=fx | category=dynamics | flavor=basic | stereo=true | params=threshold,ratio,attack,release,mix,level
//
// Dynamics Compressor Effect
//
// Generic linear-knee compressor — straight compander on each channel,
// no colour. Use as a starting point for transparent gain control.
//
// Usage:
//   group.add_effect("master_comp", "compressor", #{
//     threshold: 0.6,
//     ratio: 3.0,
//     attack: 0.005,
//     release: 0.1,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   threshold: Threshold level (0.0 - 1.0)
//   ratio:     Compression ratio
//   attack:    Attack time in seconds
//   release:   Release time in seconds
//   mix:       Dry/wet mix (1.0 = full wet, insert default)
//   level:     Final output trim (1.0 = unity)

define_fx("compressor")
    .param("threshold", 0.5) // units: linear, range: 0..1, default: 0.5. Detection threshold; higher values require a stronger signal before processing opens.
    .param("ratio", 4.0) // units: ratio, range: 1..100, default: 4.0. Frequency ratio; higher values tune the related oscillator or clock upward.
    .param("attack", 0.01) // units: seconds, range: 0..10, default: 0.01. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("release", 0.1) // units: seconds, range: 0..10, default: 0.1. Envelope time or level; higher values make that stage last longer or sustain higher.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|input, threshold, ratio, attack, release, mix, level| {
        // Apply compander to both channels
        let comp_l = compander_ar(input[0], input[0], threshold, 1.0, 1.0/ratio, attack, release);
        let comp_r = compander_ar(input[1], input[1], threshold, 1.0, 1.0/ratio, attack, release);

        let wet_l = leak_dc_ar(comp_l, 0.995);
        let wet_r = leak_dc_ar(comp_r, 0.995);

        [
            ((1.0 - mix) * input[0] + mix * wet_l) * level,
            ((1.0 - mix) * input[1] + mix * wet_r) * level
        ]
    });

//
// # Usage: compressor
//
// ```rhai
// import "stdlib/effects/dynamics/compressor.vibe" as compressor;
//
// let doc_compressor = fx("doc_compressor")
//     .synth("compressor")
//     .param("threshold", 0.5)
//     .param("ratio", 4.0)
//     .param("attack", 0.01)
//     .param("release", 0.1)
//     .apply();
// ```
