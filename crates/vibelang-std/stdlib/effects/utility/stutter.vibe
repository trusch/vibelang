// kind=fx | category=utility | flavor=stutter | stereo=true | params=rate,mix,level
//
// Stutter Effect
//
// Creates rhythmic stutter/glitch effects by repeating small buffer segments.
//
// Usage:
//   group.add_effect("stut", "stutter", #{
//     rate: 8.0,
//     mix: 0.5,
//     level: 1.0
//   });
//
// Parameters:
//   rate:  Stutter rate in Hz (1.0 to 32.0)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix

define_fx("stutter", |builder| {
    builder
        .param("rate", 8.0)
        .param("mix", 0.5)
        .param("level", 1.0)
        .body(|input, rate, mix, level| {
            // Buffer size based on rate
            let buf_time = 1.0 / rate;

            // Stuttered signal using comb filter technique
            let stutter_left = comb_c_ar(input[0], 0.5, buf_time, 0.0);
            let stutter_right = comb_c_ar(input[1], 0.5, buf_time, 0.0);

            let wet_l = leak_dc_ar(stutter_left, 0.995);
            let wet_r = leak_dc_ar(stutter_right, 0.995);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});
