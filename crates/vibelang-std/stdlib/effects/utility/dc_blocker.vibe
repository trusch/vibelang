// kind=fx | category=utility | flavor=dc_blocker | stereo=true | params=coef,mix,level
//
// DC Blocker Effect
//
// Removes DC offset from the signal using a high-pass filter.
//
// Usage:
//   group.add_effect("dc_block", "dc_blocker", #{
//     coef: 0.995,
//     mix: 1.0,
//     level: 1.0
//   });
//
// Parameters:
//   coef:  Filter coefficient (0.9 to 0.999, higher = more bass removed)
//   mix:   Dry/wet mix (0.0 = dry, 1.0 = wet)
//   level: Output trim applied after the dry/wet mix
//
// Pure-mix utility (DC blocker itself); skips the spec's redundant wet-path
// leak_dc_ar(0.995) because the wet path *is* a DC blocker.

define_fx("dc_blocker", |builder| {
    builder
        .param("coef", 0.995) // units: normalized, range: 0..1, default: 0.995. Coef amount; higher values emphasize that named musical or electrical behavior.
        .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
        .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|input, coef, mix, level| {
            // Apply DC blocking filter
            let wet_l = leak_dc_ar(input[0], coef);
            let wet_r = leak_dc_ar(input[1], coef);

            [
                ((1.0 - mix) * input[0] + mix * wet_l) * level,
                ((1.0 - mix) * input[1] + mix * wet_r) * level
            ]
        })
});

//
// # Usage: dc_blocker
//
// ```rhai
// import "stdlib/effects/utility/dc_blocker.vibe" as dc_blocker;
//
// let doc_dc_blocker = fx("doc_dc_blocker")
//     .synth("dc_blocker")
//     .param("coef", 0.995)
//     .param("mix", 1.0)
//     .param("level", 1.0)
//     .apply();
// ```
