// Saxophone Family
// Jazz/Pop | Character: Warm, expressive, brassy
//
// The saxophone family from soprano to baritone.

// Alto Saxophone
define_synthdef("alto_sax", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("growl", 0.0) // units: normalized, range: 0..1, default: 0.0. Growl amount; higher values add rough reed or throat modulation.
        .body(|freq, amp, gate, growl| {
            let env = envelope()
                .asr(0.03, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Vibrato
            let vib = sin_osc_ar(5.5) * 0.008 + 1.0;
            let mod_freq = freq * vib;

            // Saxophone harmonics
            let h1 = sin_osc_ar(mod_freq);
            let h2 = sin_osc_ar(mod_freq * 2.0) * 0.6;
            let h3 = sin_osc_ar(mod_freq * 3.0) * 0.4;
            let h4 = sin_osc_ar(mod_freq * 4.0) * 0.25;
            let h5 = sin_osc_ar(mod_freq * 5.0) * 0.15;
            let h6 = sin_osc_ar(mod_freq * 6.0) * 0.1;

            let tone = h1 + h2 + h3 + h4 + h5 + h6;

            // Growl (low frequency modulation)
            let growl_mod = sin_osc_ar(30.0) * growl * 0.3 + 1.0;

            // Bright sax formant
            let body = rlpf_ar(tone * growl_mod, 2000.0, 0.3);
            let bright = rlpf_ar(tone, 4000.0, 0.4) * 0.3;

            (body + bright) * env * amp * 0.5
        })
});

// Tenor Saxophone
define_synthdef("tenor_sax", |builder| {
    builder
        .param("freq", 330.0) // units: Hz, range: 20..20000, default: 330.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.04, 1.0, 0.12)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Vibrato
            let vib = sin_osc_ar(5.0) * 0.007 + 1.0;
            let mod_freq = freq * vib;

            // Warmer than alto
            let h1 = sin_osc_ar(mod_freq);
            let h2 = sin_osc_ar(mod_freq * 2.0) * 0.55;
            let h3 = sin_osc_ar(mod_freq * 3.0) * 0.35;
            let h4 = sin_osc_ar(mod_freq * 4.0) * 0.2;
            let h5 = sin_osc_ar(mod_freq * 5.0) * 0.12;

            let tone = h1 + h2 + h3 + h4 + h5;

            // Warm formant
            let body = rlpf_ar(tone, 1800.0, 0.35);

            body * env * amp * 0.6
        })
});

// Soprano Saxophone
define_synthdef("soprano_sax", |builder| {
    builder
        .param("freq", 660.0) // units: Hz, range: 20..20000, default: 660.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.02, 1.0, 0.08)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Vibrato
            let vib = sin_osc_ar(6.0) * 0.006 + 1.0;
            let mod_freq = freq * vib;

            // Brighter than alto
            let h1 = sin_osc_ar(mod_freq);
            let h2 = sin_osc_ar(mod_freq * 2.0) * 0.5;
            let h3 = sin_osc_ar(mod_freq * 3.0) * 0.35;
            let h4 = sin_osc_ar(mod_freq * 4.0) * 0.2;

            let tone = h1 + h2 + h3 + h4;

            // Bright formant
            let body = rlpf_ar(tone, 2500.0, 0.3);

            body * env * amp * 0.6
        })
});

// Baritone Saxophone
define_synthdef("bari_sax", |builder| {
    builder
        .param("freq", 165.0) // units: Hz, range: 20..20000, default: 165.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.06, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Slow vibrato
            let vib = sin_osc_ar(4.5) * 0.005 + 1.0;
            let mod_freq = freq * vib;

            // Full, dark harmonics
            let h1 = sin_osc_ar(mod_freq);
            let h2 = sin_osc_ar(mod_freq * 2.0) * 0.5;
            let h3 = sin_osc_ar(mod_freq * 3.0) * 0.3;
            let h4 = sin_osc_ar(mod_freq * 4.0) * 0.2;
            let h5 = sin_osc_ar(mod_freq * 5.0) * 0.1;

            let tone = h1 + h2 + h3 + h4 + h5;

            // Deep, warm formant
            let body = rlpf_ar(tone, 1200.0, 0.35);

            body * env * amp * 0.6
        })
});

//
// # Usage: `alto_sax`
//
// ```rhai
// import "stdlib/woodwinds/saxophone.vibe" as saxophone;
//
// let alto_sax = voice("doc_alto_sax")
//     .synth("alto_sax")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("growl", 0.0);
// alto_sax.output("out").to_main();
// alto_sax.run();
// ```
//
// # Usage: `tenor_sax`
//
// ```rhai
// import "stdlib/woodwinds/saxophone.vibe" as saxophone;
//
// let tenor_sax = voice("doc_tenor_sax")
//     .synth("tenor_sax")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// tenor_sax.output("out").to_main();
// tenor_sax.run();
// ```
//
// # Usage: `soprano_sax`
//
// ```rhai
// import "stdlib/woodwinds/saxophone.vibe" as saxophone;
//
// let soprano_sax = voice("doc_soprano_sax")
//     .synth("soprano_sax")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// soprano_sax.output("out").to_main();
// soprano_sax.run();
// ```
//
// # Usage: `bari_sax`
//
// ```rhai
// import "stdlib/woodwinds/saxophone.vibe" as saxophone;
//
// let bari_sax = voice("doc_bari_sax")
//     .synth("bari_sax")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// bari_sax.output("out").to_main();
// bari_sax.run();
// ```
