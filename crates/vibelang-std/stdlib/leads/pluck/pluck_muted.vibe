// Genre: Lo-fi, Jazz | Character: Muted, soft pluck
define_synthdef("lead_pluck_muted", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Soft envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Warm harmonics
            let fundamental = sin_osc_ar(freq);
            let harmonic2 = sin_osc_ar(freq * 2.0) * 0.2;
            let harmonic3 = sin_osc_ar(freq * 3.0) * 0.1;

            let mix = fundamental + harmonic2 + harmonic3;

            // Low filter for muted character
            let filtered = lpf_ar(mix, 1200.0);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pluck_muted`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_muted.vibe" as pluck_muted;
//
// let lead_pluck_muted = voice("doc_lead_pluck_muted")
//     .synth("lead_pluck_muted")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pluck_muted.output("out").to_main();
// lead_pluck_muted.run();
// ```
