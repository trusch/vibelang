// Genre: Ambient, Chillout | Character: Long, sustained pluck
define_synthdef("lead_pluck_long", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Long sustain
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Rich harmonics
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.35;
            let h3 = sin_osc_ar(freq * 3.0) * 0.2;
            let h4 = sin_osc_ar(freq * 4.0) * 0.12;

            let mix = h1 + h2 + h3 + h4;

            // Slow filter evolution
            let filter_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1200.0 + (filter_env * 3000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pluck_long`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_long.vibe" as pluck_long;
//
// let lead_pluck_long = voice("doc_lead_pluck_long")
//     .synth("lead_pluck_long")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pluck_long.output("out").to_main();
// lead_pluck_long.run();
// ```
