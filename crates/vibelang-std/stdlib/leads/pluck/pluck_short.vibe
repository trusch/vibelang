// Genre: Minimal, House | Character: Very short, staccato pluck
define_synthdef("lead_pluck_short", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Very short envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Simple harmonics for clarity
            let fundamental = sin_osc_ar(freq);
            let harmonic2 = sin_osc_ar(freq * 2.0) * 0.3;
            let harmonic3 = sin_osc_ar(freq * 3.0) * 0.15;

            let mix = fundamental + harmonic2 + harmonic3;

            // Fast filter sweep
            let filter_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1500.0 + (filter_env * 3500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pluck_short`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_short.vibe" as pluck_short;
//
// let lead_pluck_short = voice("doc_lead_pluck_short")
//     .synth("lead_pluck_short")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pluck_short.output("out").to_main();
// lead_pluck_short.run();
// ```
