// Genre: Ambient, Experimental | Character: Bell-like with inharmonic overtones
define_synthdef("lead_pluck_bell", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Bell envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Inharmonic partials for bell character
            let partial1 = sin_osc_ar(freq) * 0.6;
            let partial2 = sin_osc_ar(freq * 2.4) * 0.3;
            let partial3 = sin_osc_ar(freq * 3.8) * 0.15;
            let partial4 = sin_osc_ar(freq * 5.3) * 0.08;

            let mix = partial1 + partial2 + partial3 + partial4;

            // Gentle filter
            let filtered = lpf_ar(mix, 4000.0);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pluck_bell`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_bell.vibe" as pluck_bell;
//
// let lead_pluck_bell = voice("doc_lead_pluck_bell")
//     .synth("lead_pluck_bell")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pluck_bell.output("out").to_main();
// lead_pluck_bell.run();
// ```
