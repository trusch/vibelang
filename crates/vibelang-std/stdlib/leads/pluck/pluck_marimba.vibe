// Genre: World, Ambient | Character: Marimba-like, wooden timbre
define_synthdef("pluck_marimba", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Marimba envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Woody timbre with specific harmonics
            let fundamental = sin_osc_ar(freq);
            let harmonic2 = sin_osc_ar(freq * 4.0) * 0.25;
            let harmonic3 = sin_osc_ar(freq * 5.4) * 0.15;

            let mix = fundamental + harmonic2 + harmonic3;

            // Filter envelope
            let filter_env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1500.0 + (filter_env * 2500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `pluck_marimba`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_marimba.vibe" as pluck_marimba;
//
// let pluck_marimba = voice("doc_pluck_marimba")
//     .synth("pluck_marimba")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pluck_marimba.output("out").to_main();
// pluck_marimba.run();
// ```
