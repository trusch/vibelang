// Genre: House, Pop | Character: Bright, shimmering pluck lead
define_synthdef("lead_pluck_bright", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Quick attack, medium decay
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Bright harmonics
            let fundamental = sin_osc_ar(freq);
            let harmonic2 = sin_osc_ar(freq * 2.0) * 0.4;
            let harmonic3 = sin_osc_ar(freq * 3.0) * 0.2;
            let harmonic4 = sin_osc_ar(freq * 4.0) * 0.1;

            let mix = fundamental + harmonic2 + harmonic3 + harmonic4;

            // Filter sweep
            let filter_env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 2000.0 + (filter_env * 5000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pluck_bright`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_bright.vibe" as pluck_bright;
//
// let lead_pluck_bright = voice("doc_lead_pluck_bright")
//     .synth("lead_pluck_bright")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pluck_bright.output("out").to_main();
// lead_pluck_bright.run();
// ```
