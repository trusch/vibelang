// Genre: Techno, House | Character: Resonant pluck with filter character
define_synthdef("lead_pluck_resonant", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Medium envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sawtooth for resonant filtering
            let osc = saw_ar(freq);

            // Resonant filter sweep
            let filter_env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 800.0 + (filter_env * 3500.0);

            let filtered = rlpf_ar(osc, mod_cutoff, 0.25);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pluck_resonant`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_resonant.vibe" as pluck_resonant;
//
// let lead_pluck_resonant = voice("doc_lead_pluck_resonant")
//     .synth("lead_pluck_resonant")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pluck_resonant.output("out").to_main();
// lead_pluck_resonant.run();
// ```
