// Genre: All | Character: Piano-like pluck
define_synthdef("pluck_piano", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Piano envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Complex harmonic structure
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.4;
            let h3 = sin_osc_ar(freq * 3.0) * 0.25;
            let h4 = sin_osc_ar(freq * 4.0) * 0.15;
            let h5 = sin_osc_ar(freq * 5.0) * 0.1;
            let h6 = sin_osc_ar(freq * 6.0) * 0.05;

            let harmonics = h1 + h2 + h3 + h4 + h5 + h6;

            // Hammer attack
            let attack_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let hammer = white_noise_ar() * attack_env * 0.15;
            let filtered_hammer = lpf_ar(hammer, 4000.0);

            (harmonics + filtered_hammer) * env * amp * 0.7
        })
});

//
// # Usage: `pluck_piano`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_piano.vibe" as pluck_piano;
//
// let pluck_piano = voice("doc_pluck_piano")
//     .synth("pluck_piano")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pluck_piano.output("out").to_main();
// pluck_piano.run();
// ```
