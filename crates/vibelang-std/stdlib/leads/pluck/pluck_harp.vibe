// Genre: Ambient, Classical | Character: Harp-like pluck
define_synthdef("pluck_harp", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Harp envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Rich harmonic series
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.5;
            let h3 = sin_osc_ar(freq * 3.0) * 0.25;
            let h4 = sin_osc_ar(freq * 4.0) * 0.125;
            let h5 = sin_osc_ar(freq * 5.0) * 0.08;

            let mix = h1 + h2 + h3 + h4 + h5;

            // Pluck attack
            let attack_env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .build();
            let attack = pink_noise_ar() * attack_env * 0.12;
            let filtered_attack = lpf_ar(attack, 3000.0);

            (mix + filtered_attack) * env * amp * 0.7
        })
});

//
// # Usage: `pluck_harp`
//
// ```rhai
// import "stdlib/leads/pluck/pluck_harp.vibe" as pluck_harp;
//
// let pluck_harp = voice("doc_pluck_harp")
//     .synth("pluck_harp")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pluck_harp.output("out").to_main();
// pluck_harp.run();
// ```
