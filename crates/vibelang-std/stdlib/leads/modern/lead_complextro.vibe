// Genre: Complextro, Electro House | Character: Complextro lead - glitchy and dynamic
define_synthdef("lead_complextro")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.05)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.001, 0.15)
            .build();

        // Multiple waveforms
        let saw = saw_ar(freq) * 0.4;
        let pulse = pulse_ar(freq, 0.3) * 0.3;
        let square = pulse_ar(freq, 0.5) * 0.2;

        // Bit reduction effect
        let mix = saw + pulse + square;
        let crushed = (mix * 8.0).floor() / 8.0 * 0.3;

        let sig = mix * 0.7 + crushed;

        // Sharp, punchy filter
        let cutoff = 1000.0 + filt_env * 5000.0;
        rlpf_ar(sig, cutoff, 0.4) * env * amp
    });

//
// # Usage: `lead_complextro`
//
// ```rhai
// import "stdlib/leads/modern/lead_complextro.vibe" as lead_complextro;
//
// let lead_complextro = voice("doc_lead_complextro")
//     .synth("lead_complextro")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_complextro.output("out").to_main();
// lead_complextro.run();
// ```
