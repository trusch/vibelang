// Genre: Trance, Progressive | Character: Trance supersaw lead - massive and euphoric
define_synthdef("lead_trance")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.015, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .asr(0.05, 1.0, 0.15)
            .gate(gate)
            .build();

        // 7 detuned oscillators for supersaw
        let osc1 = saw_ar(freq * 0.985);
        let osc2 = saw_ar(freq * 0.992);
        let osc3 = saw_ar(freq * 0.998);
        let osc4 = saw_ar(freq);
        let osc5 = saw_ar(freq * 1.002);
        let osc6 = saw_ar(freq * 1.008);
        let osc7 = saw_ar(freq * 1.015);

        let mix = (osc1 + osc2 + osc3 + osc4 + osc5 + osc6 + osc7) * 0.14;

        // Euphoric filter
        let cutoff = 1500.0 + filt_env * 4000.0;
        rlpf_ar(mix, cutoff, 0.12) * env * amp
    });

//
// # Usage: `lead_trance`
//
// ```rhai
// import "stdlib/leads/modern/lead_trance.vibe" as lead_trance;
//
// let lead_trance = voice("doc_lead_trance")
//     .synth("lead_trance")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_trance.output("out").to_main();
// lead_trance.run();
// ```
