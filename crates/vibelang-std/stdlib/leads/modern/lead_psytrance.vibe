// Genre: Psytrance, Goa | Character: Psytrance acid lead - hypnotic and squelchy
define_synthdef("lead_psytrance")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("acid", 0.7) // units: normalized, range: 0..1, default: 0.7. Acid amount; higher values emphasize that named musical or electrical behavior.
    .body(|freq, amp, gate, acid| {
        let env = envelope()
            .asr(0.001, 1.0, 0.08)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Accent/filter envelope
        let filt_env = envelope()
            .perc(0.001, 0.2)
            .build();

        // Saw oscillator
        let osc = saw_ar(freq);

        // Sub for power
        let sub = sin_osc_ar(freq * 0.5) * 0.3;

        let mix = (osc + sub) * 0.5;

        // Acid filter with high resonance
        let cutoff = 400.0 + filt_env * acid * 5000.0;
        let res = 0.3 + acid * 0.4;
        rlpf_ar(mix, cutoff, res) * env * amp
    });

//
// # Usage: `lead_psytrance`
//
// ```rhai
// import "stdlib/leads/modern/lead_psytrance.vibe" as lead_psytrance;
//
// let lead_psytrance = voice("doc_lead_psytrance")
//     .synth("lead_psytrance")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("acid", 0.7);
// lead_psytrance.output("out").to_main();
// lead_psytrance.run();
// ```
