// Genre: Future Bass, Kawaii | Character: Future bass lead - bright and wobbly
define_synthdef("lead_future_bass")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.12)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Wobble LFO
        let wobble = sin_osc_ar(6.0) * 0.5 + 0.5;

        // Bright supersaws
        let saw1 = saw_ar(freq * 0.995);
        let saw2 = saw_ar(freq);
        let saw3 = saw_ar(freq * 1.005);
        let saw4 = saw_ar(freq * 2.0) * 0.3; // Octave

        let mix = (saw1 + saw2 + saw3 + saw4) * 0.25;

        // Wobbling filter
        let cutoff = 2000.0 + wobble * 4000.0;
        rlpf_ar(mix, cutoff, 0.15) * env * amp
    });

//
// # Usage: `lead_future_bass`
//
// ```rhai
// import "stdlib/leads/modern/lead_future_bass.vibe" as lead_future_bass;
//
// let lead_future_bass = voice("doc_lead_future_bass")
//     .synth("lead_future_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_future_bass.output("out").to_main();
// lead_future_bass.run();
// ```
