// Genre: Progressive House, Melodic Techno | Character: Progressive lead - smooth and evolving
define_synthdef("lead_progressive")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.03, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Slow filter envelope
        let filt_env = envelope()
            .asr(0.2, 1.0, 0.3)
            .gate(gate)
            .build();

        // Slightly detuned for width
        let osc1 = saw_ar(freq * 0.998);
        let osc2 = saw_ar(freq);
        let osc3 = saw_ar(freq * 1.002);

        let mix = (osc1 + osc2 + osc3) * 0.3;

        // Smooth, evolving filter
        let cutoff = 800.0 + filt_env * 3000.0;
        rlpf_ar(mix, cutoff, 0.15) * env * amp
    });

//
// # Usage: `lead_progressive`
//
// ```rhai
// import "stdlib/leads/modern/lead_progressive.vibe" as lead_progressive;
//
// let lead_progressive = voice("doc_lead_progressive")
//     .synth("lead_progressive")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_progressive.output("out").to_main();
// lead_progressive.run();
// ```
