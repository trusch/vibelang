// Genre: Hardstyle, Hardcore | Character: Hardstyle screech lead
define_synthdef("lead_hardstyle")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.08)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope for screech
        let filt_env = envelope()
            .perc(0.001, 0.4)
            .build();

        // Detuned saws
        let osc1 = saw_ar(freq * 0.99);
        let osc2 = saw_ar(freq);
        let osc3 = saw_ar(freq * 1.01);

        let mix = (osc1 + osc2 + osc3) * 0.35;

        // Aggressive resonant filter (the screech)
        let cutoff = 1000.0 + filt_env * 6000.0;
        let filtered = rlpf_ar(mix, cutoff, 0.6);

        // Distortion
        (filtered * 2.0).tanh() * env * amp
    });

//
// # Usage: `lead_hardstyle`
//
// ```rhai
// import "stdlib/leads/modern/lead_hardstyle.vibe" as lead_hardstyle;
//
// let lead_hardstyle = voice("doc_lead_hardstyle")
//     .synth("lead_hardstyle")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_hardstyle.output("out").to_main();
// lead_hardstyle.run();
// ```
