// Genre: Industrial, Hard Techno | Character: Distorted, aggressive stab
define_synthdef("stab_distorted", |builder| {
    builder
        .param("freq", 330.0) // units: Hz, range: 20..20000, default: 330.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.65) // units: linear, range: 0..1, default: 0.65. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Aggressive envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Chord
            let root = saw_ar(freq);
            let fifth = saw_ar(freq * 1.5);
            let octave = saw_ar(freq * 2.0);

            let chord = (root + fifth * 0.8 + octave * 0.6) * 0.6;

            // Distortion
            let driven = clip(chord, -0.8, 0.8);

            // Filter
            let filter_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1000.0 + (filter_env * 3000.0);

            let filtered = lpf_ar(driven, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `stab_distorted`
//
// ```rhai
// import "stdlib/leads/stabs/stab_distorted.vibe" as stab_distorted;
//
// let stab_distorted = voice("doc_stab_distorted")
//     .synth("stab_distorted")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// stab_distorted.output("out").to_main();
// stab_distorted.run();
// ```
