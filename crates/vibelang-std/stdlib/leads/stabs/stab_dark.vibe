// Genre: Techno, Industrial | Character: Dark, aggressive stab
define_synthdef("stab_dark", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Quick envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Minor chord (root, minor third, fifth)
            let root = saw_ar(freq);
            let minor_third = saw_ar(freq * 1.2);
            let fifth = saw_ar(freq * 1.5);

            let chord = (root + minor_third * 0.8 + fifth * 0.6) * 0.4;

            // Dark filter
            let filter_env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 600.0 + (filter_env * 1500.0);

            let filtered = lpf_ar(chord, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `stab_dark`
//
// ```rhai
// import "stdlib/leads/stabs/stab_dark.vibe" as stab_dark;
//
// let stab_dark = voice("doc_stab_dark")
//     .synth("stab_dark")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// stab_dark.output("out").to_main();
// stab_dark.run();
// ```
