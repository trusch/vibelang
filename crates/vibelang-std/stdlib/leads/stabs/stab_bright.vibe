// Genre: House, Techno | Character: Bright synth stab for emphasis
define_synthdef("stab_bright", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Sharp, quick envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Chord (root, fifth, octave)
            let root = saw_ar(freq);
            let fifth = saw_ar(freq * 1.5);
            let octave = saw_ar(freq * 2.0);

            let chord = (root + fifth * 0.8 + octave * 0.6) * 0.4;

            // Filter sweep
            let filter_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 2000.0 + (filter_env * 4000.0);

            let filtered = lpf_ar(chord, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `stab_bright`
//
// ```rhai
// import "stdlib/leads/stabs/stab_bright.vibe" as stab_bright;
//
// let stab_bright = voice("doc_stab_bright")
//     .synth("stab_bright")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// stab_bright.output("out").to_main();
// stab_bright.run();
// ```
