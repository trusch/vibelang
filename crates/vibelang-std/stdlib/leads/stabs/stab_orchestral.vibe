// Genre: Cinematic, Orchestral | Character: Orchestral string stab
define_synthdef("stab_orchestral", |builder| {
    builder
        .param("freq", 330.0) // units: Hz, range: 20..20000, default: 330.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // String-like envelope with bow attack
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Rich chord
            let root = saw_ar(freq);
            let third = saw_ar(freq * 1.25);
            let fifth = saw_ar(freq * 1.5);
            let octave = saw_ar(freq * 2.0);

            let chord = (root + third * 0.8 + fifth * 0.7 + octave * 0.5) * 0.35;

            // String-like filter
            let filter_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1200.0 + (filter_env * 2500.0);

            let filtered = lpf_ar(chord, mod_cutoff);

            // Remove mud
            let clean = hpf_ar(filtered, 150.0);

            clean * env * amp
        })
});

//
// # Usage: `stab_orchestral`
//
// ```rhai
// import "stdlib/leads/stabs/stab_orchestral.vibe" as stab_orchestral;
//
// let stab_orchestral = voice("doc_stab_orchestral")
//     .synth("stab_orchestral")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// stab_orchestral.output("out").to_main();
// stab_orchestral.run();
// ```
