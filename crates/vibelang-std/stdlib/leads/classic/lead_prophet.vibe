// Genre: Synthpop, New Wave | Character: Prophet-5 lead - lush and expressive
define_synthdef("lead_prophet")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.008, 1.0, 0.12)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.008, 0.35)
            .build();

        // Two oscillators detuned
        let osc1 = saw_ar(freq);
        let osc2 = saw_ar(freq * 1.008);
        let pulse_osc = pulse_ar(freq, 0.45) * 0.5;

        let mix = (osc1 + osc2 + pulse_osc) * 0.3;

        // Lush filter
        let cutoff = 1200.0 + filt_env * 3000.0;
        rlpf_ar(mix, cutoff, 0.2) * env * amp
    });

//
// # Usage: `lead_prophet`
//
// ```rhai
// import "stdlib/leads/classic/lead_prophet.vibe" as lead_prophet;
//
// let lead_prophet = voice("doc_lead_prophet")
//     .synth("lead_prophet")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_prophet.output("out").to_main();
// lead_prophet.run();
// ```
