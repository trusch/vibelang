// Genre: Rave, Hardcore, Jungle | Character: Hoover/Mentasm sound - aggressive and iconic
define_synthdef("lead_juno_hoover")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Pitch LFO for characteristic wobble
        let pitch_lfo = sin_osc_ar(6.0) * freq * 0.02;

        // Multiple heavily detuned saws
        let osc1 = saw_ar(freq * 0.97 + pitch_lfo);
        let osc2 = saw_ar(freq * 0.99);
        let osc3 = saw_ar(freq);
        let osc4 = saw_ar(freq * 1.01);
        let osc5 = saw_ar(freq * 1.03 + pitch_lfo * 0.5);

        let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.18;

        // PWM layer
        let pwm = sin_osc_ar(0.3) * 0.3 + 0.5;
        let pulse_layer = pulse_ar(freq * 0.5, pwm) * 0.3;

        let sig = mix + pulse_layer;

        // Aggressive filter
        rlpf_ar(sig, 3000.0, 0.4) * env * amp
    });

//
// # Usage: `lead_juno_hoover`
//
// ```rhai
// import "stdlib/leads/classic/lead_juno_hoover.vibe" as lead_juno_hoover;
//
// let lead_juno_hoover = voice("doc_lead_juno_hoover")
//     .synth("lead_juno_hoover")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_juno_hoover.output("out").to_main();
// lead_juno_hoover.run();
// ```
