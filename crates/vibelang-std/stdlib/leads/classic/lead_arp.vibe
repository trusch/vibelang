// Genre: Progressive Rock, Electronic | Character: ARP Odyssey-style lead - bright and buzzy
define_synthdef("lead_arp")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.005, 1.0, 0.08)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.005, 0.3)
            .build();

        // Two oscillators with hard sync feel
        let osc1 = saw_ar(freq);
        let osc2 = pulse_ar(freq * 1.01, 0.4);

        // Ring mod option
        let ring = osc1 * osc2 * 0.3;

        let mix = (osc1 + osc2 + ring) * 0.3;

        // Bright filter
        let cutoff = 1500.0 + filt_env * 4000.0;
        rlpf_ar(mix, cutoff, 0.3) * env * amp
    });

//
// # Usage: `lead_arp`
//
// ```rhai
// import "stdlib/leads/classic/lead_arp.vibe" as lead_arp;
//
// let lead_arp = voice("doc_lead_arp")
//     .synth("lead_arp")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_arp.output("out").to_main();
// lead_arp.run();
// ```
