// Genre: Industrial, Experimental | Character: Korg MS-20 lead - screaming and aggressive
define_synthdef("lead_ms20")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("drive", 1.5) // units: gain, range: 0..10, default: 1.5. Nonlinear drive amount; higher adds harmonic distortion and compression.
    .body(|freq, amp, gate, drive| {
        let env = envelope()
            .asr(0.002, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.002, 0.35)
            .build();

        // Dual oscillators
        let osc1 = saw_ar(freq);
        let osc2 = pulse_ar(freq * 1.005, 0.3);

        let mix = (osc1 + osc2) * 0.4;

        // MS-20 style - HP then LP with drive
        let hp = hpf_ar(mix, 100.0);
        let driven = (hp * drive).tanh();

        // Aggressive resonant filter
        let cutoff = 800.0 + filt_env * 5000.0;
        rlpf_ar(driven, cutoff, 0.5) * env * amp
    });

//
// # Usage: `lead_ms20`
//
// ```rhai
// import "stdlib/leads/classic/lead_ms20.vibe" as lead_ms20;
//
// let lead_ms20 = voice("doc_lead_ms20")
//     .synth("lead_ms20")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("drive", 1.5);
// lead_ms20.output("out").to_main();
// lead_ms20.run();
// ```
