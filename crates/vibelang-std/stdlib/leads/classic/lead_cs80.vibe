// Genre: Cinematic, Synthwave | Character: Yamaha CS-80 brass lead - expressive and lush
define_synthdef("lead_cs80")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.02, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope with slow attack
        let filt_env = envelope()
            .asr(0.1, 1.0, 0.2)
            .gate(gate)
            .build();

        // Multiple detuned oscillators for thickness
        let osc1 = saw_ar(freq * 0.998);
        let osc2 = saw_ar(freq);
        let osc3 = saw_ar(freq * 1.002);
        let osc4 = saw_ar(freq * 1.006);

        let mix = (osc1 + osc2 + osc3 + osc4) * 0.22;

        // Expressive filter
        let cutoff = 800.0 + filt_env * 4000.0;
        rlpf_ar(mix, cutoff, 0.15) * env * amp
    });

//
// # Usage: `lead_cs80`
//
// ```rhai
// import "stdlib/leads/classic/lead_cs80.vibe" as lead_cs80;
//
// let lead_cs80 = voice("doc_lead_cs80")
//     .synth("lead_cs80")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_cs80.output("out").to_main();
// lead_cs80.run();
// ```
