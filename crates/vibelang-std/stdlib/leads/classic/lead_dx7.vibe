// Genre: 80s Pop, R&B | Character: DX7 FM lead - bell-like and cutting
define_synthdef("lead_dx7")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // FM index envelope
        let mod_env = envelope()
            .perc(0.001, 0.3)
            .build();

        // 2-operator FM
        let mod_ratio = 2.0;
        let mod_index = 3.0 + mod_env * 8.0;
        let modulator = sin_osc_ar(freq * mod_ratio) * mod_index * freq;
        let carrier = sin_osc_ar(freq + modulator);

        // Second carrier for brightness
        let mod2 = sin_osc_ar(freq * 3.0) * mod_env * freq * 2.0;
        let carrier2 = sin_osc_ar(freq + mod2) * 0.4;

        let sig = (carrier + carrier2) * 0.5;

        sig * env * amp
    });

//
// # Usage: `lead_dx7`
//
// ```rhai
// import "stdlib/leads/classic/lead_dx7.vibe" as lead_dx7;
//
// let lead_dx7 = voice("doc_lead_dx7")
//     .synth("lead_dx7")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_dx7.output("out").to_main();
// lead_dx7.run();
// ```
