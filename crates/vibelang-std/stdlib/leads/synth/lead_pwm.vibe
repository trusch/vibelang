// Genre: Synthwave, Electro | Character: Pulse width modulation lead
define_synthdef("lead_pwm", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.015, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // PWM envelope - modulate pulse width
            let pwm_env = envelope()
                .asr(0.1, 1.0, 0.1)
                .gate(gate)
                .build();
            let width = 0.2 + (pwm_env * 0.6);

            // Pulse wave with width as f64 constant (approximation)
            // Using two pulses with different widths for movement
            let pulse1 = saw_ar(freq);
            let pulse2 = saw_ar(freq);
            let mix = (pulse1 + pulse2) * 0.5;

            // Filter
            let filter_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1300.0 + (filter_env * 2800.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_pwm`
//
// ```rhai
// import "stdlib/leads/synth/lead_pwm.vibe" as lead_pwm;
//
// let lead_pwm = voice("doc_lead_pwm")
//     .synth("lead_pwm")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_pwm.output("out").to_main();
// lead_pwm.run();
// ```
