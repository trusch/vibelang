// Genre: House, Techno | Character: Detuned lead with chorus effect
define_synthdef("lead_detuned", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Wide detuning for chorus
            let osc1 = saw_ar(freq * 0.985);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.015);

            let mix = (osc1 + osc2 + osc3) * 0.33;

            // Filter
            let filter_env = envelope()
                .asr(0.08, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1400.0 + (filter_env * 3000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_detuned`
//
// ```rhai
// import "stdlib/leads/synth/lead_detuned.vibe" as lead_detuned;
//
// let lead_detuned = voice("doc_lead_detuned")
//     .synth("lead_detuned")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_detuned.output("out").to_main();
// lead_detuned.run();
// ```
