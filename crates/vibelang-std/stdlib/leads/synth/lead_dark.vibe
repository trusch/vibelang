// Genre: Techno, Industrial | Character: Dark, moody lead
define_synthdef("lead_dark", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.03, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Mix of saw and pulse for darker timbre
            let saw = saw_ar(freq) * 0.5;
            let pulse = saw_ar(freq) * 0.5;
            let mix = saw + pulse;

            // Dark filter range
            let filter_env = envelope()
                .asr(0.15, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 400.0 + (filter_env * 1500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_dark`
//
// ```rhai
// import "stdlib/leads/synth/lead_dark.vibe" as lead_dark;
//
// let lead_dark = voice("doc_lead_dark")
//     .synth("lead_dark")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_dark.output("out").to_main();
// lead_dark.run();
// ```
