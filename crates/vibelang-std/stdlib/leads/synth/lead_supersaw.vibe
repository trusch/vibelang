// Genre: Trance, EDM | Character: Massive supersaw, wide and powerful
define_synthdef("lead_supersaw", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Multiple detuned saws
            let saw1 = saw_ar(freq * 0.990);
            let saw2 = saw_ar(freq * 0.996);
            let saw3 = saw_ar(freq);
            let saw4 = saw_ar(freq * 1.004);
            let saw5 = saw_ar(freq * 1.010);

            let mix = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.2;

            // Filter
            let filter_env = envelope()
                .asr(0.1, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1000.0 + (filter_env * 4000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_supersaw`
//
// ```rhai
// import "stdlib/leads/synth/lead_supersaw.vibe" as lead_supersaw;
//
// let lead_supersaw = voice("doc_lead_supersaw")
//     .synth("lead_supersaw")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_supersaw.output("out").to_main();
// lead_supersaw.run();
// ```
