// Genre: Electro, Synthwave | Character: Square wave lead, hollow and vintage
define_synthdef("lead_square", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.015, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Square waves (pulse with 0.5 width)
            let square1 = saw_ar(freq * 0.999);
            let square2 = saw_ar(freq * 1.001);
            let mix = (square1 + square2) * 0.5;

            // Filter
            let filter_env = envelope()
                .asr(0.08, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1500.0 + (filter_env * 2500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_square`
//
// ```rhai
// import "stdlib/leads/synth/lead_square.vibe" as lead_square;
//
// let lead_square = voice("doc_lead_square")
//     .synth("lead_square")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_square.output("out").to_main();
// lead_square.run();
// ```
