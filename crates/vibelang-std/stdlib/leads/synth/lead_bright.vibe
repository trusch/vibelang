// Genre: Trance, Progressive | Character: Bright, energetic lead
define_synthdef("lead_bright")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {

        // Envelope
        // Gate-controlled ASR envelope for proper note-on/note-off behavior
        let env = envelope()
            .asr(0.01, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Bright sawtooth mix
        let saw = saw_ar(freq);
        let harmonic = saw_ar(freq * 2.0) * 0.3;
        let mix = saw + harmonic;

        // High-pass for extra brightness
        let hp = hpf_ar(mix, 200.0);

        // Filter
        let filter_env = envelope()
            .asr(0.03, 1.0, 0.1)
            .gate(gate)
            .build();
        let mod_cutoff = 2000.0 + (filter_env * 4000.0);

        let filtered = lpf_ar(hp, mod_cutoff);

        filtered * env * amp
    });

//
// # Usage: `lead_bright`
//
// ```rhai
// import "stdlib/leads/synth/lead_bright.vibe" as lead_bright;
//
// let lead_bright = voice("doc_lead_bright")
//     .synth("lead_bright")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_bright.output("out").to_main();
// lead_bright.run();
// ```
