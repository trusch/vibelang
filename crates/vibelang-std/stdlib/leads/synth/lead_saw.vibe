// Genre: Trance, House | Character: Classic saw lead, bright and cutting
define_synthdef("lead_saw", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Lead envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Slightly detuned saws
            let saw1 = saw_ar(freq * 0.998);
            let saw2 = saw_ar(freq * 1.002);
            let mix = (saw1 + saw2) * 0.5;

            // Filter envelope for movement
            let filter_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1200.0 + (filter_env * 3000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_saw`
//
// ```rhai
// import "stdlib/leads/synth/lead_saw.vibe" as lead_saw;
//
// let lead_saw = voice("doc_lead_saw")
//     .synth("lead_saw")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_saw.output("out").to_main();
// lead_saw.run();
// ```
