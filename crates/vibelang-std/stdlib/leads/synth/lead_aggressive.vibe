// Genre: Hard Techno, Industrial | Character: Aggressive, distorted lead
define_synthdef("lead_aggressive", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Aggressive envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Overdriven saws
            let saw1 = saw_ar(freq * 0.995) * 1.8;
            let saw2 = saw_ar(freq * 1.005) * 1.8;
            let mix = (saw1 + saw2) * 0.5;

            // Clip for distortion
            let distorted = clip(mix, -0.8, 0.8);

            // Filter
            let filter_env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1500.0 + (filter_env * 3500.0);

            let filtered = lpf_ar(distorted, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `lead_aggressive`
//
// ```rhai
// import "stdlib/leads/synth/lead_aggressive.vibe" as lead_aggressive;
//
// let lead_aggressive = voice("doc_lead_aggressive")
//     .synth("lead_aggressive")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_aggressive.output("out").to_main();
// lead_aggressive.run();
// ```
