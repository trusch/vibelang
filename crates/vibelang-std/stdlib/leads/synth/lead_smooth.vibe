// Genre: Ambient, Chillout | Character: Smooth, gentle lead
define_synthdef("lead_smooth", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Soft envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.08, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sine with subtle harmonics
            let fundamental = sin_osc_ar(freq);
            let harmonic2 = sin_osc_ar(freq * 2.0) * 0.15;
            let harmonic3 = sin_osc_ar(freq * 3.0) * 0.08;

            let mix = fundamental + harmonic2 + harmonic3;

            // Gentle filter
            let filtered = lpf_ar(mix, 3000.0);

            filtered * env * amp
        })
});

//
// # Usage: `lead_smooth`
//
// ```rhai
// import "stdlib/leads/synth/lead_smooth.vibe" as lead_smooth;
//
// let lead_smooth = voice("doc_lead_smooth")
//     .synth("lead_smooth")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_smooth.output("out").to_main();
// lead_smooth.run();
// ```
