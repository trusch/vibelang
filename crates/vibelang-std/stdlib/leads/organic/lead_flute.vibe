// Genre: Ambient, World, Electronic | Character: Synth flute - breathy and soft
define_synthdef("lead_flute")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.08, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.0) * freq * 0.01;

        // Main tone with harmonics
        let body = sin_osc_ar(freq + vib) * 0.5;
        let harm1 = sin_osc_ar((freq + vib) * 2.0) * 0.2;
        let harm2 = sin_osc_ar((freq + vib) * 3.0) * 0.08;

        // Breath noise
        let breath_e = envelope()
            .asr(0.1, 0.6, 0.15)
            .gate(gate)
            .build();
        let breath = bpf_ar(pink_noise_ar(), freq * 1.5, 0.8) * breath_e * 0.2;

        let sig = body + harm1 + harm2 + breath;

        sig * env * amp
    });

//
// # Usage: `lead_flute`
//
// ```rhai
// import "stdlib/leads/organic/lead_flute.vibe" as lead_flute;
//
// let lead_flute = voice("doc_lead_flute")
//     .synth("lead_flute")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_flute.output("out").to_main();
// lead_flute.run();
// ```
