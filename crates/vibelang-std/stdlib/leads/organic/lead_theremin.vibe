// Genre: Experimental, Soundtrack | Character: Theremin emulation - eerie and wavering
define_synthdef("lead_theremin")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Characteristic wavering vibrato
        let vib1 = sin_osc_ar(6.0) * freq * 0.015;
        let vib2 = sin_osc_ar(0.5) * freq * 0.008;

        // Pure sine tone
        let body = sin_osc_ar(freq + vib1 + vib2);

        body * env * amp
    });

//
// # Usage: `lead_theremin`
//
// ```rhai
// import "stdlib/leads/organic/lead_theremin.vibe" as lead_theremin;
//
// let lead_theremin = voice("doc_lead_theremin")
//     .synth("lead_theremin")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// lead_theremin.output("out").to_main();
// lead_theremin.run();
// ```
