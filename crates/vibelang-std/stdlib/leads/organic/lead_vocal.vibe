// Genre: Electronic, Synthpop | Character: Vocal synth lead - human-like formants
define_synthdef("lead_vocal")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("vowel", 0.5) // units: normalized, range: 0..1, default: 0.5. Vowel/formant position; higher values move the resonant vowels forward.
    .body(|freq, amp, gate, vowel| {
        let env = envelope()
            .asr(0.02, 1.0, 0.12)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.5) * freq * 0.008;

        // Rich harmonic source
        let osc = saw_ar(freq + vib) * 0.5;

        // Formant frequencies based on vowel
        let f1 = 400.0 + vowel * 400.0;
        let f2 = 1000.0 + vowel * 1000.0;
        let f3 = 2500.0 + vowel * 500.0;

        // Formant filters
        let form1 = bpf_ar(osc, f1, 0.12) * 0.5;
        let form2 = bpf_ar(osc, f2, 0.15) * 0.3;
        let form3 = bpf_ar(osc, f3, 0.2) * 0.15;

        let sig = form1 + form2 + form3;

        sig * env * amp
    });

//
// # Usage: `lead_vocal`
//
// ```rhai
// import "stdlib/leads/organic/lead_vocal.vibe" as lead_vocal;
//
// let lead_vocal = voice("doc_lead_vocal")
//     .synth("lead_vocal")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("vowel", 0.5);
// lead_vocal.output("out").to_main();
// lead_vocal.run();
// ```
