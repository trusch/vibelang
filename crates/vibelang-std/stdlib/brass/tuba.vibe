// Tuba
// Genre: Orchestral, March | Character: Deep, powerful, round
//
// Deep tuba with full, round bass tone.

define_synthdef("tuba", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            // Slow attack for tuba
            let env = envelope()
                .asr(0.15, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Deep brass tone
            let saw1 = saw_ar(freq);
            let saw2 = saw_ar(freq * 1.001) * 0.5;
            let sub = sin_osc_ar(freq * 0.5) * 0.3;

            let tone = (saw1 + saw2) * 0.4 + sub;

            // Tuba formants (very warm)
            let f1 = rlpf_ar(tone, 250.0, 0.3) * 0.8;
            let f2 = rlpf_ar(tone, 600.0, 0.35) * 0.5;
            let f3 = rlpf_ar(tone, 1200.0, 0.4) * 0.2;

            let brass = f1 + f2 + f3;

            // Heavy low pass
            let deep = lpf_ar(brass, 2000.0);

            deep * env * amp * 0.8
        })
});

//
// # Usage: `tuba`
//
// ```rhai
// import "stdlib/brass/tuba.vibe" as tuba;
//
// let tuba = voice("doc_tuba")
//     .synth("tuba")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// tuba.output("out").to_main();
// tuba.run();
// ```
