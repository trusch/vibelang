// Utility: Click track for timing reference

// Click high - Downbeat marker
define_synthdef("click_high")
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .body(|amp| {        let env = envelope()
            .perc(0.001, 0.03)
            .cleanup_on_finish()
            .build();

        sin_osc_ar(1500.0) * env * amp
    });

// Click low - Off-beat marker
define_synthdef("click_low")
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .body(|amp| {        let env = envelope()
            .perc(0.001, 0.025)
            .cleanup_on_finish()
            .build();

        sin_osc_ar(1000.0) * env * amp
    });

// Click wood - Natural sounding click
define_synthdef("click_wood")
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .body(|amp| {        let env = envelope()
            .perc(0.001, 0.02)
            .cleanup_on_finish()
            .build();

        let noise = hpf_ar(white_noise_ar(), 2000.0);
        let body = sin_osc_ar(800.0) * 0.3;

        (noise * 0.7 + body) * env * amp
    });

//
// # Usage: `click_high`
//
// ```rhai
// import "stdlib/utility/click_track.vibe" as click_track;
//
// let click_high = voice("doc_click_high")
//     .synth("click_high")
//     .set_param("amp", 0.5)
//     .set_param("amp", 0.5)
//     .set_param("amp", 0.5);
// click_high.output("out").to_main();
// click_high.run();
// ```
