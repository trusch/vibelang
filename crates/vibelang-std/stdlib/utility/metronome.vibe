// Metronome Click
// Utility | Character: Sharp, precise click
//
// Simple metronome click for timing reference.

define_synthdef("metronome")
    .param("freq", 1000.0) // units: Hz, range: 0..20000, default: 1000.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Very short click envelope
        let env = envelope()
            .perc(0.0001, 0.03)
            .cleanup_on_finish()
            .build();

        // Sharp click tone
        let click = sin_osc_ar(freq);

        // High frequency transient for clarity
        let tick_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let tick = sin_osc_ar(freq * 4.0) * tick_env;

        (click + tick * 0.5) * env * amp
    });

// Accented metronome click (for downbeats)
define_synthdef("metronome_accent")
    .param("freq", 1500.0) // units: Hz, range: 0..20000, default: 1500.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Short click envelope
        let env = envelope()
            .perc(0.0001, 0.04)
            .cleanup_on_finish()
            .build();

        // Higher pitched accent
        let click = sin_osc_ar(freq);
        let click2 = sin_osc_ar(freq * 2.0) * 0.3;

        (click + click2) * env * amp
    });

//
// # Usage: `metronome`
//
// ```rhai
// import "stdlib/utility/metronome.vibe" as metronome;
//
// let metronome = voice("doc_metronome")
//     .synth("metronome")
//     .set_param("freq", 220.0)
//     .set_param("amp", 0.5)
//     .set_param("freq", 220.0)
//     .set_param("amp", 0.5);
// metronome.output("out").to_main();
// metronome.run();
// ```
//
// # Usage: `metronome_accent`
//
// ```rhai
// import "stdlib/utility/metronome.vibe" as metronome;
//
// let metronome_accent = voice("doc_metronome_accent")
//     .synth("metronome_accent")
//     .set_param("freq", 220.0)
//     .set_param("amp", 0.5)
//     .set_param("freq", 220.0)
//     .set_param("amp", 0.5);
// metronome_accent.output("out").to_main();
// metronome_accent.run();
// ```
