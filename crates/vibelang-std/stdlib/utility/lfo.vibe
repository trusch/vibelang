// LFO (Low Frequency Oscillator) Sources
// Utility | Modulation sources for synthesis
//
// Various LFO shapes for modulation purposes.
// Note: These output audio-rate signals for modulation.

// Canonical definitions live under stdlib/cv/lfo. Keep these imports as
// compatibility aliases so existing utility/lfo imports retain their inventory.
import "stdlib/cv/lfo/lfo_sine.vibe";
import "stdlib/cv/lfo/lfo_saw.vibe";
import "stdlib/cv/lfo/lfo_random.vibe";

// Triangle LFO (approximated)
define_synthdef("lfo_triangle", |builder| {
    builder
        .param("freq", 1.0) // units: Hz, range: 0..20000, default: 1.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.001, 1.0, 0.001)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Use sine as approximation
            let tri = sin_osc_ar(freq);
            tri * env * amp
        })
});

//
// # Usage: `lfo_sine`
//
// ```rhai
// import "stdlib/utility/lfo.vibe" as lfo;
//
// let lfo_sine = voice("doc_lfo_sine")
//     .synth("lfo_sine")
//     .set_param("freq", 220.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5)
//     .set_param("freq", 220.0);
// lfo_sine.output("out").to_main();
// lfo_sine.run();
// ```
//
// # Usage: `lfo_triangle`
//
// ```rhai
// import "stdlib/utility/lfo.vibe" as lfo;
//
// let lfo_triangle = voice("doc_lfo_triangle")
//     .synth("lfo_triangle")
//     .set_param("freq", 220.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5)
//     .set_param("freq", 220.0);
// lfo_triangle.output("out").to_main();
// lfo_triangle.run();
// ```
