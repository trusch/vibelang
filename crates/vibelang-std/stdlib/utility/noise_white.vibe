// Utility: Pure white noise generator
define_synthdef("noise_white")
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        white_noise_ar() * env * amp
    });

//
// # Usage: `noise_white`
//
// ```rhai
// import "stdlib/utility/noise_white.vibe" as noise_white;
//
// let noise_white = voice("doc_noise_white")
//     .synth("noise_white")
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5);
// noise_white.output("out").to_main();
// noise_white.run();
// ```
