// Test Tones
// Utility | Reference tones for calibration and testing
//
// Various test tones for audio setup and reference.

// Pure sine wave test tone
define_synthdef("test_sine", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 0..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.01)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            sin_osc_ar(freq) * env * amp
        })
});

// Sawtooth test tone (rich harmonics)
define_synthdef("test_saw", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 0..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.2) // units: linear, range: 0..1, default: 0.2. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.01)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            saw_ar(freq) * env * amp
        })
});

// A440 Reference tone
define_synthdef("a440", |builder| {
    builder
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.01)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            sin_osc_ar(440.0) * env * amp
        })
});

// 1kHz Reference tone (common audio test frequency)
define_synthdef("test_1k", |builder| {
    builder
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.01)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            sin_osc_ar(1000.0) * env * amp
        })
});

// Sweep tone (frequency sweep for testing)
define_synthdef("test_sweep")
    .param("amp", 0.2) // units: linear, range: 0..1, default: 0.2. Output level multiplier; higher is louder.
    .body(|amp| {
        // 3-second sweep envelope
        let env = envelope()
            .perc(0.001, 3.0)
            .cleanup_on_finish()
            .build();

        // Sweep from 20Hz to 20kHz
        let sweep_env = envelope()
            .perc(0.001, 3.0)
            .build();
        let freq = 20.0 + sweep_env * 19980.0;

        sin_osc_ar(freq) * env * amp
    });

//
// # Usage: `test_sine`
//
// ```rhai
// import "stdlib/utility/test_tones.vibe" as test_tones;
//
// let test_sine = voice("doc_test_sine")
//     .synth("test_sine")
//     .set_param("freq", 220.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5)
//     .set_param("amp", 0.5);
// test_sine.output("out").to_main();
// test_sine.run();
// ```
//
