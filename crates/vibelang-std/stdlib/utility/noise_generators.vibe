// Noise Generators
// Utility | Various noise types for synthesis and testing
//
// Different colored noise sources.

// White Noise (all frequencies, flat spectrum)
define_synthdef("white_noise_gen", |builder| {
    builder
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            white_noise_ar() * env * amp
        })
});

// Pink Noise (1/f spectrum, equal energy per octave)
define_synthdef("pink_noise_gen", |builder| {
    builder
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Approximate pink noise by filtering white noise
            let white = white_noise_ar();
            let pink = lpf_ar(white, 10000.0);

            pink * env * amp
        })
});

// Brown/Red Noise (1/f^2 spectrum, deeper)
define_synthdef("brown_noise_gen", |builder| {
    builder
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Heavy low pass for brown noise character
            let white = white_noise_ar();
            let brown = lpf_ar(lpf_ar(white, 800.0), 400.0);

            brown * env * amp * 2.0
        })
});

// High-passed Noise (hiss, bright)
define_synthdef("hiss_gen", |builder| {
    builder
        .param("amp", 0.2) // units: linear, range: 0..1, default: 0.2. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("freq", 4000.0) // units: Hz, range: 0..20000, default: 4000.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .body(|amp, gate, freq| {
            let env = envelope()
                .asr(0.01, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let white = white_noise_ar();
            let hiss = hpf_ar(white, freq);

            hiss * env * amp
        })
});

// Filtered Noise (bandpass, focused)
define_synthdef("filtered_noise_gen", |builder| {
    builder
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("freq", 1000.0) // units: Hz, range: 0..20000, default: 1000.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("rq", 0.2) // units: resonance, range: 0..1, default: 0.2. RQ macro; higher moves that model axis toward its brighter or more open setting.
        .body(|amp, gate, freq, rq| {
            let env = envelope()
                .asr(0.01, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let white = white_noise_ar();
            let filtered = rlpf_ar(white, freq, rq);

            filtered * env * amp
        })
});

// Crackle (random impulses)
define_synthdef("crackle_gen", |builder| {
    builder
        .param("amp", 0.2) // units: linear, range: 0..1, default: 0.2. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("density", 0.5) // units: normalized, range: 0..1, default: 0.5. Event density per second; higher values create more grains, dust, or impulses.
        .body(|amp, gate, density| {
            let env = envelope()
                .asr(0.01, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Use dust for random impulses
            let impulses = dust_ar(10.0 + density * 100.0);
            let crackle = hpf_ar(impulses, 1000.0);

            crackle * env * amp * 3.0
        })
});

//
// # Usage: `white_noise_gen`
//
// ```rhai
// import "stdlib/utility/noise_generators.vibe" as noise_generators;
//
// let white_noise_gen = voice("doc_white_noise_gen")
//     .synth("white_noise_gen")
//     .set_param("freq", 220.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5)
//     .set_param("amp", 0.5);
// white_noise_gen.output("out").to_main();
// white_noise_gen.run();
// ```
