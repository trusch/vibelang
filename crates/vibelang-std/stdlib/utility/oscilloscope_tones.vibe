// Utility: Oscilloscope calibration and test tones

// Sweep tone - Frequency sweep for testing
define_synthdef("sweep_tone")
    .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("rate", 0.5) // units: Hz, range: 0..100, default: 0.5. Clock or modulation rate in Hz; higher values make motion faster.
    .body(|amp, gate, rate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // LFO sweeping from 100Hz to 5000Hz
        let lfo = sin_osc_ar(rate) * 0.5 + 0.5;
        let freq = 100.0 + lfo * 4900.0;

        sin_osc_ar(freq) * env * amp
    });

// Square test - Square wave test tone
define_synthdef("square_test")
    .param("freq", 440.0) // units: Hz, range: 0..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        pulse_ar(freq, 0.5) * env * amp
    });

// Saw test - Sawtooth test tone
define_synthdef("saw_test")
    .param("freq", 440.0) // units: Hz, range: 0..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        saw_ar(freq) * env * amp
    });

// Triangle test - Triangle wave test tone
define_synthdef("tri_test")
    .param("freq", 440.0) // units: Hz, range: 0..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        lf_tri_ar(freq) * env * amp
    });

//
// # Usage: `sweep_tone`
//
// ```rhai
// import "stdlib/utility/oscilloscope_tones.vibe" as oscilloscope_tones;
//
// let sweep_tone = voice("doc_sweep_tone")
//     .synth("sweep_tone")
//     .set_param("freq", 220.0)
//     .set_param("rate", 2.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5);
// sweep_tone.output("out").to_main();
// sweep_tone.run();
// ```
//
// # Usage: `square_test`
//
// ```rhai
// import "stdlib/utility/oscilloscope_tones.vibe" as oscilloscope_tones;
//
// let square_test = voice("doc_square_test")
