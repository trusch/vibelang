// Region: Russian | Character: Triangular stringed instrument
define_synthdef("balalaika")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Plucked string excitation
        let pluck_env = envelope()
            .perc(0.001, 0.03)
            .build();
        let exciter = lpf_ar(white_noise_ar(), 3000.0) * pluck_env * 0.8;

        // Bright triangular body resonance
        let body1 = sin_osc_ar(freq) * 0.5;
        let body2 = sin_osc_ar(freq * 2.0) * 0.3;
        let body3 = sin_osc_ar(freq * 3.0) * 0.15;
        let body4 = sin_osc_ar(freq * 4.0) * 0.08;

        let sig = body1 + body2 + body3 + body4 + exciter;

        // Bright character
        let filtered = hpf_ar(sig, 200.0);

        filtered * env * amp
    });

//
// # Usage: `balalaika`
//
// ```rhai
// import "stdlib/world/balalaika.vibe" as balalaika;
//
// let balalaika = voice("doc_balalaika")
//     .synth("balalaika")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// balalaika.output("out").to_main();
// balalaika.run();
// ```
