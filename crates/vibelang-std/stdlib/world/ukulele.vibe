// Region: Hawaiian | Character: Small, bright, cheerful plucked string
define_synthdef("ukulele")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Nylon string character - softer attack
        let pluck_env = envelope()
            .perc(0.002, 0.04)
            .build();
        let exciter = lpf_ar(pink_noise_ar(), 4000.0) * pluck_env * 0.3;

        // Warm harmonics
        let str1 = sin_osc_ar(freq) * 0.5;
        let str2 = sin_osc_ar(freq * 2.0) * 0.25;
        let str3 = sin_osc_ar(freq * 3.0) * 0.1;

        let sig = str1 + str2 + str3 + exciter;

        // Small body resonance - warm and bright
        let body = bpf_ar(sig, 500.0, 0.2) * 0.3;
        let output = sig + body;

        output * env * amp
    });

//
// # Usage: `ukulele`
//
// ```rhai
// import "stdlib/world/ukulele.vibe" as ukulele;
//
// let ukulele = voice("doc_ukulele")
//     .synth("ukulele")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// ukulele.output("out").to_main();
// ukulele.run();
// ```
