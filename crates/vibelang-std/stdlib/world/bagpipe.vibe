// Genre: Celtic, Scottish | Character: Scottish bagpipe chanter
define_synthdef("bagpipe")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.05, 1.0, 0.05)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Bright, reedy tone
        let body = saw_ar(freq) * 0.3;
        let harm1 = saw_ar(freq * 2.0) * 0.2;
        let harm2 = saw_ar(freq * 3.0) * 0.15;

        // Drone (constant)
        let drone = sin_osc_ar(freq * 0.5) * 0.2;

        let mix = body + harm1 + harm2 + drone;

        // Nasal filtering
        bpf_ar(mix, 1500.0, 0.3) * 2.0 * env * amp
    });

//
// # Usage: `bagpipe`
//
// ```rhai
// import "stdlib/world/bagpipe.vibe" as bagpipe;
//
// let bagpipe = voice("doc_bagpipe")
//     .synth("bagpipe")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// bagpipe.output("out").to_main();
// bagpipe.run();
// ```
