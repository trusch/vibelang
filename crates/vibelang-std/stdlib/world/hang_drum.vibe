// Region: Swiss | Character: Handpan with bell-like, ethereal tones
define_synthdef("hang_drum")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.8)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Bell-like attack
        let attack_env = envelope()
            .perc(0.001, 0.1)
            .build();
        let attack = sin_osc_ar(freq * 4.0) * attack_env * 0.3;

        // Main tone with detuned partials
        let main = sin_osc_ar(freq) * 0.5;
        let partial1 = sin_osc_ar(freq * 2.01) * 0.25;
        let partial2 = sin_osc_ar(freq * 3.0) * 0.15;
        let partial3 = sin_osc_ar(freq * 4.02) * 0.1;

        // Subtle beating for ethereal quality
        let beat = sin_osc_ar(freq * 1.002) * 0.2;

        let sig = main + partial1 + partial2 + partial3 + beat + attack;

        sig * env * amp
    });

//
// # Usage: `hang_drum`
//
// ```rhai
// import "stdlib/world/hang_drum.vibe" as hang_drum;
//
// let hang_drum = voice("doc_hang_drum")
//     .synth("hang_drum")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// hang_drum.output("out").to_main();
// hang_drum.run();
// ```
