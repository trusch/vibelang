// Region: Persian/Indian | Character: Hammered dulcimer with shimmering tone
define_synthdef("santoor")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.4)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Hammer strike
        let strike_env = envelope()
            .perc(0.001, 0.01)
            .build();
        let strike = hpf_ar(white_noise_ar(), 4000.0) * strike_env * 0.3;

        // Multiple courses - slight detuning for shimmer
        let str1 = sin_osc_ar(freq) * 0.35;
        let str2 = sin_osc_ar(freq * 1.002) * 0.35;
        let str3 = sin_osc_ar(freq * 0.998) * 0.35;

        // Bright harmonics
        let harm1 = sin_osc_ar(freq * 2.0) * 0.2;
        let harm2 = sin_osc_ar(freq * 3.0) * 0.1;

        let sig = str1 + str2 + str3 + harm1 + harm2 + strike;

        sig * env * amp
    });

//
// # Usage: `santoor`
//
// ```rhai
// import "stdlib/world/santoor.vibe" as santoor;
//
// let santoor = voice("doc_santoor")
//     .synth("santoor")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// santoor.output("out").to_main();
// santoor.run();
// ```
