// Genre: Celtic, Irish | Character: Irish tin whistle
define_synthdef("tin_whistle")
    .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.02, 1.0, 0.05)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Light vibrato
        let vib = sin_osc_ar(5.0) * freq * 0.008;

        // Pure tone with slight harmonics
        let body = sin_osc_ar(freq + vib) * 0.6;
        let harm = sin_osc_ar((freq + vib) * 2.0) * 0.15;

        // Breath
        let breath = bpf_ar(pink_noise_ar(), freq * 2.0, 0.6) * 0.15;

        let sig = body + harm + breath;

        sig * env * amp
    });

//
// # Usage: `tin_whistle`
//
// ```rhai
// import "stdlib/world/tin_whistle.vibe" as tin_whistle;
//
// let tin_whistle = voice("doc_tin_whistle")
//     .synth("tin_whistle")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// tin_whistle.output("out").to_main();
// tin_whistle.run();
// ```
