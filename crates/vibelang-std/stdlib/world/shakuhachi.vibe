// Shakuhachi
// Japanese | Character: Breathy, meditative, wooden
//
// The traditional Japanese bamboo flute with its
// distinctive breathy, meditative sound.

define_synthdef("shakuhachi", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("breath", 0.4) // units: normalized, range: 0..1, default: 0.4. Breath-noise amount; higher adds more airy turbulence.
        .body(|freq, amp, gate, breath| {
            let env = envelope()
                .asr(0.15, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Gentle vibrato
            let vib = sin_osc_ar(5.0) * 0.008 + 1.0;
            let mod_freq = freq * vib;

            // Breathy tone
            let tone = sin_osc_ar(mod_freq);
            let h2 = sin_osc_ar(mod_freq * 2.0) * 0.3;
            let h3 = sin_osc_ar(mod_freq * 3.0) * 0.1;

            let flute = tone + h2 + h3;

            // Breath noise
            let noise = white_noise_ar() * breath * 0.15;
            let breath_filtered = lpf_ar(hpf_ar(noise, 1000.0), 5000.0);

            let mix = flute + breath_filtered;

            // Body resonance
            let body = rlpf_ar(mix, mod_freq * 2.0, 0.4);

            body * env * amp * 0.7
        })
});

//
// # Usage: `shakuhachi`
//
// ```rhai
// import "stdlib/world/shakuhachi.vibe" as shakuhachi;
//
// let shakuhachi = voice("doc_shakuhachi")
//     .synth("shakuhachi")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("breath", 0.4);
// shakuhachi.output("out").to_main();
// shakuhachi.run();
// ```
