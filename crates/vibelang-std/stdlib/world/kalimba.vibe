// Kalimba (Thumb Piano)
// African | Character: Bright, metallic, bell-like
//
// The traditional African thumb piano with its
// distinctive bright, resonant tone.

define_synthdef("kalimba", |builder| {
    builder
        .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.001, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Medium decay
            let decay_env = envelope()
                .perc(0.001, 0.8)
                .build();

            // Metallic tine sound
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.5;
            let h3 = sin_osc_ar(freq * 3.0) * 0.3;
            let h4 = sin_osc_ar(freq * 5.2) * 0.15; // Slightly inharmonic

            let tine = h1 + h2 + h3 + h4;

            // Pluck attack
            let pluck_env = envelope()
                .perc(0.0001, 0.01)
                .build();
            let pluck = sin_osc_ar(freq * 8.0) * pluck_env * 0.2;

            // Body resonance
            let body = rlpf_ar(tine, 2500.0, 0.3);

            (body + pluck) * env * decay_env * amp * 0.6
        })
});

//
// # Usage: `kalimba`
//
// ```rhai
// import "stdlib/world/kalimba.vibe" as kalimba;
//
// let kalimba = voice("doc_kalimba")
//     .synth("kalimba")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// kalimba.output("out").to_main();
// kalimba.run();
// ```
