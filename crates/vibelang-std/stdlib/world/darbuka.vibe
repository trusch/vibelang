// Genre: Middle Eastern, Arabic | Character: Darbuka/doumbek hand drum
define_synthdef("darbuka")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("type", 0.0) // units: selector, range: 0..N, default: 0.0. Selects instrument or tone type.
    .body(|freq, amp, type_param| {
        // Decay based on type
        let decay = 0.3 - type_param * 0.2;
        let amp_env = envelope()
            .perc(0.001, 1.0)
            .time_scale(decay)
            .cleanup_on_finish()
            .build();

        // Pitch based on type
        let pitch = freq * (1.0 + type_param * 2.0);

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();

        // Body
        let body = sin_osc_ar(pitch + pitch_env * pitch * (1.0 - type_param)) * (1.0 - type_param * 0.5);

        // High slap for tek/ka
        let slap = hpf_ar(white_noise_ar(), 3000.0 + type_param * 3000.0) * type_param * 0.4;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let attack = white_noise_ar() * attack_env * 0.2;

        (body + slap + attack) * amp_env * amp
    });

//
// # Usage: `darbuka`
//
// ```rhai
// import "stdlib/world/darbuka.vibe" as darbuka;
//
// let darbuka = voice("doc_darbuka")
//     .synth("darbuka")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("type", 0.0);
// darbuka.output("out").to_main();
// darbuka.run();
// ```
