// Genre: West African | Character: Kora - African harp-like instrument
define_synthdef("kora")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.65) // units: linear, range: 0..1, default: 0.65. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.003, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Bright, harp-like harmonics
        let h1 = sin_osc_ar(freq) * 0.4;
        let h2 = sin_osc_ar(freq * 2.0) * 0.28;
        let h3 = sin_osc_ar(freq * 3.0) * 0.18;
        let h4 = sin_osc_ar(freq * 4.0) * 0.1;

        // Pluck attack
        let pluck = envelope()
            .perc(0.001, 0.02)
            .build();
        let attack = hpf_ar(white_noise_ar(), 3000.0) * pluck * 0.15;

        let sig = h1 + h2 + h3 + h4 + attack;

        sig * env * amp
    });

//
// # Usage: `kora`
//
// ```rhai
// import "stdlib/world/kora.vibe" as kora;
//
// let kora = voice("doc_kora")
//     .synth("kora")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// kora.output("out").to_main();
// kora.run();
// ```
