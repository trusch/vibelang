// Genre: Folk, Tango, Zydeco | Character: Accordion/melodeon
define_synthdef("accordion")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.03, 1.0, 0.08)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Reed-like tone
        let osc1 = pulse_ar(freq, 0.4) * 0.3;
        let osc2 = pulse_ar(freq * 1.003, 0.45) * 0.25;

        // Upper harmonics
        let harm = sin_osc_ar(freq * 2.0) * 0.15;

        let mix = osc1 + osc2 + harm;

        // Bellows variation
        let bellows = sin_osc_ar(0.3) * 0.1 + 0.9;

        lpf_ar(mix, 4000.0) * bellows * env * amp
    });

//
// # Usage: `accordion`
//
// ```rhai
// import "stdlib/world/accordion.vibe" as accordion;
//
// let accordion = voice("doc_accordion")
//     .synth("accordion")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// accordion.output("out").to_main();
// accordion.run();
// ```
