// Genre: Middle Eastern, Sufi | Character: Ney flute - breathy and haunting
define_synthdef("ney")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.5) * freq * 0.012;

        // Main tone with breath
        let body = sin_osc_ar(freq + vib) * 0.5;
        let harm = sin_osc_ar((freq + vib) * 2.0) * 0.15;

        // Breath component
        let breath = bpf_ar(pink_noise_ar(), freq * 2.5, 0.6) * 0.25;

        let sig = body + harm + breath;

        sig * env * amp
    });

//
// # Usage: `ney`
//
// ```rhai
// import "stdlib/world/ney.vibe" as ney;
//
// let ney = voice("doc_ney")
//     .synth("ney")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// ney.output("out").to_main();
// ney.run();
// ```
