// Genre: Middle Eastern, Arabic | Character: Arabic oud - warm, plucked string
define_synthdef("oud")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.005, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Rich harmonics from plucked string
        let h1 = sin_osc_ar(freq) * 0.4;
        let h2 = sin_osc_ar(freq * 2.0) * 0.25;
        let h3 = sin_osc_ar(freq * 3.0) * 0.15;
        let h4 = sin_osc_ar(freq * 4.0) * 0.08;
        let h5 = sin_osc_ar(freq * 5.0) * 0.04;

        // Pluck attack
        let pluck = envelope()
            .perc(0.001, 0.03)
            .build();
        let attack = bpf_ar(white_noise_ar(), 1500.0, 0.5) * pluck * 0.2;

        let sig = h1 + h2 + h3 + h4 + h5 + attack;

        lpf_ar(sig, 4000.0) * env * amp
    });

//
// # Usage: `oud`
//
// ```rhai
// import "stdlib/world/oud.vibe" as oud;
//
// let oud = voice("doc_oud")
//     .synth("oud")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// oud.output("out").to_main();
// oud.run();
// ```
