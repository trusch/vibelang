// Gamelan Instruments
// Indonesian | Character: Metallic, resonant, bell-like
//
// Traditional Indonesian percussion ensemble instruments.

// Gamelan Gong
define_synthdef("gamelan_gong", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.001, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Very long decay for gong
            let decay_env = envelope()
                .perc(0.001, 4.0)
                .build();

            // Complex inharmonic partials
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.3) * 0.5;
            let h3 = sin_osc_ar(freq * 3.1) * 0.35;
            let h4 = sin_osc_ar(freq * 4.7) * 0.25;
            let h5 = sin_osc_ar(freq * 6.2) * 0.15;

            let gong = h1 + h2 + h3 + h4 + h5;

            // Strike
            let strike_env = envelope()
                .perc(0.0001, 0.05)
                .build();
            let strike = white_noise_ar() * strike_env * 0.15;

            (gong + lpf_ar(strike, 2000.0)) * env * decay_env * amp * 0.5
        })
});

// Gamelan Metallophone (Saron/Gender)
define_synthdef("gamelan_metal", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.001, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Medium decay
            let decay_env = envelope()
                .perc(0.001, 1.5)
                .build();

            // Metallic partials
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.5;
            let h3 = sin_osc_ar(freq * 3.8) * 0.3; // Inharmonic
            let h4 = sin_osc_ar(freq * 5.1) * 0.2;

            let metal = h1 + h2 + h3 + h4;

            // Mallet strike
            let strike_env = envelope()
                .perc(0.0001, 0.01)
                .build();
            let strike = sin_osc_ar(freq * 7.0) * strike_env * 0.15;

            (metal + strike) * env * decay_env * amp * 0.5
        })
});

//
// # Usage: `gamelan_gong`
//
// ```rhai
// import "stdlib/world/gamelan.vibe" as gamelan;
//
// let gamelan_gong = voice("doc_gamelan_gong")
//     .synth("gamelan_gong")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// gamelan_gong.output("out").to_main();
// gamelan_gong.run();
// ```
//
// # Usage: `gamelan_metal`
//
// ```rhai
// import "stdlib/world/gamelan.vibe" as gamelan;
//
// let gamelan_metal = voice("doc_gamelan_metal")
//     .synth("gamelan_metal")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// gamelan_metal.output("out").to_main();
// gamelan_metal.run();
// ```
