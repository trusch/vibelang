// Region: Australian | Character: Deep drone instrument
define_synthdef("didgeridoo")
    .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Fundamental drone
        let fundamental = saw_ar(freq) * 0.4;

        // Overtones with slight variations
        let lfo = sin_osc_ar(0.3) * 1.5;
        let ot1 = saw_ar(freq * 2.0 + lfo) * 0.2;
        let ot2 = pulse_ar(freq * 3.0, 0.3) * 0.1;

        // Breath noise
        let breath = lpf_ar(pink_noise_ar(), 300.0) * 0.15;

        let sig = fundamental + ot1 + ot2 + breath;

        // Resonant filter for tubular character
        let filtered = rlpf_ar(sig, 200.0, 0.3);

        filtered * env * amp
    });

//
// # Usage: `didgeridoo`
//
// ```rhai
// import "stdlib/world/didgeridoo.vibe" as didgeridoo;
//
// let didgeridoo = voice("doc_didgeridoo")
//     .synth("didgeridoo")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// didgeridoo.output("out").to_main();
// didgeridoo.run();
// ```
