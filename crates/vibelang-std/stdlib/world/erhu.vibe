// Genre: Chinese Traditional | Character: Erhu - Chinese bowed string
define_synthdef("erhu")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.08, 1.0, 0.12)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Expressive vibrato
        let vib = sin_osc_ar(6.0) * freq * 0.015;

        // Bowed string harmonics
        let h1 = sin_osc_ar(freq + vib) * 0.4;
        let h2 = sin_osc_ar((freq + vib) * 2.0) * 0.25;
        let h3 = sin_osc_ar((freq + vib) * 3.0) * 0.15;
        let h4 = sin_osc_ar((freq + vib) * 4.0) * 0.08;

        // Bow noise
        let bow = bpf_ar(pink_noise_ar(), 2500.0, 0.5) * 0.1;

        let sig = h1 + h2 + h3 + h4 + bow;

        lpf_ar(sig, 5000.0) * env * amp
    });

//
// # Usage: `erhu`
//
// ```rhai
// import "stdlib/world/erhu.vibe" as erhu;
//
// let erhu = voice("doc_erhu")
//     .synth("erhu")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// erhu.output("out").to_main();
// erhu.run();
// ```
