// Trap Production Sounds
// Modern Hip-Hop | Character: Dark, heavy, 808-driven
//
// The sound of modern trap and hip-hop production.

// Trap 808 Long - Extended 808 bass
define_synthdef("trap_808_long", |builder| {
    builder
        .param("freq", 40.0) // units: Hz, range: 20..20000, default: 40.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("decay", 2.0) // units: seconds, range: 0..10, default: 2.0. Envelope time or level; higher values make that stage last longer or sustain higher.
        .body(|freq, amp, gate, decay| {
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Long decay envelope
            let decay_env = envelope()
                .perc(0.001, 1.0)
                .time_scale(decay)
                .build();

            // Pitch envelope for 808 character
            let pitch_env = envelope()
                .perc(0.001, 0.08)
                .build();
            let freq_mod = pitch_env * freq * 3.0;

            // Pure sine 808
            let osc = sin_osc_ar(freq + freq_mod);

            // Slight saturation for presence
            let sat = (osc * 1.5).tanh() * 0.8;

            sat * env * decay_env * amp
        })
});

// Trap 808 Distorted - Heavy distorted 808
define_synthdef("trap_808_dist", |builder| {
    builder
        .param("freq", 40.0) // units: Hz, range: 20..20000, default: 40.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("drive", 0.6) // units: normalized, range: 0..1, default: 0.6. Nonlinear drive amount; higher adds harmonic distortion and compression.
        .body(|freq, amp, gate, drive| {
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let decay_env = envelope()
                .perc(0.001, 1.5)
                .build();

            // Pitch envelope
            let pitch_env = envelope()
                .perc(0.001, 0.06)
                .build();
            let freq_mod = pitch_env * freq * 4.0;

            // 808 oscillator
            let osc = sin_osc_ar(freq + freq_mod);

            // Heavy distortion
            let dist_amount = 2.0 + drive * 6.0;
            let dist = (osc * dist_amount).tanh();

            // Low pass to control harshness
            let filtered = lpf_ar(dist, 3000.0);

            filtered * env * decay_env * amp * 0.7
        })
});

// Trap Hihat - Fast trap hats
define_synthdef("trap_hat", |builder| {
    builder
        .param("freq", 8000.0) // units: Hz, range: 20..20000, default: 8000.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Very short envelope
            let env = envelope()
                .perc(0.001, 0.05)
                .cleanup_on_finish()
                .build();

            // High-passed noise
            let noise = white_noise_ar();
            let filtered = hpf_ar(noise, freq);

            // Metallic resonance
            let metal = rlpf_ar(noise, freq * 1.2, 0.1) * 0.5;

            (filtered + metal) * env * amp
        })
});

// Trap Hihat Roll - Rapid-fire hats
define_synthdef("trap_hat_roll", |builder| {
    builder
        .param("freq", 9000.0) // units: Hz, range: 20..20000, default: 9000.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Extra short for rolls
            let env = envelope()
                .perc(0.0001, 0.02)
                .cleanup_on_finish()
                .build();

            // Tight filtered noise
            let noise = white_noise_ar();
            let filtered = hpf_ar(noise, freq);

            filtered * env * amp
        })
});

// Trap Lead - Dark melodic lead
define_synthdef("trap_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Dark detuned saw
            let saw1 = saw_ar(freq);
            let saw2 = saw_ar(freq * 1.004);

            let source = (saw1 + saw2) * 0.5;

            // Dark filter
            let filtered = lpf_ar(source, 2500.0);

            filtered * env * amp
        })
});

// Trap Bell - Melodic bell lead
define_synthdef("trap_bell", |builder| {
    builder
        .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.001, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let decay_env = envelope()
                .perc(0.001, 0.8)
                .build();

            // Simple FM bell
            let mod_depth = decay_env * 2.0;
            let modulator = sin_osc_ar(freq * 2.0) * mod_depth;
            let carrier = sin_osc_ar(freq + modulator);

            // Harmonics
            let h2 = sin_osc_ar(freq * 2.0) * 0.3;
            let h3 = sin_osc_ar(freq * 3.0) * 0.15;

            let bell = carrier + h2 + h3;

            bell * env * decay_env * amp * 0.5
        })
});

//
// # Usage: `trap_808_long`
//
// ```rhai
// import "stdlib/modern/trap.vibe" as trap;
//
// let trap_808_long = voice("doc_trap_808_long")
//     .synth("trap_808_long")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("decay", 2.0);
// trap_808_long.output("out").to_main();
// trap_808_long.run();
// ```
//
