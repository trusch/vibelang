// # Usage: `synthwave_bass`
//
// ```rhai
// import "stdlib/modern/synthwave.vibe" as synthwave;
//
// let synthwave_bass = voice("doc_synthwave_bass")
//     .synth("synthwave_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// synthwave_bass.output("out").to_main();
// synthwave_bass.run();
// ```
