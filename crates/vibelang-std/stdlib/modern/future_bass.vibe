// Future Bass Sounds
// Modern 2015+ | Character: Bright, emotional, chord-stacked
//
// The sound of Flume, Illenium, San Holo.

// Future Bass Chord - Iconic supersaws
define_synthdef("future_chord", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("width", 0.6) // units: normalized, range: 0..1, default: 0.6. Spread width; higher values distribute energy across a wider range.
        .body(|freq, amp, gate, width| {
            let env = envelope()
                .asr(0.02, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Supersaw stack
            let spread = width * 0.025;
            let v1 = saw_ar(freq * (1.0 - spread * 2.0));
            let v2 = saw_ar(freq * (1.0 - spread));
            let v3 = saw_ar(freq);
            let v4 = saw_ar(freq * (1.0 + spread));
            let v5 = saw_ar(freq * (1.0 + spread * 2.0));

            let saws = (v1 + v2 + v3 + v4 + v5) * 0.22;

            // Subtle sub layer
            let sub = sin_osc_ar(freq * 0.5) * 0.15;

            // High pass for clarity
            let clean = hpf_ar(saws, 200.0);

            (clean + sub) * env * amp
        })
});

// Future Bass Lead - Bright lead
define_synthdef("future_lead", |builder| {
    builder
        .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Clean saw with slight detune
            let saw1 = saw_ar(freq);
            let saw2 = saw_ar(freq * 1.003);

            let source = (saw1 + saw2) * 0.5;

            // Bright filtering
            let filtered = lpf_ar(source, 8000.0);

            filtered * env * amp
        })
});

// Future Bass Wobble - Sidechain-style pump
define_synthdef("future_wobble", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("rate", 4.0) // units: Hz, range: 0..100, default: 4.0. Clock or modulation rate in Hz; higher values make motion faster.
        .body(|freq, amp, gate, rate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Chord-like oscillators
            let v1 = saw_ar(freq * 0.995);
            let v2 = saw_ar(freq);
            let v3 = saw_ar(freq * 1.005);

            let chord = (v1 + v2 + v3) * 0.35;

            // Pump LFO (simulates sidechain)
            let pump = sin_osc_ar(rate) * 0.4 + 0.6;

            let filtered = lpf_ar(chord, 4000.0);

            filtered * env * amp * pump
        })
});

// Future Bass Pad - Soft atmospheric pad
define_synthdef("future_pad", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.3) // units: linear, range: 0..1, default: 0.3. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.5, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Soft detuned voices
            let v1 = saw_ar(freq * 0.997);
            let v2 = saw_ar(freq);
            let v3 = saw_ar(freq * 1.003);
            let v4 = sin_osc_ar(freq * 0.5) * 0.3;

            let mix = (v1 + v2 + v3) * 0.25 + v4;

            // Very soft filtering
            let filtered = lpf_ar(mix, 2500.0);

            filtered * env * amp
        })
});

// Future Bass Pluck - Short melodic pluck
define_synthdef("future_pluck", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.001, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let decay_env = envelope()
                .perc(0.001, 0.25)
                .build();

            // Bright saw pluck
            let saw1 = saw_ar(freq);
            let saw2 = saw_ar(freq * 1.002);

            let source = (saw1 + saw2) * 0.5;

            // Filter sweep
            let cutoff = 800.0 + decay_env * 5000.0;
            let filtered = rlpf_ar(source, cutoff, 0.35);

            filtered * env * decay_env * amp
        })
});

//
// # Usage: `future_chord`
//
// ```rhai
// import "stdlib/modern/future_bass.vibe" as future_bass;
//
// let future_chord = voice("doc_future_chord")
//     .synth("future_chord")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("width", 0.6);
// future_chord.output("out").to_main();
// future_chord.run();
// ```
//
// # Usage: `future_lead`
//
// ```rhai
// import "stdlib/modern/future_bass.vibe" as future_bass;
//
// let future_lead = voice("doc_future_lead")
//     .synth("future_lead")
