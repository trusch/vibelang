// Random step LFO modulator (sample and hold)
// Outputs: Random values that change at the specified rate
// Use for: Generative patches, random filter/pitch modulation
define_modulator("lfo_random")
    .output_kr("out")     // 1ch — kr CV (random step LFO)
    .param("rate", 1.0)   // Rate of random value changes in Hz
    .param("lo", 0.0)     // Minimum output value
    .param("hi", 1.0)     // Maximum output value
    .body(|rate, lo, hi| {
        // LFNoise0 generates random steps, changes every 1/rate seconds
        let noise = lf_noise0_kr(rate);
        // Map from bipolar (-1 to 1) to user-specified range using basic math
        let normalized = noise * 0.5 + 0.5;  // Map to 0-1
        normalized * (hi - lo) + lo          // Map to lo-hi range
    });

// Smoothed random LFO (interpolated between random values)
define_modulator("lfo_random_smooth")
    .output_kr("out")     // 1ch — kr CV (smoothed random LFO)
    .param("rate", 1.0)
    .param("lo", 0.0)
    .param("hi", 1.0)
    .body(|rate, lo, hi| {
        // LFNoise1 generates linearly interpolated random values
        let noise = lf_noise1_kr(rate);
        // Map from bipolar (-1 to 1) to user-specified range using basic math
        let normalized = noise * 0.5 + 0.5;
        normalized * (hi - lo) + lo
    });

// Exponentially smoothed random LFO
define_modulator("lfo_random_exp")
    .output_kr("out")     // 1ch — kr CV (exp-smoothed random LFO)
    .param("rate", 1.0)
    .param("lo", 0.0)
    .param("hi", 1.0)
    .body(|rate, lo, hi| {
        // LFNoise2 generates quadratically interpolated random values
        let noise = lf_noise2_kr(rate);
        // Map from bipolar (-1 to 1) to user-specified range using basic math
        let normalized = noise * 0.5 + 0.5;
        normalized * (hi - lo) + lo
    });
