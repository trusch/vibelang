// Sampler-style | Character: Classic mellotron choir
define_synthdef("mellotron_choir")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.2, 1.0, 0.3)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Tape warble
        let warble = sin_osc_ar(4.0) * freq * 0.005;

        // Choir-like source
        let source = saw_ar(freq + warble) * 0.4;

        // Choir formants
        let f1 = bpf_ar(source, 600.0, 0.15) * 0.4;
        let f2 = bpf_ar(source, 1200.0, 0.18) * 0.3;
        let f3 = bpf_ar(source, 2400.0, 0.2) * 0.15;

        let sig = f1 + f2 + f3;

        // Tape lo-fi character
        let filtered = lpf_ar(sig, 5000.0);

        filtered * env * amp
    });

//
// # Usage: `mellotron_choir`
//
// ```rhai
// import "stdlib/keys/mellotron_choir.vibe" as mellotron_choir;
//
// let mellotron_choir = voice("doc_mellotron_choir")
//     .synth("mellotron_choir")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// mellotron_choir.output("out").to_main();
// mellotron_choir.run();
// ```
