// Wurlitzer Electric Piano
// Genre: Rock, Pop, Soul | Character: Reedy, biting, growly
//
// Wurlitzer-style EP with characteristic bark and reed-like tone.

define_synthdef("wurlitzer", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("drive", 0.3) // units: normalized, range: 0..1, default: 0.3. Nonlinear drive amount; higher adds harmonic distortion and compression.
        .body(|freq, amp, gate, drive| {
            // Envelope with punchy attack
            let env = envelope()
                .asr(0.003, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Reed-like oscillators
            let fund = sin_osc_ar(freq);
            let odd2 = sin_osc_ar(freq * 3.0) * 0.4;
            let odd3 = sin_osc_ar(freq * 5.0) * 0.2;
            let odd4 = sin_osc_ar(freq * 7.0) * 0.1;

            // Characteristic wurli bark
            let bark_env = envelope()
                .perc(0.001, 0.03)
                .build();
            let bark = white_noise_ar() * bark_env * 0.15;

            let tone = fund + odd2 + odd3 + odd4 + bark;

            // Soft overdrive for warmth
            let driven = (tone * (1.0 + drive * 3.0)).tanh();

            // Bandpass for wurli character
            let filtered = lpf_ar(hpf_ar(driven, 200.0), 4000.0);

            filtered * env * amp * 0.5
        })
});

//
// # Usage: `wurlitzer`
//
// ```rhai
// import "stdlib/keys/wurlitzer.vibe" as wurlitzer;
//
// let wurlitzer = voice("doc_wurlitzer")
//     .synth("wurlitzer")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("drive", 0.3);
// wurlitzer.output("out").to_main();
// wurlitzer.run();
// ```
