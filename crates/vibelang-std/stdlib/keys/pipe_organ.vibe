// Church instrument | Character: Majestic, sustained
define_synthdef("pipe_organ")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.15, 1.0, 0.3)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Multiple pipes at different footages
        let pipe8 = sin_osc_ar(freq) * 0.4;
        let pipe4 = sin_osc_ar(freq * 2.0) * 0.25;
        let pipe2 = sin_osc_ar(freq * 4.0) * 0.15;
        let pipe16 = sin_osc_ar(freq * 0.5) * 0.3;

        // Wind noise
        let wind = lpf_ar(pink_noise_ar(), 500.0) * 0.05;

        let sig = pipe8 + pipe4 + pipe2 + pipe16 + wind;

        sig * env * amp
    });

//
// # Usage: `pipe_organ`
//
// ```rhai
// import "stdlib/keys/pipe_organ.vibe" as pipe_organ;
//
// let pipe_organ = voice("doc_pipe_organ")
//     .synth("pipe_organ")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pipe_organ.output("out").to_main();
// pipe_organ.run();
// ```
