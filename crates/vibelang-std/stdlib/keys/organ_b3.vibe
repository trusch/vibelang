// Genre: Gospel, Jazz, Rock | Character: Hammond B3 organ with drawbars
define_synthdef("organ_b3")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.005, 1.0, 0.05)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Tonewheel harmonics (simplified drawbar settings)
        let h1 = sin_osc_ar(freq * 0.5) * 0.15;    // 16'
        let h2 = sin_osc_ar(freq * 0.75) * 0.08;   // 5 1/3'
        let h3 = sin_osc_ar(freq) * 0.4;           // 8'
        let h4 = sin_osc_ar(freq * 2.0) * 0.25;    // 4'
        let h5 = sin_osc_ar(freq * 3.0) * 0.1;     // 2 2/3'
        let h6 = sin_osc_ar(freq * 4.0) * 0.15;    // 2'
        let h7 = sin_osc_ar(freq * 6.0) * 0.05;    // 1 1/3'

        let mix = h1 + h2 + h3 + h4 + h5 + h6 + h7;

        // Key click
        let click = envelope()
            .perc(0.0001, 0.003)
            .build();
        let key_click = white_noise_ar() * click * 0.08;

        (mix + key_click) * env * amp
    });

//
// # Usage: `organ_b3`
//
// ```rhai
// import "stdlib/keys/organ_b3.vibe" as organ_b3;
//
// let organ_b3 = voice("doc_organ_b3")
//     .synth("organ_b3")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// organ_b3.output("out").to_main();
// organ_b3.run();
// ```
