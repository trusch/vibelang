// Genre: Jazz, R&B, Soul | Character: Bright Rhodes electric piano
define_synthdef("rhodes_bright")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.005, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // FM synthesis for bell-like Rhodes tone
        let mod_env = envelope()
            .perc(0.001, 0.5)
            .build();

        let mod_index = 2.0 + mod_env * 4.0;
        let modulator = sin_osc_ar(freq * 2.0) * mod_index * freq;
        let carrier = sin_osc_ar(freq + modulator);

        // Bark (attack transient)
        let bark = envelope()
            .perc(0.001, 0.02)
            .build();
        let attack = sin_osc_ar(freq * 8.0) * bark * 0.15;

        let sig = carrier * 0.6 + attack;

        sig * env * amp
    });

//
// # Usage: `rhodes_bright`
//
// ```rhai
// import "stdlib/keys/rhodes_bright.vibe" as rhodes_bright;
//
// let rhodes_bright = voice("doc_rhodes_bright")
//     .synth("rhodes_bright")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// rhodes_bright.output("out").to_main();
// rhodes_bright.run();
// ```
