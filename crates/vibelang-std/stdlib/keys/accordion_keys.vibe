// Folk instrument | Character: Reedy, bright
define_synthdef("accordion_keys")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.05, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Reed vibration
        let tremolo = sin_osc_ar(6.0) * 0.15 + 1.0;

        // Detuned reeds
        let reed1 = saw_ar(freq * 0.998) * 0.35;
        let reed2 = saw_ar(freq * 1.002) * 0.35;

        let mix = (reed1 + reed2) * tremolo;

        // Reedy character
        let filtered = bpf_ar(mix, 1500.0, 0.4) + mix * 0.4;

        filtered * env * amp
    });

//
// # Usage: `accordion_keys`
//
// ```rhai
// import "stdlib/keys/accordion_keys.vibe" as accordion_keys;
//
// let accordion_keys = voice("doc_accordion_keys")
//     .synth("accordion_keys")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// accordion_keys.output("out").to_main();
// accordion_keys.run();
// ```
