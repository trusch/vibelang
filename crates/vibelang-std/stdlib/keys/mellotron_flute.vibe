// Sampler-style | Character: Classic mellotron flute sound
define_synthdef("mellotron_flute")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Tape warble
        let warble = sin_osc_ar(3.5) * freq * 0.004;

        // Flute-like tone
        let pure = sin_osc_ar(freq + warble) * 0.5;
        let breath = bpf_ar(pink_noise_ar(), freq * 2.0, 0.2) * 0.15;
        let second_harmonic = sin_osc_ar(freq * 2.0 + warble) * 0.15;

        let sig = pure + breath + second_harmonic;

        // Tape character - slight filtering
        let filtered = lpf_ar(sig, 4000.0);

        filtered * env * amp
    });

//
// # Usage: `mellotron_flute`
//
// ```rhai
// import "stdlib/keys/mellotron_flute.vibe" as mellotron_flute;
//
// let mellotron_flute = voice("doc_mellotron_flute")
//     .synth("mellotron_flute")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// mellotron_flute.output("out").to_main();
// mellotron_flute.run();
// ```
