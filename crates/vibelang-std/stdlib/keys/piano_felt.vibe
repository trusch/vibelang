// Genre: Ambient, Cinematic | Character: Felt piano - soft and muted
define_synthdef("piano_felt")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.01, 1.0, 0.3)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Piano-like harmonics
        let h1 = sin_osc_ar(freq) * 0.5;
        let h2 = sin_osc_ar(freq * 2.0) * 0.15;
        let h3 = sin_osc_ar(freq * 3.0) * 0.08;

        // Soft hammer attack
        let attack = envelope()
            .perc(0.005, 0.03)
            .build();
        let hammer = lpf_ar(white_noise_ar(), 800.0) * attack * 0.1;

        let mix = h1 + h2 + h3 + hammer;

        // Heavy felt damping
        lpf_ar(mix, 1500.0) * env * amp
    });

//
// # Usage: `piano_felt`
//
// ```rhai
// import "stdlib/keys/piano_felt.vibe" as piano_felt;
//
// let piano_felt = voice("doc_piano_felt")
//     .synth("piano_felt")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// piano_felt.output("out").to_main();
// piano_felt.run();
// ```
