// Genre: Progressive Rock, Psychedelic | Character: Mellotron string sound
define_synthdef("mellotron_strings")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Slightly detuned for tape character
        let wow = sin_osc_ar(0.5) * freq * 0.004;

        let osc1 = saw_ar(freq + wow) * 0.3;
        let osc2 = saw_ar(freq * 1.002) * 0.25;
        let osc3 = saw_ar(freq * 0.998 + wow * 0.5) * 0.25;

        let mix = osc1 + osc2 + osc3;

        // Tape-like filtering
        let filtered = lpf_ar(mix, 3500.0);

        // Add noise for tape hiss
        let hiss = hpf_ar(white_noise_ar(), 6000.0) * 0.02;

        (filtered + hiss) * env * amp
    });

//
// # Usage: `mellotron_strings`
//
// ```rhai
// import "stdlib/keys/mellotron_strings.vibe" as mellotron_strings;
//
// let mellotron_strings = voice("doc_mellotron_strings")
//     .synth("mellotron_strings")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// mellotron_strings.output("out").to_main();
// mellotron_strings.run();
// ```
