// Genre: Lo-fi, Indie | Character: Toy piano - bright and metallic
define_synthdef("piano_toy")
    .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Short, metallic decay
        let amp_env = envelope()
            .perc(0.001, 0.4)
            .cleanup_on_finish()
            .build();

        // Metallic harmonics
        let h1 = sin_osc_ar(freq) * 0.4;
        let h2 = sin_osc_ar(freq * 2.0) * 0.3;
        let h3 = sin_osc_ar(freq * 2.8) * 0.2;
        let h4 = sin_osc_ar(freq * 4.2) * 0.12;

        // Hammer click
        let click = envelope()
            .perc(0.0001, 0.008)
            .build();
        let hammer = hpf_ar(white_noise_ar(), 4000.0) * click * 0.15;

        let sig = h1 + h2 + h3 + h4 + hammer;

        sig * amp_env * amp
    });

//
// # Usage: `piano_toy`
//
// ```rhai
// import "stdlib/keys/piano_toy.vibe" as piano_toy;
//
// let piano_toy = voice("doc_piano_toy")
//     .synth("piano_toy")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// piano_toy.output("out").to_main();
// piano_toy.run();
// ```
