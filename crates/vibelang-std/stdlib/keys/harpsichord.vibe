// Baroque keyboard | Character: Plucked string, bright
define_synthdef("harpsichord")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.05)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Pluck attack
        let pluck_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let attack = hpf_ar(white_noise_ar(), 3000.0) * pluck_env * 0.4;

        // Bright string resonance
        let str1 = pulse_ar(freq, 0.5) * 0.35;
        let str2 = pulse_ar(freq * 2.0, 0.5) * 0.2;
        let str3 = sin_osc_ar(freq * 3.0) * 0.1;

        let sig = str1 + str2 + str3 + attack;

        // Bright character
        let filtered = hpf_ar(sig, 300.0);

        filtered * env * amp
    });

//
// # Usage: `harpsichord`
//
// ```rhai
// import "stdlib/keys/harpsichord.vibe" as harpsichord;
//
// let harpsichord = voice("doc_harpsichord")
//     .synth("harpsichord")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// harpsichord.output("out").to_main();
// harpsichord.run();
// ```
