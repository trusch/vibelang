// Genre: Jazz, Neo-Soul | Character: Dark, mellow Rhodes
define_synthdef("rhodes_dark")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.008, 1.0, 0.25)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Less FM for darker tone
        let mod_env = envelope()
            .perc(0.001, 0.4)
            .build();

        let mod_index = 1.0 + mod_env * 2.0;
        let modulator = sin_osc_ar(freq * 2.0) * mod_index * freq;
        let carrier = sin_osc_ar(freq + modulator);

        // Warmer filtering
        let sig = lpf_ar(carrier, 2500.0);

        sig * env * amp
    });

//
// # Usage: `rhodes_dark`
//
// ```rhai
// import "stdlib/keys/rhodes_dark.vibe" as rhodes_dark;
//
// let rhodes_dark = voice("doc_rhodes_dark")
//     .synth("rhodes_dark")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// rhodes_dark.output("out").to_main();
// rhodes_dark.run();
// ```
