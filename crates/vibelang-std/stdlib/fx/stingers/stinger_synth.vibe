// Genre: EDM, Electronic | Character: Synth stab stinger
define_synthdef("stinger_synth", |builder| {
    builder
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("note", 60.0) // units: MIDI note, range: 0..127, default: 60.0. MIDI note value; higher values output a higher pitch.
        .body(|amp, note| {
            let env = envelope()
                .perc(0.001, 0.3)
                .cleanup_on_finish()
                .build();

            let freq = 440.0 * (2.0.pow((note - 69.0) / 12.0));

            // Punchy synth
            let osc1 = saw_ar(freq);
            let osc2 = pulse_ar(freq, 0.5) * 0.6;
            let osc3 = saw_ar(freq * 2.0) * 0.3;

            let combined = osc1 + osc2 + osc3;

            // Snappy filter
            let filter_e = envelope()
                .perc(0.001, 0.1)
                .build();
            let cutoff = 800.0 + filter_e * 4000.0;
            let filtered = rlpf_ar(combined, cutoff, 0.3);

            filtered * env * amp * 0.5
        })
});

//
// # Usage: stinger_synth
//
// ```rhai
// import "stdlib/fx/stingers/stinger_synth.vibe" as stinger_synth;
//
// let doc_stinger_synth = voice("doc_stinger_synth")
//     .synth("stinger_synth")
//     .set_param("amp", 0.7)
//     .set_param("note", 60.0)
//     ;
// doc_stinger_synth.output("out").to_main();
// doc_stinger_synth.run();
// ```
