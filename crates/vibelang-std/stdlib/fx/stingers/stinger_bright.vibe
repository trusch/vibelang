// Genre: Pop, Commercial | Character: Bright positive stinger
define_synthdef("stinger_bright", |builder| {
    builder
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("note", 72.0) // units: MIDI note, range: 0..127, default: 72.0. MIDI note value; higher values output a higher pitch.
        .body(|amp, note| {
            let env = envelope()
                .perc(0.001, 0.5)
                .cleanup_on_finish()
                .build();

            let freq = 440.0 * (2.0.pow((note - 69.0) / 12.0));

            // Bright bell-like tone
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.6;
            let h3 = sin_osc_ar(freq * 3.0) * 0.4;
            let h4 = sin_osc_ar(freq * 4.0) * 0.25;
            let h5 = sin_osc_ar(freq * 5.0) * 0.15;

            let bell = h1 + h2 + h3 + h4 + h5;

            // Add shimmer
            let shimmer = sin_osc_ar(freq * 6.0) * 0.1;
            let shimmer_mod = shimmer * sin_osc_ar(10.0);

            let mix = bell + shimmer_mod;

            mix * env * amp * 0.4
        })
});

//
// # Usage: stinger_bright
//
// ```rhai
// import "stdlib/fx/stingers/stinger_bright.vibe" as stinger_bright;
//
// let doc_stinger_bright = voice("doc_stinger_bright")
//     .synth("stinger_bright")
//     .set_param("amp", 0.6)
//     .set_param("note", 72.0)
//     ;
// doc_stinger_bright.output("out").to_main();
// doc_stinger_bright.run();
// ```
