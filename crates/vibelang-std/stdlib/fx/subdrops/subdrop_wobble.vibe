// Genre: Dubstep, Bass Music | Character: Wobbling sub drop
define_synthdef("subdrop_wobble", |builder| {
    builder
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .body(|amp| {
            let env = envelope()
                .perc(0.001, 1.5)
                .cleanup_on_finish()
                .build();

            // Pitch drop
            let pitch_e = envelope()
                .perc(0.001, 0.2)
                .build();
            let freq = 100.0 - pitch_e * 60.0;

            // Main sub with wobble
            let wobble_speed = 6.0 + (1.0 - env) * 10.0;  // Speeds up as it decays
            let wobble = sin_osc_ar(wobble_speed) * 0.5 + 0.5;
            let sub = sin_osc_ar(freq) * wobble;

            // Second harmonic wobbling
            let h2 = sin_osc_ar(freq * 2.0) * wobble * 0.3;

            // Click transient
            let click = white_noise_ar();
            let click_e = envelope()
                .perc(0.001, 0.01)
                .build();

            let mix = sub + h2 + click * click_e * 0.2;

            mix * env * amp * 0.7
        })
});

//
// # Usage: subdrop_wobble
//
// ```rhai
// import "stdlib/fx/subdrops/subdrop_wobble.vibe" as subdrop_wobble;
//
// let doc_subdrop_wobble = voice("doc_subdrop_wobble")
//     .synth("subdrop_wobble")
//     .set_param("amp", 0.8)
//     ;
// doc_subdrop_wobble.output("out").to_main();
// doc_subdrop_wobble.run();
// ```
