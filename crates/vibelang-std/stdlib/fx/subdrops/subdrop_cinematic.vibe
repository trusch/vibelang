// Genre: Trailer, Film | Character: Cinematic sub boom
define_synthdef("subdrop_cinematic", |builder| {
    builder
        .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
        .body(|amp| {
            let env = envelope()
                .perc(0.02, 3.0)
                .cleanup_on_finish()
                .build();

            // Deep sub with slow pitch descent
            let pitch_e = envelope()
                .perc(0.02, 2.0)
                .build();
            let freq = 50.0 - pitch_e * 20.0;
            let sub = sin_osc_ar(freq);

            // Second sub layer
            let sub2 = sin_osc_ar(freq * 0.5) * 0.5;

            // Mid-range punch
            let punch = sin_osc_ar(100.0) + sin_osc_ar(150.0) * 0.5;
            let punch_e = envelope()
                .perc(0.01, 0.5)
                .build();
            let punch_filtered = lpf_ar(punch, 300.0) * punch_e * 0.3;

            // Reverberant tail simulation
            let tail = sin_osc_ar(40.0) * env * 0.4;

            let mix = sub * 0.6 + sub2 + punch_filtered + tail;

            mix * env * amp * 0.6
        })
});

//
// # Usage: subdrop_cinematic
//
// ```rhai
// import "stdlib/fx/subdrops/subdrop_cinematic.vibe" as subdrop_cinematic;
//
// let doc_subdrop_cinematic = voice("doc_subdrop_cinematic")
//     .synth("subdrop_cinematic")
//     .set_param("amp", 0.9)
//     ;
// doc_subdrop_cinematic.output("out").to_main();
// doc_subdrop_cinematic.run();
// ```
