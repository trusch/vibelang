// Genre: Techno, Minimal | Character: Tight controlled sub
define_synthdef("subdrop_tight", |builder| {
    builder
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .body(|amp| {
            let env = envelope()
                .perc(0.001, 0.6)
                .cleanup_on_finish()
                .build();

            // Fast pitch drop
            let pitch_e = envelope()
                .perc(0.001, 0.1)
                .build();
            let freq = 80.0 - pitch_e * 40.0;

            // Clean sine sub
            let sub = sin_osc_ar(freq);

            // Subtle click
            let click = white_noise_ar();
            let click_e = envelope()
                .perc(0.001, 0.005)
                .build();
            let click_filtered = lpf_ar(click, 8000.0) * click_e * 0.15;

            (sub + click_filtered) * env * amp * 0.8
        })
});

//
// # Usage: subdrop_tight
//
// ```rhai
// import "stdlib/fx/subdrops/subdrop_tight.vibe" as subdrop_tight;
//
// let doc_subdrop_tight = voice("doc_subdrop_tight")
//     .synth("subdrop_tight")
//     .set_param("amp", 0.8)
//     ;
// doc_subdrop_tight.output("out").to_main();
// doc_subdrop_tight.run();
// ```
