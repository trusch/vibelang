// Genre: Brostep, Heavy Dubstep | Character: Distorted sub drop with grit
define_synthdef("subdrop_distorted", |builder| {
    builder
        .param("freq", 45.0) // units: Hz, range: 20..20000, default: 45.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Envelope
            let env = envelope()
                .perc(0.008, 0.9)
                .cleanup_on_finish()
                .build();

            // Pitch drop
            let pitch_env = envelope()
                .perc(0.008, 0.18)
                .build();
            let freq_mod = pitch_env * freq * 4.5;

            // Sub with distortion
            let sub = sin_osc_ar(freq + freq_mod) * 1.8;
            let driven = clip(sub, -0.9, 0.9);

            driven * env * amp
        })
});

//
// # Usage: subdrop_distorted
//
// ```rhai
// import "stdlib/fx/subdrops/subdrop_distorted.vibe" as subdrop_distorted;
//
// let doc_subdrop_distorted = voice("doc_subdrop_distorted")
//     .synth("subdrop_distorted")
//     .set_param("freq", 45.0)
//     .set_param("amp", 0.9)
//     ;
// doc_subdrop_distorted.output("out").to_main();
// doc_subdrop_distorted.run();
// ```
