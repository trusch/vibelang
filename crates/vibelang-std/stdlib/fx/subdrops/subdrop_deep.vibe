// Genre: Deep Dubstep | Character: Very deep, chest-hitting sub drop
define_synthdef("subdrop_deep", |builder| {
    builder
        .param("freq", 35.0) // units: Hz, range: 20..20000, default: 35.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Longer decay for depth
            let env = envelope()
                .perc(0.015, 1.2)
                .cleanup_on_finish()
                .build();

            // Extended pitch drop
            let pitch_env = envelope()
                .perc(0.015, 0.25)
                .build();
            let freq_mod = pitch_env * freq * 5.0;

            // Pure sine for maximum sub
            let sub = sin_osc_ar(freq + freq_mod);

            sub * env * amp
        })
});

//
// # Usage: subdrop_deep
//
// ```rhai
// import "stdlib/fx/subdrops/subdrop_deep.vibe" as subdrop_deep;
//
// let doc_subdrop_deep = voice("doc_subdrop_deep")
//     .synth("subdrop_deep")
//     .set_param("freq", 35.0)
//     .set_param("amp", 1.0)
//     ;
// doc_subdrop_deep.output("out").to_main();
// doc_subdrop_deep.run();
// ```
