// Genre: Dubstep, EDM | Character: Bass drop impact
define_synthdef("impact_bass_drop", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            let env = envelope()
                .perc(0.001, 1.5)
                .cleanup_on_finish()
                .build();

            // Pitch-dropping sine
            let pitch_e = envelope()
                .perc(0.001, 0.3)
                .build();
            let freq = 200.0 - pitch_e * 160.0;
            let drop = sin_osc_ar(freq);

            // Sub layer
            let sub_e = envelope()
                .perc(0.01, 1.2)
                .build();
            let sub = sin_osc_ar(35.0) * sub_e * 0.8;

            // Distorted layer for aggression
            let dist = (drop * 4.0).tanh() * 0.4;

            // Click transient
            let click = white_noise_ar();
            let click_e = envelope()
                .perc(0.001, 0.02)
                .build();
            let click_filtered = lpf_ar(click, 5000.0) * click_e * 0.3;

            let mix = drop * env * 0.5 + sub + dist * env + click_filtered;

            mix * amp * 0.6
        })
});

//
// # Usage: impact_bass_drop
//
// ```rhai
// import "stdlib/fx/impacts/impact_bass_drop.vibe" as impact_bass_drop;
//
// let doc_impact_bass_drop = voice("doc_impact_bass_drop")
//     .synth("impact_bass_drop")
//     .set_param("amp", 1.0)
//     ;
// doc_impact_bass_drop.output("out").to_main();
// doc_impact_bass_drop.run();
// ```
