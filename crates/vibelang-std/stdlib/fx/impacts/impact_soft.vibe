// Genre: Ambient, Cinematic | Character: Soft, subtle impact
define_synthdef("impact_soft", |builder| {
    builder
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .body(|amp| {
            // Gentle envelope
            let env = envelope()
                .perc(0.005, 1.2)
                .cleanup_on_finish()
                .build();

            // Low frequency body
            let sub = sin_osc_ar(80.0) * 0.5;

            // Filtered noise
            let noise = pink_noise_ar();
            let filtered_noise = lpf_ar(noise, 1500.0) * 0.3;

            // Warm tone
            let tone = sin_osc_ar(150.0) * 0.2;

            let mix = sub + filtered_noise + tone;

            mix * env * amp
        })
});

//
// # Usage: impact_soft
//
// ```rhai
// import "stdlib/fx/impacts/impact_soft.vibe" as impact_soft;
//
// let doc_impact_soft = voice("doc_impact_soft")
//     .synth("impact_soft")
//     .set_param("amp", 0.8)
//     ;
// doc_impact_soft.output("out").to_main();
// doc_impact_soft.run();
// ```
