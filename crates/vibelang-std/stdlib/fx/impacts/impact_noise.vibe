// Genre: All | Character: Noise-based impact, versatile
define_synthdef("impact_noise", |builder| {
    builder
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .body(|amp| {
            // Quick decay
            let env = envelope()
                .perc(0.002, 0.6)
                .cleanup_on_finish()
                .build();

            // Layered noise for fullness
            let low_noise = lpf_ar(pink_noise_ar(), 800.0) * 0.5;
            let mid_noise = rlpf_ar(white_noise_ar(), 2500.0, 0.5) * 0.3;
            let high_noise = hpf_ar(white_noise_ar(), 4000.0) * 0.2;

            let mix = low_noise + mid_noise + high_noise;

            mix * env * amp
        })
});

//
// # Usage: impact_noise
//
// ```rhai
// import "stdlib/fx/impacts/impact_noise.vibe" as impact_noise;
//
// let doc_impact_noise = voice("doc_impact_noise")
//     .synth("impact_noise")
//     .set_param("amp", 0.8)
//     ;
// doc_impact_noise.output("out").to_main();
// doc_impact_noise.run();
// ```
