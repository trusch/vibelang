// Genre: EDM, Cinematic | Character: Hard, aggressive impact
define_synthdef("impact_hard", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Quick attack, medium decay
            let env = envelope()
                .perc(0.001, 0.8)
                .cleanup_on_finish()
                .build();

            // Low frequency punch
            let sub = sin_osc_ar(50.0) * 0.6;

            // Noise component for impact
            let noise = white_noise_ar();
            let filtered_noise = lpf_ar(noise, 2000.0) * 0.4;

            // Metallic component
            let metal = (sin_osc_ar(180.0) + sin_osc_ar(320.0) + sin_osc_ar(580.0)) * 0.2;

            let mix = sub + filtered_noise + metal;

            mix * env * amp
        })
});

//
// # Usage: impact_hard
//
// ```rhai
// import "stdlib/fx/impacts/impact_hard.vibe" as impact_hard;
//
// let doc_impact_hard = voice("doc_impact_hard")
//     .synth("impact_hard")
//     .set_param("amp", 1.0)
//     ;
// doc_impact_hard.output("out").to_main();
// doc_impact_hard.run();
// ```
