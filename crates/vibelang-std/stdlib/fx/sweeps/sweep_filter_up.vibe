// Genre: House, Techno | Character: Upward filter sweep
define_synthdef("sweep_filter_up", |builder| {
    builder
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .body(|amp| {
            // Sweep envelope
            let env = envelope()
                .perc(0.01, 2.0)
                .cleanup_on_finish()
                .build();

            // White noise source
            let noise = white_noise_ar();

            // Upward filter sweep
            let filter_env = envelope()
                .perc(0.05, 1.8)
                .build();
            let mod_cutoff = 200.0 + (filter_env * 8000.0);

            let filtered = rlpf_ar(noise, mod_cutoff, 0.25);

            filtered * env * amp
        })
});

//
// # Usage: sweep_filter_up
//
// ```rhai
// import "stdlib/fx/sweeps/sweep_filter_up.vibe" as sweep_filter_up;
//
// let doc_sweep_filter_up = voice("doc_sweep_filter_up")
//     .synth("sweep_filter_up")
//     .set_param("amp", 0.6)
//     ;
// doc_sweep_filter_up.output("out").to_main();
// doc_sweep_filter_up.run();
// ```
