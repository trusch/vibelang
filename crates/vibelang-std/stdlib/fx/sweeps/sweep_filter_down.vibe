// Genre: House, Techno | Character: Downward filter sweep
define_synthdef("sweep_filter_down", |builder| {
    builder
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .body(|amp| {
            // Sweep envelope
            let env = envelope()
                .perc(0.01, 2.0)
                .cleanup_on_finish()
                .build();

            // White noise source
            let noise = white_noise_ar();

            // Downward filter sweep (inverted envelope)
            let filter_env = envelope()
                .perc(0.01, 0.2)
                .build();
            let mod_cutoff = 8000.0 - (filter_env * 7000.0);

            let filtered = rlpf_ar(noise, mod_cutoff, 0.3);

            filtered * env * amp
        })
});

//
// # Usage: sweep_filter_down
//
// ```rhai
// import "stdlib/fx/sweeps/sweep_filter_down.vibe" as sweep_filter_down;
//
// let doc_sweep_filter_down = voice("doc_sweep_filter_down")
//     .synth("sweep_filter_down")
//     .set_param("amp", 0.6)
//     ;
// doc_sweep_filter_down.output("out").to_main();
// doc_sweep_filter_down.run();
// ```
