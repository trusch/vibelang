// Genre: Cinematic, Trailer | Character: Epic cinematic sweep
define_synthdef("sweep_cinematic", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("duration", 3.0) // units: seconds, range: 0..60, default: 3.0. Sound duration in seconds; higher values make the voice or effect last longer.
        .body(|amp, duration| {
            let env = envelope()
                .perc(0.3, 1.0)
                .time_scale(duration)
                .cleanup_on_finish()
                .build();

            // Rising strings-like layer
            let string_freq = 200.0 + env * 600.0;
            let strings = sin_osc_ar(string_freq) + sin_osc_ar(string_freq * 2.0) * 0.5;

            // Brass swell
            let brass_freq = 100.0 + env * 200.0;
            let brass = saw_ar(brass_freq) * 0.3;
            let brass_filtered = lpf_ar(brass, 600.0 + env * 1500.0);

            // Wind/air texture
            let wind = pink_noise_ar();
            let wind_filtered = lpf_ar(hpf_ar(wind, 500.0 + env * 2000.0), 4000.0 + env * 6000.0);

            let mix = strings * 0.3 + brass_filtered + wind_filtered * 0.4;

            mix * env * amp
        })
});

//
// # Usage: sweep_cinematic
//
// ```rhai
// import "stdlib/fx/sweeps/sweep_cinematic.vibe" as sweep_cinematic;
//
// let doc_sweep_cinematic = voice("doc_sweep_cinematic")
//     .synth("sweep_cinematic")
//     .set_param("amp", 0.5)
//     .set_param("duration", 3.0)
//     ;
// doc_sweep_cinematic.output("out").to_main();
// doc_sweep_cinematic.run();
// ```
