// Genre: Cinematic, Trailer | Character: Whoosh/wind sweep
define_synthdef("sweep_whoosh", |builder| {
    builder
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .body(|amp| {
            // Quick whoosh envelope
            let env = envelope()
                .perc(0.005, 0.8)
                .cleanup_on_finish()
                .build();

            // Pink noise for natural wind character
            let noise = pink_noise_ar();

            // Fast filter sweep for whoosh
            let filter_env = envelope()
                .perc(0.01, 0.6)
                .build();
            let mod_cutoff = 500.0 + (filter_env * 6000.0);

            let filtered = rlpf_ar(noise, mod_cutoff, 0.4);

            // High-pass for air
            let clean = hpf_ar(filtered, 200.0);

            clean * env * amp
        })
});

//
// # Usage: sweep_whoosh
//
// ```rhai
// import "stdlib/fx/sweeps/sweep_whoosh.vibe" as sweep_whoosh;
//
// let doc_sweep_whoosh = voice("doc_sweep_whoosh")
//     .synth("sweep_whoosh")
//     .set_param("amp", 0.7)
//     ;
// doc_sweep_whoosh.output("out").to_main();
// doc_sweep_whoosh.run();
// ```
