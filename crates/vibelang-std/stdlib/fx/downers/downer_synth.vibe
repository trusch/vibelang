// Genre: Trance, Progressive | Character: Synth-based downlifter
define_synthdef("downer_synth", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("duration", 3.0) // units: seconds, range: 0..60, default: 3.0. Sound duration in seconds; higher values make the voice or effect last longer.
        .body(|amp, duration| {
            let env = envelope()
                .perc(0.1, 1.0)
                .time_scale(duration)
                .cleanup_on_finish()
                .build();

            let down_env = 1.0 - env;

            // Falling supersaw
            let freq = 100.0 + down_env * 600.0;
            let saw1 = saw_ar(freq);
            let saw2 = saw_ar(freq * 1.005);
            let saw3 = saw_ar(freq * 0.995);
            let saw4 = saw_ar(freq * 1.01);
            let saw5 = saw_ar(freq * 0.99);

            let supersaw = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.15;

            // Closing filter
            let cutoff = 500.0 + down_env * 6000.0;
            let filtered = rlpf_ar(supersaw, cutoff, 0.4);

            filtered * env * amp
        })
});

//
// # Usage: downer_synth
//
// ```rhai
// import "stdlib/fx/downers/downer_synth.vibe" as downer_synth;
//
// let doc_downer_synth = voice("doc_downer_synth")
//     .synth("downer_synth")
//     .set_param("amp", 0.5)
//     .set_param("duration", 3.0)
//     ;
// doc_downer_synth.output("out").to_main();
// doc_downer_synth.run();
// ```
