// Genre: House, Techno | Character: Resonant filter downlifter
define_synthdef("downer_filtered", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("duration", 2.5) // units: seconds, range: 0..60, default: 2.5. Sound duration in seconds; higher values make the voice or effect last longer.
        .body(|amp, duration| {
            let env = envelope()
                .perc(0.05, 1.0)
                .time_scale(duration)
                .cleanup_on_finish()
                .build();

            let down_env = 1.0 - env;

            // Rich source
            let source = saw_ar(100.0) + pulse_ar(100.0, 0.3) * 0.5;

            // Highly resonant falling filter
            let cutoff = 300.0 + down_env * 8000.0;
            let filtered = rlpf_ar(source, cutoff, 0.15);

            // Second resonant peak
            let peak2 = rlpf_ar(source, cutoff * 0.5, 0.2) * 0.4;

            (filtered + peak2) * env * amp * 0.7
        })
});

//
// # Usage: downer_filtered
//
// ```rhai
// import "stdlib/fx/downers/downer_filtered.vibe" as downer_filtered;
//
// let doc_downer_filtered = voice("doc_downer_filtered")
//     .synth("downer_filtered")
//     .set_param("amp", 0.5)
//     .set_param("duration", 2.5)
//     ;
// doc_downer_filtered.output("out").to_main();
// doc_downer_filtered.run();
// ```
