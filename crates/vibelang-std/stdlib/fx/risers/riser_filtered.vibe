// Genre: Techno, Trance | Character: Resonant filtered riser
define_synthdef("riser_filtered", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .body(|amp| {
            // Rise envelope
            let env = envelope()
                .perc(0.02, 2.8)
                .cleanup_on_finish()
                .build();

            // White noise
            let noise = white_noise_ar();

            // Aggressive filter sweep with high resonance
            let filter_env = envelope()
                .perc(0.4, 2.6)
                .build();
            let mod_cutoff = 300.0 + (filter_env * 10000.0);

            let filtered = rlpf_ar(noise, mod_cutoff, 0.15);

            filtered * env * amp
        })
});

//
// # Usage: riser_filtered
//
// ```rhai
// import "stdlib/fx/risers/riser_filtered.vibe" as riser_filtered;
//
// let doc_riser_filtered = voice("doc_riser_filtered")
//     .synth("riser_filtered")
//     .set_param("amp", 0.5)
//     ;
// doc_riser_filtered.output("out").to_main();
// doc_riser_filtered.run();
// ```
