// Genre: Experimental, IDM | Character: Reverse-style riser effect
define_synthdef("riser_reverse", |builder| {
    builder
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .body(|amp| {
            // Reverse envelope (starts high, fades slightly, then rises)
            let env = envelope()
                .perc(1.5, 2.0)
                .cleanup_on_finish()
                .build();

            // Pink noise
            let noise = pink_noise_ar();

            // Filter sweeps backwards then forwards
            let filter_env = envelope()
                .perc(1.2, 1.8)
                .build();
            let mod_cutoff = 5000.0 + (filter_env * 5000.0);

            let filtered = lpf_ar(noise, mod_cutoff);

            // Resonance
            let resonant = rlpf_ar(filtered, mod_cutoff * 0.7, 0.4);

            resonant * env * amp
        })
});

//
// # Usage: riser_reverse
//
// ```rhai
// import "stdlib/fx/risers/riser_reverse.vibe" as riser_reverse;
//
// let doc_riser_reverse = voice("doc_riser_reverse")
//     .synth("riser_reverse")
//     .set_param("amp", 0.6)
//     ;
// doc_riser_reverse.output("out").to_main();
// doc_riser_reverse.run();
// ```
