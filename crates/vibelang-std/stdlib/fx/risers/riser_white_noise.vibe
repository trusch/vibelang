// Genre: EDM, Trap | Character: White noise riser with filter sweep
define_synthdef("riser_white_noise", |builder| {
    builder
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .body(|amp| {
            // Long rise envelope
            let env = envelope()
                .perc(0.01, 3.0)
                .cleanup_on_finish()
                .build();

            // White noise source
            let noise = white_noise_ar();

            // Rising filter sweep
            let filter_env = envelope()
                .perc(0.5, 2.8)
                .build();
            let mod_cutoff = 200.0 + (filter_env * 8000.0);

            let filtered = lpf_ar(noise, mod_cutoff);

            // Resonance for emphasis
            let resonant = rlpf_ar(filtered, mod_cutoff * 0.8, 0.3);

            resonant * env * amp
        })
});

//
// # Usage: riser_white_noise
//
// ```rhai
// import "stdlib/fx/risers/riser_white_noise.vibe" as riser_white_noise;
//
// let doc_riser_white_noise = voice("doc_riser_white_noise")
//     .synth("riser_white_noise")
//     .set_param("amp", 0.6)
//     ;
// doc_riser_white_noise.output("out").to_main();
// doc_riser_white_noise.run();
// ```
