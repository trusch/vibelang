// Genre: Cinematic, EDM | Character: Building tension riser
define_synthdef("riser_tension", |builder| {
    builder
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("duration", 4.0) // units: seconds, range: 0..60, default: 4.0. Sound duration in seconds; higher values make the voice or effect last longer.
        .body(|amp, duration| {
            // Main envelope
            let env = envelope()
                .perc(0.01, 1.0)
                .time_scale(duration)
                .cleanup_on_finish()
                .build();

            // Multiple detuned oscillators for tension
            let freq_env = env * env * 400.0 + 60.0;  // Accelerating pitch rise
            let osc1 = sin_osc_ar(freq_env);
            let osc2 = sin_osc_ar(freq_env * 1.01);
            let osc3 = sin_osc_ar(freq_env * 0.99);
            let osc4 = saw_ar(freq_env * 2.0) * 0.3;

            let combined = (osc1 + osc2 + osc3) * 0.3 + osc4;

            // Rising noise layer
            let noise = white_noise_ar() * env * 0.3;
            let filtered_noise = hpf_ar(noise, 2000.0 + env * 6000.0);

            // Combine
            let mix = combined + filtered_noise;

            // Add resonant peak for drama
            let resonant = rlpf_ar(mix, 1000.0 + env * 4000.0, 0.2);

            resonant * env * amp * 0.6
        })
});

//
// # Usage: riser_tension
//
// ```rhai
// import "stdlib/fx/risers/riser_tension.vibe" as riser_tension;
//
// let doc_riser_tension = voice("doc_riser_tension")
//     .synth("riser_tension")
//     .set_param("amp", 0.6)
//     .set_param("duration", 4.0)
//     ;
// doc_riser_tension.output("out").to_main();
// doc_riser_tension.run();
// ```
