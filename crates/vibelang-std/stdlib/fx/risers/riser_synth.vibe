// Genre: Trance, Progressive | Character: Synth-based melodic riser
define_synthdef("riser_synth", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("duration", 4.0) // units: seconds, range: 0..60, default: 4.0. Sound duration in seconds; higher values make the voice or effect last longer.
        .body(|amp, duration| {
            let env = envelope()
                .perc(0.1, 1.0)
                .time_scale(duration)
                .cleanup_on_finish()
                .build();

            // Rising pitch from low to high
            let pitch = 80.0 + env * 800.0;

            // Supersaw-style riser
            let saw1 = saw_ar(pitch);
            let saw2 = saw_ar(pitch * 1.005);
            let saw3 = saw_ar(pitch * 0.995);
            let saw4 = saw_ar(pitch * 1.01);
            let saw5 = saw_ar(pitch * 0.99);

            let supersaw = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.15;

            // Filter opening with rise
            let cutoff = 500.0 + env * 8000.0;
            let filtered = rlpf_ar(supersaw, cutoff, 0.4);

            // Add shimmer
            let shimmer = sin_osc_ar(pitch * 4.0) * env * 0.1;

            (filtered + shimmer) * env * amp
        })
});

//
// # Usage: riser_synth
//
// ```rhai
// import "stdlib/fx/risers/riser_synth.vibe" as riser_synth;
//
// let doc_riser_synth = voice("doc_riser_synth")
//     .synth("riser_synth")
//     .set_param("amp", 0.5)
//     .set_param("duration", 4.0)
//     ;
// doc_riser_synth.output("out").to_main();
// doc_riser_synth.run();
// ```
