// Genre: All genres | Character: Fast whoosh transition
define_synthdef("whoosh_fast", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .body(|amp| {
            let env = envelope()
                .perc(0.01, 0.3)
                .cleanup_on_finish()
                .build();

            // Fast filter sweep on noise
            let noise = white_noise_ar();

            // Sweep from high to low quickly
            let sweep_e = envelope()
                .perc(0.01, 0.25)
                .build();
            let cutoff = 500.0 + sweep_e * 10000.0;

            let filtered = lpf_ar(noise, cutoff);

            // Add resonance at sweep point
            let res = rlpf_ar(noise, cutoff * 0.8, 0.2) * 0.4;

            (filtered + res) * env * amp * 0.7
        })
});

//
// # Usage: whoosh_fast
//
// ```rhai
// import "stdlib/fx/transitions/whoosh_fast.vibe" as whoosh_fast;
//
// let doc_whoosh_fast = voice("doc_whoosh_fast")
//     .synth("whoosh_fast")
//     .set_param("amp", 0.5)
//     ;
// doc_whoosh_fast.output("out").to_main();
// doc_whoosh_fast.run();
// ```
