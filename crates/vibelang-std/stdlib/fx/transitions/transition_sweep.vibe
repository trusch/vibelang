// Genre: EDM, House | Character: Tonal transition sweep
define_synthdef("transition_sweep", |builder| {
    builder
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("duration", 1.0) // units: seconds, range: 0..60, default: 1.0. Sound duration in seconds; higher values make the voice or effect last longer.
        .body(|amp, duration| {
            let env = envelope()
                .perc(0.05, 1.0)
                .time_scale(duration)
                .cleanup_on_finish()
                .build();

            // Pitch sweep
            let sweep = env * (1.0 - env) * 4.0;
            let freq = 200.0 + sweep * 2000.0;

            // Synth tone
            let tone = saw_ar(freq) + saw_ar(freq * 1.01) + saw_ar(freq * 0.99);

            // Filter following pitch
            let filtered = lpf_ar(tone, freq * 3.0) * 0.3;

            // Add noise texture
            let noise = lpf_ar(white_noise_ar(), freq * 2.0) * 0.2;

            (filtered + noise) * env * amp
        })
});

//
// # Usage: transition_sweep
//
// ```rhai
// import "stdlib/fx/transitions/transition_sweep.vibe" as transition_sweep;
//
// let doc_transition_sweep = voice("doc_transition_sweep")
//     .synth("transition_sweep")
//     .set_param("amp", 0.5)
//     .set_param("duration", 1.0)
//     ;
// doc_transition_sweep.output("out").to_main();
// doc_transition_sweep.run();
// ```
