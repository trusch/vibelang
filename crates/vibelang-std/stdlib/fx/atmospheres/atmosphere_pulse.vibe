// Genre: Electronic, Techno | Character: Pulsing rhythmic atmosphere
define_synthdef("atmosphere_pulse", |builder| {
    builder
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("rate", 2.0) // units: Hz, range: 0..100, default: 2.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, rate, gate| {
            let env = envelope()
                .asr(0.5, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Pulsing LFO
            let pulse_lfo = sin_osc_ar(rate) * 0.5 + 0.5;

            // Sub pulse
            let sub = sin_osc_ar(50.0) * pulse_lfo * 0.4;

            // Mid-range pulse
            let mid = saw_ar(100.0) + saw_ar(100.5);
            let mid_filtered = lpf_ar(mid, 400.0) * pulse_lfo * 0.2;

            // High shimmer
            let high = hpf_ar(white_noise_ar(), 6000.0) * pulse_lfo * 0.1;

            let mix = sub + mid_filtered + high;

            mix * env * amp
        })
});

//
// # Usage: atmosphere_pulse
//
// ```rhai
// import "stdlib/fx/atmospheres/atmosphere_pulse.vibe" as atmosphere_pulse;
//
// let doc_atmosphere_pulse = voice("doc_atmosphere_pulse")
//     .synth("atmosphere_pulse")
//     .set_param("amp", 0.4)
//     .set_param("rate", 2.0)
//     .set_param("gate", 1.0)
//     ;
// doc_atmosphere_pulse.output("out").to_main();
// doc_atmosphere_pulse.run();
// ```
