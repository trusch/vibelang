// Genre: Dark Ambient, Horror | Character: Dark foreboding atmosphere
define_synthdef("atmosphere_dark", |builder| {
    builder
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|amp, gate| {
            let env = envelope()
                .asr(2.0, 1.0, 2.0)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Deep drone
            let drone_freq = 40.0 + sin_osc_ar(0.05) * 5.0;
            let drone = sin_osc_ar(drone_freq) + sin_osc_ar(drone_freq * 1.5) * 0.4;

            // Distant thunder-like rumble
            let rumble = lpf_ar(pink_noise_ar(), 60.0);
            let rumble_mod = rumble * (sin_osc_ar(0.1) * 0.5 + 0.5);

            // Eerie high frequencies
            let high = sin_osc_ar(2000.0 + sin_osc_ar(0.07) * 300.0) * 0.03;

            // Subtle metallic resonance
            let metal = rlpf_ar(pink_noise_ar(), 800.0, 0.05) * 0.1;

            let mix = drone * 0.3 + rumble_mod * 0.4 + high + metal;

            mix * env * amp
        })
});

//
// # Usage: atmosphere_dark
//
// ```rhai
// import "stdlib/fx/atmospheres/atmosphere_dark.vibe" as atmosphere_dark;
//
// let doc_atmosphere_dark = voice("doc_atmosphere_dark")
//     .synth("atmosphere_dark")
//     .set_param("amp", 0.4)
//     .set_param("gate", 1.0)
//     ;
// doc_atmosphere_dark.output("out").to_main();
// doc_atmosphere_dark.run();
// ```
