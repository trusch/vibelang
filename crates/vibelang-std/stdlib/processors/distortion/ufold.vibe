// kind=processor | category=distortion | flavor=ufold | inputs=in:1 | outputs=out:1 | params=folds,folds_cv,folds_cv_amt,symmetry,symmetry_cv,symmetry_cv_amt,stages,level
//
// Intellijel uFold-inspired DC-coupled mono wavefolder.
// The fold stage wraps peaks back into the -1..1 window instead of clipping.

/// @vibelang-api export=import_callable_internal support=unsupported
fn _ufold_stage(x) {
    1.0 - abs(wrap_ar(x + 1.0, 0.0, 4.0) - 2.0)
}

define_synthdef("ufold")
    .input("in", 1)
    .output("out", 1)
    .param("folds", 0.3) // units: normalized, range: 0..1, default: 0.3. Wavefold amount; higher folds the waveform into brighter harmonics.
    .param("folds_cv", 0.0) // units: normalized, range: 0..1, default: 0.0. Folds CV input; bipolar values modulate the matching panel control.
    .param("folds_cv_amt", 0.0) // units: linear, range: -1..1, default: 0.0. FOLDS CV AMT attenuator; higher makes the matching CV modulation stronger.
    .param("symmetry", 0.0) // units: normalized, range: 0..1, default: 0.0. Wavefold symmetry offset; higher skews folding toward one side of the waveform.
    .param("symmetry_cv", 0.0) // units: normalized, range: 0..1, default: 0.0. Symmetry CV input; bipolar values modulate the matching panel control.
    .param("symmetry_cv_amt", 0.0) // units: linear, range: -1..1, default: 0.0. SYMMETRY CV AMT attenuator; higher makes the matching CV modulation stronger.
    .param("stages", 4.0) // units: selector, range: 0..N, default: 4.0. Selects mode, table, or step count.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body_map(|p| {
        let symmetry = clip(p.symmetry, -1.0, 1.0);
        let symmetry_cv_amt = clip(p.symmetry_cv_amt, 0.0, 1.0);
        let fold_amt = clip(p.folds, 0.0, 1.0);
        let folds_cv_amt = clip(p.folds_cv_amt, 0.0, 1.0);
        let level = clip(p.level, 0.0, 2.0);

        let biased = p.inputs["in"] + symmetry + p.symmetry_cv * symmetry_cv_amt;
        let fold_gain = (1.0 + fold_amt * 4.0 + p.folds_cv * folds_cv_amt * 4.0).max(0.0);
        let driven = biased * fold_gain;

        let folded_1 = _ufold_stage(driven);
        let folded_2 = _ufold_stage(folded_1 * fold_gain);
        let folded_3 = _ufold_stage(folded_2 * fold_gain);
        let folded_4 = _ufold_stage(folded_3 * fold_gain);
        let folded_5 = _ufold_stage(folded_4 * fold_gain);
        let folded_6 = _ufold_stage(folded_5 * fold_gain);

        let stage_count = clip(round(p.stages), 2.0, 6.0);
        let idx = clip(round((stage_count - 2.0) * 0.5), 0.0, 2.0);
        let stage_2 = clip(1.0 - abs(idx - 0.0), 0.0, 1.0);
        let stage_4 = clip(1.0 - abs(idx - 1.0), 0.0, 1.0);
        let stage_6 = clip(1.0 - abs(idx - 2.0), 0.0, 1.0);
        let selected = folded_2 * stage_2 + folded_4 * stage_4 + folded_6 * stage_6;

        [selected * level]
    });

//
// # Usage: `ufold`
//
// ```rhai
// import "stdlib/processors/distortion/ufold.vibe" as ufold;
//
// let ufold = voice("doc_ufold")
//     .synth("ufold")
//     .set_param("level", 0.5)
//     .set_param("folds", 0.6)
//     .set_param("folds_cv", 0.6)
//     .set_param("folds_cv_amt", 0.6);
// ufold.output("out").to_main();
// ufold.run();
// ```
