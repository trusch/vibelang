// kind=processor | category=filters | flavor=qpas | inputs=in:2 | outputs=out:2 | params=cutoff,q,radiate,smile,frown,q_plus,q_minus,mode,input_gain,mix,level
//
// Make Noise QPAS-inspired stereo multi-peak filter approximation.
// Source reference: https://www.makenoisemusic.com/modules/qpas/
//
// mode: 0=ALL, 1=LP, 2=HP, 3=BP, 4=NOTCH (LP+HP), 5=BP+HP.

// Stereo peak output ports need nested per-port channel returns, which the
// current .vibe-only multi-output path does not support. Use mode 1/2/3 on
// parallel QPAS voices as LP/HP/BP peak taps until the builder supports that.
define_synthdef("qpas")
    .input("in", 2)
    .param("cutoff", 1200.0) // units: Hz, range: 20..20000, default: 1200.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
    .param("q", 0.35) // units: resonance, range: 0..1, default: 0.35. Filter resonance amount; higher emphasizes a narrower frequency peak.
    .param("radiate", 0.25) // units: normalized, range: 0..1, default: 0.25. QPAS radiate spread; higher offsets the filter cores for wider stereo motion.
    .param("smile", 0.5) // units: normalized, range: 0..1, default: 0.5. QPAS smile response; higher emphasizes the upward spectral curve.
    .param("frown", 0.5) // units: normalized, range: 0..1, default: 0.5. QPAS frown response; higher emphasizes the downward spectral curve.
    .param("q_plus", 0.0) // units: normalized, range: 0..1, default: 0.0. Filter resonance amount; higher emphasizes a narrower frequency peak.
    .param("q_minus", 0.0) // units: normalized, range: 0..1, default: 0.0. Filter resonance amount; higher emphasizes a narrower frequency peak.
    .param("mode", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or step count.
    .param("input_gain", 0.8) // units: linear, range: 0..1, default: 0.8. Input Gain trim; higher sends more of that input into the processor.
    .param("mix", 1.0) // units: ratio, range: 0..1, default: 1.0. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body_map(|p| {
        let dry_l = p.inputs["in"][0] * p.input_gain;
        let dry_r = p.inputs["in"][1] * p.input_gain;
        let cutoff = clip(p.cutoff, 30.0, 16000.0);
        let q = clip(p.q, 0.05, 1.0);
        let q_plus = clip(p.q_plus, -1.0, 1.0);
        let q_minus = clip(p.q_minus, -1.0, 1.0);
        let q_low = clip(q + q_minus * 0.35, 0.05, 1.0);
        let q_high = clip(q + q_plus * 0.35, 0.05, 1.0);
        let radiate = clip(p.radiate, 0.0, 1.0);
        let smile = clip(p.smile, -1.0, 1.0);
        let frown = clip(p.frown, -1.0, 1.0);
        let spread = radiate * 0.35;

        let low_base = cutoff * (1.0 - spread * 0.5);
        let low_offset = low_base * spread * smile;
        let low_cut_a = clip(low_base - low_offset, 20.0, 18000.0);
        let low_cut_b = clip(low_base + low_offset, 20.0, 18000.0);

        let high_base = cutoff * (1.0 + spread * 0.5);
        let high_offset = high_base * spread * frown;
        let high_cut_a = clip(high_base - high_offset, 20.0, 18000.0);
        let high_cut_b = clip(high_base + high_offset, 20.0, 18000.0);

        let low_l_a = rlpf_ar(dry_l, low_cut_a, q_low);
        let low_l_b = rlpf_ar(dry_l, low_cut_b, q_low);
        let low_r_a = rlpf_ar(dry_r, low_cut_b, q_low);
        let low_r_b = rlpf_ar(dry_r, low_cut_a, q_low);
        let low_l = (low_l_a + low_l_b) * 0.5;
        let low_r = (low_r_a + low_r_b) * 0.5;

        let band_l = (
            bpf_ar(dry_l, cutoff * (1.0 - spread), q) +
            bpf_ar(dry_l, cutoff * (1.0 + spread * 1.5), q)
        ) * 0.5;
        let band_r = (
            bpf_ar(dry_r, cutoff * (1.0 + spread), q) +
            bpf_ar(dry_r, cutoff * (1.0 - spread * 1.5), q)
        ) * 0.5;

        let high_l_a = rhpf_ar(dry_l, high_cut_a, q_high);
        let high_l_b = rhpf_ar(dry_l, high_cut_b, q_high);
        let high_r_a = rhpf_ar(dry_r, high_cut_b, q_high);
        let high_r_b = rhpf_ar(dry_r, high_cut_a, q_high);
        let high_l = (high_l_a + high_l_b) * 0.5;
        let high_r = (high_r_a + high_r_b) * 0.5;

        let all_l = low_l * 0.38 + band_l * 0.32 + high_l * 0.38;
        let all_r = low_r * 0.38 + band_r * 0.32 + high_r * 0.38;
        let notch_l = (low_l + high_l) * 0.5;
        let notch_r = (low_r + high_r) * 0.5;
        let bp_hp_l = (band_l + high_l) * 0.5;
        let bp_hp_r = (band_r + high_r) * 0.5;

        let mode = round(clip(p.mode, 0.0, 5.0));
        let all_w = clip(1.0 - abs(mode - 0.0), 0.0, 1.0);
        let low_w = clip(1.0 - abs(mode - 1.0), 0.0, 1.0);
        let high_w = clip(1.0 - abs(mode - 2.0), 0.0, 1.0);
        let band_w = clip(1.0 - abs(mode - 3.0), 0.0, 1.0);
        let notch_w = clip(1.0 - abs(mode - 4.0), 0.0, 1.0);
        let bp_hp_w = clip(1.0 - abs(mode - 5.0), 0.0, 1.0);

        let wet_l = leak_dc_ar(
            all_l * all_w +
            low_l * low_w +
            high_l * high_w +
            band_l * band_w +
            notch_l * notch_w +
            bp_hp_l * bp_hp_w,
            0.995
        );
        let wet_r = leak_dc_ar(
            all_r * all_w +
            low_r * low_w +
            high_r * high_w +
            band_r * band_w +
            notch_r * notch_w +
            bp_hp_r * bp_hp_w,
            0.995
        );
        let mix = clip(p.mix, 0.0, 1.0);
        let out_l = softclip(((1.0 - mix) * dry_l + mix * wet_l) * p.level);
        let out_r = softclip(((1.0 - mix) * dry_r + mix * wet_r) * p.level);

        [
            out_l,
            out_r
        ]
    });

//
// # Usage: `qpas`
//
// ```rhai
// import "stdlib/processors/filters/qpas.vibe" as qpas;
//
// let qpas = voice("doc_qpas")
//     .synth("qpas")
//     .set_param("cutoff", 1800.0)
//     .set_param("input_gain", 0.5)
//     .set_param("level", 0.5)
//     .set_param("mix", 0.45);
// qpas.output("out").to_main();
// qpas.run();
// ```
