// kind=processor | category=dynamics | flavor=dxg | inputs=ch1:2,strike1:1,ch2:2,strike2:1,aux:2 | outputs=out:2 | params=ctrl1,ctrl2,strike_level,strike_decay,ch1_gain,ch2_gain,aux_gain,level
//
// Make Noise DXG-inspired dual stereo low-pass gate and mixer approximation.
// Source reference: https://www.makenoisemusic.com/modules/dxg/

define_synthdef("dxg")
    .input("ch1", 2)
    .input("strike1", 1)
    .input("ch2", 2)
    .input("strike2", 1)
    .input("aux", 2)
    .param("ctrl1", 0.75)
    .param("ctrl2", 0.75)
    .param("strike_level", 0.8)
    .param("strike_decay", 0.45)
    .param("ch1_gain", 0.8)
    .param("ch2_gain", 0.8)
    .param("aux_gain", 0.8)
    .param("level", 0.85)
    .body_map(|p| {
        let strike_decay = clip(p.strike_decay, 0.02, 4.0);
        let strike1 = decay2_ar(clip(p.inputs.strike1, 0.0, 1.0), 0.002, strike_decay) * p.strike_level;
        let strike2 = decay2_ar(clip(p.inputs.strike2, 0.0, 1.0), 0.002, strike_decay) * p.strike_level;

        let open1 = lag_ud_ar(clip(p.ctrl1 + strike1, 0.0, 1.0), 0.004, strike_decay);
        let open2 = lag_ud_ar(clip(p.ctrl2 + strike2, 0.0, 1.0), 0.004, strike_decay);
        let cutoff1 = 80.0 + open1 * open1 * 9000.0;
        let cutoff2 = 80.0 + open2 * open2 * 9000.0;
        let amp1 = open1 * open1;
        let amp2 = open2 * open2;

        let ch1_l = lpf_ar(p.inputs.ch1[0] * p.ch1_gain, cutoff1) * amp1;
        let ch1_r = lpf_ar(p.inputs.ch1[1] * p.ch1_gain, cutoff1) * amp1;
        let ch2_l = lpf_ar(p.inputs.ch2[0] * p.ch2_gain, cutoff2) * amp2;
        let ch2_r = lpf_ar(p.inputs.ch2[1] * p.ch2_gain, cutoff2) * amp2;
        let aux_l = p.inputs.aux[0] * p.aux_gain;
        let aux_r = p.inputs.aux[1] * p.aux_gain;

        [
            softclip((ch1_l + ch2_l + aux_l) * p.level),
            softclip((ch1_r + ch2_r + aux_r) * p.level)
        ]
    });
