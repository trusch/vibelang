// kind=processor | category=mixers | flavor=mixer4_stereo | inputs=ch1:2,ch2:2,ch3:2,ch4:2 | outputs=out:2 | params=ch1_gain,ch2_gain,ch3_gain,ch4_gain,level

define_synthdef("mixer4_stereo")
    .input("ch1", 2)
    .input("ch2", 2)
    .input("ch3", 2)
    .input("ch4", 2)
    .param("ch1_gain", 1.0) // units: linear, range: 0..1, default: 1.0. Channel 1 gain trim; higher sends more of that channel to the mix.
    .param("ch2_gain", 1.0) // units: linear, range: 0..1, default: 1.0. Channel 2 gain trim; higher sends more of that channel to the mix.
    .param("ch3_gain", 1.0) // units: linear, range: 0..1, default: 1.0. Channel 3 gain trim; higher sends more of that channel to the mix.
    .param("ch4_gain", 1.0) // units: linear, range: 0..1, default: 1.0. Channel 4 gain trim; higher sends more of that channel to the mix.
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body_map(|p| {
        let left =
            p.inputs.ch1[0] * p.ch1_gain +
            p.inputs.ch2[0] * p.ch2_gain +
            p.inputs.ch3[0] * p.ch3_gain +
            p.inputs.ch4[0] * p.ch4_gain;
        let right =
            p.inputs.ch1[1] * p.ch1_gain +
            p.inputs.ch2[1] * p.ch2_gain +
            p.inputs.ch3[1] * p.ch3_gain +
            p.inputs.ch4[1] * p.ch4_gain;

        [
            left * p.level,
            right * p.level
        ]
    });

//
// # Usage: `mixer4_stereo`
//
// ```rhai
// import "stdlib/processors/mixers/mixer4_stereo.vibe" as mixer4_stereo;
//
// let mixer4_stereo = voice("doc_mixer4_stereo")
//     .synth("mixer4_stereo")
//     .set_param("ch1_gain", 0.5)
//     .set_param("level", 0.5)
//     .set_param("ch2_gain", 0.5)
//     .set_param("ch3_gain", 0.5);
// mixer4_stereo.output("out").to_main();
// mixer4_stereo.run();
// ```
