// kind=processor | category=mixers | flavor=erica_black_output | inputs=in1:1,in2:1,in3:1 | outputs=out:2 | params=level1,level2,level3,pan1,pan2,pan3,pan3_cv_amt,pan3_cv,master,phones_level,limit
//
// Erica Synths Black Output-inspired final output mixer approximation.
// Three mono buffered inputs are levelled, panned to a stereo bus, then sent
// to separate main balanced and headphone stereo outputs. Input 3 exposes the
// hardware CV autopan behavior as a signed normalized pan3_cv param.

/// @vibelang-api export=import_callable_internal support=unsupported
fn _erica_black_output_soft(sig, limit_on) {
    let limited = tanh_ar(sig * 1.25) / 1.25;
    let bypass = sig;
    let limit = round(clip(limit_on, 0.0, 1.0));
    let m_bypass = (1.0 - abs(limit - 0.0)).max(0.0);
    let m_limited = (1.0 - abs(limit - 1.0)).max(0.0);
    m_bypass * bypass + m_limited * limited
}

define_synthdef("erica_black_output")
    .input("in1", 1)
    .input("in2", 1)
    .input("in3", 1)
    .param("level1", 0.7) // units: linear, range: 0..1, default: 0.7. Band 1 output level; higher makes that resonator louder.
    .param("level2", 0.7) // units: linear, range: 0..1, default: 0.7. Band 2 output level; higher makes that resonator louder.
    .param("level3", 0.7) // units: linear, range: 0..1, default: 0.7. Band 3 output level; higher makes that resonator louder.
    .param("pan1", 0.0) // units: pan, range: -1..1, default: 0.0. Stereo pan position; -1 is left, 0 is center, +1 is right.
    .param("pan2", 0.0) // units: pan, range: -1..1, default: 0.0. Stereo pan position; -1 is left, 0 is center, +1 is right.
    .param("pan3", 0.0) // units: pan, range: -1..1, default: 0.0. Stereo pan position; -1 is left, 0 is center, +1 is right.
    .param("pan3_cv_amt", 0.0) // units: linear, range: -1..1, default: 0.0. PAN3 CV AMT attenuator; higher makes the matching CV modulation stronger.
    .param("pan3_cv", 0.0) // units: pan, range: -1..1, default: 0.0. Pan3 CV input; bipolar values modulate the matching panel control.
    .param("master", 0.8) // units: linear, range: 0..1, default: 0.8. Master output level; higher raises the final stereo bus.
    .param("phones_level", 0.5) // units: linear, range: 0..1, default: 0.5. Headphone monitor level; higher raises the phones output feed.
    .param("limit", 1.0) // units: normalized, range: 0..1, default: 1.0. Limiter enable/amount; higher applies more output protection.
    .body_map(|p| {
        let pan1 = clip(p.pan1, -1.0, 1.0);
        let pan2 = clip(p.pan2, -1.0, 1.0);
        let pan3_cv = clip(p.pan3_cv, -1.0, 1.0) * clip(p.pan3_cv_amt, 0.0, 1.0);
        let pan3 = clip(p.pan3 + pan3_cv, -1.0, 1.0);

        let ch1 = channels(pan2_ar(p.inputs.in1, pan1, clip(p.level1, 0.0, 1.0)), 2);
        let ch2 = channels(pan2_ar(p.inputs.in2, pan2, clip(p.level2, 0.0, 1.0)), 2);
        let ch3 = channels(pan2_ar(p.inputs.in3, pan3, clip(p.level3, 0.0, 1.0)), 2);

        let master = clip(p.master, 0.0, 1.0);
        let main_l = (ch1[0] + ch2[0] + ch3[0]) * master;
        let main_r = (ch1[1] + ch2[1] + ch3[1]) * master;
        let out_l = _erica_black_output_soft(main_l, p.limit);
        let out_r = _erica_black_output_soft(main_r, p.limit);

        [
            out_l,
            out_r
        ]
    });

//
// # Usage: `erica_black_output`
//
// ```rhai
// import "stdlib/processors/mixers/erica_black_output.vibe" as erica_black_output;
//
// let erica_black_output = voice("doc_erica_black_output")
//     .synth("erica_black_output")
//     .set_param("level1", 0.5)
//     .set_param("level2", 0.5)
//     .set_param("level3", 0.5)
//     .set_param("pan1", -0.2);
// erica_black_output.output("out").to_main();
// erica_black_output.run();
// ```
