// kind=processor | category=mixers | flavor=erica_black_output | inputs=in1:1,in2:1,in3:1 | outputs=out:2,phones:2 | params=level1,level2,level3,pan1,pan2,pan3,pan3_cv_amt,pan3_cv,master,phones_level,limit
//
// Erica Synths Black Output-inspired final output mixer approximation.
// Three mono buffered inputs are levelled, panned to a stereo bus, then sent
// to separate main balanced and headphone stereo outputs. Input 3 exposes the
// hardware CV autopan behavior as a signed normalized pan3_cv param.

fn _erica_black_output_soft(sig, limit_on) {
    let limited = tanh_ar(sig * 1.25) / 1.25;
    let bypass = sig;
    select_ar(round(clip(limit_on, 0.0, 1.0)), [bypass, limited])
}

define_synthdef("erica_black_output")
    .input("in1", 1)
    .input("in2", 1)
    .input("in3", 1)
    .output("out", 2)
    .output("phones", 2)
    .param("level1", 0.7)
    .param("level2", 0.7)
    .param("level3", 0.7)
    .param("pan1", 0.0)
    .param("pan2", 0.0)
    .param("pan3", 0.0)
    .param("pan3_cv_amt", 0.0)
    .param("pan3_cv", 0.0)
    .param("master", 0.8)
    .param("phones_level", 0.5)
    .param("limit", 1.0)
    .body_map(|p| {
        let pan1 = clip(p.pan1, -1.0, 1.0);
        let pan2 = clip(p.pan2, -1.0, 1.0);
        let pan3_cv = clip(p.pan3_cv, -1.0, 1.0) * clip(p.pan3_cv_amt, 0.0, 1.0);
        let pan3 = clip(p.pan3 + pan3_cv, -1.0, 1.0);

        let ch1 = channels(pan2_ar(p.inputs.in1, pan1, clip(p.level1, 0.0, 1.0)), 2);
        let ch2 = channels(pan2_ar(p.inputs.in2, pan2, clip(p.level2, 0.0, 1.0)), 2);
        let ch3 = channels(pan2_ar(p.inputs.in3, pan3, clip(p.level3, 0.0, 1.0)), 2);

        let master = clip(p.master, 0.0, 1.0);
        let main_l = (ch1[0] + ch2[0] + ch3[0]) * master;
        let main_r = (ch1[1] + ch2[1] + ch3[1]) * master;
        let out_l = _erica_black_output_soft(main_l, p.limit);
        let out_r = _erica_black_output_soft(main_r, p.limit);

        let phones_level = clip(p.phones_level, 0.0, 1.0);

        [
            [out_l, out_r],
            [out_l * phones_level, out_r * phones_level]
        ]
    });
