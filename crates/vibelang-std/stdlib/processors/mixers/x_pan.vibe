// kind=processor | category=mixers | flavor=x_pan | inputs=ch1_a:1,ch1_b:1,ch2_a:1,ch2_b:1,aux:2 | outputs=out:2 | params=ch1_fade,ch1_pan,ch1_gain,ch2_fade,ch2_pan,ch2_gain,aux_gain,level
//
// Make Noise X-PAN-inspired voltage-controlled stereo mixer approximation.
// Source reference: https://www.makenoisemusic.com/modules/x-pan/

define_synthdef("x_pan")
    .input("ch1_a", 1)
    .input("ch1_b", 1)
    .input("ch2_a", 1)
    .input("ch2_b", 1)
    .input("aux", 2)
    .param("ch1_fade", 0.0) // units: normalized, range: 0..1, default: 0.0. Channel 1 crossfade position; higher moves that channel toward the alternate side.
    .param("ch1_pan", -0.25) // units: pan, range: -1..1, default: -0.25. Stereo pan position; -1 is left, 0 is center, +1 is right.
    .param("ch1_gain", 0.7) // units: linear, range: 0..1, default: 0.7. Channel 1 gain trim; higher sends more of that channel to the mix.
    .param("ch2_fade", 0.0) // units: normalized, range: 0..1, default: 0.0. Channel 2 crossfade position; higher moves that channel toward the alternate side.
    .param("ch2_pan", 0.25) // units: pan, range: -1..1, default: 0.25. Stereo pan position; -1 is left, 0 is center, +1 is right.
    .param("ch2_gain", 0.7) // units: linear, range: 0..1, default: 0.7. Channel 2 gain trim; higher sends more of that channel to the mix.
    .param("aux_gain", 0.8) // units: linear, range: 0..1, default: 0.8. Auxiliary input gain; higher sends more aux signal to the mix.
    .param("level", 0.85) // units: linear, range: 0..1, default: 0.85. Output level multiplier; higher is louder.
    .body_map(|p| {
        let ch1_fade = clip(p.ch1_fade, 0.0, 1.0);
        let ch2_fade = clip(p.ch2_fade, 0.0, 1.0);
        let ch1_pan = clip(p.ch1_pan, -1.0, 1.0);
        let ch2_pan = clip(p.ch2_pan, -1.0, 1.0);

        let ch1_mono =
            p.inputs.ch1_a * (1.0 - ch1_fade) +
            p.inputs.ch1_b * ch1_fade;
        let ch2_mono =
            p.inputs.ch2_a * (1.0 - ch2_fade) +
            p.inputs.ch2_b * ch2_fade;

        let ch1 = channels(pan2_ar(ch1_mono, ch1_pan, p.ch1_gain), 2);
        let ch2 = channels(pan2_ar(ch2_mono, ch2_pan, p.ch2_gain), 2);
        let aux_l = p.inputs.aux[0] * p.aux_gain;
        let aux_r = p.inputs.aux[1] * p.aux_gain;

        [
            softclip((ch1[0] + ch2[0] + aux_l) * p.level),
            softclip((ch1[1] + ch2[1] + aux_r) * p.level)
        ]
    });

//
// # Usage: `x_pan`
//
// ```rhai
// import "stdlib/processors/mixers/x_pan.vibe" as x_pan;
//
// let x_pan = voice("doc_x_pan")
//     .synth("x_pan")
//     .set_param("ch1_gain", 0.5)
//     .set_param("level", 0.5)
//     .set_param("ch1_fade", 0.5)
//     .set_param("ch1_pan", -0.2);
// x_pan.output("out").to_main();
// x_pan.run();
// ```
