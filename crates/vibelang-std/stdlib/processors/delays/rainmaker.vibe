    .param("tap_pan_1", -1.0) // units: pan, range: -1..1, default: -1.0. Tap 1 stereo pan; -1 is left, +1 is right.
    .param("tap_pan_2", 1.0) // units: pan, range: -1..1, default: 1.0. Tap 2 stereo pan; -1 is left, +1 is right.
