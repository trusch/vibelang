// kind=processor | category=delays | flavor=rainmaker | inputs=in:2 | outputs=out:2
//
// Intellijel/Cylonix Rainmaker-inspired stereo rhythm delay and comb resonator.
// This is a performance-rack processor model: sixteen editable rhythm taps
// feed a stereo wet bus, with pitch-shifted/tone-shaped feedback and a separate
// comb-resonator layer.

/// @vibelang-api export=import_callable_internal support=unsupported
fn _rainmaker_filter(sig, cutoff, q, filter_type) {
    let cutoff = clip(cutoff, 20.0, 18000.0);
    let q = clip(q, 0.1, 1.0);
    let mode = round(clip(filter_type, 0.0, 2.0));
    let low_w = clip(1.0 - abs(mode - 0.0), 0.0, 1.0);
    let band_w = clip(1.0 - abs(mode - 1.0), 0.0, 1.0);
    let high_w = clip(1.0 - abs(mode - 2.0), 0.0, 1.0);

    rlpf_ar(sig, cutoff, q) * low_w +
        bpf_ar(sig, cutoff, q) * band_w +
        rhpf_ar(sig, cutoff, q) * high_w
}

/// @vibelang-api export=import_callable_internal support=unsupported
fn _rainmaker_tap(src, base_time, grid, tap_index, level, pan, cutoff, q, filter_type, pitch, detune, mute, reverse) {
    let reverse = clip(round(reverse), 0.0, 1.0);
    let step = tap_index * (1.0 - reverse) + (17.0 - tap_index) * reverse;
    let tap_time = clip(base_time * step / grid, 0.001, 4.0);
    let raw = delay_l_ar(src, 4.0, tap_time);
    let filtered = _rainmaker_filter(raw, cutoff, q, filter_type);
    let ratio = pow(2.0, (clip(pitch, -24.0, 24.0) + clip(detune, -1.0, 1.0)) / 12.0);
    let shifted = pitch_shift_ar(filtered, 0.12, ratio, 0.0, 0.0);
    let active = 1.0 - clip(round(mute), 0.0, 1.0);
    let pan = clip(pan, -1.0, 1.0);
    let gain = clip(level, 0.0, 1.5) * active;

    [
        shifted * gain * (1.0 - pan) * 0.5,
        shifted * gain * (1.0 + pan) * 0.5
    ]
}

/// @vibelang-api export=import_callable_internal support=unsupported
fn _rainmaker_comb_weight(taps, threshold) {
    clip((taps - threshold + 1.0) / 8.0, 0.0, 1.0)
}

define_synthdef("rainmaker")
    .input("in", 2)
    .param("time", 500.0) // units: ms, range: 1..16000, default: 500.0. Delay or segment time; higher values make repeats arrive later.
    .param("grid", 16.0) // units: steps, range: 1..32, default: 16.0. Rhythm grid division count; higher values create finer tap spacing.
    .param("feedback", 0.4) // units: normalized, range: 0..1, default: 0.4. Feedback amount; higher gives longer repeats and can approach self-oscillation.
    .param("feedback_pitch", 0.0) // units: normalized, range: 0..1, default: 0.0. Feedback pitch shift; higher values transpose recirculating repeats upward.
    .param("feedback_tone", 0.5) // units: normalized, range: 0..1, default: 0.5. Feedback tone color; higher values keep recirculating repeats brighter.
    .param("reverse", 0.0) // units: normalized, range: 0..1, default: 0.0. Reverse switch; rounded values turn that mode off or on.
    .param("wet_dry", 0.5) // units: normalized, range: 0..1, default: 0.5. Dry/wet balance; 0 is dry and 1 is fully processed.
    .param("tap_level_1", 0.50) // units: linear, range: 0..1, default: 0.50. Tap 1 output gain; higher makes that rhythm tap louder.
    .param("tap_level_2", 0.48) // units: linear, range: 0..1, default: 0.48. Tap 2 output gain; higher makes that rhythm tap louder.
    .param("tap_level_3", 0.46) // units: linear, range: 0..1, default: 0.46. Tap 3 output gain; higher makes that rhythm tap louder.
    .param("tap_level_4", 0.44) // units: linear, range: 0..1, default: 0.44. Tap 4 output gain; higher makes that rhythm tap louder.
