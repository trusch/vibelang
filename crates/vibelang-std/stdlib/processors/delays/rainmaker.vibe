    .param("tap_level_6", 0.40) // units: linear, range: 0..1, default: 0.40. Tap 6 output gain; higher makes that rhythm tap louder.
    .param("tap_level_7", 0.38) // units: linear, range: 0..1, default: 0.38. Tap 7 output gain; higher makes that rhythm tap louder.
    .param("tap_level_8", 0.36) // units: linear, range: 0..1, default: 0.36. Tap 8 output gain; higher makes that rhythm tap louder.
    .param("tap_level_9", 0.34) // units: linear, range: 0..1, default: 0.34. Tap 9 output gain; higher makes that rhythm tap louder.
    .param("tap_level_10", 0.32) // units: linear, range: 0..1, default: 0.32. Tap 10 output gain; higher makes that rhythm tap louder.
