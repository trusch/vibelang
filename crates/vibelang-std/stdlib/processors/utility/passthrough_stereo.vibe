// kind=processor | category=utility | flavor=passthrough_stereo | inputs=in:2 | outputs=out:2 | params=level

define_synthdef("passthrough_stereo")
    .input("in", 2)
    .param("level", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body_map(|p| {
        [
            p.inputs["in"][0] * p.level,
            p.inputs["in"][1] * p.level
        ]
    });

//
// # Usage: `passthrough_stereo`
//
// ```rhai
// import "stdlib/processors/utility/passthrough_stereo.vibe" as passthrough_stereo;
//
// let passthrough_stereo = voice("doc_passthrough_stereo")
//     .synth("passthrough_stereo")
//     .set_param("level", 0.5);
// passthrough_stereo.output("out").to_main();
// passthrough_stereo.run();
// ```
