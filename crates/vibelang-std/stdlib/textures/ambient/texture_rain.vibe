// Genre: Ambient, Nature | Character: Rain-like texture
define_synthdef("texture_rain", |builder| {
    builder
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .body(|amp| {
            // Long sustain
            let env = envelope()
                .perc(0.5, 10.0)
                .cleanup_on_finish()
                .build();

            // White noise for rain character
            let noise = white_noise_ar();

            // Mid-range filtering
            let filtered = rlpf_ar(noise, 3500.0, 0.6);

            // High-pass to remove lows
            let clean = hpf_ar(filtered, 400.0);

            clean * env * amp * 0.7
        })
});

//
// # Usage: `texture_rain`
//
// ```rhai
// import "stdlib/textures/ambient/texture_rain.vibe" as texture_rain;
//
// let texture_rain = voice("doc_texture_rain")
//     .synth("texture_rain")
//     .set_param("amp", 0.5);
// texture_rain.output("out").to_main();
// texture_rain.run();
// ```
