// Genre: Ambient, Sci-Fi | Character: Spacious, ethereal texture
define_synthdef("texture_space", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Very long envelope
            let env = envelope()
                .perc(2.0, 12.0)
                .cleanup_on_finish()
                .build();

            // Multiple slow oscillators
            let osc1 = sin_osc_ar(freq * 0.5);
            let osc2 = sin_osc_ar(freq * 0.75);
            let osc3 = sin_osc_ar(freq);
            let osc4 = sin_osc_ar(freq * 1.5);

            // Mix with harmonics
            let mix = (osc1 * 0.3 + osc2 * 0.25 + osc3 * 0.25 + osc4 * 0.2);

            // Evolving filter
            let filter_env = envelope()
                .perc(3.0, 10.0)
                .build();
            let mod_cutoff = 500.0 + (filter_env * 2500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `texture_space`
//
// ```rhai
// import "stdlib/textures/ambient/texture_space.vibe" as texture_space;
//
// let texture_space = voice("doc_texture_space")
//     .synth("texture_space")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// texture_space.output("out").to_main();
// texture_space.run();
// ```
