// Genre: Ambient, Experimental | Character: Granular-style texture
define_synthdef("texture_granular", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Long envelope
            let env = envelope()
                .perc(1.5, 9.0)
                .cleanup_on_finish()
                .build();

            // Multiple detuned oscillators for grain-like character
            let osc1 = saw_ar(freq * 0.983);
            let osc2 = saw_ar(freq * 0.991);
            let osc3 = saw_ar(freq);
            let osc4 = saw_ar(freq * 1.009);
            let osc5 = saw_ar(freq * 1.017);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.2;

            // Heavy filtering for smoothness
            let filtered = lpf_ar(mix, 1500.0);

            // Additional resonant layer
            let resonant = rlpf_ar(filtered, 2000.0, 0.6) * 0.5;

            (filtered + resonant) * env * amp * 0.6
        })
});

//
// # Usage: `texture_granular`
//
// ```rhai
// import "stdlib/textures/ambient/texture_granular.vibe" as texture_granular;
//
// let texture_granular = voice("doc_texture_granular")
//     .synth("texture_granular")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// texture_granular.output("out").to_main();
// texture_granular.run();
// ```
