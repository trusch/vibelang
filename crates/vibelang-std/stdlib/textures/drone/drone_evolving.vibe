// Genre: Ambient, Drone | Character: Slowly evolving drone
define_synthdef("drone_evolving", |builder| {
    builder
        .param("freq", 82.0) // units: Hz, range: 20..20000, default: 82.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Very long sustain
            let env = envelope()
                .perc(4.0, 25.0)
                .cleanup_on_finish()
                .build();

            // Wide detuning
            let osc1 = saw_ar(freq * 0.980);
            let osc2 = saw_ar(freq * 0.990);
            let osc3 = saw_ar(freq);
            let osc4 = saw_ar(freq * 1.010);
            let osc5 = saw_ar(freq * 1.020);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.2;

            // Slowly evolving filter
            let filter_env = envelope()
                .perc(8.0, 20.0)
                .build();
            let mod_cutoff = 400.0 + (filter_env * 2000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            // Additional resonance layer
            let resonant = rlpf_ar(filtered, mod_cutoff * 0.8, 0.5) * 0.5;

            (filtered + resonant) * env * amp * 0.7
        })
});

//
// # Usage: `drone_evolving`
//
// ```rhai
// import "stdlib/textures/drone/drone_evolving.vibe" as drone_evolving;
//
// let drone_evolving = voice("doc_drone_evolving")
//     .synth("drone_evolving")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// drone_evolving.output("out").to_main();
// drone_evolving.run();
// ```
