// Genre: Ambient, Experimental | Character: Resonant, metallic drone
define_synthdef("drone_resonant", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Long sustain
            let env = envelope()
                .perc(2.5, 18.0)
                .cleanup_on_finish()
                .build();

            // Sawtooth source
            let osc = saw_ar(freq);

            // Multiple resonant filters at different frequencies
            let res1 = rlpf_ar(osc, freq * 2.0, 0.1) * 0.35;
            let res2 = rlpf_ar(osc, freq * 3.0, 0.15) * 0.3;
            let res3 = rlpf_ar(osc, freq * 5.0, 0.2) * 0.25;
            let res4 = rlpf_ar(osc, freq * 7.0, 0.25) * 0.1;

            let mix = res1 + res2 + res3 + res4;

            // Overall filtering
            let filtered = lpf_ar(mix, 3000.0);

            filtered * env * amp
        })
});

//
// # Usage: `drone_resonant`
//
// ```rhai
// import "stdlib/textures/drone/drone_resonant.vibe" as drone_resonant;
//
// let drone_resonant = voice("doc_drone_resonant")
//     .synth("drone_resonant")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// drone_resonant.output("out").to_main();
// drone_resonant.run();
// ```
