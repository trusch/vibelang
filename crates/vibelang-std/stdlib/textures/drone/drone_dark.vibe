// Genre: Dark Ambient, Drone | Character: Dark, ominous drone
define_synthdef("drone_dark", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Very long sustain
            let env = envelope()
                .perc(3.0, 20.0)
                .cleanup_on_finish()
                .build();

            // Low, detuned oscillators
            let osc1 = saw_ar(freq * 0.995);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.005);
            let osc4 = saw_ar(freq * 0.5);

            let mix = (osc1 + osc2 + osc3) * 0.25 + (osc4 * 0.25);

            // Dark filtering
            let filtered = lpf_ar(mix, 600.0);

            filtered * env * amp
        })
});

//
// # Usage: `drone_dark`
//
// ```rhai
// import "stdlib/textures/drone/drone_dark.vibe" as drone_dark;
//
// let drone_dark = voice("doc_drone_dark")
//     .synth("drone_dark")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// drone_dark.output("out").to_main();
// drone_dark.run();
// ```
