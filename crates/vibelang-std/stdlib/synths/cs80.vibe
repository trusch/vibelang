// Yamaha CS-80 Emulation
// Classic 1977 | Character: Lush, expressive, cinematic

// CS-80 Lead - Expressive lead with vibrato
define_synthdef("cs80_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("vibrato", 0.5) // units: normalized, range: 0..1, default: 0.5. Vibrato depth; higher values make pitch wobble wider.
        .body(|freq, amp, gate, vibrato| {
            let env = envelope()
                .asr(0.05, 1.0, 0.3)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Characteristic vibrato
            let vib = sin_osc_ar(5.0) * freq * 0.015 * vibrato;
            let mod_freq = freq + vib;

            // Dual layers - saw and ring mod
            let osc1 = saw_ar(mod_freq) * 0.4;
            let osc2 = saw_ar(mod_freq * 1.003) * 0.4;
            let ring = sin_osc_ar(mod_freq * 2.0) * 0.2;

            let mix = osc1 + osc2 + ring;

            // Warm filtering
            let filtered = lpf_ar(mix, 3500.0);

            filtered * env * amp
        })
});

// CS-80 Brass - Famous brass sound (Blade Runner)
define_synthdef("cs80_brass", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.08, 1.0, 0.25)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.1, 1.0, 0.2)
                .gate(gate)
                .build();

            // Dual oscillators with detune
            let osc1 = saw_ar(freq * 0.998);
            let osc2 = saw_ar(freq * 1.002);
            let sub = saw_ar(freq * 0.5) * 0.3;

            let mix = (osc1 + osc2) * 0.4 + sub;

            // Resonant filter sweep
            let cutoff = 800.0 + filt_env * 2500.0;
            let filtered = rlpf_ar(mix, cutoff, 0.7);

            filtered * env * amp
        })
});

// CS-80 Strings - Lush string pad
define_synthdef("cs80_strings", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.3, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Chorus-like detuning
            let lfo = sin_osc_ar(0.3) * 0.003;
            let osc1 = saw_ar(freq * (0.997 + lfo));
            let osc2 = saw_ar(freq * (1.0 - lfo));
            let osc3 = saw_ar(freq * (1.003 + lfo));

            let mix = (osc1 + osc2 + osc3) * 0.35;

            // Warm string filtering
            let filtered = lpf_ar(mix, 3000.0);

            filtered * env * amp
        })
});

//
// # Usage: `cs80_lead`
//
// ```rhai
// import "stdlib/synths/cs80.vibe" as cs80;
//
// let cs80_lead = voice("doc_cs80_lead")
//     .synth("cs80_lead")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("vibrato", 0.5);
// cs80_lead.output("out").to_main();
// cs80_lead.run();
// ```
//
// # Usage: `cs80_brass`
//
// ```rhai
// import "stdlib/synths/cs80.vibe" as cs80;
//
// let cs80_brass = voice("doc_cs80_brass")
//     .synth("cs80_brass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// cs80_brass.output("out").to_main();
// cs80_brass.run();
// ```
//
// # Usage: `cs80_strings`
//
// ```rhai
// import "stdlib/synths/cs80.vibe" as cs80;
//
// let cs80_strings = voice("doc_cs80_strings")
//     .synth("cs80_strings")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// cs80_strings.output("out").to_main();
// cs80_strings.run();
// ```
