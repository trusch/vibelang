// Minimoog Emulation
// Classic 1970s | Character: Fat, warm, rich analog
//
// The Minimoog Model D - the synth that defined analog synthesis.
// Three oscillators, ladder filter, legendary warmth.

// Minimoog Bass - Classic fat bass
define_synthdef("minimoog_bass", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("filter_freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .param("resonance", 0.3) // units: resonance, range: 0..1, default: 0.3. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .body(|freq, amp, gate, filter_freq, resonance| {
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filt_env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .build();

            // Three detuned oscillators (classic Moog)
            let osc1 = saw_ar(freq);
            let osc2 = saw_ar(freq * 0.995) * 0.8;  // Slightly detuned
            let osc3 = saw_ar(freq * 0.5) * 0.6;   // Sub octave

            let mix = (osc1 + osc2 + osc3) * 0.4;

            // Ladder filter emulation (resonant lowpass)
            let cutoff = filter_freq + filt_env * 2000.0;
            let filtered = rlpf_ar(mix, cutoff, 1.0 - resonance * 0.9);

            filtered * env * amp
        })
});

// Minimoog Lead - Screaming mono lead
define_synthdef("minimoog_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("filter_freq", 2000.0) // units: Hz, range: 20..20000, default: 2000.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .param("resonance", 0.4) // units: resonance, range: 0..1, default: 0.4. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .body(|freq, amp, gate, filter_freq, resonance| {
            let env = envelope()
                .asr(0.02, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filt_env = envelope()
                .asr(0.01, 1.0, 0.2)
                .gate(gate)
                .build();

            // Three oscillators - mix of saw and pulse
            let osc1 = saw_ar(freq);
            let osc2 = saw_ar(freq * 1.005);  // Detuned up
            let osc3 = saw_ar(freq * 2.0) * 0.3; // Octave up

            let mix = (osc1 + osc2 + osc3) * 0.4;

            // Resonant filter sweep
            let cutoff = filter_freq + filt_env * 4000.0;
            let filtered = rlpf_ar(mix, cutoff, 1.0 - resonance * 0.85);

            filtered * env * amp
        })
});

// Minimoog Pad - Warm analog pad
define_synthdef("minimoog_pad", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.5, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Warm detuned oscillators
            let osc1 = saw_ar(freq * 0.998);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.002);
            let sub = sin_osc_ar(freq * 0.5) * 0.3;

            let mix = (osc1 + osc2 + osc3) * 0.3 + sub;

            // Warm filtering
            let filtered = lpf_ar(mix, 2500.0);

            filtered * env * amp
        })
});

//
// # Usage: `minimoog_bass`
//
// ```rhai
// import "stdlib/synths/minimoog.vibe" as minimoog;
//
// let minimoog_bass = voice("doc_minimoog_bass")
//     .synth("minimoog_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("filter_freq", 1200.0);
// minimoog_bass.output("out").to_main();
// minimoog_bass.run();
// ```
//
