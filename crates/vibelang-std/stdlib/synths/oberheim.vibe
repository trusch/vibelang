// Oberheim OB-X/OB-Xa Emulation
// Classic 1979-1981 | Character: Fat, brassy, lush
//
// The sound of Van Halen's "Jump". Thick, aggressive
// brass and incredibly fat pads.

// Oberheim Pad - Ultra-lush pad
define_synthdef("oberheim_pad", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.4, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Two VCOs per voice, slightly detuned
            let vco1a = saw_ar(freq * 0.996);
            let vco1b = saw_ar(freq * 0.998);
            let vco2a = saw_ar(freq * 1.002);
            let vco2b = saw_ar(freq * 1.004);

            let mix = (vco1a + vco1b + vco2a + vco2b) * 0.28;

            // Warm SEM-style filter
            let filtered = lpf_ar(mix, 2800.0);

            filtered * env * amp
        })
});

// Oberheim Brass - The "Jump" brass
define_synthdef("oberheim_brass", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.03, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filt_env = envelope()
                .asr(0.015, 1.0, 0.12)
                .gate(gate)
                .build();

            // Fat oscillators
            let vco1 = saw_ar(freq * 0.998);
            let vco2 = saw_ar(freq * 1.002);

            let mix = (vco1 + vco2) * 0.5;

            // Aggressive filter sweep
            let cutoff = 300.0 + filt_env * 5000.0;
            let filtered = rlpf_ar(mix, cutoff, 0.25);

            filtered * env * amp
        })
});

// Oberheim Lead - Screaming lead
define_synthdef("oberheim_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Two saw VCOs
            let vco1 = saw_ar(freq);
            let vco2 = saw_ar(freq * 1.008);

            let mix = (vco1 + vco2) * 0.5;

            // Bright resonant filter
            let filtered = rlpf_ar(mix, 4000.0, 0.4);

            filtered * env * amp
        })
});

// Oberheim Bass - Fat bass
define_synthdef("oberheim_bass", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.008, 1.0, 0.12)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filt_env = envelope()
                .perc(0.001, 0.25)
                .build();

            // Fat oscillators with sub
            let vco1 = saw_ar(freq);
            let vco2 = saw_ar(freq * 1.003);
            let sub = sin_osc_ar(freq * 0.5) * 0.4;

            let mix = (vco1 + vco2) * 0.4 + sub;

            // Punchy filter
            let cutoff = 250.0 + filt_env * 3000.0;
            let filtered = rlpf_ar(mix, cutoff, 0.3);

            filtered * env * amp
        })
});

//
// # Usage: `oberheim_pad`
//
// ```rhai
// import "stdlib/synths/oberheim.vibe" as oberheim;
//
// let oberheim_pad = voice("doc_oberheim_pad")
//     .synth("oberheim_pad")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// oberheim_pad.output("out").to_main();
// oberheim_pad.run();
// ```
//
// # Usage: `oberheim_brass`
//
// ```rhai
// import "stdlib/synths/oberheim.vibe" as oberheim;
//
// let oberheim_brass = voice("doc_oberheim_brass")
//     .synth("oberheim_brass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// oberheim_brass.output("out").to_main();
// oberheim_brass.run();
// ```
//
// # Usage: `oberheim_lead`
//
// ```rhai
// import "stdlib/synths/oberheim.vibe" as oberheim;
//
// let oberheim_lead = voice("doc_oberheim_lead")
//     .synth("oberheim_lead")
//     .set_param("freq", 440.0)
