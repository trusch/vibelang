// Korg MS-20 Emulation
// Classic 1978 | Character: Aggressive, gritty, raw analog

// MS-20 Bass - Aggressive filter bass
define_synthdef("ms20_bass", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("filter_freq", 600.0) // units: Hz, range: 20..20000, default: 600.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .param("resonance", 0.5) // units: resonance, range: 0..1, default: 0.5. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .body(|freq, amp, gate, filter_freq, resonance| {
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.02, 1.0, 0.15)
                .gate(gate)
                .build();

            // Dual oscillator - MS-20 style
            let osc1 = saw_ar(freq);
            let osc2 = pulse_ar(freq * 0.5, 0.4) * 0.7;

            let mix = (osc1 + osc2) * 0.5;

            // MS-20's aggressive high-pass then low-pass
            let hp = hpf_ar(mix, 80.0);
            let cutoff = filter_freq + filt_env * 1500.0;
            let filtered = rlpf_ar(hp, cutoff, 1.0 - resonance * 0.95);

            filtered * env * amp
        })
});

// MS-20 Lead - Screaming acid lead
define_synthdef("ms20_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("filter_freq", 1500.0) // units: Hz, range: 20..20000, default: 1500.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .param("resonance", 0.6) // units: resonance, range: 0..1, default: 0.6. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .body(|freq, amp, gate, filter_freq, resonance| {
            let env = envelope()
                .asr(0.01, 1.0, 0.12)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.01, 1.0, 0.2)
                .gate(gate)
                .build();

            // Ring mod style cross modulation
            let osc1 = saw_ar(freq);
            let osc2 = pulse_ar(freq * 1.002, 0.3);
            let ring = osc1 * sin_osc_ar(freq * 2.0) * 0.3;

            let mix = (osc1 + osc2 * 0.5 + ring) * 0.4;

            let cutoff = filter_freq + filt_env * 3000.0;
            let filtered = rlpf_ar(mix, cutoff, 1.0 - resonance * 0.9);

            filtered * env * amp
        })
});

// MS-20 Sync - Oscillator sync sound
define_synthdef("ms20_sync", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("sync_ratio", 2.5) // units: ratio, range: 0..8, default: 2.5. Frequency ratio; higher values tune the related oscillator or clock upward.
        .body(|freq, amp, gate, sync_ratio| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Simulated sync with multiple harmonics
            let fund = saw_ar(freq) * 0.4;
            let sync_freq = freq * sync_ratio;
            let sync1 = saw_ar(sync_freq) * 0.3;
            let sync2 = sin_osc_ar(sync_freq * 2.0) * 0.15;

            let mix = fund + sync1 + sync2;
            let filtered = lpf_ar(mix, 4000.0);

            filtered * env * amp
        })
});

//
// # Usage: `ms20_bass`
//
// ```rhai
// import "stdlib/synths/ms20.vibe" as ms20;
//
// let ms20_bass = voice("doc_ms20_bass")
//     .synth("ms20_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("filter_freq", 1200.0);
// ms20_bass.output("out").to_main();
// ms20_bass.run();
// ```
//
// # Usage: `ms20_lead`
//
// ```rhai
// import "stdlib/synths/ms20.vibe" as ms20;
//
// let ms20_lead = voice("doc_ms20_lead")
//     .synth("ms20_lead")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("filter_freq", 1200.0);
// ms20_lead.output("out").to_main();
// ms20_lead.run();
// ```
//
// # Usage: `ms20_sync`
//
// ```rhai
// import "stdlib/synths/ms20.vibe" as ms20;
//
// let ms20_sync = voice("doc_ms20_sync")
//     .synth("ms20_sync")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("sync_ratio", 2.5);
// ms20_sync.output("out").to_main();
// ms20_sync.run();
// ```
