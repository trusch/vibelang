// ARP Odyssey Emulation
// Classic 1972 | Character: Aggressive, raw, biting

// Odyssey Bass - Fat duophonic bass
define_synthdef("odyssey_bass", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("filter_freq", 700.0) // units: Hz, range: 20..20000, default: 700.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .body(|freq, amp, gate, filter_freq| {
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.01, 1.0, 0.12)
                .gate(gate)
                .build();

            // Dual oscillators with sync option
            let osc1 = saw_ar(freq);
            let osc2 = pulse_ar(freq * 0.5, 0.5) * 0.6;

            let mix = (osc1 + osc2) * 0.5;

            let cutoff = filter_freq + filt_env * 1800.0;
            let filtered = rlpf_ar(mix, cutoff, 0.55);

            filtered * env * amp
        })
});

// Odyssey Lead - Biting mono lead
define_synthdef("odyssey_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("resonance", 0.5) // units: resonance, range: 0..1, default: 0.5. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .body(|freq, amp, gate, resonance| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.01, 1.0, 0.2)
                .gate(gate)
                .build();

            // Ring mod character
            let osc1 = saw_ar(freq);
            let osc2 = saw_ar(freq * 1.005);
            let ring = osc1 * sin_osc_ar(freq * 1.5) * 0.2;

            let mix = (osc1 + osc2) * 0.4 + ring;

            let cutoff = 1200.0 + filt_env * 4000.0;
            let filtered = rlpf_ar(mix, cutoff, 1.0 - resonance * 0.9);

            filtered * env * amp
        })
});

// Odyssey Sample Hold - Random stepped modulation
define_synthdef("odyssey_sh", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("rate", 8.0) // units: Hz, range: 0..100, default: 8.0. Clock or modulation rate in Hz; higher values make motion faster.
        .body(|freq, amp, gate, rate| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // S&H style random modulation
            let sh = dust_ar(rate) * 100.0;
            let mod_freq = freq + sh;

            let osc1 = saw_ar(mod_freq);
            let osc2 = pulse_ar(freq, 0.5) * 0.5;

            let mix = (osc1 + osc2) * 0.45;

            let filtered = rlpf_ar(mix, 2500.0, 0.6);

            filtered * env * amp
        })
});

//
// # Usage: `odyssey_bass`
//
// ```rhai
// import "stdlib/synths/odyssey.vibe" as odyssey;
//
// let odyssey_bass = voice("doc_odyssey_bass")
//     .synth("odyssey_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("filter_freq", 1200.0);
// odyssey_bass.output("out").to_main();
// odyssey_bass.run();
// ```
//
// # Usage: `odyssey_lead`
//
// ```rhai
// import "stdlib/synths/odyssey.vibe" as odyssey;
//
// let odyssey_lead = voice("doc_odyssey_lead")
//     .synth("odyssey_lead")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("resonance", 0.5);
// odyssey_lead.output("out").to_main();
// odyssey_lead.run();
// ```
//
// # Usage: `odyssey_sh`
//
// ```rhai
// import "stdlib/synths/odyssey.vibe" as odyssey;
//
// let odyssey_sh = voice("doc_odyssey_sh")
//     .synth("odyssey_sh")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("rate", 8.0);
// odyssey_sh.output("out").to_main();
// odyssey_sh.run();
// ```
