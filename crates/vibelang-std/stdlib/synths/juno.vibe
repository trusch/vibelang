// Roland Juno-60/106 Emulation
// Classic 1980s | Character: Lush, shimmering, warm chorus
//
// The definitive polysynth sound. Known for its
// built-in chorus and smooth, creamy pads.

// Juno Pad - The iconic lush pad
define_synthdef("juno_pad", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("chorus", 0.7) // units: normalized, range: 0..1, default: 0.7. Chorus depth; higher values widen the synth with more modulation.
        .body(|freq, amp, gate, chorus| {
            let env = envelope()
                .asr(0.4, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Single DCO with sub oscillator
            let saw = saw_ar(freq);
            let sub = sin_osc_ar(freq * 0.5) * 0.4;

            let source = saw * 0.7 + sub;

            // Juno-style chorus (stereo detune)
            let lfo1 = sin_osc_ar(0.5) * chorus * 0.008;
            let lfo2 = sin_osc_ar(0.6) * chorus * 0.008;

            let voice1 = saw_ar(freq * (1.0 + lfo1));
            let voice2 = saw_ar(freq * (1.0 + lfo2));

            let chorused = (source + voice1 + voice2) * 0.35;

            // Warm resonant filter
            let filtered = rlpf_ar(chorused, 2000.0, 0.4);

            filtered * env * amp
        })
});

// Juno Brass - Classic synth brass
define_synthdef("juno_brass", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.08, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope for brass attack
            let filt_env = envelope()
                .asr(0.03, 1.0, 0.15)
                .gate(gate)
                .build();

            // Saw waves with PWM character
            let saw1 = saw_ar(freq);
            let saw2 = saw_ar(freq * 1.003);

            let source = (saw1 + saw2) * 0.5;

            // Filter sweep
            let cutoff = 600.0 + filt_env * 3000.0;
            let filtered = rlpf_ar(source, cutoff, 0.3);

            filtered * env * amp
        })
});

// Juno Bass - Punchy analog bass
define_synthdef("juno_bass", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Saw + sub
            let saw = saw_ar(freq);
            let sub = sin_osc_ar(freq * 0.5) * 0.5;

            let source = saw * 0.6 + sub;

            // Punchy filter envelope
            let filt_env = envelope()
                .perc(0.001, 0.2)
                .build();
            let cutoff = 400.0 + filt_env * 2000.0;

            let filtered = rlpf_ar(source, cutoff, 0.35);

            filtered * env * amp
        })
});

// Juno Strings - Classic polysynth strings
define_synthdef("juno_strings", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.3, 1.0, 0.4)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Multiple detuned voices
            let v1 = saw_ar(freq * 0.996);
            let v2 = saw_ar(freq * 0.999);
            let v3 = saw_ar(freq * 1.001);
            let v4 = saw_ar(freq * 1.004);

            let voices = (v1 + v2 + v3 + v4) * 0.3;

            // Smooth filtering
            let filtered = lpf_ar(voices, 3500.0);

            filtered * env * amp
        })
});

//
// # Usage: `juno_pad`
//
// ```rhai
// import "stdlib/synths/juno.vibe" as juno;
//
// let juno_pad = voice("doc_juno_pad")
//     .synth("juno_pad")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("chorus", 0.7);
// juno_pad.output("out").to_main();
// juno_pad.run();
// ```
//
// # Usage: `juno_brass`
//
// ```rhai
// import "stdlib/synths/juno.vibe" as juno;
//
// let juno_brass = voice("doc_juno_brass")
//     .synth("juno_brass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// juno_brass.output("out").to_main();
// juno_brass.run();
// ```
//
// # Usage: `juno_bass`
//
// ```rhai
// import "stdlib/synths/juno.vibe" as juno;
//
// let juno_bass = voice("doc_juno_bass")
//     .synth("juno_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// juno_bass.output("out").to_main();
// juno_bass.run();
// ```
//
// # Usage: `juno_strings`
//
// ```rhai
// import "stdlib/synths/juno.vibe" as juno;
//
// let juno_strings = voice("doc_juno_strings")
//     .synth("juno_strings")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// juno_strings.output("out").to_main();
// juno_strings.run();
// ```
