// Sequential Circuits Pro-One Emulation
// Classic 1981 | Character: Aggressive, mono, versatile

// Pro-One Bass - Punchy mono bass
define_synthdef("pro_one_bass", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("filter_freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Filter Freq in Hz; higher values move that tone or filter point upward.
        .param("resonance", 0.4) // units: resonance, range: 0..1, default: 0.4. Filter resonance amount; higher emphasizes a narrower frequency peak.
        .body(|freq, amp, gate, filter_freq, resonance| {
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.005, 1.0, 0.15)
                .gate(gate)
                .build();

            // Dual oscillators
            let osc1 = saw_ar(freq);
            let osc2 = pulse_ar(freq * 0.5, 0.3) * 0.7;

            let mix = (osc1 + osc2) * 0.5;

            let cutoff = filter_freq + filt_env * 2000.0;
            let filtered = rlpf_ar(mix, cutoff, 1.0 - resonance * 0.9);

            filtered * env * amp
        })
});

// Pro-One Lead - Aggressive lead
define_synthdef("pro_one_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("pw", 0.3) // units: ratio, range: 0..1, default: 0.3. PW macro; higher moves that model axis toward its brighter or more open setting.
        .body(|freq, amp, gate, pw| {
            let env = envelope()
                .asr(0.01, 1.0, 0.12)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.01, 1.0, 0.2)
                .gate(gate)
                .build();

            // PWM lead
            let pwm = sin_osc_ar(3.0) * 0.2 + pw;
            let osc1 = pulse_ar(freq, pwm);
            let osc2 = saw_ar(freq * 1.003) * 0.5;

            let mix = (osc1 + osc2) * 0.45;

            let cutoff = 1500.0 + filt_env * 3500.0;
            let filtered = rlpf_ar(mix, cutoff, 0.65);

            filtered * env * amp
        })
});

// Pro-One Sync - Hard sync lead
define_synthdef("pro_one_sync", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("sync_ratio", 2.0) // units: ratio, range: 0..8, default: 2.0. Frequency ratio; higher values tune the related oscillator or clock upward.
        .body(|freq, amp, gate, sync_ratio| {
            let env = envelope()
                .asr(0.01, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Simulated hard sync
            let master = saw_ar(freq);
            let slave_freq = freq * sync_ratio;
            let slave = saw_ar(slave_freq) * 0.6;
            let harmonics = sin_osc_ar(slave_freq * 2.0) * 0.2;

            let mix = (master + slave + harmonics) * 0.4;

            let filtered = lpf_ar(mix, 5000.0);

            filtered * env * amp
        })
});

//
// # Usage: `pro_one_bass`
//
// ```rhai
// import "stdlib/synths/pro_one.vibe" as pro_one;
//
// let pro_one_bass = voice("doc_pro_one_bass")
//     .synth("pro_one_bass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("filter_freq", 1200.0);
// pro_one_bass.output("out").to_main();
// pro_one_bass.run();
// ```
//
// # Usage: `pro_one_lead`
//
// ```rhai
// import "stdlib/synths/pro_one.vibe" as pro_one;
//
// let pro_one_lead = voice("doc_pro_one_lead")
//     .synth("pro_one_lead")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("pw", 0.3);
// pro_one_lead.output("out").to_main();
// pro_one_lead.run();
// ```
//
// # Usage: `pro_one_sync`
//
// ```rhai
// import "stdlib/synths/pro_one.vibe" as pro_one;
//
// let pro_one_sync = voice("doc_pro_one_sync")
//     .synth("pro_one_sync")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("sync_ratio", 2.0);
// pro_one_sync.output("out").to_main();
// pro_one_sync.run();
// ```
