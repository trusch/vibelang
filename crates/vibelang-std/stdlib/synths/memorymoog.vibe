// Memorymoog Emulation
// Classic 1982 | Character: Massive, warm, rich polyphonic Moog

// Memorymoog Pad - Lush poly pad
define_synthdef("memorymoog_pad", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.4, 1.0, 0.5)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Six voice unison simulation
            let detune = 0.003;
            let osc1 = saw_ar(freq * (1.0 - detune * 2.0)) * 0.2;
            let osc2 = saw_ar(freq * (1.0 - detune)) * 0.2;
            let osc3 = saw_ar(freq) * 0.2;
            let osc4 = saw_ar(freq * (1.0 + detune)) * 0.2;
            let osc5 = saw_ar(freq * (1.0 + detune * 2.0)) * 0.2;
            let sub = sin_osc_ar(freq * 0.5) * 0.15;

            let mix = osc1 + osc2 + osc3 + osc4 + osc5 + sub;

            // Warm Moog ladder filter
            let filtered = lpf_ar(mix, 2800.0);

            filtered * env * amp
        })
});

// Memorymoog Brass - Poly brass section
define_synthdef("memorymoog_brass", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.08, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.1, 1.0, 0.25)
                .gate(gate)
                .build();

            // Rich detuned oscillators
            let osc1 = saw_ar(freq * 0.997);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.003);

            let mix = (osc1 + osc2 + osc3) * 0.4;

            let cutoff = 600.0 + filt_env * 3000.0;
            let filtered = rlpf_ar(mix, cutoff, 0.65);

            filtered * env * amp
        })
});

// Memorymoog Lead - Fat poly lead
define_synthdef("memorymoog_lead", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            let env = envelope()
                .asr(0.02, 1.0, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let filt_env = envelope()
                .asr(0.02, 1.0, 0.2)
                .gate(gate)
                .build();

            // Three oscillators
            let osc1 = saw_ar(freq);
            let osc2 = saw_ar(freq * 1.004) * 0.8;
            let osc3 = pulse_ar(freq * 2.0, 0.3) * 0.3;

            let mix = (osc1 + osc2 + osc3) * 0.4;

            let cutoff = 2000.0 + filt_env * 4000.0;
            let filtered = rlpf_ar(mix, cutoff, 0.6);

            filtered * env * amp
        })
});

//
// # Usage: `memorymoog_pad`
//
// ```rhai
// import "stdlib/synths/memorymoog.vibe" as memorymoog;
//
// let memorymoog_pad = voice("doc_memorymoog_pad")
//     .synth("memorymoog_pad")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// memorymoog_pad.output("out").to_main();
// memorymoog_pad.run();
// ```
//
// # Usage: `memorymoog_brass`
//
// ```rhai
// import "stdlib/synths/memorymoog.vibe" as memorymoog;
//
// let memorymoog_brass = voice("doc_memorymoog_brass")
//     .synth("memorymoog_brass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// memorymoog_brass.output("out").to_main();
// memorymoog_brass.run();
// ```
//
// # Usage: `memorymoog_lead`
//
// ```rhai
// import "stdlib/synths/memorymoog.vibe" as memorymoog;
//
// let memorymoog_lead = voice("doc_memorymoog_lead")
//     .synth("memorymoog_lead")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// memorymoog_lead.output("out").to_main();
// memorymoog_lead.run();
// ```
