// Genre: Video Game, Chiptune | Character: Jump sound effect
define_synthdef("sfx_jump")
    .param("freq", 150.0) // units: Hz, range: 20..20000, default: 150.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        let amp_env = envelope()
            .perc(0.001, 0.15)
            .cleanup_on_finish()
            .build();

        // Quick pitch up then down
        let pitch_env = envelope()
            .perc(0.001, 0.08)
            .build();
        let sweep_freq = freq + pitch_env * freq * 3.0;

        // Triangle wave
        let osc = lf_tri_ar(sweep_freq);

        osc * amp_env * amp
    });

//
// # Usage: `sfx_jump`
//
// ```rhai
// import "stdlib/retro/sfx_jump.vibe" as sfx_jump;
//
// let sfx_jump = voice("doc_sfx_jump")
//     .synth("sfx_jump")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// sfx_jump.output("out").to_main();
// sfx_jump.run();
// ```
