// Genre: Video Game, Chiptune | Character: Laser/shoot sound effect
define_synthdef("sfx_laser")
    .param("freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        let amp_env = envelope()
            .perc(0.001, 0.1)
            .cleanup_on_finish()
            .build();

        // Descending pitch
        let pitch_env = envelope()
            .perc(0.001, 0.08)
            .build();
        let sweep_freq = freq * (1.0 + pitch_env * 2.0);

        // Square wave
        let osc = pulse_ar(sweep_freq, 0.5);

        // Add noise burst
        let noise_e = envelope()
            .perc(0.001, 0.02)
            .build();
        let noise = hpf_ar(white_noise_ar(), 5000.0) * noise_e * 0.3;

        (osc + noise) * amp_env * amp
    });

//
// # Usage: `sfx_laser`
//
// ```rhai
// import "stdlib/retro/sfx_laser.vibe" as sfx_laser;
//
// let sfx_laser = voice("doc_sfx_laser")
//     .synth("sfx_laser")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// sfx_laser.output("out").to_main();
// sfx_laser.run();
// ```
