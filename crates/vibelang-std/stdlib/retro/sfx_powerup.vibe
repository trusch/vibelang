// Genre: Video Game, Chiptune | Character: Power-up ascending sound
define_synthdef("sfx_powerup")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        let amp_env = envelope()
            .perc(0.001, 0.4)
            .cleanup_on_finish()
            .build();

        // Ascending pitch
        let pitch_env = envelope()
            .perc(0.001, 0.35)
            .build();
        let sweep_freq = freq + pitch_env * freq * 4.0;

        // Pulse wave for chip sound
        let osc = pulse_ar(sweep_freq, 0.5);

        osc * amp_env * amp
    });

//
// # Usage: `sfx_powerup`
//
// ```rhai
// import "stdlib/retro/sfx_powerup.vibe" as sfx_powerup;
//
// let sfx_powerup = voice("doc_sfx_powerup")
//     .synth("sfx_powerup")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// sfx_powerup.output("out").to_main();
// sfx_powerup.run();
// ```
