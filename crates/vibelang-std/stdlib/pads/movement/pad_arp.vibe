// Genre: Ambient, Electronic | Character: Arpeggiated pad texture
define_synthdef("pad_arp")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("rate", 8.0) // units: Hz, range: 0..100, default: 8.0. Clock or modulation rate in Hz; higher values make motion faster.
    .body(|freq, amp, gate, rate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.25)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Arp-like amplitude modulation
        let arp_lfo = sin_osc_ar(rate);
        let arp_env = arp_lfo * 0.5 + 0.5;

        // Different pitches modulated
        let osc1 = sin_osc_ar(freq) * arp_env;
        let osc2 = sin_osc_ar(freq * 1.5) * (1.0 - arp_env) * 0.5;
        let osc3 = sin_osc_ar(freq * 2.0) * arp_env * 0.3;

        // Pad bed
        let bed = saw_ar(freq * 0.5) * 0.15;

        let mix = osc1 + osc2 + osc3 + bed;

        lpf_ar(mix, 4000.0) * env * amp
    });

//
// # Usage: `pad_arp`
//
// ```rhai
// import "stdlib/pads/movement/pad_arp.vibe" as pad_arp;
//
// let pad_arp = voice("doc_pad_arp")
//     .synth("pad_arp")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("rate", 8.0);
// pad_arp.output("out").to_main();
// pad_arp.run();
// ```
