// Genre: Cinematic, Ambient | Character: Slowly swelling pad
define_synthdef("pad_swelling")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        // Very slow attack
        let env = envelope()
            .asr(2.0, 1.0, 0.5)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter swell envelope
        let filt_env = envelope()
            .asr(2.5, 1.0, 0.5)
            .gate(gate)
            .build();

        // Rich detuned oscillators
        let osc1 = saw_ar(freq * 0.996);
        let osc2 = saw_ar(freq);
        let osc3 = saw_ar(freq * 1.004);

        let mix = (osc1 + osc2 + osc3) * 0.3;

        // Swelling filter
        let cutoff = 300.0 + filt_env * 4000.0;
        rlpf_ar(mix, cutoff, 0.12) * env * amp
    });

//
// # Usage: `pad_swelling`
//
// ```rhai
// import "stdlib/pads/movement/pad_swelling.vibe" as pad_swelling;
//
// let pad_swelling = voice("doc_pad_swelling")
//     .synth("pad_swelling")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_swelling.output("out").to_main();
// pad_swelling.run();
// ```
