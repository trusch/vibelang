// Genre: Horror, Dark Ambient | Character: Ghostly pad - eerie and unsettling
define_synthdef("pad_ghostly")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.5, 1.0, 0.6)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Slow, eerie modulation
        let mod1 = sin_osc_ar(0.15) * freq * 0.02;
        let mod2 = sin_osc_ar(0.23) * freq * 0.015;

        // Detuned, wavering tones
        let tone1 = sin_osc_ar(freq + mod1) * 0.35;
        let tone2 = sin_osc_ar(freq * 1.01 + mod2) * 0.25;
        let tone3 = sin_osc_ar(freq * 0.99 - mod1) * 0.25;

        // Spectral component
        let spectral = bpf_ar(pink_noise_ar(), freq * 3.0, 0.3) * 0.1;

        let sig = tone1 + tone2 + tone3 + spectral;

        lpf_ar(sig, 2500.0) * env * amp
    });

//
// # Usage: `pad_ghostly`
//
// ```rhai
// import "stdlib/pads/textural/pad_ghostly.vibe" as pad_ghostly;
//
// let pad_ghostly = voice("doc_pad_ghostly")
//     .synth("pad_ghostly")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_ghostly.output("out").to_main();
// pad_ghostly.run();
// ```
