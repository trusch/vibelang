// Genre: Ambient, Cinematic | Character: Glass/crystalline pad - bright and delicate
define_synthdef("pad_glass")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.3, 1.0, 0.4)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Bright sine harmonics
        let h1 = sin_osc_ar(freq) * 0.4;
        let h2 = sin_osc_ar(freq * 2.0) * 0.25;
        let h3 = sin_osc_ar(freq * 3.0) * 0.15;
        let h4 = sin_osc_ar(freq * 4.0) * 0.1;
        let h5 = sin_osc_ar(freq * 5.0) * 0.06;

        // Slight shimmer
        let shimmer_lfo = sin_osc_ar(4.0) * 0.02 + 1.0;
        let shimmer = sin_osc_ar(freq * 6.0 * shimmer_lfo) * 0.04;

        let sig = h1 + h2 + h3 + h4 + h5 + shimmer;

        sig * env * amp
    });

//
// # Usage: `pad_glass`
//
// ```rhai
// import "stdlib/pads/textural/pad_glass.vibe" as pad_glass;
//
// let pad_glass = voice("doc_pad_glass")
//     .synth("pad_glass")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_glass.output("out").to_main();
// pad_glass.run();
// ```
