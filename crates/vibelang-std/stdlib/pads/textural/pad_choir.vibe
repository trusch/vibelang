// Genre: Cinematic, Ambient | Character: Choir pad - ethereal voices
define_synthdef("pad_choir")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.35, 1.0, 0.4)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.0) * freq * 0.008;

        // Multiple voices with formants
        let voice1 = saw_ar(freq + vib) * 0.3;
        let voice2 = saw_ar(freq * 1.002 + vib * 0.8) * 0.25;
        let voice3 = saw_ar(freq * 0.998 + vib * 1.2) * 0.25;

        let mix = voice1 + voice2 + voice3;

        // Vowel formants (aaah)
        let f1 = bpf_ar(mix, 700.0, 0.12) * 0.5;
        let f2 = bpf_ar(mix, 1200.0, 0.15) * 0.3;
        let f3 = bpf_ar(mix, 2500.0, 0.2) * 0.15;

        let sig = f1 + f2 + f3;

        sig * env * amp
    });

//
// # Usage: `pad_choir`
//
// ```rhai
// import "stdlib/pads/textural/pad_choir.vibe" as pad_choir;
//
// let pad_choir = voice("doc_pad_choir")
//     .synth("pad_choir")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_choir.output("out").to_main();
// pad_choir.run();
// ```
