// Genre: Ambient, Drone | Character: Cold, digital pad
define_synthdef("pad_cold", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Slow attack
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.4, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Pulse waves for digital character
            let pulse1 = saw_ar(freq * 0.997);
            let pulse2 = saw_ar(freq);
            let pulse3 = saw_ar(freq * 1.003);

            let mix = (pulse1 + pulse2 + pulse3) * 0.33;

            // Cold filtering - remove lows
            let hp = hpf_ar(mix, 300.0);
            let filtered = lpf_ar(hp, 2500.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_cold`
//
// ```rhai
// import "stdlib/pads/ambient/pad_cold.vibe" as pad_cold;
//
// let pad_cold = voice("doc_pad_cold")
//     .synth("pad_cold")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_cold.output("out").to_main();
// pad_cold.run();
// ```
