// Genre: Ambient, Post-Rock | Character: Shimmering pad with high harmonics
define_synthdef("pad_shimmer", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Long attack for shimmer
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.5, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Fundamental and high harmonics
            let fundamental = saw_ar(freq) * 0.4;
            let harmonic2 = saw_ar(freq * 2.0) * 0.25;
            let harmonic3 = saw_ar(freq * 3.0) * 0.15;
            let harmonic4 = saw_ar(freq * 4.0) * 0.1;

            let mix = fundamental + harmonic2 + harmonic3 + harmonic4;

            // Bright filter
            let filtered = lpf_ar(mix, 4000.0);

            // High-pass for air
            let clean = hpf_ar(filtered, 200.0);

            clean * env * amp
        })
});

//
// # Usage: `pad_shimmer`
//
// ```rhai
// import "stdlib/pads/ambient/pad_shimmer.vibe" as pad_shimmer;
//
// let pad_shimmer = voice("doc_pad_shimmer")
//     .synth("pad_shimmer")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_shimmer.output("out").to_main();
// pad_shimmer.run();
// ```
