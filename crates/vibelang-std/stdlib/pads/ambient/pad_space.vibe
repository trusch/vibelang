// Genre: Ambient, Space Music | Character: Spacious, atmospheric pad
define_synthdef("pad_space", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Very long attack and release
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.8, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Wide detuning for space
            let osc1 = saw_ar(freq * 0.985);
            let osc2 = saw_ar(freq * 0.995);
            let osc3 = saw_ar(freq);
            let osc4 = saw_ar(freq * 1.005);
            let osc5 = saw_ar(freq * 1.015);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.2;

            // Filter movement for evolution
            let filter_env = envelope()
                .asr(1.5, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 800.0 + (filter_env * 2500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            // Remove mud
            let clean = hpf_ar(filtered, 120.0);

            clean * env * amp
        })
});

//
// # Usage: `pad_space`
//
// ```rhai
// import "stdlib/pads/ambient/pad_space.vibe" as pad_space;
//
// let pad_space = voice("doc_pad_space")
//     .synth("pad_space")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_space.output("out").to_main();
// pad_space.run();
// ```
