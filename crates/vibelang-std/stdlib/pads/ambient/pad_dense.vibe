// Genre: Ambient, Drone | Character: Dense, thick pad
define_synthdef("pad_dense", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Moderate attack, long sustain
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.3, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Many detuned oscillators for thickness
            let osc1 = saw_ar(freq * 0.988);
            let osc2 = saw_ar(freq * 0.994);
            let osc3 = saw_ar(freq);
            let osc4 = saw_ar(freq * 1.006);
            let osc5 = saw_ar(freq * 1.012);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.2;

            // Warm filtering
            let filtered = lpf_ar(mix, 1800.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_dense`
//
// ```rhai
// import "stdlib/pads/ambient/pad_dense.vibe" as pad_dense;
//
// let pad_dense = voice("doc_pad_dense")
//     .synth("pad_dense")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_dense.output("out").to_main();
// pad_dense.run();
// ```
