// Genre: Ambient, Minimal | Character: Sparse, minimal pad
define_synthdef("pad_sparse", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Very slow attack
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.6, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Just two oscillators, subtle detuning
            let osc1 = sin_osc_ar(freq * 0.998);
            let osc2 = sin_osc_ar(freq * 1.002);

            let mix = (osc1 + osc2) * 0.5;

            // Minimal filtering
            let filtered = lpf_ar(mix, 2000.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_sparse`
//
// ```rhai
// import "stdlib/pads/ambient/pad_sparse.vibe" as pad_sparse;
//
// let pad_sparse = voice("doc_pad_sparse")
//     .synth("pad_sparse")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_sparse.output("out").to_main();
// pad_sparse.run();
// ```
