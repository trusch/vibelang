// Genre: Ambient, Chillout | Character: Bright, airy pad
define_synthdef("pad_bright", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Slow attack, long release
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.4, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Bright oscillators with wide detuning
            let osc1 = saw_ar(freq * 0.990);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.010);

            let mix = (osc1 + osc2 + osc3) * 0.33;

            // Bright filtering
            let filtered = lpf_ar(mix, 3000.0);

            // High-pass to remove mud
            let clean = hpf_ar(filtered, 150.0);

            clean * env * amp
        })
});

//
// # Usage: `pad_bright`
//
// ```rhai
// import "stdlib/pads/ambient/pad_bright.vibe" as pad_bright;
//
// let pad_bright = voice("doc_pad_bright")
//     .synth("pad_bright")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_bright.output("out").to_main();
// pad_bright.run();
// ```
