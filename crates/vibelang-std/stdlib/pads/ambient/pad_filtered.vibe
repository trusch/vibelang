// Genre: Ambient, Techno | Character: Heavily filtered pad with resonance
define_synthdef("pad_filtered", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Slow attack
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.4, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Detuned saws
            let osc1 = saw_ar(freq * 0.995);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.005);

            let mix = (osc1 + osc2 + osc3) * 0.33;

            // Resonant filter
            let filter_env = envelope()
                .asr(0.8, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 500.0 + (filter_env * 1500.0);

            let filtered = rlpf_ar(mix, mod_cutoff, 0.4);

            filtered * env * amp
        })
});

//
// # Usage: `pad_filtered`
//
// ```rhai
// import "stdlib/pads/ambient/pad_filtered.vibe" as pad_filtered;
//
// let pad_filtered = voice("doc_pad_filtered")
//     .synth("pad_filtered")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_filtered.output("out").to_main();
// pad_filtered.run();
// ```
