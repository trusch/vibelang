// Genre: Ambient, Experimental | Character: Evolving pad with filter movement
define_synthdef("pad_evolving", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Long attack and release
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.5, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Detuned oscillators
            let osc1 = saw_ar(freq * 0.993);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.007);

            let mix = (osc1 + osc2 + osc3) * 0.33;

            // Filter evolves over time
            let filter_env = envelope()
                .asr(1.0, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 600.0 + (filter_env * 2000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: `pad_evolving`
//
// ```rhai
// import "stdlib/pads/ambient/pad_evolving.vibe" as pad_evolving;
//
// let pad_evolving = voice("doc_pad_evolving")
//     .synth("pad_evolving")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_evolving.output("out").to_main();
// pad_evolving.run();
// ```
