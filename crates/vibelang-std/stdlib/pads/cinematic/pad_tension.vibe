// Genre: Film Score, Horror | Character: Tension-building pad
define_synthdef("pad_tension")
    .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.5, 1.0, 0.4)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Dissonant cluster
        let osc1 = sin_osc_ar(freq) * 0.35;
        let osc2 = sin_osc_ar(freq * 1.06) * 0.25; // Minor 2nd
        let osc3 = sin_osc_ar(freq * 1.12) * 0.2;  // Augmented

        // Low rumble
        let rumble = lpf_ar(pink_noise_ar(), 100.0) * 0.15;

        // Slow rising filter
        let filt_env = envelope()
            .asr(1.0, 1.0, 0.5)
            .gate(gate)
            .build();

        let mix = osc1 + osc2 + osc3 + rumble;
        let cutoff = 200.0 + filt_env * 1500.0;

        lpf_ar(mix, cutoff) * env * amp
    });

//
// # Usage: `pad_tension`
//
// ```rhai
// import "stdlib/pads/cinematic/pad_tension.vibe" as pad_tension;
//
// let pad_tension = voice("doc_pad_tension")
//     .synth("pad_tension")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_tension.output("out").to_main();
// pad_tension.run();
// ```
