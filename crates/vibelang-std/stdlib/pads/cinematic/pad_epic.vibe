// Genre: Epic, Trailer | Character: Epic orchestral pad - massive and powerful
define_synthdef("pad_epic")
    .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.4, 1.0, 0.4)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope for power
        let filt_env = envelope()
            .asr(0.5, 1.0, 0.4)
            .gate(gate)
            .build();

        // Multiple octaves for size
        let low = saw_ar(freq) * 0.3;
        let mid1 = saw_ar(freq * 2.0 * 0.998) * 0.2;
        let mid2 = saw_ar(freq * 2.0) * 0.2;
        let mid3 = saw_ar(freq * 2.0 * 1.002) * 0.2;
        let high = saw_ar(freq * 4.0) * 0.1;

        let mix = low + mid1 + mid2 + mid3 + high;

        // Powerful filter sweep
        let cutoff = 400.0 + filt_env * 4000.0;
        rlpf_ar(mix, cutoff, 0.15) * env * amp
    });

//
// # Usage: `pad_epic`
//
// ```rhai
// import "stdlib/pads/cinematic/pad_epic.vibe" as pad_epic;
//
// let pad_epic = voice("doc_pad_epic")
//     .synth("pad_epic")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_epic.output("out").to_main();
// pad_epic.run();
// ```
