// Genre: Horror, Dark Ambient | Character: Horror pad - dark and unsettling
define_synthdef("pad_horror")
    .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.6, 1.0, 0.5)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Slow detuning for unease
        let detune = sin_osc_ar(0.1) * freq * 0.03;

        // Dark oscillators
        let osc1 = saw_ar(freq + detune) * 0.3;
        let osc2 = saw_ar(freq * 1.5 - detune) * 0.2;
        let sub = sin_osc_ar(freq * 0.5) * 0.25;

        // Noise texture
        let noise = lpf_ar(pink_noise_ar(), 400.0) * 0.1;

        let mix = osc1 + osc2 + sub + noise;

        // Dark filtering
        lpf_ar(mix, 600.0) * env * amp
    });

//
// # Usage: `pad_horror`
//
// ```rhai
// import "stdlib/pads/cinematic/pad_horror.vibe" as pad_horror;
//
// let pad_horror = voice("doc_pad_horror")
//     .synth("pad_horror")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_horror.output("out").to_main();
// pad_horror.run();
// ```
