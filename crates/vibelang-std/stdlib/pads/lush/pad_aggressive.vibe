// Genre: Techno, Industrial | Character: Aggressive, driven pad
define_synthdef("pad_aggressive", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Sharper attack
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.08, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Detuned saws with more energy
            let osc1 = saw_ar(freq * 0.993);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.007);

            let mix = (osc1 + osc2 + osc3) * 0.4;

            // Clip for aggression
            let driven = clip(mix, -0.9, 0.9);

            // Filtering
            let filtered = lpf_ar(driven, 2800.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_aggressive`
//
// ```rhai
// import "stdlib/pads/lush/pad_aggressive.vibe" as pad_aggressive;
//
// let pad_aggressive = voice("doc_pad_aggressive")
//     .synth("pad_aggressive")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_aggressive.output("out").to_main();
// pad_aggressive.run();
// ```
