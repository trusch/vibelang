// Genre: Synthwave, Pop | Character: Chorused pad with movement
define_synthdef("pad_chorus", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Pad envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.3, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Detuned oscillators simulating chorus
            let osc1 = saw_ar(freq * 0.992);
            let osc2 = saw_ar(freq * 0.996);
            let osc3 = saw_ar(freq);
            let osc4 = saw_ar(freq * 1.004);
            let osc5 = saw_ar(freq * 1.008);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.2;

            // Filtering
            let filtered = lpf_ar(mix, 3000.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_chorus`
//
// ```rhai
// import "stdlib/pads/lush/pad_chorus.vibe" as pad_chorus;
//
// let pad_chorus = voice("doc_pad_chorus")
//     .synth("pad_chorus")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_chorus.output("out").to_main();
// pad_chorus.run();
// ```
