// Genre: Ambient, Experimental | Character: Morphing, evolving lush pad
define_synthdef("pad_morphing", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Long evolution
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.6, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Detuned oscillators
            let osc1 = saw_ar(freq * 0.991);
            let osc2 = saw_ar(freq * 0.998);
            let osc3 = saw_ar(freq);
            let osc4 = saw_ar(freq * 1.002);
            let osc5 = saw_ar(freq * 1.009);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.2;

            // Evolving filter
            let filter_env = envelope()
                .asr(1.2, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 500.0 + (filter_env * 3000.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            // Resonance evolves too
            let resonant = rlpf_ar(filtered, mod_cutoff * 0.8, 0.5);

            resonant * env * amp
        })
});

//
// # Usage: `pad_morphing`
//
// ```rhai
// import "stdlib/pads/lush/pad_morphing.vibe" as pad_morphing;
//
// let pad_morphing = voice("doc_pad_morphing")
//     .synth("pad_morphing")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_morphing.output("out").to_main();
// pad_morphing.run();
// ```
