// Genre: Ambient, Chillout | Character: Very wide stereo pad
define_synthdef("pad_wide", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Slow envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.4, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Extreme detuning for width
            let left1 = saw_ar(freq * 0.975);
            let left2 = saw_ar(freq * 0.990);
            let center = saw_ar(freq);
            let right1 = saw_ar(freq * 1.010);
            let right2 = saw_ar(freq * 1.025);

            let mix = (left1 + left2 + center + right1 + right2) * 0.2;

            // Filtering
            let filtered = lpf_ar(mix, 2800.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_wide`
//
// ```rhai
// import "stdlib/pads/lush/pad_wide.vibe" as pad_wide;
//
// let pad_wide = voice("doc_pad_wide")
//     .synth("pad_wide")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_wide.output("out").to_main();
// pad_wide.run();
// ```
