// Genre: Gospel, Jazz | Character: Organ-like pad with drawbars
define_synthdef("pad_organ", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Quick attack like organ
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Organ drawbars (harmonic series)
            let h1 = sin_osc_ar(freq) * 0.5;
            let h2 = sin_osc_ar(freq * 2.0) * 0.4;
            let h3 = sin_osc_ar(freq * 3.0) * 0.3;
            let h4 = sin_osc_ar(freq * 4.0) * 0.2;
            let h5 = sin_osc_ar(freq * 5.0) * 0.15;
            let h6 = sin_osc_ar(freq * 6.0) * 0.1;

            let mix = h1 + h2 + h3 + h4 + h5 + h6;

            // Gentle filtering
            let filtered = lpf_ar(mix, 3500.0);

            filtered * env * amp * 0.6
        })
});

//
// # Usage: `pad_organ`
//
// ```rhai
// import "stdlib/pads/lush/pad_organ.vibe" as pad_organ;
//
// let pad_organ = voice("doc_pad_organ")
//     .synth("pad_organ")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_organ.output("out").to_main();
// pad_organ.run();
// ```
