// Genre: Minimal, House | Character: Narrow, focused lush pad
define_synthdef("pad_narrow", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Pad envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.3, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Subtle detuning
            let osc1 = saw_ar(freq * 0.998);
            let osc2 = saw_ar(freq);
            let osc3 = saw_ar(freq * 1.002);

            let mix = (osc1 + osc2 + osc3) * 0.33;

            // Filtering
            let filtered = lpf_ar(mix, 2200.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_narrow`
//
// ```rhai
// import "stdlib/pads/lush/pad_narrow.vibe" as pad_narrow;
//
// let pad_narrow = voice("doc_pad_narrow")
//     .synth("pad_narrow")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_narrow.output("out").to_main();
// pad_narrow.run();
// ```
