// Genre: Trance, EDM | Character: Heavily detuned, wide and lush
define_synthdef("pad_detuned", |builder| {
    builder
        .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.35) // units: linear, range: 0..1, default: 0.35. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Slow attack for pad character
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.25, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Many detuned oscillators for width
            let osc1 = saw_ar(freq * 0.980);
            let osc2 = saw_ar(freq * 0.990);
            let osc3 = saw_ar(freq * 0.998);
            let osc4 = saw_ar(freq);
            let osc5 = saw_ar(freq * 1.002);
            let osc6 = saw_ar(freq * 1.010);
            let osc7 = saw_ar(freq * 1.020);

            let mix = (osc1 + osc2 + osc3 + osc4 + osc5 + osc6 + osc7) * 0.14;

            // Lush filtering
            let filtered = lpf_ar(mix, 2500.0);

            filtered * env * amp
        })
});

//
// # Usage: `pad_detuned`
//
// ```rhai
// import "stdlib/pads/lush/pad_detuned.vibe" as pad_detuned;
//
// let pad_detuned = voice("doc_pad_detuned")
//     .synth("pad_detuned")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_detuned.output("out").to_main();
// pad_detuned.run();
// ```
