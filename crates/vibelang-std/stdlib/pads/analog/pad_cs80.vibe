// Genre: Cinematic, Synthwave | Character: Yamaha CS-80 pad - expressive and cinematic
define_synthdef("pad_cs80")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.25, 1.0, 0.35)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Slow filter envelope
        let filt_env = envelope()
            .asr(0.4, 1.0, 0.4)
            .gate(gate)
            .build();

        // Rich detuned oscillators
        let osc1 = saw_ar(freq * 0.994);
        let osc2 = saw_ar(freq * 0.998);
        let osc3 = saw_ar(freq);
        let osc4 = saw_ar(freq * 1.002);
        let osc5 = saw_ar(freq * 1.006);

        let mix = (osc1 + osc2 + osc3 + osc4 + osc5) * 0.18;

        // Expressive filter
        let cutoff = 500.0 + filt_env * 2500.0;
        rlpf_ar(mix, cutoff, 0.12) * env * amp
    });

//
// # Usage: `pad_cs80`
//
// ```rhai
// import "stdlib/pads/analog/pad_cs80.vibe" as pad_cs80;
//
// let pad_cs80 = voice("doc_pad_cs80")
//     .synth("pad_cs80")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_cs80.output("out").to_main();
// pad_cs80.run();
// ```
