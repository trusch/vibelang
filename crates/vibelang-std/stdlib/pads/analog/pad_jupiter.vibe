// Genre: Electronic, Synthpop | Character: Roland Jupiter-8 pad - bright and wide
define_synthdef("pad_jupiter")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.18, 1.0, 0.28)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .asr(0.25, 1.0, 0.3)
            .gate(gate)
            .build();

        // Detuned saws with pulse
        let saw1 = saw_ar(freq * 0.997);
        let saw2 = saw_ar(freq);
        let saw3 = saw_ar(freq * 1.003);
        let pulse = pulse_ar(freq, 0.45) * 0.4;

        let mix = (saw1 + saw2 + saw3 + pulse) * 0.25;

        // Bright but smooth filter
        let cutoff = 1000.0 + filt_env * 3500.0;
        rlpf_ar(mix, cutoff, 0.15) * env * amp
    });

//
// # Usage: `pad_jupiter`
//
// ```rhai
// import "stdlib/pads/analog/pad_jupiter.vibe" as pad_jupiter;
//
// let pad_jupiter = voice("doc_pad_jupiter")
//     .synth("pad_jupiter")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// pad_jupiter.output("out").to_main();
// pad_jupiter.run();
// ```
