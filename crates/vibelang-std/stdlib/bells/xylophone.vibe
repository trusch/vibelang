// Xylophone
// Genre: Orchestral, Marimba | Character: Bright, wooden, percussive
//
// Wooden mallet percussion with short decay.

define_synthdef("xylophone", |builder| {
    builder
        .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            // Short percussive envelope
            let env = envelope()
                .asr(0.001, 1.0, 0.05)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Short decay
            let decay_env = envelope()
                .perc(0.001, 0.3)
                .build();

            // Xylophone partials (bright, woody)
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 3.0) * 0.4; // Strong 3rd harmonic
            let h3 = sin_osc_ar(freq * 4.0) * 0.2;
            let h4 = sin_osc_ar(freq * 6.0) * 0.15;

            let wood = h1 + h2 + h3 + h4;

            // Woody mallet click
            let click_env = envelope()
                .perc(0.0001, 0.015)
                .build();
            let click = white_noise_ar() * click_env * 0.2;
            let click_filtered = hpf_ar(click, 2000.0);

            (wood + click_filtered) * env * decay_env * amp * 0.7
        })
});

//
// # Usage: `xylophone`
//
// ```rhai
// import "stdlib/bells/xylophone.vibe" as xylophone;
//
// let xylophone = voice("doc_xylophone")
//     .synth("xylophone")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// xylophone.output("out").to_main();
// xylophone.run();
// ```
