// Vibraphone
// Genre: Jazz, Lounge | Character: Warm, mellow, vibrato
//
// Jazz vibraphone with characteristic motor vibrato.

define_synthdef("vibraphone", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("vibrato_speed", 5.0) // units: Hz, range: 0..20, default: 5.0. Vibrato rate in Hz; higher makes pitch modulation faster.
        .body(|freq, amp, gate, vibrato_speed| {
            // Vibes envelope
            let env = envelope()
                .asr(0.005, 1.0, 0.4)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Medium-long decay
            let decay_env = envelope()
                .perc(0.001, 2.0)
                .build();

            // Vibraphone partials
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 2.0) * 0.5;
            let h3 = sin_osc_ar(freq * 3.0) * 0.3;
            let h4 = sin_osc_ar(freq * 4.0) * 0.2;
            let h5 = sin_osc_ar(freq * 4.8) * 0.1; // Slightly inharmonic

            let bell = h1 + h2 + h3 + h4 + h5;

            // Motor vibrato (amplitude tremolo)
            let motor = sin_osc_ar(vibrato_speed) * 0.3 + 0.7;

            // Mallet soft attack
            let mallet_env = envelope()
                .perc(0.001, 0.03)
                .build();
            let mallet = white_noise_ar() * mallet_env * 0.05;

            (bell * motor + mallet) * env * decay_env * amp * 0.6
        })
});

//
// # Usage: `vibraphone`
//
// ```rhai
// import "stdlib/bells/vibraphone.vibe" as vibraphone;
//
// let vibraphone = voice("doc_vibraphone")
//     .synth("vibraphone")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("vibrato_speed", 5.0);
// vibraphone.output("out").to_main();
// vibraphone.run();
// ```
