// Marimba
// Genre: World, Jazz | Character: Warm, resonant, wooden
//
// Deep wooden marimba with resonant body.

define_synthdef("marimba", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            // Marimba envelope
            let env = envelope()
                .asr(0.001, 1.0, 0.2)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Medium decay
            let decay_env = envelope()
                .perc(0.001, 0.6)
                .build();

            // Marimba partials (warm, strong fundamental)
            let h1 = sin_osc_ar(freq);
            let h2 = sin_osc_ar(freq * 3.0) * 0.3;
            let h3 = sin_osc_ar(freq * 4.0) * 0.15;
            let h4 = sin_osc_ar(freq * 5.0) * 0.08;

            let wood = h1 + h2 + h3 + h4;

            // Soft mallet attack
            let mallet_env = envelope()
                .perc(0.001, 0.02)
                .build();
            let mallet = white_noise_ar() * mallet_env * 0.08;
            let mallet_filtered = lpf_ar(mallet, 3000.0);

            // Body resonance
            let body = rlpf_ar(wood, freq * 1.5, 0.3) * 0.3;

            (wood + body + mallet_filtered) * env * decay_env * amp * 0.7
        })
});

//
// # Usage: `marimba`
//
// ```rhai
// import "stdlib/bells/marimba.vibe" as marimba;
//
// let marimba = voice("doc_marimba")
//     .synth("marimba")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// marimba.output("out").to_main();
// marimba.run();
// ```
