// Triad Functions
// ============================================================================

/// @vibelang-api export=public support=supported
fn major_triad(root) {
    major_triad_ex(root, 4)
}

/// @vibelang-api export=public support=supported
fn major_triad_ex(root, octave) {
    return _generate_chord_ex(root, _major_triad_intervals(), octave);
}

