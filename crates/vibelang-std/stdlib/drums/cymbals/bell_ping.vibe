// Genre: Jazz, Experimental | Character: Ride bell or cymbal ping
define_synthdef("bell_ping", |builder| {
    builder
        .param("freq", 880.0) // units: Hz, range: 20..20000, default: 880.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Medium decay
            let env = envelope()
                .perc(0.001, 0.8)
                .cleanup_on_finish()
                .build();

            // Clear bell tones with inharmonic partials
            let bell1 = sin_osc_ar(freq) * 0.4;
            let bell2 = sin_osc_ar(freq * 1.5) * 0.3;
            let bell3 = sin_osc_ar(freq * 2.3) * 0.2;
            let bell4 = sin_osc_ar(freq * 3.8) * 0.1;

            let bells = bell1 + bell2 + bell3 + bell4;

            // Metallic shimmer
            let metal = saw_ar(freq * 4.5) * 0.15;

            // Subtle attack noise
            let attack_env = envelope()
                .perc(0.0005, 0.008)
                .build();
            let attack = white_noise_ar() * attack_env * 0.1;

            (bells + metal + attack) * env * amp
        })
});

//
// # Usage: bell_ping
//
// ```rhai
// import "stdlib/drums/cymbals/bell_ping.vibe" as bell_ping;
//
// let doc_bell_ping = voice("doc_bell_ping")
//     .synth("bell_ping")
//     .set_param("freq", 880.0)
//     .set_param("amp", 0.7)
//     ;
// doc_bell_ping.output("out").to_main();
// doc_bell_ping.run();
// ```
