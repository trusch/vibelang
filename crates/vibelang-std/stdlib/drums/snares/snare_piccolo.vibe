// Genre: Funk, Pop | Character: High-pitched, tight piccolo snare
define_synthdef("snare_piccolo", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Bright, short noise
            let noise_env = envelope()
                .perc(0.001, 0.08)
                .cleanup_on_finish()
                .build();
            let noise = white_noise_ar();
            let filtered_noise = hpf_ar(noise, 4000.0);
            let snare_noise = filtered_noise * noise_env;

            // High-pitched tone
            let tone_env = envelope()
                .perc(0.001, 0.06)
                .build();
            let tone = sin_osc_ar(280.0) * tone_env * 0.35;

            // Crack/stick sound
            let crack_env = envelope()
                .perc(0.0005, 0.004)
                .build();
            let crack = white_noise_ar() * crack_env * 0.3;

            (snare_noise * 0.7 + tone + crack) * amp
        })
});

//
// # Usage: snare_piccolo
//
// ```rhai
// import "stdlib/drums/snares/snare_piccolo.vibe" as snare_piccolo;
//
// let doc_snare_piccolo = voice("doc_snare_piccolo")
//     .synth("snare_piccolo")
//     .set_param("amp", 1.0)
//     ;
// doc_snare_piccolo.output("out").to_main();
// doc_snare_piccolo.run();
// ```
