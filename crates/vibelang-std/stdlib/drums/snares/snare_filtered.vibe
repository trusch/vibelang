// Genre: Lo-fi, Experimental | Character: Heavily filtered, muffled
define_synthdef("snare_filtered", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .param("cutoff", 1200.0) // units: Hz, range: 20..20000, default: 1200.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
        .body(|amp, cutoff| {
            // Noise component with heavy filtering
            let noise_env = envelope()
                .perc(0.002, 0.18)
                .cleanup_on_finish()
                .build();
            let noise = white_noise_ar();
            // Heavy low-pass for muffled character
            let filtered_noise = lpf_ar(noise, cutoff);
            let snare_noise = filtered_noise * noise_env;

            // Muted tone
            let tone_env = envelope()
                .perc(0.001, 0.12)
                .build();
            let tone = sin_osc_ar(160.0) * tone_env * 0.3;

            (snare_noise * 0.8 + tone) * amp
        })
});

//
// # Usage: snare_filtered
//
// ```rhai
// import "stdlib/drums/snares/snare_filtered.vibe" as snare_filtered;
//
// let doc_snare_filtered = voice("doc_snare_filtered")
//     .synth("snare_filtered")
//     .set_param("amp", 1.0)
//     .set_param("cutoff", 1200.0)
//     ;
// doc_snare_filtered.output("out").to_main();
// doc_snare_filtered.run();
// ```
