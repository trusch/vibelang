// Genre: Latin, Reggaeton | Character: Rimshot, sharp and cutting
define_synthdef("snare_rimshot", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Very short, sharp envelope
            let rim_env = envelope()
                .perc(0.0003, 0.04)
                .cleanup_on_finish()
                .build();

            // High-frequency click
            let click = white_noise_ar();
            let filtered_click = hpf_ar(click, 6000.0);

            // Metallic tone
            let tone1 = sin_osc_ar(800.0) * 0.4;
            let tone2 = sin_osc_ar(1200.0) * 0.3;
            let tones = (tone1 + tone2) * rim_env;

            (filtered_click * rim_env * 0.5 + tones) * amp
        })
});

//
// # Usage: snare_rimshot
//
// ```rhai
// import "stdlib/drums/snares/snare_rimshot.vibe" as snare_rimshot;
//
// let doc_snare_rimshot = voice("doc_snare_rimshot")
//     .synth("snare_rimshot")
//     .set_param("amp", 1.0)
//     ;
// doc_snare_rimshot.output("out").to_main();
// doc_snare_rimshot.run();
// ```
