// Genre: Marching Band, Orchestral | Character: Tight marching snare with wire buzz
define_synthdef("snare_marching")
    .param("freq", 250.0) // units: Hz, range: 20..20000, default: 250.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Tight, controlled decay
        let amp_env = envelope()
            .perc(0.001, 0.2)
            .cleanup_on_finish()
            .build();

        // High-pitched body
        let pitch_env = envelope()
            .perc(0.001, 0.015)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 2.0) * 0.35;

        // Prominent wire buzz
        let wire_env = envelope()
            .perc(0.001, 0.18)
            .build();
        let wires = hpf_ar(white_noise_ar(), 4000.0) * wire_env * 0.5;

        // Sharp stick attack
        let attack_env = envelope()
            .perc(0.0001, 0.002)
            .build();
        let attack = white_noise_ar() * attack_env * 0.3;

        (body + wires + attack) * amp_env * amp
    });

//
// # Usage: snare_marching
//
// ```rhai
// import "stdlib/drums/snares/snare_marching.vibe" as snare_marching;
//
// let doc_snare_marching = voice("doc_snare_marching")
//     .synth("snare_marching")
//     .set_param("freq", 250.0)
//     .set_param("amp", 0.9)
//     ;
// doc_snare_marching.output("out").to_main();
// doc_snare_marching.run();
// ```
