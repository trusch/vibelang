// Genre: Hip-hop, Pop | Character: Snare with clap character, layered
define_synthdef("snare_clap_snare", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Clap layer - multiple short bursts
            let clap_env1 = envelope()
                .perc(0.001, 0.03)
                .build();
            let clap_env2 = envelope()
                .perc(0.015, 0.03)
                .build();
            let clap_env3 = envelope()
                .perc(0.025, 0.03)
                .cleanup_on_finish()
                .build();

            let clap_noise = white_noise_ar();
            let clap = hpf_ar(clap_noise, 1500.0) * (clap_env1 + clap_env2 * 0.7 + clap_env3 * 0.5);

            // Snare layer
            let snare_env = envelope()
                .perc(0.001, 0.15)
                .build();
            let snare_noise = rlpf_ar(white_noise_ar(), 4000.0, 0.5) * snare_env;

            // Tone
            let tone_env = envelope()
                .perc(0.001, 0.1)
                .build();
            let tone = sin_osc_ar(190.0) * tone_env * 0.2;

            (clap * 0.5 + snare_noise * 0.6 + tone) * amp
        })
});

//
// # Usage: snare_clap_snare
//
// ```rhai
// import "stdlib/drums/snares/snare_clap_snare.vibe" as snare_clap_snare;
//
// let doc_snare_clap_snare = voice("doc_snare_clap_snare")
//     .synth("snare_clap_snare")
//     .set_param("amp", 1.0)
//     ;
// doc_snare_clap_snare.output("out").to_main();
// doc_snare_clap_snare.run();
// ```
