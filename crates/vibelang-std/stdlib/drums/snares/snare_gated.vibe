// Genre: 80s Rock, Pop | Character: Big gated reverb snare from the 80s
define_synthdef("snare_gated")
    .param("freq", 190.0) // units: Hz, range: 20..20000, default: 190.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Medium decay with abrupt end (gated feel)
        let amp_env = envelope()
            .perc(0.001, 0.3)
            .cleanup_on_finish()
            .build();

        // Body with pitch sweep
        let pitch_env = envelope()
            .perc(0.001, 0.025)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 1.8) * 0.4;

        // Sustained noise layer
        let noise_env = envelope()
            .perc(0.001, 0.28)
            .build();
        let noise = bpf_ar(white_noise_ar(), 3000.0, 0.5) * noise_env * 0.5;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let attack = white_noise_ar() * attack_env * 0.2;

        (body + noise + attack) * amp_env * amp
    });

//
// # Usage: snare_gated
//
// ```rhai
// import "stdlib/drums/snares/snare_gated.vibe" as snare_gated;
//
// let doc_snare_gated = voice("doc_snare_gated")
//     .synth("snare_gated")
//     .set_param("freq", 190.0)
//     .set_param("amp", 0.9)
//     ;
// doc_snare_gated.output("out").to_main();
// doc_snare_gated.run();
// ```
