// Genre: Electro, Techno | Character: Tight, electronic, punchy
define_synthdef("snare_tight_electronic", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Short, controlled envelope
            let noise_env = envelope()
                .perc(0.001, 0.11)
                .cleanup_on_finish()
                .build();

            // Filtered noise with resonance
            let noise = white_noise_ar();
            let filtered_noise = rlpf_ar(noise, 2800.0, 0.3);

            // Punchy tone
            let tone_env = envelope()
                .perc(0.0005, 0.07)
                .build();
            let tone = sin_osc_ar(220.0) * tone_env * 0.4;

            // Attack transient
            let attack_env = envelope()
                .perc(0.0001, 0.003)
                .build();
            let attack = white_noise_ar() * attack_env * 0.4;

            (filtered_noise * noise_env + tone + attack) * amp
        })
});

//
// # Usage: snare_tight_electronic
//
// ```rhai
// import "stdlib/drums/snares/snare_tight_electronic.vibe" as snare_tight_electronic;
//
// let doc_snare_tight_electronic = voice("doc_snare_tight_electronic")
//     .synth("snare_tight_electronic")
//     .set_param("amp", 1.0)
//     ;
// doc_snare_tight_electronic.output("out").to_main();
// doc_snare_tight_electronic.run();
// ```
