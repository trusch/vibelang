// Genre: Electronic, Experimental | Character: Tunable synth snare with tonal body
define_synthdef("snare_pitched")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("tone", 0.6) // units: normalized, range: 0..1, default: 0.6. Filter cutoff or tone point; higher keeps more high-frequency brightness.
    .body(|freq, amp, tone| {
        // Decay
        let amp_env = envelope()
            .perc(0.001, 0.22)
            .cleanup_on_finish()
            .build();

        // Pitched body with tone control
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 2.0) * tone * 0.5;

        // Noise layer inversely proportional to tone
        let noise_env = envelope()
            .perc(0.001, 0.18)
            .build();
        let noise = hpf_ar(white_noise_ar(), 2500.0) * noise_env * (1.0 - tone * 0.5) * 0.5;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.004)
            .build();
        let attack = white_noise_ar() * attack_env * 0.15;

        (body + noise + attack) * amp_env * amp
    });

//
// # Usage: snare_pitched
//
// ```rhai
// import "stdlib/drums/snares/snare_pitched.vibe" as snare_pitched;
//
// let doc_snare_pitched = voice("doc_snare_pitched")
//     .synth("snare_pitched")
//     .set_param("freq", 200.0)
//     .set_param("amp", 0.8)
//     .set_param("tone", 0.6)
//     ;
// doc_snare_pitched.output("out").to_main();
// doc_snare_pitched.run();
// ```
