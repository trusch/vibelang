// Genre: Funk, Soul | Character: Loose, spread out clap
define_synthdef("clap_loose", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Four bursts with larger timing spread
            let burst1_env = envelope()
                .perc(0.002, 0.032)
                .build();

            let burst2_env = envelope()
                .perc(0.018, 0.032)
                .build();

            let burst3_env = envelope()
                .perc(0.032, 0.032)
                .build();

            let burst4_env = envelope()
                .perc(0.045, 0.032)
                .cleanup_on_finish()
                .build();

            // Warm filtering
            let noise = pink_noise_ar();
            let filtered = rlpf_ar(noise, 2000.0, 0.6);

            let clap = filtered * (burst1_env + burst2_env * 0.85 + burst3_env * 0.7 + burst4_env * 0.55);

            clap * amp
        })
});

//
// # Usage: clap_loose
//
// ```rhai
// import "stdlib/drums/claps/clap_loose.vibe" as clap_loose;
//
// let doc_clap_loose = voice("doc_clap_loose")
//     .synth("clap_loose")
//     .set_param("amp", 1.0)
//     ;
// doc_clap_loose.output("out").to_main();
// doc_clap_loose.run();
// ```
