// Genre: Techno, House | Character: Tight, short clap
define_synthdef("clap_short", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Two quick bursts for tight character
            let burst1_env = envelope()
                .perc(0.0005, 0.018)
                .build();

            let burst2_env = envelope()
                .perc(0.008, 0.018)
                .cleanup_on_finish()
                .build();

            // Bright filtered noise
            let noise = white_noise_ar();
            let filtered = hpf_ar(noise, 1800.0);

            let clap = filtered * (burst1_env + burst2_env * 0.7);

            clap * amp
        })
});

//
// # Usage: clap_short
//
// ```rhai
// import "stdlib/drums/claps/clap_short.vibe" as clap_short;
//
// let doc_clap_short = voice("doc_clap_short")
//     .synth("clap_short")
//     .set_param("amp", 1.0)
//     ;
// doc_clap_short.output("out").to_main();
// doc_clap_short.run();
// ```
