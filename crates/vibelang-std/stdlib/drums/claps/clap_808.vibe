// Genre: Hip-hop, Trap | Character: Classic 808 clap, short and snappy
define_synthdef("clap_808", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Three quick bursts for clap character
            let burst1_env = envelope()
                .perc(0.001, 0.025)
                .build();

            let burst2_env = envelope()
                .perc(0.012, 0.025)
                .build();

            let burst3_env = envelope()
                .perc(0.020, 0.025)
                .cleanup_on_finish()
                .build();

            // Filtered noise
            let noise = white_noise_ar();
            let filtered = rlpf_ar(noise, 2500.0, 0.5);

            // Combine bursts
            let clap = filtered * (burst1_env + burst2_env * 0.8 + burst3_env * 0.6);

            clap * amp
        })
});

//
// # Usage: clap_808
//
// ```rhai
// import "stdlib/drums/claps/clap_808.vibe" as clap_808;
//
// let doc_clap_808 = voice("doc_clap_808")
//     .synth("clap_808")
//     .set_param("amp", 1.0)
//     ;
// doc_clap_808.output("out").to_main();
// doc_clap_808.run();
// ```
