// Genre: Lo-fi, Experimental | Character: Heavily filtered, muffled
define_synthdef("clap_filtered", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .param("cutoff", 1500.0) // units: Hz, range: 20..20000, default: 1500.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
        .body(|amp, cutoff| {
            // Three bursts
            let burst1_env = envelope()
                .perc(0.002, 0.028)
                .build();

            let burst2_env = envelope()
                .perc(0.015, 0.028)
                .build();

            let burst3_env = envelope()
                .perc(0.025, 0.028)
                .cleanup_on_finish()
                .build();

            // Heavy filtering for lo-fi character
            let noise = pink_noise_ar();
            let filtered = lpf_ar(noise, cutoff);

            let clap = filtered * (burst1_env + burst2_env * 0.8 + burst3_env * 0.6);

            clap * amp
        })
});

//
// # Usage: clap_filtered
//
// ```rhai
// import "stdlib/drums/claps/clap_filtered.vibe" as clap_filtered;
//
// let doc_clap_filtered = voice("doc_clap_filtered")
//     .synth("clap_filtered")
//     .set_param("amp", 1.0)
//     .set_param("cutoff", 1500.0)
//     ;
// doc_clap_filtered.output("out").to_main();
// doc_clap_filtered.run();
// ```
