// Genre: Lo-fi Hip-hop | Character: Dusty, vintage clap
define_synthdef("clap_lofi", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Soft, dusty bursts
            let burst1_env = envelope()
                .perc(0.003, 0.035)
                .build();

            let burst2_env = envelope()
                .perc(0.018, 0.035)
                .build();

            let burst3_env = envelope()
                .perc(0.030, 0.035)
                .cleanup_on_finish()
                .build();

            // Pink noise for warmth
            let noise = pink_noise_ar();
            let filtered = rlpf_ar(noise, 1800.0, 0.7);

            // Add vinyl crackle
            let crackle_env = burst1_env * 0.5;
            let crackle = hpf_ar(white_noise_ar(), 7000.0) * crackle_env * 0.06;

            let clap = filtered * (burst1_env + burst2_env * 0.8 + burst3_env * 0.65);

            (clap + crackle) * amp
        })
});

//
// # Usage: clap_lofi
//
// ```rhai
// import "stdlib/drums/claps/clap_lofi.vibe" as clap_lofi;
//
// let doc_clap_lofi = voice("doc_clap_lofi")
//     .synth("clap_lofi")
//     .set_param("amp", 1.0)
//     ;
// doc_clap_lofi.output("out").to_main();
// doc_clap_lofi.run();
// ```
