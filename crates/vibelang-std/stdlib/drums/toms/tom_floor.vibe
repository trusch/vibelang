// Genre: Rock, Pop | Character: Deep floor tom
define_synthdef("tom_floor")
    .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.85) // units: linear, range: 0..1, default: 0.85. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Deep, resonant decay
        let amp_env = envelope()
            .perc(0.001, 0.5)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.05)
            .build();
        let freq_mod = pitch_env * freq * 1.5;

        // Deep body
        let body = sin_osc_ar(freq + freq_mod) * 0.7;
        let sub = sin_osc_ar((freq + freq_mod) * 0.5) * 0.15;
        let overtone = sin_osc_ar((freq + freq_mod) * 1.8) * 0.1;

        // Stick attack
        let attack_env = envelope()
            .perc(0.0001, 0.012)
            .build();
        let attack = bpf_ar(white_noise_ar(), 1500.0, 0.5) * attack_env * 0.2;

        (body + sub + overtone + attack) * amp_env * amp
    });

//
// # Usage: tom_floor
//
// ```rhai
// import "stdlib/drums/toms/tom_floor.vibe" as tom_floor;
//
// let doc_tom_floor = voice("doc_tom_floor")
//     .synth("tom_floor")
//     .set_param("freq", 80.0)
//     .set_param("amp", 0.85)
//     ;
// doc_tom_floor.output("out").to_main();
// doc_tom_floor.run();
// ```
