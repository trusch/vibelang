// Genre: 70s Rock, Prog | Character: Rototom with tunable, sustained pitch
define_synthdef("tom_roto")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Medium sustain
        let amp_env = envelope()
            .perc(0.001, 0.35)
            .cleanup_on_finish()
            .build();

        // Minimal pitch drop (rototom characteristic)
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let freq_mod = pitch_env * freq * 0.8;

        // Clear, pitched body
        let body = sin_osc_ar(freq + freq_mod) * 0.7;
        let overtone = sin_osc_ar((freq + freq_mod) * 2.0) * 0.15;

        // Sharp attack
        let attack_env = envelope()
            .perc(0.0001, 0.006)
            .build();
        let attack = hpf_ar(white_noise_ar(), 3000.0) * attack_env * 0.18;

        (body + overtone + attack) * amp_env * amp
    });

//
// # Usage: tom_roto
//
// ```rhai
// import "stdlib/drums/toms/tom_roto.vibe" as tom_roto;
//
// let doc_tom_roto = voice("doc_tom_roto")
//     .synth("tom_roto")
//     .set_param("freq", 200.0)
//     .set_param("amp", 0.8)
//     ;
// doc_tom_roto.output("out").to_main();
// doc_tom_roto.run();
// ```
