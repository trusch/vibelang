// Genre: Electronic, Synthpop | Character: Synthetic electronic tom
define_synthdef("tom_synth")
    .param("freq", 150.0) // units: Hz, range: 20..20000, default: 150.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Electronic decay
        let amp_env = envelope()
            .perc(0.001, 0.3)
            .cleanup_on_finish()
            .build();

        // Dramatic pitch sweep
        let pitch_env = envelope()
            .perc(0.001, 0.1)
            .build();
        let freq_mod = pitch_env * freq * 3.0;

        // Pure sine body
        let body = sin_osc_ar(freq + freq_mod);

        // Subtle click
        let click_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let click = bpf_ar(white_noise_ar(), 2000.0, 0.5) * click_env * 0.15;

        (body + click) * amp_env * amp
    });

//
// # Usage: tom_synth
//
// ```rhai
// import "stdlib/drums/toms/tom_synth.vibe" as tom_synth;
//
// let doc_tom_synth = voice("doc_tom_synth")
//     .synth("tom_synth")
//     .set_param("freq", 150.0)
//     .set_param("amp", 0.8)
//     ;
// doc_tom_synth.output("out").to_main();
// doc_tom_synth.run();
// ```
