// Genre: Experimental, World | Character: Hollow wooden block
define_synthdef("woodblock", |builder| {
    builder
        .param("freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Short, percussive envelope
            let env = envelope()
                .perc(0.0005, 0.045)
                .cleanup_on_finish()
                .build();

            // Resonant frequencies for hollow character
            let tone1 = sin_osc_ar(freq) * 0.5;
            let tone2 = sin_osc_ar(freq * 1.8) * 0.3;
            let tone3 = sin_osc_ar(freq * 2.4) * 0.2;

            // Add filtered noise for wood texture
            let noise = pink_noise_ar();
            let filtered_noise = rlpf_ar(noise, freq * 3.0, 0.5) * 0.15;

            (tone1 + tone2 + tone3 + filtered_noise) * env * amp
        })
});

//
// # Usage: woodblock
//
// ```rhai
// import "stdlib/drums/percussion/woodblock.vibe" as woodblock;
//
// let doc_woodblock = voice("doc_woodblock")
//     .synth("woodblock")
//     .set_param("freq", 800.0)
//     .set_param("amp", 1.0)
//     ;
// doc_woodblock.output("out").to_main();
// doc_woodblock.run();
// ```
