// Genre: All | Character: High tom, resonant
define_synthdef("tom_high", |builder| {
    builder
        .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Medium decay
            let amp_env = envelope()
                .perc(0.002, 0.25)
                .cleanup_on_finish()
                .build();

            // Pitch envelope for tom character
            let pitch_env = envelope()
                .perc(0.001, 0.08)
                .build();
            let freq_mod = pitch_env * freq * 1.5;

            // Main tone
            let tone = sin_osc_ar(freq + freq_mod);

            // Add harmonics
            let harmonic = sin_osc_ar((freq + freq_mod) * 1.5) * 0.2;

            // Attack transient
            let attack_env = envelope()
                .perc(0.001, 0.015)
                .build();
            let attack = pink_noise_ar() * attack_env * 0.15;
            let filtered_attack = lpf_ar(attack, 3000.0);

            (tone + harmonic + filtered_attack) * amp_env * amp
        })
});

//
// # Usage: tom_high
//
// ```rhai
// import "stdlib/drums/percussion/tom_high.vibe" as tom_high;
//
// let doc_tom_high = voice("doc_tom_high")
//     .synth("tom_high")
//     .set_param("freq", 200.0)
//     .set_param("amp", 1.0)
//     ;
// doc_tom_high.output("out").to_main();
// doc_tom_high.run();
// ```
