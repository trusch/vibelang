// Genre: Pop, Latin | Character: Shaker, bright and rattling
define_synthdef("shaker", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Very short, crisp envelope
            let env = envelope()
                .perc(0.001, 0.05)
                .cleanup_on_finish()
                .build();

            // Bright filtered noise
            let noise = white_noise_ar();
            let filtered = hpf_ar(noise, 7000.0);

            // Add resonance for rattle
            let resonant = rlpf_ar(filtered, 10000.0, 0.4);

            resonant * env * amp
        })
});

//
// # Usage: shaker
//
// ```rhai
// import "stdlib/drums/percussion/shaker.vibe" as shaker;
//
// let doc_shaker = voice("doc_shaker")
//     .synth("shaker")
//     .set_param("amp", 1.0)
//     ;
// doc_shaker.output("out").to_main();
// doc_shaker.run();
// ```
