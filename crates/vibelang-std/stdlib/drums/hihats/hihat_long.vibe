// Genre: Ambient, Downtempo | Character: Long decay, washy
define_synthdef("hihat_long", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Long envelope for washy character
            let env = envelope()
                .perc(0.002, 0.5)
                .cleanup_on_finish()
                .build();

            // Mix of white and pink noise for texture
            let white = white_noise_ar() * 0.6;
            let pink = pink_noise_ar() * 0.4;
            let noise = white + pink;

            // Moderate high-pass
            let filtered = hpf_ar(noise, 7000.0);

            // Add shimmer with resonance
            let shimmer = rlpf_ar(filtered, 10000.0, 0.5);

            shimmer * env * amp
        })
});

//
// # Usage: hihat_long
//
// ```rhai
// import "stdlib/drums/hihats/hihat_long.vibe" as hihat_long;
//
// let doc_hihat_long = voice("doc_hihat_long")
//     .synth("hihat_long")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_long.output("out").to_main();
// doc_hihat_long.run();
// ```
