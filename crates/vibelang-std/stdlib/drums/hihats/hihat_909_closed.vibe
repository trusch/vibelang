// Genre: House, Techno | Character: Classic 909 closed hihat, bright and crisp
define_synthdef("hihat_909_closed", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Short, tight envelope
            let env = envelope()
                .perc(0.0003, 0.05)
                .cleanup_on_finish()
                .build();

            // White noise base
            let noise = white_noise_ar();

            // Aggressive high-pass for 909 character
            let filtered = hpf_ar(noise, 10000.0);

            // Add slight resonance
            let resonant = rlpf_ar(filtered, 12000.0, 0.3);

            resonant * env * amp
        })
});

//
// # Usage: hihat_909_closed
//
// ```rhai
// import "stdlib/drums/hihats/hihat_909_closed.vibe" as hihat_909_closed;
//
// let doc_hihat_909_closed = voice("doc_hihat_909_closed")
//     .synth("hihat_909_closed")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_909_closed.output("out").to_main();
// doc_hihat_909_closed.run();
// ```
