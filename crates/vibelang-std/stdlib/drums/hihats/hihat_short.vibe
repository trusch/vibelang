// Genre: Techno, Minimal | Character: Very short, click-like
define_synthdef("hihat_short", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Very short envelope
            let env = envelope()
                .perc(0.0002, 0.025)
                .cleanup_on_finish()
                .build();

            // White noise
            let noise = white_noise_ar();

            // Extreme high-pass for click character
            let filtered = hpf_ar(noise, 12000.0);

            filtered * env * amp
        })
});

//
// # Usage: hihat_short
//
// ```rhai
// import "stdlib/drums/hihats/hihat_short.vibe" as hihat_short;
//
// let doc_hihat_short = voice("doc_hihat_short")
//     .synth("hihat_short")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_short.output("out").to_main();
// doc_hihat_short.run();
// ```
