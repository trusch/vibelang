// Genre: Hip-hop, Trap | Character: Classic 808 closed hihat, short and tight
define_synthdef("hihat_808_closed")
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|amp| {
        // Very short envelope
        let env = envelope()
            .perc(0.0005, 0.04)
            .cleanup_on_finish()
            .build();

        // Square wave oscillators for metallic character
        let osc1 = saw_ar(315.0);
        let osc2 = saw_ar(380.0);
        let osc3 = saw_ar(445.0);
        let osc4 = saw_ar(540.0);
        let osc5 = saw_ar(620.0);
        let osc6 = saw_ar(745.0);

        let mix_osc = (osc1 + osc2 + osc3 + osc4 + osc5 + osc6) * 0.16;

        // High-pass filter for brightness
        let filtered = hpf_ar(mix_osc, 8000.0);

        filtered * env * amp
    });

//
// # Usage: hihat_808_closed
//
// ```rhai
// import "stdlib/drums/hihats/hihat_808_closed.vibe" as hihat_808_closed;
//
// let doc_hihat_808_closed = voice("doc_hihat_808_closed")
//     .synth("hihat_808_closed")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_808_closed.output("out").to_main();
// doc_hihat_808_closed.run();
// ```
