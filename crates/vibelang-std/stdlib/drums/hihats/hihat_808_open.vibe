// Genre: Hip-hop, Trap | Character: Classic 808 open hihat, longer decay
define_synthdef("hihat_808_open")
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|amp| {
        // Longer envelope for open character
        let env = envelope()
            .perc(0.001, 0.25)
            .cleanup_on_finish()
            .build();

        // Square wave oscillators
        let osc1 = saw_ar(315.0);
        let osc2 = saw_ar(380.0);
        let osc3 = saw_ar(445.0);
        let osc4 = saw_ar(540.0);
        let osc5 = saw_ar(620.0);
        let osc6 = saw_ar(745.0);

        let mix_osc = (osc1 + osc2 + osc3 + osc4 + osc5 + osc6) * 0.16;

        // High-pass filter
        let filtered = hpf_ar(mix_osc, 7000.0);

        filtered * env * amp
    });

//
// # Usage: hihat_808_open
//
// ```rhai
// import "stdlib/drums/hihats/hihat_808_open.vibe" as hihat_808_open;
//
// let doc_hihat_808_open = voice("doc_hihat_808_open")
//     .synth("hihat_808_open")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_808_open.output("out").to_main();
// doc_hihat_808_open.run();
// ```
