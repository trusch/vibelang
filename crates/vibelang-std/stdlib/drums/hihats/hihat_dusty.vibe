// Genre: Lo-fi Hip-hop | Character: Dusty, lo-fi texture
define_synthdef("hihat_dusty", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Soft attack and medium decay
            let env = envelope()
                .perc(0.003, 0.12)
                .cleanup_on_finish()
                .build();

            // Use pink noise for warmer character
            let noise = pink_noise_ar();

            // Gentle high-pass
            let filtered = hpf_ar(noise, 4500.0);

            // Roll off highs for dusty character
            let rolled_off = lpf_ar(filtered, 8000.0);

            rolled_off * env * amp
        })
});

//
// # Usage: hihat_dusty
//
// ```rhai
// import "stdlib/drums/hihats/hihat_dusty.vibe" as hihat_dusty;
//
// let doc_hihat_dusty = voice("doc_hihat_dusty")
//     .synth("hihat_dusty")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_dusty.output("out").to_main();
// doc_hihat_dusty.run();
// ```
