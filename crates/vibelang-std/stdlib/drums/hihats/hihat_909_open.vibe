// Genre: House, Techno | Character: Classic 909 open hihat with decay
define_synthdef("hihat_909_open", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Medium-long envelope
            let env = envelope()
                .perc(0.001, 0.3)
                .cleanup_on_finish()
                .build();

            // White noise
            let noise = white_noise_ar();

            // High-pass filter
            let filtered = hpf_ar(noise, 9000.0);

            // Band-pass for resonant character
            let resonant = rlpf_ar(filtered, 11000.0, 0.4);

            resonant * env * amp
        })
});

//
// # Usage: hihat_909_open
//
// ```rhai
// import "stdlib/drums/hihats/hihat_909_open.vibe" as hihat_909_open;
//
// let doc_hihat_909_open = voice("doc_hihat_909_open")
//     .synth("hihat_909_open")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_909_open.output("out").to_main();
// doc_hihat_909_open.run();
// ```
