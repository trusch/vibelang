// Genre: Rock, Jazz | Character: Splash cymbal, bright and long
define_synthdef("hihat_splash", |builder| {
    builder
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|amp| {
            // Long, complex envelope
            let env = envelope()
                .perc(0.005, 0.8)
                .cleanup_on_finish()
                .build();

            // Mix multiple noise colors for complex texture
            let white = white_noise_ar() * 0.5;
            let pink = pink_noise_ar() * 0.3;
            let noise = white + pink;

            // Multiple filter bands for complex spectrum
            let high = hpf_ar(noise, 8000.0) * 0.7;
            let mid = rlpf_ar(noise, 6000.0, 0.6) * 0.3;

            let mix = high + mid;

            mix * env * amp
        })
});

//
// # Usage: hihat_splash
//
// ```rhai
// import "stdlib/drums/hihats/hihat_splash.vibe" as hihat_splash;
//
// let doc_hihat_splash = voice("doc_hihat_splash")
//     .synth("hihat_splash")
//     .set_param("amp", 1.0)
//     ;
// doc_hihat_splash.output("out").to_main();
// doc_hihat_splash.run();
// ```
