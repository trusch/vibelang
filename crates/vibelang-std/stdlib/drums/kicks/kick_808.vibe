// Genre: Hip-hop, Trap | Character: Classic 808, deep sub bass with pitch decay
define_synthdef("kick_808")
    .param("freq", 60.0) // units: Hz, range: 20..20000, default: 60.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Main amplitude envelope - 808 character (fixed at 0.5s decay)
        let amp_env = envelope()
            .perc(0.001, 0.5)
            .cleanup_on_finish()
            .build();

        // Pitch envelope - classic 808 pitch sweep
        let pitch_env = envelope()
            .perc(0.001, 0.08)
            .build();
        let freq_mod = pitch_env * freq * 3.0;

        // Main sine tone
        let sig = sin_osc_ar(freq + freq_mod) * amp_env;

        // Add subtle click for attack definition
        let click_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let click = white_noise_ar() * click_env * 0.05;

        (sig + click) * amp
    });

//
// # Usage: kick_808
//
// ```rhai
// import "stdlib/drums/kicks/kick_808.vibe" as kick_808;
//
// let doc_kick_808 = voice("doc_kick_808")
//     .synth("kick_808")
//     .set_param("freq", 60.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_808.output("out").to_main();
// doc_kick_808.run();
// ```
