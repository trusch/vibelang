// Genre: Hard Techno, Industrial | Character: Aggressive, distorted, punchy
define_synthdef("kick_techno_hard", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Sharp, aggressive envelope
            let amp_env = envelope()
                .perc(0.001, 0.3)
                .cleanup_on_finish()
                .build();

            // Aggressive pitch sweep
            let pitch_env = envelope()
                .perc(0.001, 0.03)
                .build();
            let freq_mod = pitch_env * freq * 4.0;

            // Main tone with more drive
            let sig = sin_osc_ar(freq + freq_mod) * 1.5;

            // Clip for distortion character
            let distorted = clip(sig, -0.8, 0.8);

            // Prominent click/noise layer
            let click_env = envelope()
                .perc(0.0001, 0.012)
                .build();
            let click = white_noise_ar() * click_env * 0.25;

            (distorted + click) * amp_env * amp * 0.7
        })
});

//
// # Usage: kick_techno_hard
//
// ```rhai
// import "stdlib/drums/kicks/kick_techno_hard.vibe" as kick_techno_hard;
//
// let doc_kick_techno_hard = voice("doc_kick_techno_hard")
//     .synth("kick_techno_hard")
//     .set_param("freq", 55.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_techno_hard.output("out").to_main();
// doc_kick_techno_hard.run();
// ```
