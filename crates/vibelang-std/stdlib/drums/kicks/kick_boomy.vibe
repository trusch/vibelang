// Genre: Rock, Acoustic, Live | Character: Room-y acoustic kick with natural boom
define_synthdef("kick_boomy")
    .param("freq", 60.0) // units: Hz, range: 20..20000, default: 60.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Long, boomy decay
        let amp_env = envelope()
            .perc(0.002, 0.55)
            .cleanup_on_finish()
            .build();

        // Natural pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.08)
            .build();
        let freq_mod = pitch_env * freq * 1.8;

        // Main body
        let body = sin_osc_ar(freq + freq_mod) * 0.7;

        // Room resonance
        let room = sin_osc_ar(freq * 0.5) * 0.2;

        // Beater attack
        let attack_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let attack = bpf_ar(white_noise_ar(), 1200.0, 0.5) * attack_env * 0.25;

        (body + room + attack) * amp_env * amp
    });

//
// # Usage: kick_boomy
//
// ```rhai
// import "stdlib/drums/kicks/kick_boomy.vibe" as kick_boomy;
//
// let doc_kick_boomy = voice("doc_kick_boomy")
//     .synth("kick_boomy")
//     .set_param("freq", 60.0)
//     .set_param("amp", 0.9)
//     ;
// doc_kick_boomy.output("out").to_main();
// doc_kick_boomy.run();
// ```
