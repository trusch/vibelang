// Genre: Dubstep, Bass Music | Character: Pure sub bass, minimal harmonics
define_synthdef("kick_sub", |builder| {
    builder
        .param("freq", 40.0) // units: Hz, range: 20..20000, default: 40.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Medium-long decay for sub presence
            let amp_env = envelope()
                .perc(0.005, 0.55)
                .cleanup_on_finish()
                .build();

            // Gentle pitch sweep
            let pitch_env = envelope()
                .perc(0.001, 0.1)
                .build();
            let freq_mod = pitch_env * freq * 2.0;

            // Pure sine wave for clean sub
            let sig = sin_osc_ar(freq + freq_mod);

            // Very minimal click - just for timing reference
            let click_env = envelope()
                .perc(0.0001, 0.002)
                .build();
            let click = white_noise_ar() * click_env * 0.02;
            let filtered_click = lpf_ar(click, 8000.0);

            (sig + filtered_click) * amp_env * amp
        })
});

//
// # Usage: kick_sub
//
// ```rhai
// import "stdlib/drums/kicks/kick_sub.vibe" as kick_sub;
//
// let doc_kick_sub = voice("doc_kick_sub")
//     .synth("kick_sub")
//     .set_param("freq", 40.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_sub.output("out").to_main();
// doc_kick_sub.run();
// ```
