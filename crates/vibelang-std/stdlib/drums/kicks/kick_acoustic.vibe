// Genre: Jazz, Acoustic | Character: Natural-sounding, warm
define_synthdef("kick_acoustic", |builder| {
    builder
        .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Natural decay curve
            let amp_env = envelope()
                .perc(0.002, 0.4)
                .cleanup_on_finish()
                .build();

            // Subtle pitch bend
            let pitch_env = envelope()
                .perc(0.001, 0.05)
                .build();
            let freq_mod = pitch_env * freq * 1.5;

            // Mix of sine and triangle for warmth
            let sig = sin_osc_ar(freq + freq_mod) * 0.7;
            let harmonic = sin_osc_ar((freq + freq_mod) * 2.0) * 0.15;

            // Noise component for beater attack
            let noise_env = envelope()
                .perc(0.001, 0.025)
                .build();
            let noise = white_noise_ar() * noise_env * 0.12;
            let filtered_noise = lpf_ar(noise, 3000.0);

            (sig + harmonic + filtered_noise) * amp_env * amp
        })
});

//
// # Usage: kick_acoustic
//
// ```rhai
// import "stdlib/drums/kicks/kick_acoustic.vibe" as kick_acoustic;
//
// let doc_kick_acoustic = voice("doc_kick_acoustic")
//     .synth("kick_acoustic")
//     .set_param("freq", 80.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_acoustic.output("out").to_main();
// doc_kick_acoustic.run();
// ```
