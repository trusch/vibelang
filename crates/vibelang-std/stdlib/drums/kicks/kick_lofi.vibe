// Genre: Lo-fi Hip-hop, Chillhop | Character: Warm, dusty lo-fi kick
define_synthdef("kick_lofi")
    .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Soft decay
        let amp_env = envelope()
            .perc(0.003, 0.35)
            .cleanup_on_finish()
            .build();

        // Gentle pitch sweep
        let pitch_env = envelope()
            .perc(0.001, 0.06)
            .build();
        let freq_mod = pitch_env * freq * 2.0;

        // Warm body with slight saturation
        let raw = sin_osc_ar(freq + freq_mod);
        let body = lpf_ar((raw * 1.2).tanh(), 2000.0) * 0.8;

        // Soft attack
        let attack_env = envelope()
            .perc(0.001, 0.015)
            .build();
        let attack = lpf_ar(white_noise_ar(), 1500.0) * attack_env * 0.12;

        (body + attack) * amp_env * amp
    });

//
// # Usage: kick_lofi
//
// ```rhai
// import "stdlib/drums/kicks/kick_lofi.vibe" as kick_lofi;
//
// let doc_kick_lofi = voice("doc_kick_lofi")
//     .synth("kick_lofi")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.9)
//     ;
// doc_kick_lofi.output("out").to_main();
// doc_kick_lofi.run();
// ```
