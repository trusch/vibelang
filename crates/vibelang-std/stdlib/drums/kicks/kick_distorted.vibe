// Genre: Industrial, Hardcore | Character: Heavy distortion, aggressive
define_synthdef("kick_distorted", |builder| {
    builder
        .param("freq", 58.0) // units: Hz, range: 20..20000, default: 58.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .param("drive", 2.5) // units: gain, range: 0..10, default: 2.5. Nonlinear drive amount; higher adds harmonic distortion and compression.
        .body(|freq, amp, drive| {
            // Punchy envelope
            let amp_env = envelope()
                .perc(0.001, 0.28)
                .cleanup_on_finish()
                .build();

            // Aggressive pitch sweep
            let pitch_env = envelope()
                .perc(0.001, 0.04)
                .build();
            let freq_mod = pitch_env * freq * 3.5;

            // Main tone with overdrive
            let sig = sin_osc_ar(freq + freq_mod) * drive;

            // Hard clipping for distortion
            let distorted = clip(sig, -0.6, 0.6);

            // Add harmonics through filtering
            let filtered = lpf_ar(distorted, 2000.0);

            // Heavy click/noise
            let click_env = envelope()
                .perc(0.0001, 0.015)
                .build();
            let click = white_noise_ar() * click_env * 0.3;

            (filtered + click) * amp_env * amp * 0.6
        })
});

//
// # Usage: kick_distorted
//
// ```rhai
// import "stdlib/drums/kicks/kick_distorted.vibe" as kick_distorted;
//
// let doc_kick_distorted = voice("doc_kick_distorted")
//     .synth("kick_distorted")
//     .set_param("freq", 58.0)
//     .set_param("amp", 1.0)
//     .set_param("drive", 2.5)
//     ;
// doc_kick_distorted.output("out").to_main();
// doc_kick_distorted.run();
// ```
