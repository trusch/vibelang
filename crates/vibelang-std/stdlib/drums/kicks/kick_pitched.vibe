// Genre: House, Melodic Techno | Character: Tonal kick with clear pitch
define_synthdef("kick_pitched", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Medium decay to hear pitch
            let amp_env = envelope()
                .perc(0.001, 0.35)
                .cleanup_on_finish()
                .build();

            // Minimal pitch sweep to retain tonality
            let pitch_env = envelope()
                .perc(0.001, 0.03)
                .build();
            let freq_mod = pitch_env * freq * 0.8;

            // Main tone with harmonic
            let sig = sin_osc_ar(freq + freq_mod);
            let harmonic = sin_osc_ar((freq + freq_mod) * 2.0) * 0.2;

            // Light click
            let click_env = envelope()
                .perc(0.0001, 0.005)
                .build();
            let click = white_noise_ar() * click_env * 0.08;

            (sig + harmonic + click) * amp_env * amp
        })
});

//
// # Usage: kick_pitched
//
// ```rhai
// import "stdlib/drums/kicks/kick_pitched.vibe" as kick_pitched;
//
// let doc_kick_pitched = voice("doc_kick_pitched")
//     .synth("kick_pitched")
//     .set_param("freq", 110.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_pitched.output("out").to_main();
// doc_kick_pitched.run();
// ```
