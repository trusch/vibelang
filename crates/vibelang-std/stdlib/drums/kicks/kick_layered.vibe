// Genre: Modern Production | Character: Pre-layered kick stack with sub, mid, and click
define_synthdef("kick_layered")
    .param("freq", 50.0) // units: Hz, range: 20..20000, default: 50.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .param("sub_level", 0.6) // units: linear, range: 0..1, default: 0.6. Sub oscillator level; higher values add more low fundamental.
    .param("click_level", 0.5) // units: linear, range: 0..1, default: 0.5. Click Level amount; higher values emphasize that named musical or electrical behavior.
    .body(|freq, amp, sub_level, click_level| {
        // Main body envelope
        let amp_env = envelope()
            .perc(0.001, 0.4)
            .cleanup_on_finish()
            .build();

        // Sub layer (long, deep)
        let sub_env = envelope()
            .perc(0.005, 0.5)
            .build();
        let sub = sin_osc_ar(freq * 0.5) * sub_env * sub_level * 0.5;

        // Mid/punch layer
        let punch_env = envelope()
            .perc(0.001, 0.08)
            .build();
        let punch_freq = freq + punch_env * freq * 4.0;
        let punch = sin_osc_ar(punch_freq) * 0.6;

        // Click layer
        let click_env = envelope()
            .perc(0.0001, 0.01)
            .build();
        let click = bpf_ar(white_noise_ar(), 3500.0, 0.4) * click_env * click_level * 0.4;

        (sub + punch + click) * amp_env * amp
    });

//
// # Usage: kick_layered
//
// ```rhai
// import "stdlib/drums/kicks/kick_layered.vibe" as kick_layered;
//
// let doc_kick_layered = voice("doc_kick_layered")
//     .synth("kick_layered")
//     .set_param("freq", 50.0)
//     .set_param("amp", 1.0)
//     .set_param("sub_level", 0.6)
//     .set_param("click_level", 0.5)
//     ;
// doc_kick_layered.output("out").to_main();
// doc_kick_layered.run();
// ```
