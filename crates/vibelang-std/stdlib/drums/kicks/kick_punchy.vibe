// Genre: Pop, Modern | Character: Modern pop kick with controlled punch
define_synthdef("kick_punchy")
    .param("freq", 52.0) // units: Hz, range: 20..20000, default: 52.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Controlled decay
        let amp_env = envelope()
            .perc(0.001, 0.35)
            .cleanup_on_finish()
            .build();

        // Tight pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.035)
            .build();
        let freq_mod = pitch_env * freq * 5.0;

        // Punchy body
        let body = sin_osc_ar(freq + freq_mod) * 0.85;

        // Mid punch
        let mid_env = envelope()
            .perc(0.001, 0.05)
            .build();
        let mid = sin_osc_ar(freq * 2.5) * mid_env * 0.15;

        // Click
        let click_env = envelope()
            .perc(0.0001, 0.008)
            .build();
        let click = bpf_ar(white_noise_ar(), 2800.0, 0.5) * click_env * 0.2;

        (body + mid + click) * amp_env * amp
    });

//
// # Usage: kick_punchy
//
// ```rhai
// import "stdlib/drums/kicks/kick_punchy.vibe" as kick_punchy;
//
// let doc_kick_punchy = voice("doc_kick_punchy")
//     .synth("kick_punchy")
//     .set_param("freq", 52.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_punchy.output("out").to_main();
// doc_kick_punchy.run();
// ```
