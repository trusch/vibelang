// Genre: Reggaeton, Dembow | Character: Tight, punchy dembow-style kick
define_synthdef("kick_reggaeton")
    .param("freq", 58.0) // units: Hz, range: 20..20000, default: 58.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Short, tight decay
        let amp_env = envelope()
            .perc(0.001, 0.28)
            .cleanup_on_finish()
            .build();

        // Quick pitch drop
        let pitch_env = envelope()
            .perc(0.001, 0.03)
            .build();
        let freq_mod = pitch_env * freq * 4.5;

        // Punchy body
        let body = sin_osc_ar(freq + freq_mod) * 0.85;

        // Sharp attack
        let attack_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let attack = bpf_ar(white_noise_ar(), 3000.0, 0.4) * attack_env * 0.2;

        (body + attack) * amp_env * amp
    });

//
// # Usage: kick_reggaeton
//
// ```rhai
// import "stdlib/drums/kicks/kick_reggaeton.vibe" as kick_reggaeton;
//
// let doc_kick_reggaeton = voice("doc_kick_reggaeton")
//     .synth("kick_reggaeton")
//     .set_param("freq", 58.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_reggaeton.output("out").to_main();
// doc_kick_reggaeton.run();
// ```
