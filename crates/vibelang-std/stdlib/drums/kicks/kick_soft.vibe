// Genre: Ambient, Chillout | Character: Soft, gentle, minimal attack
define_synthdef("kick_soft", |builder| {
    builder
        .param("freq", 75.0) // units: Hz, range: 20..20000, default: 75.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .body(|freq, amp| {
            // Gentle attack and decay
            let amp_env = envelope()
                .perc(0.01, 0.45)
                .cleanup_on_finish()
                .build();

            // Subtle pitch movement
            let pitch_env = envelope()
                .perc(0.005, 0.06)
                .build();
            let freq_mod = pitch_env * freq * 1.2;

            // Warm sine tone
            let sig = sin_osc_ar(freq + freq_mod);

            // Add subtle warmth with low harmonic
            let harmonic = sin_osc_ar((freq + freq_mod) * 1.5) * 0.1;

            // Very soft click - barely noticeable
            let click_env = envelope()
                .perc(0.002, 0.008)
                .build();
            let click = pink_noise_ar() * click_env * 0.03;
            let filtered_click = lpf_ar(click, 4000.0);

            (sig + harmonic + filtered_click) * amp_env * amp
        })
});

//
// # Usage: kick_soft
//
// ```rhai
// import "stdlib/drums/kicks/kick_soft.vibe" as kick_soft;
//
// let doc_kick_soft = voice("doc_kick_soft")
//     .synth("kick_soft")
//     .set_param("freq", 75.0)
//     .set_param("amp", 1.0)
//     ;
// doc_kick_soft.output("out").to_main();
// doc_kick_soft.run();
// ```
