// Genre: Experimental, Lo-fi | Character: Book drop thump
define_synthdef("foley_book_drop")
    .param("freq", 100.0) // units: Hz, range: 20..20000, default: 100.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Soft thump decay
        let amp_env = envelope()
            .perc(0.002, 0.18)
            .cleanup_on_finish()
            .build();

        // Muffled thud
        let pitch_env = envelope()
            .perc(0.001, 0.03)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 1.2) * 0.5;

        // Paper flutter
        let paper_env = envelope()
            .perc(0.01, 0.1)
            .build();
        let paper = bpf_ar(pink_noise_ar(), 2000.0, 0.8) * paper_env * 0.2;

        // Impact
        let impact_env = envelope()
            .perc(0.001, 0.015)
            .build();
        let impact = lpf_ar(white_noise_ar(), 1500.0) * impact_env * 0.25;

        (body + paper + impact) * amp_env * amp
    });

//
// # Usage: foley_book_drop
//
// ```rhai
// import "stdlib/drums/foley/foley_book_drop.vibe" as foley_book_drop;
//
// let doc_foley_book_drop = voice("doc_foley_book_drop")
//     .synth("foley_book_drop")
//     .set_param("freq", 100.0)
//     .set_param("amp", 0.7)
//     ;
// doc_foley_book_drop.output("out").to_main();
// doc_foley_book_drop.run();
// ```
