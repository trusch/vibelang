// Genre: Experimental, Industrial | Character: Metal pot lid cymbal
define_synthdef("foley_pot_lid")
    .param("freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Metallic ring
        let amp_env = envelope()
            .perc(0.001, 0.6)
            .cleanup_on_finish()
            .build();

        // Inharmonic metallic partials
        let body = sin_osc_ar(freq) * 0.3;
        let ring1 = sin_osc_ar(freq * 1.7) * 0.25;
        let ring2 = sin_osc_ar(freq * 2.4) * 0.2;
        let ring3 = sin_osc_ar(freq * 3.1) * 0.15;
        let ring4 = sin_osc_ar(freq * 4.6) * 0.08;

        // Hit attack
        let attack_env = envelope()
            .perc(0.0001, 0.003)
            .build();
        let attack = hpf_ar(white_noise_ar(), 5000.0) * attack_env * 0.25;

        (body + ring1 + ring2 + ring3 + ring4 + attack) * amp_env * amp
    });

//
// # Usage: foley_pot_lid
//
// ```rhai
// import "stdlib/drums/foley/foley_pot_lid.vibe" as foley_pot_lid;
//
// let doc_foley_pot_lid = voice("doc_foley_pot_lid")
//     .synth("foley_pot_lid")
//     .set_param("freq", 800.0)
//     .set_param("amp", 0.6)
//     ;
// doc_foley_pot_lid.output("out").to_main();
// doc_foley_pot_lid.run();
// ```
