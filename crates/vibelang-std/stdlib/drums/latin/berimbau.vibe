// Genre: Brazilian, Capoeira | Character: Musical bow with gourd resonator
define_synthdef("berimbau")
    .param("freq", 120.0) // units: Hz, range: 20..20000, default: 120.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .param("open", 1.0) // units: ratio, range: 0..1, default: 1.0. Open amount; higher values emphasize that named musical or electrical behavior.
    .body(|freq, amp, open| {
        // Decay length based on open/closed
        let decay_time = 0.2 + (open * 0.4);
        let amp_env = envelope()
            .perc(0.001, 1.0)
            .time_scale(decay_time)
            .cleanup_on_finish()
            .build();

        // Wire string with harmonics
        let body = sin_osc_ar(freq) * 0.5;
        let harm1 = sin_osc_ar(freq * 2.0) * 0.25;
        let harm2 = sin_osc_ar(freq * 3.0) * 0.15;
        let harm3 = sin_osc_ar(freq * 4.0) * 0.08;

        // Gourd resonance (filter based on open/closed)
        let cutoff = 400.0 + (open * 2000.0);
        let resonated = lpf_ar(body + harm1 + harm2 + harm3, cutoff);

        // Stick attack
        let attack_env = envelope()
            .perc(0.0001, 0.008)
            .build();
        let attack = bpf_ar(white_noise_ar(), 2000.0, 0.5) * attack_env * 0.2;

        (resonated + attack) * amp_env * amp
    });

//
// # Usage: berimbau
//
// ```rhai
// import "stdlib/drums/latin/berimbau.vibe" as berimbau;
//
// let doc_berimbau = voice("doc_berimbau")
//     .synth("berimbau")
//     .set_param("freq", 120.0)
//     .set_param("amp", 0.7)
//     .set_param("open", 1.0)
//     ;
// doc_berimbau.output("out").to_main();
// doc_berimbau.run();
// ```
