// Genre: Latin, Salsa, Mambo | Character: Cascara/rim pattern stick hit
define_synthdef("timbale_rim")
    .param("freq", 800.0) // units: Hz, range: 20..20000, default: 800.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Short, tight decay
        let amp_env = envelope()
            .perc(0.0001, 0.12)
            .cleanup_on_finish()
            .build();

        // High metallic ping
        let body = sin_osc_ar(freq) * 0.4;
        let ring1 = sin_osc_ar(freq * 2.7) * 0.3;
        let ring2 = sin_osc_ar(freq * 4.1) * 0.2;

        // Sharp stick attack
        let attack_env = envelope()
            .perc(0.0001, 0.002)
            .build();
        let attack = hpf_ar(white_noise_ar(), 6000.0) * attack_env * 0.25;

        (body + ring1 + ring2 + attack) * amp_env * amp
    });

//
// # Usage: timbale_rim
//
// ```rhai
// import "stdlib/drums/latin/timbale_rim.vibe" as timbale_rim;
//
// let doc_timbale_rim = voice("doc_timbale_rim")
//     .synth("timbale_rim")
//     .set_param("freq", 800.0)
//     .set_param("amp", 0.8)
//     ;
// doc_timbale_rim.output("out").to_main();
// doc_timbale_rim.run();
// ```
