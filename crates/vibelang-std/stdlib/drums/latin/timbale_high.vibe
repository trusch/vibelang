// Genre: Latin, Salsa, Mambo | Character: Bright, ringing timbale with metallic overtones
define_synthdef("timbale_high")
    .param("freq", 450.0) // units: Hz, range: 20..20000, default: 450.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Ringing decay
        let amp_env = envelope()
            .perc(0.001, 0.5)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.01)
            .build();
        let freq_mod = pitch_env * freq * 1.5;

        // Metallic body with harmonics
        let body = sin_osc_ar(freq + freq_mod) * 0.5;
        let ring1 = sin_osc_ar((freq + freq_mod) * 2.5) * 0.25;
        let ring2 = sin_osc_ar((freq + freq_mod) * 4.2) * 0.15;
        let ring3 = sin_osc_ar((freq + freq_mod) * 5.8) * 0.08;

        // Sharp metallic attack
        let attack_env = envelope()
            .perc(0.0001, 0.003)
            .build();
        let attack = hpf_ar(white_noise_ar(), 5000.0) * attack_env * 0.2;

        (body + ring1 + ring2 + ring3 + attack) * amp_env * amp
    });

//
// # Usage: timbale_high
//
// ```rhai
// import "stdlib/drums/latin/timbale_high.vibe" as timbale_high;
//
// let doc_timbale_high = voice("doc_timbale_high")
//     .synth("timbale_high")
//     .set_param("freq", 450.0)
//     .set_param("amp", 0.8)
//     ;
// doc_timbale_high.output("out").to_main();
// doc_timbale_high.run();
// ```
