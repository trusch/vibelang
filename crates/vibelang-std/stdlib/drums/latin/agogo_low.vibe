// Genre: Brazilian, Samba, Latin | Character: Low-pitched agogo bell
define_synthdef("agogo_low")
    .param("freq", 600.0) // units: Hz, range: 20..20000, default: 600.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Longer metallic decay
        let amp_env = envelope()
            .perc(0.001, 0.5)
            .cleanup_on_finish()
            .build();

        // Bell harmonics
        let body = sin_osc_ar(freq) * 0.55;
        let ring1 = sin_osc_ar(freq * 2.3) * 0.22;
        let ring2 = sin_osc_ar(freq * 3.6) * 0.12;

        // Stick attack
        let attack_env = envelope()
            .perc(0.0001, 0.003)
            .build();
        let attack = lpf_ar(white_noise_ar(), 6000.0) * attack_env * 0.18;

        (body + ring1 + ring2 + attack) * amp_env * amp
    });

//
// # Usage: agogo_low
//
// ```rhai
// import "stdlib/drums/latin/agogo_low.vibe" as agogo_low;
//
// let doc_agogo_low = voice("doc_agogo_low")
//     .synth("agogo_low")
//     .set_param("freq", 600.0)
//     .set_param("amp", 0.7)
//     ;
// doc_agogo_low.output("out").to_main();
// doc_agogo_low.run();
// ```
