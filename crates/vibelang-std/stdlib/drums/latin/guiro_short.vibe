// Genre: Latin, Caribbean, World | Character: Short guiro accent
define_synthdef("guiro_short")
    .param("freq", 3500.0) // units: Hz, range: 20..20000, default: 3500.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Quick scrape
        let amp_env = envelope()
            .perc(0.005, 0.08)
            .cleanup_on_finish()
            .build();

        // Fast ridges
        let ridge_rate = 60.0;
        let ridges = sin_osc_ar(ridge_rate) * 0.4 + 0.6;

        // Bright scraping noise
        let scrape = bpf_ar(white_noise_ar(), freq, 0.4);

        scrape * ridges * amp_env * amp
    });

//
// # Usage: guiro_short
//
// ```rhai
// import "stdlib/drums/latin/guiro_short.vibe" as guiro_short;
//
// let doc_guiro_short = voice("doc_guiro_short")
//     .synth("guiro_short")
//     .set_param("freq", 3500.0)
//     .set_param("amp", 0.6)
//     ;
// doc_guiro_short.output("out").to_main();
// doc_guiro_short.run();
// ```
