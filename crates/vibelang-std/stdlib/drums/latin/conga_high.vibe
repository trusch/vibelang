// Genre: Latin, Salsa, Afro-Cuban | Character: High-pitched conga slap with bright attack
define_synthdef("conga_high")
    .param("freq", 350.0) // units: Hz, range: 20..20000, default: 350.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Main body envelope
        let amp_env = envelope()
            .perc(0.001, 0.25)
            .cleanup_on_finish()
            .build();

        // Pitch envelope for that conga "pop"
        let pitch_env = envelope()
            .perc(0.001, 0.03)
            .build();
        let freq_mod = pitch_env * freq * 2.0;

        // Main tone - combination of sine and resonant body
        let body = sin_osc_ar(freq + freq_mod) * 0.7;
        let overtone = sin_osc_ar((freq + freq_mod) * 2.1) * 0.2;
        let click = sin_osc_ar((freq + freq_mod) * 3.5) * 0.1;

        // Attack transient
        let attack_env = envelope()
            .perc(0.0001, 0.008)
            .build();
        let attack = white_noise_ar() * attack_env * 0.15;

        (body + overtone + click + attack) * amp_env * amp
    });

//
// # Usage: conga_high
//
// ```rhai
// import "stdlib/drums/latin/conga_high.vibe" as conga_high;
//
// let doc_conga_high = voice("doc_conga_high")
//     .synth("conga_high")
//     .set_param("freq", 350.0)
//     .set_param("amp", 0.8)
//     ;
// doc_conga_high.output("out").to_main();
// doc_conga_high.run();
// ```
