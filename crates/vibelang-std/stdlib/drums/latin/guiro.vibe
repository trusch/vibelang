// Genre: Latin, Caribbean, World | Character: Scraped guiro with ridged texture
define_synthdef("guiro")
    .param("freq", 3000.0) // units: Hz, range: 20..20000, default: 3000.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("length", 0.3) // units: seconds, range: 0..60, default: 0.3. Step count or loop length; higher values increase quantization or memory resolution.
    .body(|freq, amp, length| {
        // Scraping duration envelope
        let amp_env = envelope()
            .perc(0.01, 1.0)
            .time_scale(length)
            .cleanup_on_finish()
            .build();

        // Ridged texture using amplitude modulation
        let ridge_rate = 40.0;
        let ridges = sin_osc_ar(ridge_rate) * 0.5 + 0.5;

        // Filtered noise for scraping sound
        let scrape = bpf_ar(white_noise_ar(), freq, 0.3);
        let body = bpf_ar(white_noise_ar(), freq * 0.5, 0.5) * 0.3;

        (scrape + body) * ridges * amp_env * amp
    });

//
// # Usage: guiro
//
// ```rhai
// import "stdlib/drums/latin/guiro.vibe" as guiro;
//
// let doc_guiro = voice("doc_guiro")
//     .synth("guiro")
//     .set_param("freq", 3000.0)
//     .set_param("amp", 0.6)
//     .set_param("length", 0.3)
//     ;
// doc_guiro.output("out").to_main();
// doc_guiro.run();
// ```
