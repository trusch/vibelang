// Genre: Latin, Salsa, Afro-Cuban | Character: Deep conga tone with warm resonance
define_synthdef("conga_low")
    .param("freq", 180.0) // units: Hz, range: 20..20000, default: 180.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Longer decay for low conga
        let amp_env = envelope()
            .perc(0.001, 0.4)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.05)
            .build();
        let freq_mod = pitch_env * freq * 1.5;

        // Warm body tone
        let body = sin_osc_ar(freq + freq_mod) * 0.8;
        let sub = sin_osc_ar((freq + freq_mod) * 0.5) * 0.15;
        let overtone = sin_osc_ar((freq + freq_mod) * 2.0) * 0.1;

        // Soft attack
        let attack_env = envelope()
            .perc(0.0001, 0.01)
            .build();
        let attack = lpf_ar(white_noise_ar(), 2000.0) * attack_env * 0.1;

        (body + sub + overtone + attack) * amp_env * amp
    });

//
// # Usage: conga_low
//
// ```rhai
// import "stdlib/drums/latin/conga_low.vibe" as conga_low;
//
// let doc_conga_low = voice("doc_conga_low")
//     .synth("conga_low")
//     .set_param("freq", 180.0)
//     .set_param("amp", 0.8)
//     ;
// doc_conga_low.output("out").to_main();
// doc_conga_low.run();
// ```
