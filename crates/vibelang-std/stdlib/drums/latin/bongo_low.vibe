// Genre: Latin, Cuban, World | Character: Deeper bongo with warm tone
define_synthdef("bongo_low")
    .param("freq", 350.0) // units: Hz, range: 20..20000, default: 350.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Medium decay
        let amp_env = envelope()
            .perc(0.001, 0.2)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let freq_mod = pitch_env * freq * 2.0;

        // Warm body
        let body = sin_osc_ar(freq + freq_mod) * 0.7;
        let overtone = sin_osc_ar((freq + freq_mod) * 2.1) * 0.2;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.006)
            .build();
        let attack = lpf_ar(white_noise_ar(), 4000.0) * attack_env * 0.12;

        (body + overtone + attack) * amp_env * amp
    });

//
// # Usage: bongo_low
//
// ```rhai
// import "stdlib/drums/latin/bongo_low.vibe" as bongo_low;
//
// let doc_bongo_low = voice("doc_bongo_low")
//     .synth("bongo_low")
//     .set_param("freq", 350.0)
//     .set_param("amp", 0.8)
//     ;
// doc_bongo_low.output("out").to_main();
// doc_bongo_low.run();
// ```
