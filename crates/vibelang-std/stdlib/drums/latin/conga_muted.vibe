// Genre: Latin, Salsa, Afro-Cuban | Character: Muted conga with short, dry attack
define_synthdef("conga_muted")
    .param("freq", 260.0) // units: Hz, range: 20..20000, default: 260.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Very short decay for muted sound
        let amp_env = envelope()
            .perc(0.001, 0.08)
            .cleanup_on_finish()
            .build();

        // Quick pitch drop
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let freq_mod = pitch_env * freq * 1.0;

        // Dry, muted tone
        let body = sin_osc_ar(freq + freq_mod) * 0.6;
        let click = sin_osc_ar((freq + freq_mod) * 2.5) * 0.3;

        // Sharp attack
        let attack_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let attack = hpf_ar(white_noise_ar(), 1500.0) * attack_env * 0.2;

        (body + click + attack) * amp_env * amp
    });

//
// # Usage: conga_muted
//
// ```rhai
// import "stdlib/drums/latin/conga_muted.vibe" as conga_muted;
//
// let doc_conga_muted = voice("doc_conga_muted")
//     .synth("conga_muted")
//     .set_param("freq", 260.0)
//     .set_param("amp", 0.8)
//     ;
// doc_conga_muted.output("out").to_main();
// doc_conga_muted.run();
// ```
