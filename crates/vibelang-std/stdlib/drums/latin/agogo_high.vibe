// Genre: Brazilian, Samba, Latin | Character: High-pitched agogo bell
define_synthdef("agogo_high")
    .param("freq", 900.0) // units: Hz, range: 20..20000, default: 900.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Metallic ring decay
        let amp_env = envelope()
            .perc(0.001, 0.4)
            .cleanup_on_finish()
            .build();

        // Bell harmonics
        let body = sin_osc_ar(freq) * 0.5;
        let ring1 = sin_osc_ar(freq * 2.4) * 0.25;
        let ring2 = sin_osc_ar(freq * 3.8) * 0.15;
        let ring3 = sin_osc_ar(freq * 5.2) * 0.08;

        // Stick attack
        let attack_env = envelope()
            .perc(0.0001, 0.002)
            .build();
        let attack = hpf_ar(white_noise_ar(), 4000.0) * attack_env * 0.2;

        (body + ring1 + ring2 + ring3 + attack) * amp_env * amp
    });

//
// # Usage: agogo_high
//
// ```rhai
// import "stdlib/drums/latin/agogo_high.vibe" as agogo_high;
//
// let doc_agogo_high = voice("doc_agogo_high")
//     .synth("agogo_high")
//     .set_param("freq", 900.0)
//     .set_param("amp", 0.7)
//     ;
// doc_agogo_high.output("out").to_main();
// doc_agogo_high.run();
// ```
