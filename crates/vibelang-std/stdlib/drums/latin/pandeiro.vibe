// Genre: Brazilian, Samba, Choro | Character: Brazilian tambourine with jingles
define_synthdef("pandeiro")
    .param("freq", 300.0) // units: Hz, range: 20..20000, default: 300.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Medium decay
        let amp_env = envelope()
            .perc(0.001, 0.2)
            .cleanup_on_finish()
            .build();

        // Drum body
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq) * 0.4;

        // Jingles (high metallic)
        let jingle_env = envelope()
            .perc(0.001, 0.15)
            .build();
        let jingles = hpf_ar(white_noise_ar(), 6000.0) * jingle_env * 0.35;

        // Attack transient
        let attack_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let attack = white_noise_ar() * attack_env * 0.2;

        (body + jingles + attack) * amp_env * amp
    });

//
// # Usage: pandeiro
//
// ```rhai
// import "stdlib/drums/latin/pandeiro.vibe" as pandeiro;
//
// let doc_pandeiro = voice("doc_pandeiro")
//     .synth("pandeiro")
//     .set_param("freq", 300.0)
//     .set_param("amp", 0.7)
//     ;
// doc_pandeiro.output("out").to_main();
// doc_pandeiro.run();
// ```
