// Genre: 80s Hip-hop, Electro | Character: Oberheim DMX kick - tight, punchy
define_synthdef("dmx_kick")
    .param("freq", 52.0) // units: Hz, range: 20..20000, default: 52.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Tight decay
        let amp_env = envelope()
            .perc(0.001, 0.32)
            .cleanup_on_finish()
            .build();

        // Sharp pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.05)
            .build();
        let freq_mod = pitch_env * freq * 5.0;

        // Punchy body
        let body = sin_osc_ar(freq + freq_mod) * 0.85;

        // Crisp attack
        let attack_env = envelope()
            .perc(0.0001, 0.006)
            .build();
        let attack = hpf_ar(white_noise_ar(), 1500.0) * attack_env * 0.15;

        (body + attack) * amp_env * amp
    });

//
// # Usage: dmx_kick
//
// ```rhai
// import "stdlib/drums/machines/dmx_kick.vibe" as dmx_kick;
//
// let doc_dmx_kick = voice("doc_dmx_kick")
//     .synth("dmx_kick")
//     .set_param("freq", 52.0)
//     .set_param("amp", 1.0)
//     ;
// doc_dmx_kick.output("out").to_main();
// doc_dmx_kick.run();
// ```
