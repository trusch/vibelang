// Genre: 80s Hip-hop, Electro | Character: Oberheim DMX snare - sharp, cutting
define_synthdef("dmx_snare")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Snappy decay
        let amp_env = envelope()
            .perc(0.001, 0.22)
            .cleanup_on_finish()
            .build();

        // Punchy body
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 2.5) * 0.4;

        // Bright noise
        let noise_env = envelope()
            .perc(0.001, 0.18)
            .build();
        let noise = hpf_ar(white_noise_ar(), 3500.0) * noise_env * 0.55;

        // Sharp attack
        let attack_env = envelope()
            .perc(0.0001, 0.003)
            .build();
        let attack = white_noise_ar() * attack_env * 0.2;

        (body + noise + attack) * amp_env * amp
    });

//
// # Usage: dmx_snare
//
// ```rhai
// import "stdlib/drums/machines/dmx_snare.vibe" as dmx_snare;
//
// let doc_dmx_snare = voice("doc_dmx_snare")
//     .synth("dmx_snare")
//     .set_param("freq", 220.0)
//     .set_param("amp", 0.9)
//     ;
// doc_dmx_snare.output("out").to_main();
// doc_dmx_snare.run();
// ```
