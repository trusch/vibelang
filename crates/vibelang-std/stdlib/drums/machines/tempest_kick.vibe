// Genre: Electronic, Techno | Character: DSI Tempest-style kick - modern analog, deep
define_synthdef("tempest_kick")
    .param("freq", 48.0) // units: Hz, range: 20..20000, default: 48.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .param("punch", 0.7) // units: ratio, range: 0..1, default: 0.7. Punch amount; higher values emphasize that named musical or electrical behavior.
    .body(|freq, amp, punch| {
        // Deep decay
        let amp_env = envelope()
            .perc(0.001, 0.45)
            .cleanup_on_finish()
            .build();

        // Aggressive pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 1.0)
            .time_scale(0.04 + punch * 0.03)
            .build();
        let freq_mod = pitch_env * freq * (3.0 + punch * 3.0);

        // Thick analog body
        let body = sin_osc_ar(freq + freq_mod) * 0.7;
        let sub = sin_osc_ar((freq + freq_mod) * 0.5) * 0.25;

        // Punch click
        let click_env = envelope()
            .perc(0.0001, 0.006)
            .build();
        let click = bpf_ar(white_noise_ar(), 2500.0, 0.4) * click_env * punch * 0.3;

        (body + sub + click) * amp_env * amp
    });

//
// # Usage: tempest_kick
//
// ```rhai
// import "stdlib/drums/machines/tempest_kick.vibe" as tempest_kick;
//
// let doc_tempest_kick = voice("doc_tempest_kick")
//     .synth("tempest_kick")
//     .set_param("freq", 48.0)
//     .set_param("amp", 1.0)
//     .set_param("punch", 0.7)
//     ;
// doc_tempest_kick.output("out").to_main();
// doc_tempest_kick.run();
// ```
