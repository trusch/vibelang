// Genre: 90s Hip-hop, Boom Bap | Character: E-mu SP-1200 kick - crunchy, 12-bit warmth
define_synthdef("sp1200_kick")
    .param("freq", 48.0) // units: Hz, range: 20..20000, default: 48.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Punchy decay
        let amp_env = envelope()
            .perc(0.001, 0.4)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.07)
            .build();
        let freq_mod = pitch_env * freq * 3.5;

        // Main body with slight saturation (12-bit character)
        let raw = sin_osc_ar(freq + freq_mod);
        let body = (raw * 1.2).tanh() * 0.8;

        // Sub layer
        let sub = sin_osc_ar((freq + freq_mod) * 0.5) * 0.15;

        // Crunchy click
        let click_env = envelope()
            .perc(0.0001, 0.012)
            .build();
        let click = lpf_ar(white_noise_ar(), 3000.0) * click_env * 0.2;

        (body + sub + click) * amp_env * amp
    });

//
// # Usage: sp1200_kick
//
// ```rhai
// import "stdlib/drums/machines/sp1200_kick.vibe" as sp1200_kick;
//
// let doc_sp1200_kick = voice("doc_sp1200_kick")
//     .synth("sp1200_kick")
//     .set_param("freq", 48.0)
//     .set_param("amp", 1.0)
//     ;
// doc_sp1200_kick.output("out").to_main();
// doc_sp1200_kick.run();
// ```
