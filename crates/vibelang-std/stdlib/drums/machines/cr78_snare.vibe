// Genre: Vintage, New Wave, Synthpop | Character: Roland CR-78 snare - lo-fi, filtered
define_synthdef("cr78_snare")
    .param("freq", 180.0) // units: Hz, range: 20..20000, default: 180.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Vintage decay
        let amp_env = envelope()
            .perc(0.001, 0.2)
            .cleanup_on_finish()
            .build();

        // Body
        let pitch_env = envelope()
            .perc(0.001, 0.015)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 1.5) * 0.35;

        // Filtered noise
        let noise_env = envelope()
            .perc(0.001, 0.18)
            .build();
        let noise = bpf_ar(white_noise_ar(), 4000.0, 0.4) * noise_env * 0.5;

        (body + noise) * amp_env * amp
    });

//
// # Usage: cr78_snare
//
// ```rhai
// import "stdlib/drums/machines/cr78_snare.vibe" as cr78_snare;
//
// let doc_cr78_snare = voice("doc_cr78_snare")
//     .synth("cr78_snare")
//     .set_param("freq", 180.0)
//     .set_param("amp", 0.8)
//     ;
// doc_cr78_snare.output("out").to_main();
// doc_cr78_snare.run();
// ```
