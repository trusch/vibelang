// Genre: Hip-hop, R&B, Production | Character: MPC-style kick - clean, punchy
define_synthdef("mpc_kick")
    .param("freq", 50.0) // units: Hz, range: 20..20000, default: 50.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Clean, tight decay
        let amp_env = envelope()
            .perc(0.001, 0.38)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.06)
            .build();
        let freq_mod = pitch_env * freq * 4.0;

        // Clean body
        let body = sin_osc_ar(freq + freq_mod) * 0.85;

        // Subtle sub
        let sub = sin_osc_ar((freq + freq_mod) * 0.5) * 0.1;

        // Click
        let click_env = envelope()
            .perc(0.0001, 0.008)
            .build();
        let click = bpf_ar(white_noise_ar(), 2000.0, 0.6) * click_env * 0.15;

        (body + sub + click) * amp_env * amp
    });

//
// # Usage: mpc_kick
//
// ```rhai
// import "stdlib/drums/machines/mpc_kick.vibe" as mpc_kick;
//
// let doc_mpc_kick = voice("doc_mpc_kick")
//     .synth("mpc_kick")
//     .set_param("freq", 50.0)
//     .set_param("amp", 1.0)
//     ;
// doc_mpc_kick.output("out").to_main();
// doc_mpc_kick.run();
// ```
