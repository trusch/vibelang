// Genre: 90s Hip-hop, Boom Bap | Character: E-mu SP-1200 snare - gritty, lo-fi
define_synthdef("sp1200_snare")
    .param("freq", 190.0) // units: Hz, range: 20..20000, default: 190.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Medium decay
        let amp_env = envelope()
            .perc(0.001, 0.28)
            .cleanup_on_finish()
            .build();

        // Body with saturation
        let pitch_env = envelope()
            .perc(0.001, 0.025)
            .build();
        let raw_body = sin_osc_ar(freq + pitch_env * freq * 2.0);
        let body = (raw_body * 1.3).tanh() * 0.35;

        // Crunchy noise
        let noise_env = envelope()
            .perc(0.001, 0.22)
            .build();
        let raw_noise = bpf_ar(white_noise_ar(), 3500.0, 0.5);
        let noise = (raw_noise * 1.5).tanh() * noise_env * 0.5;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let attack = white_noise_ar() * attack_env * 0.18;

        (body + noise + attack) * amp_env * amp
    });

//
// # Usage: sp1200_snare
//
// ```rhai
// import "stdlib/drums/machines/sp1200_snare.vibe" as sp1200_snare;
//
// let doc_sp1200_snare = voice("doc_sp1200_snare")
//     .synth("sp1200_snare")
//     .set_param("freq", 190.0)
//     .set_param("amp", 0.9)
//     ;
// doc_sp1200_snare.output("out").to_main();
// doc_sp1200_snare.run();
// ```
