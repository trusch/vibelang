// Genre: IDM, Techno, Experimental | Character: Elektron Machinedrum-style kick - digital, versatile
define_synthdef("machinedrum_kick")
    .param("freq", 50.0) // units: Hz, range: 20..20000, default: 50.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .param("shape", 0.5) // units: normalized, range: 0..1, default: 0.5. Curve shape; higher values bend the envelope or oscillator toward a sharper contour.
    .body(|freq, amp, shape| {
        // Adjustable decay
        let decay = 0.3 + shape * 0.2;
        let amp_env = envelope()
            .perc(0.001, 1.0)
            .time_scale(decay)
            .cleanup_on_finish()
            .build();

        // Pitch envelope with shape control
        let pitch_env = envelope()
            .perc(0.001, 1.0)
            .time_scale(0.04 + shape * 0.04)
            .build();
        let freq_mod = pitch_env * freq * (2.5 + shape * 3.0);

        // Body with waveshaping based on shape
        let raw = sin_osc_ar(freq + freq_mod);
        let body = (raw * (1.0 + shape)).tanh() * 0.8;

        // Digital click
        let click_env = envelope()
            .perc(0.0001, 0.005)
            .build();
        let click = hpf_ar(white_noise_ar(), 2000.0) * click_env * shape * 0.2;

        (body + click) * amp_env * amp
    });

//
// # Usage: machinedrum_kick
//
// ```rhai
// import "stdlib/drums/machines/machinedrum_kick.vibe" as machinedrum_kick;
//
// let doc_machinedrum_kick = voice("doc_machinedrum_kick")
//     .synth("machinedrum_kick")
//     .set_param("freq", 50.0)
//     .set_param("amp", 1.0)
//     .set_param("shape", 0.5)
//     ;
// doc_machinedrum_kick.output("out").to_main();
// doc_machinedrum_kick.run();
// ```
