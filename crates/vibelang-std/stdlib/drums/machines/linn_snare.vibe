// Genre: 80s Pop, R&B, Hip-hop | Character: LinnDrum snare - bright, crisp, sampled feel
define_synthdef("linn_snare")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Medium decay
        let amp_env = envelope()
            .perc(0.001, 0.25)
            .cleanup_on_finish()
            .build();

        // Body tone
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 2.0) * 0.4;

        // Snare noise
        let noise_env = envelope()
            .perc(0.001, 0.2)
            .build();
        let noise = hpf_ar(white_noise_ar(), 2500.0) * noise_env * 0.5;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.004)
            .build();
        let attack = white_noise_ar() * attack_env * 0.2;

        (body + noise + attack) * amp_env * amp
    });

//
// # Usage: linn_snare
//
// ```rhai
// import "stdlib/drums/machines/linn_snare.vibe" as linn_snare;
//
// let doc_linn_snare = voice("doc_linn_snare")
//     .synth("linn_snare")
//     .set_param("freq", 200.0)
//     .set_param("amp", 0.9)
//     ;
// doc_linn_snare.output("out").to_main();
// doc_linn_snare.run();
// ```
