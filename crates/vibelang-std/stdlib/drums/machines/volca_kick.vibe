// Genre: Electronic, Lo-fi | Character: Korg Volca Beats style kick - analog, characterful
define_synthdef("volca_kick")
    .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .param("click", 0.5) // units: linear, range: 0..1, default: 0.5. Click amount; higher values emphasize that named musical or electrical behavior.
    .body(|freq, amp, click| {
        // Analog-style decay
        let amp_env = envelope()
            .perc(0.001, 0.35)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.05)
            .build();
        let freq_mod = pitch_env * freq * 3.0;

        // Analog body with slight waveshaping
        let raw = sin_osc_ar(freq + freq_mod);
        let body = (raw * 1.1).tanh() * 0.85;

        // Variable click
        let click_env = envelope()
            .perc(0.0001, 0.01)
            .build();
        let click_sound = bpf_ar(white_noise_ar(), 1800.0, 0.5) * click_env * click * 0.3;

        (body + click_sound) * amp_env * amp
    });

//
// # Usage: volca_kick
//
// ```rhai
// import "stdlib/drums/machines/volca_kick.vibe" as volca_kick;
//
// let doc_volca_kick = voice("doc_volca_kick")
//     .synth("volca_kick")
//     .set_param("freq", 55.0)
//     .set_param("amp", 1.0)
//     .set_param("click", 0.5)
//     ;
// doc_volca_kick.output("out").to_main();
// doc_volca_kick.run();
// ```
