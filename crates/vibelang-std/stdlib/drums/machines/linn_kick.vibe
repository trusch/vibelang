// Genre: 80s Pop, R&B, Hip-hop | Character: LinnDrum kick - punchy, bright attack
define_synthdef("linn_kick")
    .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Tight, punchy envelope
        let amp_env = envelope()
            .perc(0.001, 0.35)
            .cleanup_on_finish()
            .build();

        // Pitch sweep
        let pitch_env = envelope()
            .perc(0.001, 0.06)
            .build();
        let freq_mod = pitch_env * freq * 4.0;

        // Main tone
        let body = sin_osc_ar(freq + freq_mod) * 0.8;

        // Bright attack click
        let click_env = envelope()
            .perc(0.0001, 0.008)
            .build();
        let click = bpf_ar(white_noise_ar(), 2500.0, 0.5) * click_env * 0.25;

        (body + click) * amp_env * amp
    });

//
// # Usage: linn_kick
//
// ```rhai
// import "stdlib/drums/machines/linn_kick.vibe" as linn_kick;
//
// let doc_linn_kick = voice("doc_linn_kick")
//     .synth("linn_kick")
//     .set_param("freq", 55.0)
//     .set_param("amp", 1.0)
//     ;
// doc_linn_kick.output("out").to_main();
// doc_linn_kick.run();
// ```
