// Genre: Hip-hop, R&B, Production | Character: MPC-style snare - versatile, balanced
define_synthdef("mpc_snare")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Balanced decay
        let amp_env = envelope()
            .perc(0.001, 0.24)
            .cleanup_on_finish()
            .build();

        // Body
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 2.0) * 0.4;

        // Noise
        let noise_env = envelope()
            .perc(0.001, 0.2)
            .build();
        let noise = hpf_ar(white_noise_ar(), 2800.0) * noise_env * 0.5;

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.004)
            .build();
        let attack = white_noise_ar() * attack_env * 0.15;

        (body + noise + attack) * amp_env * amp
    });

//
// # Usage: mpc_snare
//
// ```rhai
// import "stdlib/drums/machines/mpc_snare.vibe" as mpc_snare;
//
// let doc_mpc_snare = voice("doc_mpc_snare")
//     .synth("mpc_snare")
//     .set_param("freq", 200.0)
//     .set_param("amp", 0.9)
//     ;
// doc_mpc_snare.output("out").to_main();
// doc_mpc_snare.run();
// ```
