// Genre: IDM, Techno, Experimental | Character: Elektron Machinedrum-style snare - digital, morphable
define_synthdef("machinedrum_snare")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .param("metallic", 0.4) // units: ratio, range: 0..1, default: 0.4. Metallic amount; higher values emphasize that named musical or electrical behavior.
    .body(|freq, amp, metallic| {
        // Decay
        let amp_env = envelope()
            .perc(0.001, 0.25)
            .cleanup_on_finish()
            .build();

        // Body
        let pitch_env = envelope()
            .perc(0.001, 0.02)
            .build();
        let body = sin_osc_ar(freq + pitch_env * freq * 2.0) * 0.35;

        // Metallic ring (morphable)
        let ring_env = envelope()
            .perc(0.001, 0.15)
            .build();
        let ring = sin_osc_ar(freq * 3.7) * ring_env * metallic * 0.25;

        // Noise
        let noise_env = envelope()
            .perc(0.001, 0.2)
            .build();
        let noise = hpf_ar(white_noise_ar(), 3000.0) * noise_env * (0.5 - metallic * 0.2);

        // Attack
        let attack_env = envelope()
            .perc(0.0001, 0.003)
            .build();
        let attack = white_noise_ar() * attack_env * 0.2;

        (body + ring + noise + attack) * amp_env * amp
    });

//
// # Usage: machinedrum_snare
//
// ```rhai
// import "stdlib/drums/machines/machinedrum_snare.vibe" as machinedrum_snare;
//
// let doc_machinedrum_snare = voice("doc_machinedrum_snare")
//     .synth("machinedrum_snare")
//     .set_param("freq", 200.0)
//     .set_param("amp", 0.9)
//     .set_param("metallic", 0.4)
//     ;
// doc_machinedrum_snare.output("out").to_main();
// doc_machinedrum_snare.run();
// ```
