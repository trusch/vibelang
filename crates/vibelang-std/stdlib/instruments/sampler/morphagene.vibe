// Morphagene Story A + B + C — Reel + Splice metadata + Granular path
//
// Multi-splice reel with continuous Vari-Speed playback, Organize-driven
// splice selection (with EOS-hold semantics), Sound-On-Sound recording,
// and a `grain_buf_ar`-based granular layer with the full Morph staircase
// (gap → 1:1 → 2:1 → 3:1 + per-grain pan → 4:1 + per-grain pitch-up).
// Per `kb/morphagene-synthdef-plan.md` §3 (Reel/Splice/Gene hierarchy),
// §4 (UGen mapping), §6.B + §6.C.
//
// Splice model (Story B):
//   The Reel is logically divided into `num_splices` evenly-spaced splices.
//   For splice index i: start = i · BufFrames / num_splices,
//                       end   = (i+1) · BufFrames / num_splices.
//   This matches the manual's "splices distributed evenly across Organize
//   range" property literally.
//
// Selection logic (Story B):
//   pending_idx = floor(organize · num_splices), clamped. committed_idx is
//   Latch(pending_idx, trig=eos) — a knob turn re-paints the Splice LED
//   immediately but the audible switch defers to end-of-splice. The
//   committed value is bounced through a 1-frame LocalBuf to break the
//   committed → splice_len → phasor → eos → committed feedback loop.
//
// EOS detection (Story B):
//   The playback Phasor advances `rate · buf_rate_scale` per sample inside
//   [0, splice_len). At a wrap, |Δphase| ≈ splice_len; in steady state,
//   |Δphase| = |rate|. Threshold at splice_len/2 separates the two cleanly
//   under any Vari-Speed direction. Decimated to kr for the Latch.
//
// Granular path (Story C):
//   Gene-Size in [0, 1] maps via cubic curve to gene_dur_sec ∈ [splice_len,
//   50 µs]. The granular branch uses `grain_buf_ar` (numChannels=2) with
//   per-grain Tukey/Hanning envelope, cubic interpolation, and
//   maxGrains=64 to bound CPU. Morph staircase is encoded as a piecewise
//   spawn-rate factor (0.67 → 1 → 2 → 3 → flat → 4) divided by gene_dur
//   to get the Impulse spawn frequency, lagged 5 ms ("Dynamic Enveloping").
//   Per-grain pan latches white-noise ramped in over Morph 0.55..0.85.
//   Per-grain pitch-up multiplies rate by `1 + TRand(0, pitch_amt)` ramped
//   in over Morph 0.85..1.0 with max +0.8 (≈ +10 ST). The whole-splice
//   path (Story A's Phasor+BufRd) is preserved and used when Gene-Size is
//   below a 0.02 threshold; transitions cross-fade over 5 ms via Lag on
//   the active flag.
//
// SOS recording (Story B):
//   record_buf_ar overdubs into the Reel with
//     recLevel = (1 - sos_norm) · rec_active
//     preLevel =      sos_norm  · rec_active   (loop feedback)
//   Forward-only at unit rate; loop=0 hard-stops at end-of-Reel. The
//   recorder Phasor is independent of the playback Phasor so reverse
//   Vari-Speed during SOS does not flip the commit direction.
//
// Param budget — Rhai closures cap at 10 args. Story B's `shift_trig` and
// `splice_trig` are dropped here to make room for `gene_size` and `morph`.
// Rationale: Organize already covers splice selection (the recently-
// touched-wins logic was Shift-only sugar), and runtime marker drops are
// out of scope for the granular layer. The marker-buffer write side from
// Story B drops with the param; users wanting marker editing layer it on
// top via a separate synthdef.
//
// Stereo: the granular path delivers true stereo via grain_buf_ar's
// numChannels=2 + per-grain pan; the whole-splice branch still surfaces
// channel-0 of the stereo Reel through BufRd (mono→duplicated). The
// branch crossfade therefore widens at the Gene-Size 0.02 threshold.

define_synthdef("morphagene", |builder| {
    builder
        .param("bufnum", 0.0)
        .param("num_splices", 1.0)        // 1..300, evenly-spaced division of Reel
        .param("organize", 0.0)           // 0..1 splice select knob+CV
        .param("sos", 0.0)                // 0..1 SOS mix (preLevel / 1-recLevel)
        .param("rec_active", 0.0)         // 0/1 recording gate (RecordBuf run input)
        .param("vari_speed", 0.0)         // bipolar -1..+1, 0 = halt
        .param("slide", 0.0)              // 0..1 start position within splice
        .param("gene_size", 0.0)          // 0..1 grain duration (cubic; 0 = whole splice)
        .param("morph", 0.0)              // 0..1 spawn cadence + pan + pitch-up
        .param("gate", 1.0)               // synth-instance lifecycle
        .body(|bufnum, num_splices, organize, sos, rec_active,
               vari_speed, slide, gene_size, morph, gate| {

            // --- Reel buffer info ----------------------------------------------
            let buf_n = buf_frames_kr(bufnum);
            let buf_scale = buf_rate_scale_kr(bufnum);
            let buf_sr = buf_sample_rate_kr(bufnum);

            // --- Splice metadata buffers ---------------------------------------
            // Single 1-frame committed-idx feedback cell; clear_buf_ir zeroes it
            // at synth init so the first block starts at splice 0.
            let committed_buf = local_buf_ir(1, 1.0);
            let _z2 = clear_buf_ir(committed_buf);

            // --- Vari-Speed → rate ---------------------------------------------
            // Asymmetric cubic per the manual's "12 up / 26 down" spec; smooth
            // through zero, finer-near-center, no dead-zone needed.
            let v_pos = vari_speed.max(0.0);
            let v_neg = vari_speed.min(0.0);
            let rate = (v_pos * v_pos * v_pos) * 2.0
                     + (v_neg * v_neg * v_neg) * 4.4898;

            // --- Splice selection (Organize) -----------------------------------
            // max_idx = num_splices - 1, floored at 0.
            let max_idx = (num_splices - 1.0).max(0.0);
            // Clamp shy of 1.0 so floor(organize · num_splices) lands inside
            // [0, num_splices-1] without ever hitting num_splices itself.
            let organize_pos = clip(organize, 0.0, 0.99999) * num_splices;
            let organize_idx = floor(organize_pos);
            let pending_idx = clip(organize_idx, 0.0, max_idx);

            // --- Committed splice idx feedback (one-block latency) -------------
            let committed_idx = buf_rd_kr(1, committed_buf, 0.0, 0, 1);

            // Splice bounds: even spacing, computed from the committed idx.
            let splice_len_frames = buf_n / num_splices.max(1.0);
            let splice_start_frame = committed_idx * splice_len_frames;
            let splice_offset = slide * splice_len_frames;

            // --- Whole-splice playback path (Story A — Phasor + BufRd) ---------
            // Audio-rate read position is splice_start + slide_offset + phase,
            // wrapped within splice_len. BufRd cubic interpolation; mono read
            // (channel 0) duplicated below.
            let phase = phasor_ar(0.0, rate * buf_scale, 0.0, splice_len_frames, 0.0);
            let read_pos = splice_start_frame
                         + wrap_ar(phase + splice_offset, 0.0, splice_len_frames);
            let raw = buf_rd_ar(2, bufnum, read_pos, 1.0, 4.0);

            // --- EOS detection (kr) --------------------------------------------
            let phase_prev = delay1_ar(phase);
            let phase_diff = phase - phase_prev;
            let abs_diff = abs(phase_diff);
            let wrap_excess = abs_diff - splice_len_frames * 0.5;
            let eos_trig_ar = sign(wrap_excess).max(0.0);
            let eos_trig = a2_k_kr(eos_trig_ar);

            // Latch pending_idx on rising EOS, write back to feedback cell.
            let new_committed = latch_kr(pending_idx, eos_trig);
            let _wrote_committed = buf_wr_kr(new_committed, committed_buf, 0.0, 0);

            // --- Gene-Size mapping (C1) ----------------------------------------
            // gene_dur_sec = mix(splice_len_sec, 50µs, gene_size_n^3).
            // Cubic shape: most of the knob travel is in long-grain territory;
            // sub-millisecond pulsar grains live in the last quarter turn.
            let gene_size_n = clip(gene_size, 0.0, 1.0);
            let gs_cubed = gene_size_n.pow(3.0);
            let splice_len_sec = splice_len_frames / buf_sr.max(1.0);
            let gene_min_sec = 50.0e-6;
            let gene_dur_sec = splice_len_sec * (1.0 - gs_cubed)
                             + gene_min_sec * gs_cubed;

            // --- Morph staircase (C3) ------------------------------------------
            // Piecewise spawn-rate factor mirroring the manual's panel arc:
            //   0.00..0.25  : 0.67 → 1.00   (gap-of-silence closing)
            //   0.25..0.50  : 1.00 → 2.00   (overlap, second instance enters)
            //   0.50..0.55  : 2.00 → 3.00   (third instance enters)
            //   0.55..0.70  : 3.00         (panning ramps in — see C4)
            //   0.70..0.85  : 3.00 → 4.00   (fourth instance enters)
            //   0.85..1.00  : 4.00 + per-grain pitch-up (see C5)
            // Each segment is a clipped ramp summed onto a 0.67 baseline.
            let morph_n = clip(morph, 0.0, 1.0);
            let r0 = clip(morph_n * 4.0, 0.0, 1.0) * 0.33;
            let r1 = clip((morph_n - 0.25) * 4.0, 0.0, 1.0);
            let r2 = clip((morph_n - 0.50) * 20.0, 0.0, 1.0);
            let r3 = clip((morph_n - 0.70) * 6.6667, 0.0, 1.0);
            let spawn_rate_factor = 0.67 + r0 + r1 + r2 + r3;

            // spawn_rate_hz = factor / gene_dur_sec, clamped to a sane ceiling
            // so the tiniest gene_dur (~50 µs) doesn't push Impulse past audio
            // rate. 4 kHz is well above any rhythmic spawn density and still
            // safely below Nyquist concerns at 48 kHz.
            let raw_rate_hz = spawn_rate_factor / gene_dur_sec.max(1.0e-6);
            let spawn_rate_hz = clip(raw_rate_hz, 0.05, 4000.0);
            // 5 ms lag on spawn rate — vibelang's stand-in for the manual's
            // "Dynamic Enveloping" smoothing of grain-rate parameter jumps.
            let smoothed_rate = lag_kr(spawn_rate_hz, 0.005);
            let spawn_trig = impulse_ar(smoothed_rate, 0.0);
            let spawn_trig_kr = a2_k_kr(spawn_trig);

            // --- Per-grain pan (C4) --------------------------------------------
            // pan_amount ramps 0..1 across Morph 0.55..0.85.
            let pan_amount = clip((morph_n - 0.55) * 3.3333, 0.0, 1.0);
            let pan_raw = white_noise_kr() * pan_amount;
            let grain_pan = latch_kr(pan_raw, spawn_trig_kr);

            // --- Per-grain pitch-up (C5) ---------------------------------------
            // pitch_amount ramps 0..0.8 across Morph 0.85..1.0. TRand returns
            // a fresh random in [0, pitch_amount] on each rising trigger and
            // holds until the next — already per-grain latched by definition.
            let pitch_amount = clip((morph_n - 0.85) * 6.6667, 0.0, 1.0) * 0.8;
            let pitch_rand = t_rand_kr(0.0, pitch_amount, spawn_trig_kr);
            let grain_rate = rate * (1.0 + pitch_rand);

            // --- Granular branch (C2) ------------------------------------------
            // Grain start position = splice_start + slide·splice_len, expressed
            // as a fraction of the whole Reel (grain_buf_ar takes pos in [0,1]).
            let grain_start_frame = splice_start_frame + splice_offset;
            let grain_pos_norm = grain_start_frame / buf_n.max(1.0);

            // grain_buf_ar(numChannels, trigger, dur, sndbuf, rate, pos,
            //              interp, pan, envbufnum, maxGrains)
            // envbufnum = -1 → built-in Hann window; maxGrains = 64 caps CPU
            // under 4× overlap with high spawn rates.
            let grain = grain_buf_ar(
                2.0,                  // numChannels = stereo
                spawn_trig,           // trigger (ar)
                gene_dur_sec,         // dur (seconds, per-grain)
                bufnum,               // sndbuf
                grain_rate,           // rate (vari-speed × pitch-up)
                grain_pos_norm,       // pos in reel
                4.0,                  // interp = cubic
                grain_pan,            // pan (per-grain via Latch)
                -1.0,                 // envbufnum = default Hann
                64.0,                 // maxGrains
            );
            let grain_lr = channels(grain, 2);
            let grain_l = grain_lr[0];
            let grain_r = grain_lr[1];

            // --- Branch crossfade (C6) -----------------------------------------
            // Gene-Size below 0.02 routes to the whole-splice path (cheaper and
            // bit-identical to a single-grain-per-cycle granular at full size).
            // The crossfade is a hard switch lagged by 5 ms to avoid clicks.
            let granular_active = clip((gene_size_n - 0.02) * 1000.0, 0.0, 1.0);
            let smooth_active = lag_ar(granular_active, 0.005);
            let mix_l = raw * (1.0 - smooth_active) + grain_l * smooth_active;
            let mix_r = raw * (1.0 - smooth_active) + grain_r * smooth_active;

            // --- SOS RecordBuf (Story B) ---------------------------------------
            // Recording advances at unit rate, forward-only — Vari-Speed never
            // affects the recorder offset. loop=0 hard-stops at end-of-Reel.
            let rec_pos = phasor_ar(0.0, 1.0, 0.0, buf_n, 0.0);
            let in_mono = sound_in_channel(0);
            let sos_norm = clip(sos, 0.0, 1.0);
            let _rec = record_buf_ar(
                in_mono,
                bufnum,
                rec_pos,
                (1.0 - sos_norm) * rec_active,    // recLevel
                sos_norm * rec_active,            // preLevel (loop feedback)
                rec_active,                       // run
                0.0,                              // loop=0 (hard-stop at end)
                1.0,                              // trigger
                0.0,                              // doneAction
            );

            // --- Output --------------------------------------------------------
            // Synth-instance ASR keeps the synth alive for held notes; DC-block
            // each output channel.
            let env = envelope()
                .asr(0.005, 1.0, 0.02)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            let left  = leak_dc_ar(mix_l * env, 0.995);
            let right = leak_dc_ar(mix_r * env, 0.995);

            [left, right]
        })
});
