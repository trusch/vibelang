// Make Noise CV Bus — passive-style kr router / normaliser.
//
// Patch CV into `in1..in4` via `.to_param` or `.modulate_by`. Each channel has
// attenuate/offset controls. `norm12`, `norm23`, and `norm34` add the previous
// bus into the next bus, approximating a normalled utility row.
//
// Public interface:
//   in1..in4       : kr CV inputs to patch with `.to_param` or `.modulate_by`.
//   atten1..atten4 : per-channel gain, default 1.0; bipolar values invert.
//   offset1..offset4: DC offsets added after attenuation.
//   norm12/norm23/norm34: normalled sends from previous bus to next, default on.
//   bus1..bus4     : clipped -1..1 per-channel kr outputs.
//   sum            : clipped kr sum of all four bus outputs.

define_synthdef("cv_bus", |builder| {
    builder
        .output_kr("bus1")
        .output_kr("bus2")
        .output_kr("bus3")
        .output_kr("bus4")
        .output_kr("sum")
        .param("in1", 0.0) // units: normalized, range: 0..1, default: 0.0. Input 1 gain; higher values add more of that CV/audio input.
        .param("in2", 0.0) // units: normalized, range: 0..1, default: 0.0. Input 2 gain; higher values add more of that CV/audio input.
        .param("in3", 0.0) // units: normalized, range: 0..1, default: 0.0. Input 3 gain; higher values add more of that CV/audio input.
        .param("in4", 0.0) // units: normalized, range: 0..1, default: 0.0. Input 4 gain; higher values add more of that CV/audio input.
        .param("atten1", 1.0) // units: normalized, range: 0..1, default: 1.0. Atten 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("atten2", 1.0) // units: normalized, range: 0..1, default: 1.0. Atten 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("atten3", 1.0) // units: normalized, range: 0..1, default: 1.0. Atten 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("atten4", 1.0) // units: normalized, range: 0..1, default: 1.0. Atten 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("offset1", 0.0) // units: normalized, range: 0..1, default: 0.0. Offset 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("offset2", 0.0) // units: normalized, range: 0..1, default: 0.0. Offset 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("offset3", 0.0) // units: normalized, range: 0..1, default: 0.0. Offset 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("offset4", 0.0) // units: normalized, range: 0..1, default: 0.0. Offset 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("norm12", 1.0) // units: normalized, range: 0..1, default: 1.0. Norm 12 amount; higher values emphasize that named musical or electrical behavior.
        .param("norm23", 1.0) // units: normalized, range: 0..1, default: 1.0. Norm 23 amount; higher values emphasize that named musical or electrical behavior.
        .param("norm34", 1.0) // units: normalized, range: 0..1, default: 1.0. Norm 34 amount; higher values emphasize that named musical or electrical behavior.
        .body_map(|p| {
            let bus1 = clip_kr(p.in1 * p.atten1 + p.offset1, -1.0, 1.0);
            let bus2 = clip_kr(p.in2 * p.atten2 + p.offset2 + bus1 * p.norm12, -1.0, 1.0);
            let bus3 = clip_kr(p.in3 * p.atten3 + p.offset3 + bus2 * p.norm23, -1.0, 1.0);
            let bus4 = clip_kr(p.in4 * p.atten4 + p.offset4 + bus3 * p.norm34, -1.0, 1.0);
            let sum_out = clip_kr(bus1 + bus2 + bus3 + bus4, -1.0, 1.0);

            [bus1, bus2, bus3, bus4, sum_out]
        })
});

//
// # Usage: `cv_bus`
//
// ```rhai
// import "stdlib/instruments/eurorack/cv_bus.vibe" as cv_bus;
//
// let cv_bus = voice("doc_cv_bus")
//     .synth("cv_bus")
//     .set_param("in1", 0.5)
//     .set_param("in2", 0.5)
//     .set_param("in3", 0.5)
//     .set_param("in4", 0.5);
// cv_bus.outputs(["bus1"]).mute();
// cv_bus.run();
// ```
