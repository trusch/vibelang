// Erica Synths Black VC EG - voltage-controlled ADSR envelope generator.
//
// Approximation: live-modulatable ADSR with per-stage CV attenuators, a
// retrigger input, +5 V-style timing pulses, and looped attack-decay cycling
// while `loop_gate` and `gate` are both high. `env` is unipolar 0..1.

fn _erica_vc_eg_gate(x) {
    schmidt_kr(x, 0.05, 0.25)
}

fn _erica_vc_eg_stage(base, cv, amt) {
    let base_clamped = clip_kr(base, 0.0, 1.0);
    let cv_clamped = clip_kr(cv, -1.0, 1.0);
    let amt_clamped = clip_kr(amt, 0.0, 1.0);

    (base_clamped * (1.0 + cv_clamped * amt_clamped)).max(0.001)
}

fn _erica_vc_eg_level(base, cv, amt) {
    let base_clamped = clip_kr(base, 0.0, 1.0);
    let cv_clamped = clip_kr(cv, -1.0, 1.0);
    let amt_clamped = clip_kr(amt, 0.0, 1.0);

    clip_kr(base_clamped * (1.0 + cv_clamped * amt_clamped), 0.0, 1.0)
}

fn _erica_vc_eg_rise(pos) {
    let x = clip_kr(pos, 0.0, 1.0);
    x * x * (3.0 - 2.0 * x)
}

define_synthdef("erica_vc_eg", |builder| {
    builder
        .output_kr("env")
        .output_kr("eoa")
        .output_kr("eod")
        .output_kr("eor")
        .param("gate", 0.0)
        .param("trigger", 0.0)
        .param("attack", 0.05)
        .param("decay", 0.3)
        .param("sustain", 0.5)
        .param("release", 0.3)
        .param("level", 1.0)
        .param("attack_cv_amt", 0.0)
        .param("decay_cv_amt", 0.0)
        .param("sustain_cv_amt", 0.0)
        .param("release_cv_amt", 0.0)
        .param("attack_cv", 0.0)
        .param("decay_cv", 0.0)
        .param("sustain_cv", 0.0)
        .param("release_cv", 0.0)
        .param("loop_gate", 0.0)
        .body_map(|p| {
            let gate = _erica_vc_eg_gate(p.gate);
            let trigger = _erica_vc_eg_gate(p.trigger);
            let gate_prev = delay1_kr(gate);
            let gate_rise = in_range_kr(gate_prev, 0.0, 0.499) * in_range_kr(gate, 0.5, 1.0);
            let gate_fall = in_range_kr(gate_prev, 0.5, 1.0) * in_range_kr(gate, 0.0, 0.499);
            let retrig = trig1_kr(trigger, 0.001);
            let start = clip_kr(gate_rise + retrig, 0.0, 1.0);

            let attack_s = _erica_vc_eg_stage(p.attack, p.attack_cv, p.attack_cv_amt);
            let decay_s = _erica_vc_eg_stage(p.decay, p.decay_cv, p.decay_cv_amt);
            let sustain = _erica_vc_eg_level(p.sustain, p.sustain_cv, p.sustain_cv_amt);
            let release_s = _erica_vc_eg_stage(p.release, p.release_cv, p.release_cv_amt);
            let level = clip_kr(p.level, 0.0, 1.0);
            let loop_mode = clip_kr(round(p.loop_gate), 0.0, 1.0);
            let normal_mode = 1.0 - loop_mode;

            let elapsed = sweep_kr(start, 1.0);
            let seen = clip_kr(pulse_count_kr(start, 0.0), 0.0, 1.0);
            let attack_pos = clip_kr(elapsed / attack_s, 0.0, 1.0);
            let decay_pos = clip_kr((elapsed - attack_s) / decay_s, 0.0, 1.0);
            let attack_env = _erica_vc_eg_rise(attack_pos);
            let decay_env = 1.0 - (1.0 - sustain) * _erica_vc_eg_rise(decay_pos);
            let attack_mask = in_range_kr(elapsed, 0.0, attack_s);
            let decay_mask = in_range_kr(elapsed, attack_s, attack_s + decay_s);
            let sustain_mask = clip_kr(1.0 - attack_mask - decay_mask, 0.0, 1.0);
            let adsr_hold = (
                attack_env * attack_mask +
                    decay_env * decay_mask +
                    sustain * sustain_mask
            ) * seen;

            let loop_total = attack_s + decay_s;
            let loop_phase = wrap_kr(sweep_kr(start, 1.0 / loop_total.max(0.002)), 0.0, 1.0);
            let loop_prev = delay1_kr(loop_phase);
            let loop_attack_frac = clip_kr(attack_s / loop_total.max(0.002), 0.001, 0.999);
            let loop_attack_pos = clip_kr(loop_phase / loop_attack_frac, 0.0, 1.0);
            let loop_decay_pos = clip_kr((loop_phase - loop_attack_frac) / (1.0 - loop_attack_frac), 0.0, 1.0);
            let loop_attack = _erica_vc_eg_rise(loop_attack_pos);
            let loop_decay = 1.0 - _erica_vc_eg_rise(loop_decay_pos);
            let loop_attack_mask = in_range_kr(loop_phase, 0.0, loop_attack_frac);
            let loop_env = (loop_attack * loop_attack_mask + loop_decay * (1.0 - loop_attack_mask)) * seen;

            let pre_release = adsr_hold * normal_mode + loop_env * loop_mode;
            let release_level = latch_kr(pre_release, gate_fall);
            let release_elapsed = sweep_kr(gate_fall, 1.0);
            let release_pos = clip_kr(release_elapsed / release_s, 0.0, 1.0);
            let release_active = in_range_kr(release_elapsed, 0.0, release_s) * clip_kr(pulse_count_kr(gate_fall, start), 0.0, 1.0);
            let release_env = release_level * (1.0 - _erica_vc_eg_rise(release_pos)) * release_active;
            let env = clip_kr((pre_release * gate + release_env * (1.0 - gate)) * level, 0.0, 1.0);

            let normal_start = start * normal_mode * gate;
            let normal_eoa = trig1_kr(t_delay_kr(normal_start, attack_s), 0.005) * gate;
            let normal_eod = trig1_kr(t_delay_kr(normal_start, attack_s + decay_s), 0.005) * gate;

            let loop_reset_mask = 1.0 - clip_kr(trig1_kr(start, 0.005), 0.0, 1.0);
            let loop_eoa_edge = in_range_kr(loop_prev, 0.0, loop_attack_frac) * in_range_kr(loop_phase, loop_attack_frac, 1.0);
            let loop_eod_edge = in_range_kr(loop_prev - loop_phase, 0.001, 2.0) * loop_reset_mask;
            let loop_eoa = trig1_kr(loop_eoa_edge * loop_mode * gate, 0.005);
            let loop_eod = trig1_kr(loop_eod_edge * loop_mode * gate, 0.005);
            let eor = trig1_kr(t_delay_kr(gate_fall, release_s), 0.005);

            [
                env,
                clip_kr((normal_eoa + loop_eoa) * 0.5, -1.0, 1.0),
                clip_kr((normal_eod + loop_eod) * 0.5, -1.0, 1.0),
                clip_kr(eor * 0.5, -1.0, 1.0),
            ]
        })
});
