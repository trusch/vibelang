// kind=processor | category=eurorack | flavor=mutable-rings | inputs=in:1 | outputs=odd:1,even:1,sum:1 | params=pit,structure,brightness,damping,position,model,polyphony,internal_exciter,bypass,gain,trigger
//
// Mutable Instruments Rings - modal resonator / sympathetic string processor.
//
// Thin wrapper around the canonical mi-UGens `mi_rings_ar` port. Feed
// excitation audio into the named `in` jack, or set `internal_exciter=1` and
// pulse `trigger` to let Rings sing without an `in` signal.
//
// Model table:
//   0  modal
//   1  sympathetic string
//   2  string
//   3  FM voice
//   4  quantized sympathetic string
//   5  string + reverb
//
// Outputs:
//   odd  - first Rings output, conventionally routed as the odd resonator bank
//   even - second Rings output, conventionally routed as the even resonator bank
//   sum  - odd + even mono mix for simple single-port patches
//
// Public interface:
//   in              : mono external excitation audio.
//   odd/even/sum    : mono audio outputs described above.
//   pit             : pitch in MIDI note units.
//   structure       : 0..1 resonator structure.
//   brightness      : 0..1 exciter/resonator brightness.
//   damping         : 0..1 decay damping.
//   position        : 0..1 excitation position.
//   model           : rounded model enum above.
//   polyphony       : polyphony selector passed to the Rings core.
//   internal_exciter: 0 external input, 1 use internal exciter.
//   bypass          : 0 resonator, 1 bypass through the core.
//   gain            : output gain multiplier.
//   trigger         : 0/1 trigger for the internal exciter.

define_synthdef("rings", |builder| {
    builder
        .input("in", 1)             // 1ch - external excitation audio
        .output("odd")              // 1ch - Rings first output
        .output("even")             // 1ch - Rings second output
        .output("sum")              // 1ch - odd + even convenience mix
        .param("pit", 60.0) // units: MIDI note, range: 0..127, default: 60.0. Pitch in MIDI-note units; higher values play higher notes.
        .param("structure", 0.5) // units: normalized, range: 0..1, default: 0.5. Structure macro; higher values move the model toward its brighter or more complex side.
        .param("brightness", 0.5) // units: normalized, range: 0..1, default: 0.5. Tone brightness; higher values add more high-frequency content.
        .param("damping", 0.5) // units: linear, range: 0..1, default: 0.5. High-frequency damping; higher values darken and shorten resonant tails.
        .param("position", 0.5) // units: normalized, range: 0..1, default: 0.5. Position macro; higher values move the model toward its brighter or more complex side.
        .param("model", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or step count.
        .param("polyphony", 1.0) // units: normalized, range: 0..1, default: 1.0. Polyphony amount; higher values emphasize that named musical or electrical behavior.
        .param("internal_exciter", 0.0) // units: normalized, range: 0..1, default: 0.0. Internal Exciter amount; higher values emphasize that named musical or electrical behavior.
        .param("bypass", 0.0) // units: normalized, range: 0..1, default: 0.0. Bypass switch; rounded values turn that mode off or on.
        .param("gain", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
        .param("trigger", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body_map(|p| {
            // mi_rings_ar args: in, trig, pit, struct, bright, damp, pos,
            // model, poly, intern_exciter, easteregg, bypass, mul
            let rings = channels(
                mi_rings_ar(
                    p.inputs["in"],
                    p.trigger,
                    p.pit,
                    p.structure,
                    p.brightness,
                    p.damping,
                    p.position,
                    p.model,
                    p.polyphony,
                    p.internal_exciter,
                    0.0,
                    p.bypass,
                    p.gain
                ),
                2
            );

            let odd = leak_dc_ar(rings[0], 0.995);
            let even = leak_dc_ar(rings[1], 0.995);

            [
                odd,
                even,
                odd + even,
            ]
        })
});

//
// # Usage: `rings`
//
// ```rhai
// import "stdlib/instruments/eurorack/rings.vibe" as rings;
//
// let rings = voice("doc_rings")
//     .synth("rings")
//     .set_param("damping", 0.5)
//     .set_param("gain", 0.5)
//     .set_param("model", 1.0)
//     .set_param("pit", 0.5);
// rings.output("odd").to_main();
// rings.run();
// ```
