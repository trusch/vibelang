// kind=processor | category=eurorack | flavor=mutable-rings | inputs=in:1 | outputs=odd:1,even:1,sum:1 | params=pit,structure,brightness,damping,position,model,polyphony,internal_exciter,bypass,gain,trigger
//
// Mutable Instruments Rings - modal resonator / sympathetic string processor.
//
// Thin wrapper around the canonical mi-UGens `mi_rings_ar` port. Feed
// excitation audio into the named `in` jack, or set `internal_exciter=1` and
// pulse `trigger` to let Rings sing without an `in` signal.
//
// Model table:
//   0  modal
//   1  sympathetic string
//   2  string
//   3  FM voice
//   4  quantized sympathetic string
//   5  string + reverb
//
// Outputs:
//   odd  - first Rings output, conventionally routed as the odd resonator bank
//   even - second Rings output, conventionally routed as the even resonator bank
//   sum  - odd + even mono mix for simple single-port patches
//
// Public interface:
//   in              : mono external excitation audio.
//   odd/even/sum    : mono audio outputs described above.
//   pit             : pitch in MIDI note units.
//   structure       : 0..1 resonator structure.
//   brightness      : 0..1 exciter/resonator brightness.
//   damping         : 0..1 decay damping.
//   position        : 0..1 excitation position.
//   model           : rounded model enum above.
//   polyphony       : polyphony selector passed to the Rings core.
//   internal_exciter: 0 external input, 1 use internal exciter.
//   bypass          : 0 resonator, 1 bypass through the core.
//   gain            : output gain multiplier.
//   trigger         : 0/1 trigger for the internal exciter.

define_synthdef("rings", |builder| {
    builder
        .input("in", 1)             // 1ch - external excitation audio
        .output("odd")              // 1ch - Rings first output
        .output("even")             // 1ch - Rings second output
        .output("sum")              // 1ch - odd + even convenience mix
        .param("pit", 60.0)                 // pitch in MIDI note units passed to the Rings core
        .param("structure", 0.5)            // 0..1 resonator structure control
        .param("brightness", 0.5)           // 0..1 exciter/resonator brightness
        .param("damping", 0.5)              // 0..1 resonator decay damping
        .param("position", 0.5)             // 0..1 excitation position along the resonator
        .param("model", 0.0)                // rounded Rings resonator model enum
        .param("polyphony", 1.0)            // polyphony selector passed to the Rings core
        .param("internal_exciter", 0.0)     // 0 external input, 1 use internal exciter
        .param("bypass", 0.0)               // 0 resonator path, 1 bypass through the core
        .param("gain", 1.0)                 // output gain multiplier for Rings outputs
        .param("trigger", 0.0)              // 0/1 trigger for the internal exciter
        .body_map(|p| {
            // mi_rings_ar args: in, trig, pit, struct, bright, damp, pos,
            // model, poly, intern_exciter, easteregg, bypass, mul
            let rings = channels(
                mi_rings_ar(
                    p.inputs["in"],
                    p.trigger,
                    p.pit,
                    p.structure,
                    p.brightness,
                    p.damping,
                    p.position,
                    p.model,
                    p.polyphony,
                    p.internal_exciter,
                    0.0,
                    p.bypass,
                    p.gain
                ),
                2
            );

            let odd = leak_dc_ar(rings[0], 0.995);
            let even = leak_dc_ar(rings[1], 0.995);

            [
                odd,
                even,
                odd + even,
            ]
        })
});
