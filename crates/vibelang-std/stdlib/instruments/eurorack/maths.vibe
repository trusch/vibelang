// Make Noise Maths — practical multi-output control recreation.
//
// kr ports:
//   ch1/ch4: triggered or cycling function channels.
//   ch2/ch3: attenuverter/offset utility channels. Patch kr CV to `ch2`/`ch3`
//            via `.to_param`/`.modulate_by`; `chN_scale` is a bipolar knob.
//   sum/or/inv: Maths-style combined outputs.
//   eor1/eoc1/eor4/eoc4: 5 ms +5 V timing pulses.
//
// Params are intentionally direct CV patch points. `riseN_cv`/`fallN_cv`
// bend the base segment times exponentially, and `shape1`/`shape4` are a
// practical runtime curve morph: 0 = squared/log-like, 0.5 = Decay2's native
// exponential, 1 = sqrt/exp-like. This is not a segment-accurate Maths curve
// circuit, but it makes the shape controls musically useful with current UGens.
//
// Public interface:
//   ch1/ch4        : kr function outputs, clipped -1..1.
//   ch2/ch3        : kr attenuverter/offset utility outputs.
//   sum/or/inv     : kr combined outputs from all four channels.
//   eorN/eocN      : kr 5 ms timing pulses for channels 1 and 4.
//   riseN/fallN    : base segment times in seconds for channels 1 and 4.
//   riseN_cv/fallN_cv: bipolar timing CV inputs.
//   riseN_cv_scale/fallN_cv_scale: bipolar CV depth, clipped to +/-1 after
//                   multiplication.
//   shapeN         : 0 squared/log-like, 0.5 native exponential, 1 sqrt/exp-like.
//   cycleN         : 0 one-shot trigger mode; >0 cycles at 1/(rise+fall).
//   trigN          : 0/1 trigger input for channels 1 and 4.
//   ch2/ch3        : direct utility CV inputs, usually mapped from another kr port.
//   chN_scale      : 0..1 knob mapped to -1..+1 attenuverter gain.
//   chN_offset     : DC offset added after scaling.

define_synthdef("maths", |builder| {
    builder
        .output_kr("ch1")
        .output_kr("ch2")
        .output_kr("ch3")
        .output_kr("ch4")
        .output_kr("sum")
        .output_kr("or")
        .output_kr("inv")
        .output_kr("eor1")
        .output_kr("eoc1")
        .output_kr("eor4")
        .output_kr("eoc4")
        .param("rise1", 0.05)
        .param("rise1_cv", 0.0)
        .param("rise1_cv_scale", 1.0)
        .param("fall1", 0.5)
        .param("fall1_cv", 0.0)
        .param("fall1_cv_scale", 1.0)
        .param("shape1", 0.5)
        .param("cycle1", 0.0)
        .param("trig1", 0.0)
        .param("rise4", 0.05)
        .param("rise4_cv", 0.0)
        .param("rise4_cv_scale", 1.0)
        .param("fall4", 0.5)
        .param("fall4_cv", 0.0)
        .param("fall4_cv_scale", 1.0)
        .param("shape4", 0.5)
        .param("cycle4", 0.0)
        .param("trig4", 0.0)
        .param("ch2", 0.0)
        .param("ch2_scale", 0.5)
        .param("ch2_offset", 0.0)
        .param("ch3", 0.0)
        .param("ch3_scale", 0.5)
        .param("ch3_offset", 0.0)
        .body_map(|p| {
            let rise1_cv = clip(p.rise1_cv * p.rise1_cv_scale, -1.0, 1.0);
            let fall1_cv = clip(p.fall1_cv * p.fall1_cv_scale, -1.0, 1.0);
            let rise4_cv = clip(p.rise4_cv * p.rise4_cv_scale, -1.0, 1.0);
            let fall4_cv = clip(p.fall4_cv * p.fall4_cv_scale, -1.0, 1.0);

            let rise1 = (p.rise1 * pow(2.0, rise1_cv * 4.0)).max(0.001);
            let fall1 = (p.fall1 * pow(2.0, fall1_cv * 4.0)).max(0.001);
            let rise4 = (p.rise4 * pow(2.0, rise4_cv * 4.0)).max(0.001);
            let fall4 = (p.fall4 * pow(2.0, fall4_cv * 4.0)).max(0.001);

            let cycle_rate1 = p.cycle1.max(0.0) / (rise1 + fall1 + 0.001);
            let cycle_rate4 = p.cycle4.max(0.0) / (rise4 + fall4 + 0.001);
            let trig_src1 = p.trig1 + impulse_kr(cycle_rate1, 0.0);
            let trig_src4 = p.trig4 + impulse_kr(cycle_rate4, 0.0);

            let env1_raw = decay2_kr(trig_src1, rise1, fall1);
            let env4_raw = decay2_kr(trig_src4, rise4, fall4);

            let shape1 = clip(p.shape1, 0.0, 1.0);
            let low1 = (1.0 - shape1 * 2.0).max(0.0);
            let high1 = (shape1 * 2.0 - 1.0).max(0.0);
            let mid1 = (1.0 - low1 - high1).max(0.0);
            let env1_sq = env1_raw * env1_raw;
            let env1_sqrt = sqrt(clip(env1_raw, 0.0, 1.0));
            let ch1_out = clip_kr(env1_sq * low1 + env1_raw * mid1 + env1_sqrt * high1, -1.0, 1.0);

            let shape4 = clip(p.shape4, 0.0, 1.0);
            let low4 = (1.0 - shape4 * 2.0).max(0.0);
            let high4 = (shape4 * 2.0 - 1.0).max(0.0);
            let mid4 = (1.0 - low4 - high4).max(0.0);
            let env4_sq = env4_raw * env4_raw;
            let env4_sqrt = sqrt(clip(env4_raw, 0.0, 1.0));
            let ch4_out = clip_kr(env4_sq * low4 + env4_raw * mid4 + env4_sqrt * high4, -1.0, 1.0);

            let ch2_attenuverter = clip(p.ch2_scale * 2.0 - 1.0, -1.0, 1.0);
            let ch3_attenuverter = clip(p.ch3_scale * 2.0 - 1.0, -1.0, 1.0);
            let ch2_out = clip_kr(p.ch2 * ch2_attenuverter + p.ch2_offset, -1.0, 1.0);
            let ch3_out = clip_kr(p.ch3 * ch3_attenuverter + p.ch3_offset, -1.0, 1.0);

            let sum_mix = ch1_out + ch2_out + ch3_out + ch4_out;
            let sum_out = clip_kr(sum_mix, -1.0, 1.0);
            let or_out = max(max(ch1_out, ch2_out), max(ch3_out, ch4_out));
            let inv_out = clip_kr(0.0 - sum_mix, -1.0, 1.0);

            let eor1 = clip_kr(trig1_kr(t_delay_kr(trig_src1, rise1), 0.005) * 0.5, -1.0, 1.0);
            let eoc1 = clip_kr(trig1_kr(t_delay_kr(trig_src1, rise1 + fall1), 0.005) * 0.5, -1.0, 1.0);
            let eor4 = clip_kr(trig1_kr(t_delay_kr(trig_src4, rise4), 0.005) * 0.5, -1.0, 1.0);
            let eoc4 = clip_kr(trig1_kr(t_delay_kr(trig_src4, rise4 + fall4), 0.005) * 0.5, -1.0, 1.0);

            [
                ch1_out, ch2_out, ch3_out, ch4_out, sum_out, or_out, inv_out,
                eor1, eoc1, eor4, eoc4,
            ]
        })
});
