// kind=cv | category=eurorack | flavor=mutable-frames | inputs=in1:1,in2:1,in3:1,in4:1 | outputs=out1:kr,out2:kr,out3:kr,out4:kr,mix:kr | params=frame,frame_cv,frame_cv_amt,level_1..level_4,easing_1..easing_4,kf_1_1..kf_4_8
//
// Mutable Instruments Frames - four-channel keyframe morpher / VCA mixer.
//
// The hardware stores many timestamped keyframes and panel settings. This
// stdlib version exposes eight script-level keyframes per channel and a direct
// `frame` scan position. Patch audio-rate CV into `in1..in4`; the ports are
// decimated to kr so `out1..out4` and `mix` can drive params through the normal
// CV routing surface.
//
// Easing table (`easing_X`, rounded and clipped to 0..5):
//   0 step        - hold the current keyframe until the next boundary.
//   1 linear      - straight interpolation.
//   2 quartic-in  - slow start, fast finish.
//   3 quartic-out - fast start, slow finish.
//   4 sine        - sinusoidal ease-in/out.
//   5 bounce      - ease-out bounce response.
//
// Public interface:
//   in1..in4       : mono audio/CV inputs, decimated to kr inside the module.
//   out1..out4     : per-channel kr VCA/morpher outputs.
//   mix            : kr sum of out1..out4.
//   frame          : 0..1 keyframe scan position.
//   frame_cv       : bipolar frame CV; `frame_cv_amt` scales it before clipping.
//   level_1..level_4: 0..1 channel input gains.
//   easing_1..easing_4: enum above for interpolation per channel.
//   kf_N_1..kf_N_8 : eight 0..1 keyframe levels for channel N.

fn _frames_mask(value, target) {
    1.0 - clip_kr(abs(value - target), 0.0, 1.0)
}

fn _frames_select8(index, kf1, kf2, kf3, kf4, kf5, kf6, kf7, kf8) {
    let idx = clip_kr(index, 0.0, 7.0);
    let m0 = _frames_mask(idx, 0.0);
    let m1 = _frames_mask(idx, 1.0);
    let m2 = _frames_mask(idx, 2.0);
    let m3 = _frames_mask(idx, 3.0);
    let m4 = _frames_mask(idx, 4.0);
    let m5 = _frames_mask(idx, 5.0);
    let m6 = _frames_mask(idx, 6.0);
    let m7 = _frames_mask(idx, 7.0);

    m0 * clip_kr(kf1, 0.0, 1.0)
        + m1 * clip_kr(kf2, 0.0, 1.0)
        + m2 * clip_kr(kf3, 0.0, 1.0)
        + m3 * clip_kr(kf4, 0.0, 1.0)
        + m4 * clip_kr(kf5, 0.0, 1.0)
        + m5 * clip_kr(kf6, 0.0, 1.0)
        + m6 * clip_kr(kf7, 0.0, 1.0)
        + m7 * clip_kr(kf8, 0.0, 1.0)
}

fn _frames_ease(frac, easing) {
    let t = clip_kr(frac, 0.0, 1.0);
    let curve = clip_kr(round(easing), 0.0, 5.0);
    let m_step = _frames_mask(curve, 0.0);
    let m_linear = _frames_mask(curve, 1.0);
    let m_quartic_in = _frames_mask(curve, 2.0);
    let m_quartic_out = _frames_mask(curve, 3.0);
    let m_sine = _frames_mask(curve, 4.0);
    let m_bounce = _frames_mask(curve, 5.0);

    let t2 = t * t;
    let quartic_in = t2 * t2;
    let out_t = 1.0 - t;
    let out_t2 = out_t * out_t;
    let quartic_out = 1.0 - out_t2 * out_t2;
    let sine = (sin_osc_kr(0.0, t * 3.1415927 - 1.5707963) + 1.0) * 0.5;

    let b0 = in_range_kr(t, 0.0, 0.3636363);
    let b1 = in_range_kr(t, 0.3636364, 0.7272727);
    let b2 = in_range_kr(t, 0.7272728, 0.9090909);
    let b3 = in_range_kr(t, 0.9090910, 1.0);
    let b1t = t - 0.5454545;
    let b2t = t - 0.8181818;
    let b3t = t - 0.9545455;
    let bounce =
        b0 * (7.5625 * t * t)
        + b1 * (7.5625 * b1t * b1t + 0.75)
        + b2 * (7.5625 * b2t * b2t + 0.9375)
        + b3 * (7.5625 * b3t * b3t + 0.984375);

    clip_kr(
        m_step * 0.0
            + m_linear * t
            + m_quartic_in * quartic_in
            + m_quartic_out * quartic_out
            + m_sine * sine
            + m_bounce * bounce,
        0.0,
        1.0
    )
}

fn _frames_interp(pos, easing, kf1, kf2, kf3, kf4, kf5, kf6, kf7, kf8) {
    let scaled = clip_kr(pos, 0.0, 1.0) * 7.0;
    let index = floor(scaled);
    let next_index = (index + 1.0).min(7.0);
    let frac = clip_kr(scaled - index, 0.0, 1.0);
    let eased = _frames_ease(frac, easing);

    let current = _frames_select8(index, kf1, kf2, kf3, kf4, kf5, kf6, kf7, kf8);
    let next = _frames_select8(next_index, kf1, kf2, kf3, kf4, kf5, kf6, kf7, kf8);

    current * (1.0 - eased) + next * eased
}

define_synthdef("frames", |builder| {
    builder
        .input("in1", 1)
        .input("in2", 1)
        .input("in3", 1)
        .input("in4", 1)
        .output_kr("out1")
        .output_kr("out2")
        .output_kr("out3")
        .output_kr("out4")
        .output_kr("mix")
        .param("frame", 0.0) // units: normalized, range: 0..1, default: 0.0. Frame amount; higher values emphasize that named musical or electrical behavior.
        .param("frame_cv", 0.0) // units: normalized, range: 0..1, default: 0.0. Frame CV input; bipolar values modulate the matching panel control.
        .param("frame_cv_amt", 0.0) // units: linear, range: -1..1, default: 0.0. FRAME CV AMT attenuator; higher makes the matching CV modulation stronger.
        .param("level_1", 0.5) // units: linear, range: 0..1, default: 0.5. VCA channel 1 level; higher opens the amplifier further.
        .param("easing_1", 1.0) // units: normalized, range: 0..1, default: 1.0. Easing 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_1", 0.1) // units: normalized, range: 0..1, default: 0.1. Kf 1 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_2", 0.2) // units: normalized, range: 0..1, default: 0.2. Kf 1 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_3", 0.3) // units: normalized, range: 0..1, default: 0.3. Kf 1 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_4", 0.4) // units: normalized, range: 0..1, default: 0.4. Kf 1 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_5", 0.5) // units: normalized, range: 0..1, default: 0.5. Kf 1 5 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_6", 0.6) // units: normalized, range: 0..1, default: 0.6. Kf 1 6 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_7", 0.7) // units: normalized, range: 0..1, default: 0.7. Kf 1 7 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_1_8", 0.8) // units: normalized, range: 0..1, default: 0.8. Kf 1 8 amount; higher values emphasize that named musical or electrical behavior.
        .param("level_2", 0.5) // units: linear, range: 0..1, default: 0.5. VCA channel 2 level; higher opens the amplifier further.
        .param("easing_2", 1.0) // units: normalized, range: 0..1, default: 1.0. Easing 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_1", 0.1) // units: normalized, range: 0..1, default: 0.1. Kf 2 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_2", 0.2) // units: normalized, range: 0..1, default: 0.2. Kf 2 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_3", 0.3) // units: normalized, range: 0..1, default: 0.3. Kf 2 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_4", 0.4) // units: normalized, range: 0..1, default: 0.4. Kf 2 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_5", 0.5) // units: normalized, range: 0..1, default: 0.5. Kf 2 5 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_6", 0.6) // units: normalized, range: 0..1, default: 0.6. Kf 2 6 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_7", 0.7) // units: normalized, range: 0..1, default: 0.7. Kf 2 7 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_2_8", 0.8) // units: normalized, range: 0..1, default: 0.8. Kf 2 8 amount; higher values emphasize that named musical or electrical behavior.
        .param("level_3", 0.5) // units: linear, range: 0..1, default: 0.5. VCA channel 3 level; higher opens the amplifier further.
        .param("easing_3", 1.0) // units: normalized, range: 0..1, default: 1.0. Easing 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_1", 0.1) // units: normalized, range: 0..1, default: 0.1. Kf 3 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_2", 0.2) // units: normalized, range: 0..1, default: 0.2. Kf 3 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_3", 0.3) // units: normalized, range: 0..1, default: 0.3. Kf 3 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_4", 0.4) // units: normalized, range: 0..1, default: 0.4. Kf 3 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_5", 0.5) // units: normalized, range: 0..1, default: 0.5. Kf 3 5 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_6", 0.6) // units: normalized, range: 0..1, default: 0.6. Kf 3 6 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_7", 0.7) // units: normalized, range: 0..1, default: 0.7. Kf 3 7 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_3_8", 0.8) // units: normalized, range: 0..1, default: 0.8. Kf 3 8 amount; higher values emphasize that named musical or electrical behavior.
        .param("level_4", 0.5) // units: linear, range: 0..1, default: 0.5. VCA channel 4 level; higher opens the amplifier further.
        .param("easing_4", 1.0) // units: normalized, range: 0..1, default: 1.0. Easing 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_1", 0.1) // units: normalized, range: 0..1, default: 0.1. Kf 4 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_2", 0.2) // units: normalized, range: 0..1, default: 0.2. Kf 4 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_3", 0.3) // units: normalized, range: 0..1, default: 0.3. Kf 4 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_4", 0.4) // units: normalized, range: 0..1, default: 0.4. Kf 4 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_5", 0.5) // units: normalized, range: 0..1, default: 0.5. Kf 4 5 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_6", 0.6) // units: normalized, range: 0..1, default: 0.6. Kf 4 6 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_7", 0.7) // units: normalized, range: 0..1, default: 0.7. Kf 4 7 amount; higher values emphasize that named musical or electrical behavior.
        .param("kf_4_8", 0.8) // units: normalized, range: 0..1, default: 0.8. Kf 4 8 amount; higher values emphasize that named musical or electrical behavior.
        .body_map(|p| {
            let pos = clip_kr(p.frame + p.frame_cv * clip_kr(p.frame_cv_amt, 0.0, 1.0), 0.0, 1.0);

            let k1 = _frames_interp(
                pos, p.easing_1,
                p.kf_1_1, p.kf_1_2, p.kf_1_3, p.kf_1_4,
                p.kf_1_5, p.kf_1_6, p.kf_1_7, p.kf_1_8
            );
            let k2 = _frames_interp(
                pos, p.easing_2,
                p.kf_2_1, p.kf_2_2, p.kf_2_3, p.kf_2_4,
                p.kf_2_5, p.kf_2_6, p.kf_2_7, p.kf_2_8
            );
            let k3 = _frames_interp(
                pos, p.easing_3,
                p.kf_3_1, p.kf_3_2, p.kf_3_3, p.kf_3_4,
                p.kf_3_5, p.kf_3_6, p.kf_3_7, p.kf_3_8
            );
            let k4 = _frames_interp(
                pos, p.easing_4,
                p.kf_4_1, p.kf_4_2, p.kf_4_3, p.kf_4_4,
                p.kf_4_5, p.kf_4_6, p.kf_4_7, p.kf_4_8
            );

            let out1 = a2k_kr(p.inputs.in1) * clip_kr(p.level_1, 0.0, 1.0) * k1;
            let out2 = a2k_kr(p.inputs.in2) * clip_kr(p.level_2, 0.0, 1.0) * k2;
            let out3 = a2k_kr(p.inputs.in3) * clip_kr(p.level_3, 0.0, 1.0) * k3;
            let out4 = a2k_kr(p.inputs.in4) * clip_kr(p.level_4, 0.0, 1.0) * k4;
            let mix = out1 + out2 + out3 + out4;

            [out1, out2, out3, out4, mix]
        })
});

//
// # Usage: `frames`
//
// ```rhai
// import "stdlib/instruments/eurorack/frames.vibe" as frames;
//
// let frames = voice("doc_frames")
//     .synth("frames")
//     .set_param("level_1", 0.5)
//     .set_param("frame", 0.5)
//     .set_param("frame_cv", 0.5)
//     .set_param("frame_cv_amt", 0.5);
// frames.outputs(["out1"]).mute();
// frames.run();
// ```
