// kind=instrument | category=eurorack | flavor=mutable-plaits | params=pitch,engine,harmonics,timbre,morph,trigger,level,fm_mod,timbre_mod,morph_mod,decay,lpg_colour
//
// Mutable Instruments Plaits - macro-oscillator voice.
//
// Thin wrapper around the canonical mi-UGens `mi_plaits_ar` port. Plaits
// exposes two independent mono audio outputs: `out` is the main model output,
// and `aux` is the model-specific alternate output.
//
// Engines use the source-current 24-engine enum:
//
//   Original 16 panel engines:
//     0  virtual_analog       1  waveshaping
//     2  fm                   3  grain
//     4  additive             5  wavetable
//     6  chord                7  speech
//     8  swarm                9  noise
//     10 particle             11 string
//     12 modal                13 bass_drum
//     14 snare_drum           15 hi_hat
//
//   v1.2 additions:
//     16 virtual_analog_vcf   17 phase_distortion
//     18 6op_bank1            19 6op_bank2
//     20 6op_bank3            21 wave_terrain
//     22 string_machine       23 chiptune
//
// `trigger` defaults to 0 for sustained/manual control. A positive trigger
// fires Plaits' internal envelope/LPG; `level`, `decay`, and `lpg_colour`
// shape the internal low-pass gate.
//
// Public interface:
//   out/aux        : mono main and model-specific alternate audio outputs.
//   pitch          : pitch in MIDI note units.
//   engine         : rounded 0..23 engine enum above.
//   harmonics/timbre/morph: 0..1 model controls.
//   trigger        : positive trigger/gate for the internal exciter/LPG.
//   level          : 0..1 internal LPG level.
//   fm_mod/timbre_mod/morph_mod: bipolar CV-style modulation inputs passed to
//                  the Plaits core.
//   decay          : 0..1 internal envelope decay.
//   lpg_colour     : 0..1 low-pass gate color.

define_synthdef("plaits", |builder| {
    builder
        .output("out")       // 1ch - main Plaits OUT jack
        .output("aux")       // 1ch - model-specific AUX jack
        .param("pitch", 60.0) // units: MIDI note, range: 0..127, default: 60.0. Pitch in MIDI-note units; higher values play higher notes.
        .param("engine", 0.0) // units: normalized, range: 0..1, default: 0.0. Mode selector; rounded values choose the model or scale listed in the header.
        .param("harmonics", 0.5) // units: normalized, range: 0..1, default: 0.5. Harmonics macro; higher values move the model toward its brighter or more complex side.
        .param("timbre", 0.5) // units: normalized, range: 0..1, default: 0.5. Timbre macro; higher values move the model toward its brighter or more complex side.
        .param("morph", 0.5) // units: normalized, range: 0..1, default: 0.5. Morph macro; higher values move the model toward its brighter or more complex side.
        .param("trigger", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("level", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("fm_mod", 0.0) // units: normalized, range: 0..1, default: 0.0. Fm modulation input; bipolar values push that macro around its panel setting.
        .param("timbre_mod", 0.0) // units: normalized, range: 0..1, default: 0.0. Timbre modulation input; bipolar values push that macro around its panel setting.
        .param("morph_mod", 0.0) // units: normalized, range: 0..1, default: 0.0. Morph modulation input; bipolar values push that macro around its panel setting.
        .param("decay", 0.5) // units: seconds, range: 0..60, default: 0.5. Envelope time or level; higher values make that stage last longer or sustain higher.
        .param("lpg_colour", 0.5) // units: normalized, range: 0..1, default: 0.5. Lpg Colour amount; higher values emphasize that named musical or electrical behavior.
        .body_map(|p| {
            // mi_plaits_ar args: pitch, engine, harm, timbre, morph, trigger,
            // level, fm_mod, timb_mod, morph_mod, decay, lpg_colour, mul
            let plaits = channels(
                mi_plaits_ar(
                    p.pitch,
                    p.engine,
                    p.harmonics,
                    p.timbre,
                    p.morph,
                    p.trigger,
                    p.level,
                    p.fm_mod,
                    p.timbre_mod,
                    p.morph_mod,
                    p.decay,
                    p.lpg_colour,
                    1.0
                ),
                2
            );

            [
                leak_dc_ar(plaits[0], 0.995),
                leak_dc_ar(plaits[1], 0.995),
            ]
        })
});

//
// # Usage: `plaits`
//
// ```rhai
// import "stdlib/instruments/eurorack/plaits.vibe" as plaits;
//
// let plaits = voice("doc_plaits")
//     .synth("plaits")
//     .set_param("level", 0.5)
//     .set_param("decay", 0.35)
//     .set_param("pitch", 0.5)
//     .set_param("engine", 0.5);
// plaits.output("out").to_main();
// plaits.run();
// ```
