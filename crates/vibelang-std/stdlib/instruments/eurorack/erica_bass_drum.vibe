// Erica Synths Black Bass Drum - patchable 909-style Eurorack kick voice.
//
// Approximation: sine body with exponential pitch sweep, shaped attack noise,
// gate sustain mode, accent level/pitch boost, and voltage-style params for
// pitch/decay/drive modulation.
//
// Public interface:
//   out/noise       : mono full kick and isolated attack-noise audio outputs.
//   trig/gate       : 0/1 trigger inputs; `gate` also holds a sustained tail.
//   accent          : 0..1 level and pitch emphasis.
//   pitch           : base body frequency in Hz, clipped to 20..220.
//   pitch_cv        : bipolar pitch CV; `pitch_cv_amt` scales up to +/-2 oct.
//   tune_depth      : pitch-sweep depth in semitones, clipped to 0..36.
//   tune_decay      : pitch-sweep decay seconds, clipped to 5..500 ms.
//   attack          : 0..1 beater/noise brightness and click length.
//   decay           : amp decay seconds before CV, clipped to 40 ms..4 s.
//   decay_cv        : bipolar decay CV; `decay_cv_amt` scales up to +/-2 oct.
//   drive           : 0..1 soft saturation; `drive_cv`/`drive_cv_amt` modulate it.

define_synthdef("erica_bass_drum", |builder| {
    builder
        .output("out")
        .output("noise")
        .param("trig", 0.0)                 // 0/1 trigger input that fires the kick envelope
        .param("gate", 0.0)                 // 0/1 gate input that fires and can hold a sustained tail
        .param("accent", 0.0)               // 0..1 level and pitch emphasis for accented hits
        .param("pitch", 55.0)               // base body frequency in Hz before CV and accent
        .param("pitch_cv", 0.0)             // bipolar pitch CV scaled by pitch_cv_amt up to +/-2 octaves
        .param("pitch_cv_amt", 0.0)         // 0..1 attenuator for pitch_cv depth
        .param("tune_depth", 12.0)          // pitch-sweep depth in semitones
        .param("tune_decay", 0.05)          // pitch-sweep decay time in seconds
        .param("attack", 0.55)              // 0..1 beater click brightness and length
        .param("decay", 0.5)                // amp decay time in seconds before decay CV
        .param("decay_cv", 0.0)             // bipolar decay CV scaled by decay_cv_amt up to +/-2 octaves
        .param("decay_cv_amt", 0.0)         // 0..1 attenuator for decay_cv depth
        .param("drive", 0.25)               // 0..1 soft saturation amount before accent gain
        .param("drive_cv", 0.0)             // bipolar CV summed into drive through drive_cv_amt
        .param("drive_cv_amt", 0.0)         // 0..1 attenuator for drive_cv depth
        .body_map(|p| {
            let accent = clip(p.accent, 0.0, 1.0);
            let attack = clip(p.attack, 0.0, 1.0);

            let pitch_cv = clip(p.pitch_cv, -1.0, 1.0) * clip(p.pitch_cv_amt, 0.0, 1.0);
            let base_pitch = clip(p.pitch * pow(2.0, pitch_cv * 2.0 + accent * (2.0 / 12.0)), 20.0, 220.0);

            let decay_cv = clip(p.decay_cv, -1.0, 1.0) * clip(p.decay_cv_amt, 0.0, 1.0);
            let amp_decay = clip(p.decay * pow(2.0, decay_cv * 2.0), 0.04, 4.0);

            let drive_cv = clip(p.drive_cv, -1.0, 1.0) * clip(p.drive_cv_amt, 0.0, 1.0);
            let drive = clip(p.drive + drive_cv, 0.0, 1.0);

            let trig_in = k2a_ar(clip(p.trig, 0.0, 1.0));
            let gate_in = k2a_ar(clip(p.gate, 0.0, 1.0));
            let trig_pulse = trig1_ar(trig_in, 0.001);
            let gate_pulse = trig1_ar(gate_in, 0.001);
            let fire = trig_pulse + gate_pulse;

            let tune_decay = clip(p.tune_decay, 0.005, 0.5);
            let sweep_semitones = clip(p.tune_depth + accent * 4.0, 0.0, 36.0);
            let pitch_env = decay2_ar(fire, 0.001, tune_decay);
            let freq = base_pitch * pow(2.0, (sweep_semitones * pitch_env) / 12.0);

            let hit_env = decay2_ar(fire, 0.001, amp_decay);
            let gate_hold = lag_ud_ar(gate_in, 0.001, amp_decay) * 0.7;
            let amp_env = max(hit_env, gate_hold);

            let body = sin_osc_ar(freq) * amp_env;
            let low_weight = 0.08 + (1.0 - attack) * 0.12;
            let low_body = sin_osc_ar(freq * 0.5) * amp_env * low_weight;

            let click_time = 0.01 + attack * 0.02;
            let click_env = decay2_ar(fire, 0.0005, click_time);
            let click_filter = 1800.0 + attack * 6200.0;
            let noise_burst = hpf_ar(white_noise_ar(), click_filter) * click_env * (0.08 + attack * 0.32);
            let beater = sin_osc_ar(freq * (4.0 + attack * 6.0)) * click_env * attack * 0.08;

            let raw = body + low_body + noise_burst + beater;
            let drive_gain = 1.0 + drive * 6.0;
            let saturated = (raw * drive_gain).tanh() / drive_gain.sqrt();
            let driven = raw * (1.0 - drive) + saturated * drive;

            let accent_gain = 1.0 + accent * 0.5;
            let out = clip_ar(leak_dc_ar(driven * accent_gain * 0.9, 0.995), -1.0, 1.0);
            let noise = clip_ar(noise_burst * accent_gain * (1.0 + drive), -1.0, 1.0);

            [out, noise]
        })
});
