// Erica Synths Black VCO2 - analog-style multi-output Eurorack oscillator.
//
// Approximation: simultaneous sine, triangle, saw, pulse, sub, and expander
// mix outputs with octave switching, pulse-width CV, saw wavefold shaping,
// linear/exponential FM, trigger-reset hard sync, and two internal LFO bends.
//
// Public interface:
//   out/mix         : mono expander mix; both carry the same mixed oscillator.
//   sine/tri/saw/pulse/sub: mono raw waveform taps.
//   freq           : base Hz when `voct` is 0, default 110.
//   voct           : MIDI-note-style pitch source; nonzero replaces `freq`.
//   octave         : rounded -2..+2 octave switch.
//   pw             : pulse width 0.05..0.95 after `pw_cv` modulation.
//   saw_shape      : 0 clean saw to 1 folded saw.
//   fm             : 0..1 FM amount; `fm_in` is bipolar CV, clipped +/-5.
//   fm_mode        : 0 linear Hz offset, 1 exponential octave-style FM.
//   reset_mode     : 0 free oscillators, 1 hard-sync to `reset_trig`.
//   reset_trig     : 0/1 sync trigger.
//   lfo1_rate/lfo2_rate: internal pitch LFO rates in Hz.
//   lfo1_depth/lfo2_depth: 0..1 internal pitch LFO depths.
//   pw_cv/pw_cv_amt: bipolar pulse-width CV and 0..1 attenuator.
//   mix_sine..mix_sub: 0..1 expander mix levels, normalized when sum exceeds 1.

fn _erica_black_vco2_fold(x) {
    1.0 - abs(wrap_ar(x + 1.0, 0.0, 4.0) - 2.0)
}

define_synthdef("erica_black_vco2", |builder| {
    builder
        .output("out", 1)
        .output("sine", 1)
        .output("tri", 1)
        .output("saw", 1)
        .output("pulse", 1)
        .output("sub", 1)
        .output("mix", 1)
        .param("freq", 110.0) // units: Hz, range: 0..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("voct", 0.0) // units: normalized, range: 0..1, default: 0.0. Pitch in MIDI-note units; higher values play higher notes.
        .param("octave", 0.0) // units: normalized, range: 0..1, default: 0.0. Octave offset; higher values transpose the pitch upward by octaves.
        .param("pw", 0.5) // units: normalized, range: 0..1, default: 0.5. PW macro; higher moves that model axis toward its brighter or more open setting.
        .param("saw_shape", 0.0) // units: normalized, range: 0..1, default: 0.0. Saw Shape amount; higher values emphasize that named musical or electrical behavior.
        .param("fm", 0.0) // units: normalized, range: 0..1, default: 0.0. FM macro; higher moves that model axis toward its brighter or more open setting.
        .param("fm_mode", 1.0) // units: selector, range: 0..N, default: 1.0. Selects mode, table, or step count.
        .param("fm_in", 0.0) // units: normalized, range: 0..1, default: 0.0. Fm In CV input; bipolar values modulate the matching panel control.
        .param("reset_mode", 0.0) // units: trigger, range: 0..1, default: 0.0. Reset mode selector; rounded values choose how sync resets the oscillator.
        .param("reset_trig", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("lfo1_rate", 4.0) // units: Hz, range: 0..100, default: 4.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("lfo1_depth", 0.0) // units: normalized, range: 0..1, default: 0.0. Modulation depth; higher values make the movement more pronounced.
        .param("lfo2_rate", 0.5) // units: Hz, range: 0..100, default: 0.5. Clock or modulation rate in Hz; higher values make motion faster.
        .param("lfo2_depth", 0.0) // units: normalized, range: 0..1, default: 0.0. Modulation depth; higher values make the movement more pronounced.
        .param("pw_cv_amt", 0.0) // units: linear, range: -1..1, default: 0.0. PW CV AMT attenuator; higher makes the matching CV modulation stronger.
        .param("pw_cv", 0.0) // units: normalized, range: 0..1, default: 0.0. Pw CV input; bipolar values modulate the matching panel control.
        .param("mix_sine", 0.5) // units: normalized, range: 0..1, default: 0.5. Mix Sine amount; higher values emphasize that named musical or electrical behavior.
        .param("mix_tri", 0.5) // units: normalized, range: 0..1, default: 0.5. Mix Tri amount; higher values emphasize that named musical or electrical behavior.
        .param("mix_saw", 0.5) // units: normalized, range: 0..1, default: 0.5. Mix Saw amount; higher values emphasize that named musical or electrical behavior.
        .param("mix_pulse", 0.5) // units: normalized, range: 0..1, default: 0.5. Mix Pulse amount; higher values emphasize that named musical or electrical behavior.
        .param("mix_sub", 0.5) // units: normalized, range: 0..1, default: 0.5. Mix Sub amount; higher values emphasize that named musical or electrical behavior.
        .body_map(|p| {
            let freq_hz = clip(p.freq, 0.001, 20000.0);
            let voct_on = clip(p.voct * 1000.0, 0.0, 1.0);
            let voct_hz = 8.175799 * pow(2.0, clip(p.voct, 0.0, 144.0) / 12.0);
            let base_freq = freq_hz * (1.0 - voct_on) + voct_hz * voct_on;

            let octave = clip(round(p.octave), -2.0, 2.0);
            let switched_freq = base_freq * pow(2.0, octave);

            let fm = clip(p.fm, 0.0, 1.0);
            let fm_in = clip(p.fm_in, -5.0, 5.0);
            let linear_freq = switched_freq + fm * fm_in * 100.0;
            let exp_freq = switched_freq * pow(2.0, fm * fm_in);
            let exp_mode = clip(round(p.fm_mode), 0.0, 1.0);
            let fm_freq = linear_freq * (1.0 - exp_mode) + exp_freq * exp_mode;

            let lfo1 = sin_osc_kr(clip(p.lfo1_rate, 0.0, 100.0), 0.0) * clip(p.lfo1_depth, 0.0, 1.0);
            let lfo2 = sin_osc_kr(clip(p.lfo2_rate, 0.0, 100.0), 1.5707963) * clip(p.lfo2_depth, 0.0, 1.0);
            let lfo_factor = clip(1.0 + lfo1 + lfo2, 0.03125, 32.0);
            let effective_freq = clip(fm_freq * lfo_factor, 0.001, 20000.0);

            let pw = clip(p.pw + p.pw_cv * clip(p.pw_cv_amt, 0.0, 1.0), 0.05, 0.95);
            let reset_mix = clip(round(p.reset_mode), 0.0, 1.0);
            let reset_trig = trig1_ar(k2a_ar(clip(p.reset_trig, 0.0, 1.0)), 0.001) * reset_mix;
            let two_pi = 6.283185307179586;

            let phase = phasor_ar(reset_trig, effective_freq / 44100.0, 0.0, 1.0, 0.0);
            let sub_phase = phasor_ar(reset_trig, effective_freq * 0.5 / 44100.0, 0.0, 1.0, 0.0);

            let free_sine = sin_osc_ar(effective_freq);
            let reset_sine = sin_osc_ar(0.0, phase * two_pi);
            let sine = free_sine * (1.0 - reset_mix) + reset_sine * reset_mix;

            let free_tri = lf_tri_ar(effective_freq, 0.0);
            let reset_tri = 1.0 - abs(phase * 4.0 - 2.0);
            let tri = free_tri * (1.0 - reset_mix) + reset_tri * reset_mix;

            let free_saw = lf_saw_ar(effective_freq, 0.0);
            let reset_saw = phase * 2.0 - 1.0;
            let raw_saw = free_saw * (1.0 - reset_mix) + reset_saw * reset_mix;
            let saw_shape = clip(p.saw_shape, 0.0, 1.0);
            let folded_saw = _erica_black_vco2_fold(raw_saw * (1.0 + saw_shape * 4.0));
            let saw = raw_saw * (1.0 - saw_shape) + folded_saw * saw_shape;

            let free_pulse = lf_pulse_ar(effective_freq, 0.0, pw) * 2.0 - 1.0;
            let reset_pulse = clip((pw - phase) * 100000.0, 0.0, 1.0) * 2.0 - 1.0;
            let pulse = free_pulse * (1.0 - reset_mix) + reset_pulse * reset_mix;

            let free_sub = lf_pulse_ar(effective_freq * 0.5, 0.0, 0.5) * 2.0 - 1.0;
            let reset_sub = clip((0.5 - sub_phase) * 100000.0, 0.0, 1.0) * 2.0 - 1.0;
            let sub = free_sub * (1.0 - reset_mix) + reset_sub * reset_mix;

            let mix_sine = clip(p.mix_sine, 0.0, 1.0);
            let mix_tri = clip(p.mix_tri, 0.0, 1.0);
            let mix_saw = clip(p.mix_saw, 0.0, 1.0);
            let mix_pulse = clip(p.mix_pulse, 0.0, 1.0);
            let mix_sub = clip(p.mix_sub, 0.0, 1.0);
            let mix_norm = (mix_sine + mix_tri + mix_saw + mix_pulse + mix_sub).max(1.0);
            let mix = (sine * mix_sine
                     + tri * mix_tri
                     + saw * mix_saw
                     + pulse * mix_pulse
                     + sub * mix_sub) / mix_norm;

            [
                clip_ar(mix, -1.0, 1.0),
                clip_ar(sine, -1.0, 1.0),
                clip_ar(tri, -1.0, 1.0),
                clip_ar(saw, -1.0, 1.0),
                clip_ar(pulse, -1.0, 1.0),
                clip_ar(sub, -1.0, 1.0),
                clip_ar(mix, -1.0, 1.0)
            ]
        })
});

//
// # Usage: `erica_black_vco2`
//
// ```rhai
// import "stdlib/instruments/eurorack/erica_black_vco2.vibe" as erica_black_vco2;
//
// let erica_black_vco2 = voice("doc_erica_black_vco2")
//     .synth("erica_black_vco2")
//     .set_param("freq", 220.0)
//     .set_param("lfo1_rate", 2.0)
//     .set_param("mix_sine", 0.5)
//     .set_param("reset_mode", 0.35);
// erica_black_vco2.output("out").to_main();
// erica_black_vco2.run();
// ```
