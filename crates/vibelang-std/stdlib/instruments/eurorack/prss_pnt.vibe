// Make Noise PrssPnt — four pressable touch CV pads.
//
// `pressN` params are patchable pressure values in 0..1. Each pad emits a
// slewed pressure CV and a held +5 V gate when pressure crosses `threshold`.
//
// Public interface:
//   pressure1/gate1 .. pressure4/gate4: kr pressure CV and +5 V-style gate per pad.
//   press1..press4  : 0..1 pressure inputs, usually mapped from touch/CV logic.
//   threshold       : 0..1 gate threshold shared by all pads.
//   slew            : seconds for pressure attack/release lag.

define_synthdef("prss_pnt", |builder| {
    builder
        .output_kr("pressure1")
        .output_kr("gate1")
        .output_kr("pressure2")
        .output_kr("gate2")
        .output_kr("pressure3")
        .output_kr("gate3")
        .output_kr("pressure4")
        .output_kr("gate4")
        .param("press1", 0.0) // units: normalized, range: 0..1, default: 0.0. Press 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("press2", 0.0) // units: normalized, range: 0..1, default: 0.0. Press 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("press3", 0.0) // units: normalized, range: 0..1, default: 0.0. Press 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("press4", 0.0) // units: normalized, range: 0..1, default: 0.0. Press 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("threshold", 0.05) // units: normalized, range: 0..1, default: 0.05. Detection threshold; higher values require a stronger signal before processing opens.
        .param("slew", 0.01) // units: normalized, range: 0..1, default: 0.01. Slew smoothing time; higher values soften abrupt CV changes.
        .body_map(|p| {
            let slew = p.slew.max(0.0);
            let threshold = clip(p.threshold, 0.0, 1.0);
            let p1 = clip_kr(lag_ud_kr(clip(p.press1, 0.0, 1.0), slew, slew), 0.0, 1.0);
            let p2 = clip_kr(lag_ud_kr(clip(p.press2, 0.0, 1.0), slew, slew), 0.0, 1.0);
            let p3 = clip_kr(lag_ud_kr(clip(p.press3, 0.0, 1.0), slew, slew), 0.0, 1.0);
            let p4 = clip_kr(lag_ud_kr(clip(p.press4, 0.0, 1.0), slew, slew), 0.0, 1.0);

            let g1 = clip_kr(in_range_kr(p1, threshold, 1.0) * 0.5, -1.0, 1.0);
            let g2 = clip_kr(in_range_kr(p2, threshold, 1.0) * 0.5, -1.0, 1.0);
            let g3 = clip_kr(in_range_kr(p3, threshold, 1.0) * 0.5, -1.0, 1.0);
            let g4 = clip_kr(in_range_kr(p4, threshold, 1.0) * 0.5, -1.0, 1.0);

            [p1, g1, p2, g2, p3, g3, p4, g4]
        })
});

//
// # Usage: `prss_pnt`
//
// ```rhai
// import "stdlib/instruments/eurorack/prss_pnt.vibe" as prss_pnt;
//
// let prss_pnt = voice("doc_prss_pnt")
//     .synth("prss_pnt")
//     .set_param("press1", 0.35)
//     .set_param("press2", 0.35)
//     .set_param("press3", 0.35)
//     .set_param("press4", 0.35);
// prss_pnt.outputs(["pressure1"]).mute();
// prss_pnt.run();
// ```
