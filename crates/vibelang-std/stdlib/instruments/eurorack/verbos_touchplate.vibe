// Verbos Touchplate Keyboard - pressure keyboard and tunable CV row.
//
// Public interface:
//   pitch           : kr V/oct pitch from `key` and `octave`.
//   gate/trigger    : kr held gate and 10 ms trigger from `pressure`.
//   pressure        : kr slewed 0..1 pressure CV.
//   bend            : kr bipolar bend CV, clipped -1..1.
//   tune_cv         : kr selected tune row voltage.
//   tune_gate/tune_pressure: kr gate and pressure outputs for the tune row.
//   key             : rounded 0..31 keyboard key index.
//   octave          : rounded 0..3 octave offset.
//   pressure        : 0..1 main touch pressure.
//   bend            : -1..1 pitch bend CV.
//   tune_key        : rounded 0..7 selector for tune1..tune8.
//   tune_pressure   : 0..1 pressure for the tune row.
//   tune1..tune8    : tune row voltages, clipped -2..2.
//   threshold       : 0..1 gate threshold for both pressure lanes.
//   slew            : 0..1 pitch/pressure lag amount.

define_synthdef("verbos_touchplate", |builder| {
    builder
        .output_kr("pitch")
        .output_kr("gate")
        .output_kr("trigger")
        .output_kr("pressure")
        .output_kr("bend")
        .output_kr("tune_cv")
        .output_kr("tune_gate")
        .output_kr("tune_pressure")
        .param("key", 0.0)                  // rounded 0..31 keyboard key index
        .param("octave", 1.0)               // rounded 0..3 octave offset for pitch output
        .param("pressure", 0.0)             // 0..1 main touch pressure for gate and pressure CV
        .param("bend", 0.0)                 // -1..1 pitch bend CV output
        .param("tune_key", 0.0)             // rounded selector for tune row slots 1..8
        .param("tune_pressure", 0.0)        // 0..1 pressure input for the tune row gate/CV
        .param("tune1", 0.0)                // tune-row voltage for touchplate slot 1
        .param("tune2", 0.1666667)          // tune-row voltage for touchplate slot 2
        .param("tune3", 0.3333333)          // tune-row voltage for touchplate slot 3
        .param("tune4", 0.4166667)          // tune-row voltage for touchplate slot 4
        .param("tune5", 0.5833333)          // tune-row voltage for touchplate slot 5
        .param("tune6", 0.75)               // tune-row voltage for touchplate slot 6
        .param("tune7", 0.9166667)          // tune-row voltage for touchplate slot 7
        .param("tune8", 1.0)                // tune-row voltage for touchplate slot 8
        .param("threshold", 0.05)           // 0..1 gate threshold for both pressure lanes
        .param("slew", 0.1)                 // 0..1 pitch and pressure lag amount
        .body_map(|p| {
            let key = clip_kr(round(p.key), 0.0, 31.0);
            let octave = clip_kr(round(p.octave), 0.0, 3.0);
            let pressure_raw = clip_kr(p.pressure, 0.0, 1.0);
            let bend = clip_kr(p.bend, -1.0, 1.0);
            let tune_key = clip_kr(round(p.tune_key), 0.0, 7.0);
            let tune_pressure_raw = clip_kr(p.tune_pressure, 0.0, 1.0);
            let threshold = clip_kr(p.threshold, 0.0, 1.0);
            let slew = clip_kr(p.slew, 0.0, 1.0);
            let pitch_slew = slew * 0.01;
            let pressure_slew = slew * 0.05;

            let pitch_raw = key / 12.0 + octave;
            let pitch = lag_ud_kr(pitch_raw, pitch_slew, pitch_slew);
            let gate = clip_kr(in_range_kr(pressure_raw, threshold, 1.0), 0.0, 1.0);
            let trigger = clip_kr(trig1_kr(gate, 0.01), 0.0, 1.0);
            let pressure = clip_kr(
                lag_ud_kr(pressure_raw, pressure_slew, pressure_slew),
                0.0,
                1.0
            );

            let m1 = (1.0 - abs(tune_key - 0.0)).max(0.0);
            let m2 = (1.0 - abs(tune_key - 1.0)).max(0.0);
            let m3 = (1.0 - abs(tune_key - 2.0)).max(0.0);
            let m4 = (1.0 - abs(tune_key - 3.0)).max(0.0);
            let m5 = (1.0 - abs(tune_key - 4.0)).max(0.0);
            let m6 = (1.0 - abs(tune_key - 5.0)).max(0.0);
            let m7 = (1.0 - abs(tune_key - 6.0)).max(0.0);
            let m8 = (1.0 - abs(tune_key - 7.0)).max(0.0);
            let tune_cv = m1 * clip_kr(p.tune1, -2.0, 2.0)
                + m2 * clip_kr(p.tune2, -2.0, 2.0)
                + m3 * clip_kr(p.tune3, -2.0, 2.0)
                + m4 * clip_kr(p.tune4, -2.0, 2.0)
                + m5 * clip_kr(p.tune5, -2.0, 2.0)
                + m6 * clip_kr(p.tune6, -2.0, 2.0)
                + m7 * clip_kr(p.tune7, -2.0, 2.0)
                + m8 * clip_kr(p.tune8, -2.0, 2.0);

            let tune_gate = clip_kr(
                in_range_kr(tune_pressure_raw, threshold, 1.0),
                0.0,
                1.0
            );
            let tune_pressure = clip_kr(
                lag_ud_kr(tune_pressure_raw, pressure_slew, pressure_slew),
                0.0,
                1.0
            );

            [pitch, gate, trigger, pressure, bend, tune_cv, tune_gate, tune_pressure]
        })
});
