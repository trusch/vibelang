// Verbos Touchplate Keyboard - pressure keyboard and tunable CV row.
//
// Public interface:
//   pitch           : kr V/oct pitch from `key` and `octave`.
//   gate/trigger    : kr held gate and 10 ms trigger from `pressure`.
//   pressure        : kr slewed 0..1 pressure CV.
//   bend            : kr bipolar bend CV, clipped -1..1.
//   tune_cv         : kr selected tune row voltage.
//   tune_gate/tune_pressure: kr gate and pressure outputs for the tune row.
//   key             : rounded 0..31 keyboard key index.
//   octave          : rounded 0..3 octave offset.
//   pressure        : 0..1 main touch pressure.
//   bend            : -1..1 pitch bend CV.
//   tune_key        : rounded 0..7 selector for tune1..tune8.
//   tune_pressure   : 0..1 pressure for the tune row.
//   tune1..tune8    : tune row voltages, clipped -2..2.
//   threshold       : 0..1 gate threshold for both pressure lanes.
//   slew            : 0..1 pitch/pressure lag amount.

define_synthdef("verbos_touchplate", |builder| {
    builder
        .output_kr("pitch")
        .output_kr("gate")
        .output_kr("trigger")
        .output_kr("pressure")
        .output_kr("bend")
        .output_kr("tune_cv")
        .output_kr("tune_gate")
        .output_kr("tune_pressure")
        .param("key", 0.0) // units: normalized, range: 0..1, default: 0.0. Key amount; higher values emphasize that named musical or electrical behavior.
        .param("octave", 1.0) // units: normalized, range: 0..1, default: 1.0. Octave offset; higher values transpose the pitch upward by octaves.
        .param("pressure", 0.0) // units: normalized, range: 0..1, default: 0.0. Pressure amount; higher values emphasize that named musical or electrical behavior.
        .param("bend", 0.0) // units: normalized, range: 0..1, default: 0.0. Pitch bend offset in Hz; positive values sweep the drum voice upward.
        .param("tune_key", 0.0) // units: normalized, range: 0..1, default: 0.0. Tune Key amount; higher values emphasize that named musical or electrical behavior.
        .param("tune_pressure", 0.0) // units: normalized, range: 0..1, default: 0.0. Tune Pressure amount; higher values emphasize that named musical or electrical behavior.
        .param("tune1", 0.0) // units: normalized, range: 0..1, default: 0.0. Tune slot 1; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune2", 0.1666667) // units: normalized, range: 0..1, default: 0.1666667. Tune slot 2; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune3", 0.3333333) // units: normalized, range: 0..1, default: 0.3333333. Tune slot 3; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune4", 0.4166667) // units: normalized, range: 0..1, default: 0.4166667. Tune slot 4; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune5", 0.5833333) // units: normalized, range: 0..1, default: 0.5833333. Tune slot 5; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune6", 0.75) // units: normalized, range: 0..1, default: 0.75. Tune slot 6; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune7", 0.9166667) // units: normalized, range: 0..1, default: 0.9166667. Tune slot 7; higher values adjust that numbered harmonic or stage as labeled.
        .param("tune8", 1.0) // units: normalized, range: 0..1, default: 1.0. Tune slot 8; higher values adjust that numbered harmonic or stage as labeled.
        .param("threshold", 0.05) // units: normalized, range: 0..1, default: 0.05. Detection threshold; higher values require a stronger signal before processing opens.
        .param("slew", 0.1) // units: normalized, range: 0..1, default: 0.1. Slew smoothing time; higher values soften abrupt CV changes.
        .body_map(|p| {
            let key = clip_kr(round(p.key), 0.0, 31.0);
            let octave = clip_kr(round(p.octave), 0.0, 3.0);
            let pressure_raw = clip_kr(p.pressure, 0.0, 1.0);
            let bend = clip_kr(p.bend, -1.0, 1.0);
            let tune_key = clip_kr(round(p.tune_key), 0.0, 7.0);
            let tune_pressure_raw = clip_kr(p.tune_pressure, 0.0, 1.0);
            let threshold = clip_kr(p.threshold, 0.0, 1.0);
            let slew = clip_kr(p.slew, 0.0, 1.0);
            let pitch_slew = slew * 0.01;
            let pressure_slew = slew * 0.05;

            let pitch_raw = key / 12.0 + octave;
            let pitch = lag_ud_kr(pitch_raw, pitch_slew, pitch_slew);
            let gate = clip_kr(in_range_kr(pressure_raw, threshold, 1.0), 0.0, 1.0);
            let trigger = clip_kr(trig1_kr(gate, 0.01), 0.0, 1.0);
            let pressure = clip_kr(
                lag_ud_kr(pressure_raw, pressure_slew, pressure_slew),
                0.0,
                1.0
            );

            let m1 = (1.0 - abs(tune_key - 0.0)).max(0.0);
            let m2 = (1.0 - abs(tune_key - 1.0)).max(0.0);
            let m3 = (1.0 - abs(tune_key - 2.0)).max(0.0);
            let m4 = (1.0 - abs(tune_key - 3.0)).max(0.0);
            let m5 = (1.0 - abs(tune_key - 4.0)).max(0.0);
            let m6 = (1.0 - abs(tune_key - 5.0)).max(0.0);
            let m7 = (1.0 - abs(tune_key - 6.0)).max(0.0);
            let m8 = (1.0 - abs(tune_key - 7.0)).max(0.0);
            let tune_cv = m1 * clip_kr(p.tune1, -2.0, 2.0)
                + m2 * clip_kr(p.tune2, -2.0, 2.0)
                + m3 * clip_kr(p.tune3, -2.0, 2.0)
                + m4 * clip_kr(p.tune4, -2.0, 2.0)
                + m5 * clip_kr(p.tune5, -2.0, 2.0)
                + m6 * clip_kr(p.tune6, -2.0, 2.0)
                + m7 * clip_kr(p.tune7, -2.0, 2.0)
                + m8 * clip_kr(p.tune8, -2.0, 2.0);

            let tune_gate = clip_kr(
                in_range_kr(tune_pressure_raw, threshold, 1.0),
                0.0,
                1.0
            );
            let tune_pressure = clip_kr(
                lag_ud_kr(tune_pressure_raw, pressure_slew, pressure_slew),
                0.0,
                1.0
            );

            [pitch, gate, trigger, pressure, bend, tune_cv, tune_gate, tune_pressure]
        })
});

//
// # Usage: `verbos_touchplate`
//
// ```rhai
// import "stdlib/instruments/eurorack/verbos_touchplate.vibe" as verbos_touchplate;
//
// let verbos_touchplate = voice("doc_verbos_touchplate")
//     .synth("verbos_touchplate")
//     .set_param("pressure", 0.35)
//     .set_param("key", 0.5)
//     .set_param("octave", 0.5)
//     .set_param("bend", 0.5);
// verbos_touchplate.outputs(["pitch"]).mute();
// verbos_touchplate.run();
// ```
