// Make Noise Tempi — six phase-locked kr clock outputs.
//
// `scene` selects a six-channel multiplier table. Scene 0 preserves the old
// default ratios and lets `multN` trim each channel around that table. `shiftN`
// offsets a channel by eighth-period steps. `width` is the fixed gate pulse
// duration in seconds. Outputs are +5 V-style gates scaled to the library's
// ±1 CV range.
//
// Public interface:
//   ch1..ch6       : kr phase-locked clock outputs.
//   bpm            : master tempo in beats per minute.
//   run            : 0 stops clocks, 1 runs.
//   reset          : 0/1 reset trigger.
//   reset_on_scene : 0 keep phase on scene changes, 1 reset on scene changes.
//   mod            : nonnegative tempo multiplier.
//   scene          : rounded 0..3 multiplier-table selector.
//   variation      : -1..1 phase variation shared across channels.
//   width          : pulse width in seconds, clipped to 1 ms..1 s.
//   mult1..mult6   : scene-0 ratio trims for each channel.
//   shift1..shift6 : phase offsets in eighth-period steps, clipped 0..7.
//   mute1..mute6   : 0 active, 1 muted per channel.

define_synthdef("tempi", |builder| {
    builder
        .output_kr("ch1")
        .output_kr("ch2")
        .output_kr("ch3")
        .output_kr("ch4")
        .output_kr("ch5")
        .output_kr("ch6")
        .param("bpm", 120.0) // units: BPM, range: 20..300, default: 120.0. Clock tempo in beats per minute; higher values make the pulse faster.
        .param("run", 1.0) // units: trigger, range: 0..1, default: 1.0. Run switch; 1 lets the clocked process advance.
        .param("reset", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("reset_on_scene", 1.0) // units: trigger, range: 0..1, default: 1.0. Reset On Scene amount; higher values emphasize that named musical or electrical behavior.
        .param("mod", 1.0) // units: linear, range: -1..1, default: 1.0. Mod amount; higher values emphasize that named musical or electrical behavior.
        .param("scene", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or step count.
        .param("variation", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or step count.
        .param("width", 0.02) // units: ratio, range: 0..1, default: 0.02. Spread width; higher values distribute energy across a wider range.
        .param("mult1", 1.0) // units: normalized, range: 0..1, default: 1.0. Clock multiplier for mult1; higher values create faster related trigger outputs.
        .param("mult2", 2.0) // units: multiplier, range: 0..16, default: 2.0. Clock multiplier for mult2; higher values create faster related trigger outputs.
        .param("mult3", 0.5) // units: normalized, range: 0..1, default: 0.5. Clock multiplier for mult3; higher values create faster related trigger outputs.
        .param("mult4", 4.0) // units: multiplier, range: 0..16, default: 4.0. Clock multiplier for mult4; higher values create faster related trigger outputs.
        .param("mult5", 0.25) // units: normalized, range: 0..1, default: 0.25. Clock multiplier for mult5; higher values create faster related trigger outputs.
        .param("mult6", 3.0) // units: multiplier, range: 0..16, default: 3.0. Clock multiplier for mult6; higher values create faster related trigger outputs.
        .param("shift1", 0.0) // units: cycles, range: 0..1, default: 0.0. Shift 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("shift2", 0.0) // units: cycles, range: 0..1, default: 0.0. Shift 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("shift3", 0.0) // units: cycles, range: 0..1, default: 0.0. Shift 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("shift4", 0.0) // units: cycles, range: 0..1, default: 0.0. Shift 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("shift5", 0.0) // units: cycles, range: 0..1, default: 0.0. Shift 5 amount; higher values emphasize that named musical or electrical behavior.
        .param("shift6", 0.0) // units: cycles, range: 0..1, default: 0.0. Shift 6 amount; higher values emphasize that named musical or electrical behavior.
        .param("mute1", 0.0) // units: trigger, range: 0..1, default: 0.0. Mute 1 amount; higher values emphasize that named musical or electrical behavior.
        .param("mute2", 0.0) // units: trigger, range: 0..1, default: 0.0. Mute 2 amount; higher values emphasize that named musical or electrical behavior.
        .param("mute3", 0.0) // units: trigger, range: 0..1, default: 0.0. Mute 3 amount; higher values emphasize that named musical or electrical behavior.
        .param("mute4", 0.0) // units: trigger, range: 0..1, default: 0.0. Mute 4 amount; higher values emphasize that named musical or electrical behavior.
        .param("mute5", 0.0) // units: trigger, range: 0..1, default: 0.0. Mute 5 amount; higher values emphasize that named musical or electrical behavior.
        .param("mute6", 0.0) // units: trigger, range: 0..1, default: 0.0. Mute 6 amount; higher values emphasize that named musical or electrical behavior.
        .body_map(|p| {
            let run = clip_kr(p.run, 0.0, 1.0);
            let base = (p.bpm.max(1.0) / 60.0) * p.mod.max(0.0) * run;
            let width = clip_kr(p.width, 0.001, 1.0);

            let scene = floor(clip_kr(p.scene + 0.5, 0.0, 3.0));
            let s0 = (1.0 - abs(scene - 0.0)).max(0.0);
            let s1 = (1.0 - abs(scene - 1.0)).max(0.0);
            let s2 = (1.0 - abs(scene - 2.0)).max(0.0);
            let s3 = (1.0 - abs(scene - 3.0)).max(0.0);

            let reset = p.reset + changed_kr(scene, 0.0) * clip_kr(p.reset_on_scene, 0.0, 1.0);
            let phase = sweep_kr(reset, base);

            let scene0_trim1 = p.mult1.max(0.0) / 1.0;
            let scene0_trim2 = p.mult2.max(0.0) / 2.0;
            let scene0_trim3 = p.mult3.max(0.0) / 0.5;
            let scene0_trim4 = p.mult4.max(0.0) / 4.0;
            let scene0_trim5 = p.mult5.max(0.0) / 0.25;
            let scene0_trim6 = p.mult6.max(0.0) / 3.0;

            let m1 = (s0 * 1.0 + s1 * 1.0 + s2 * 0.25 + s3 * 1.0) * scene0_trim1;
            let m2 = (s0 * 2.0 + s1 * 3.0 + s2 * 0.5 + s3 * 1.25) * scene0_trim2;
            let m3 = (s0 * 0.5 + s1 * 5.0 + s2 * 1.0 + s3 * 1.5) * scene0_trim3;
            let m4 = (s0 * 4.0 + s1 * 7.0 + s2 * 2.0 + s3 * 2.0) * scene0_trim4;
            let m5 = (s0 * 0.25 + s1 * 0.5 + s2 * 4.0 + s3 * 2.5) * scene0_trim5;
            let m6 = (s0 * 3.0 + s1 * 1.5 + s2 * 8.0 + s3 * 3.0) * scene0_trim6;

            let variation = clip_kr(p.variation, -1.0, 1.0) / 8.0;

            let sh1 = clip_kr(p.shift1, 0.0, 7.0) / 8.0;
            let sh2 = clip_kr(p.shift2, 0.0, 7.0) / 8.0 + variation;
            let sh3 = clip_kr(p.shift3, 0.0, 7.0) / 8.0 + variation * 2.0;
            let sh4 = clip_kr(p.shift4, 0.0, 7.0) / 8.0 + variation * 3.0;
            let sh5 = clip_kr(p.shift5, 0.0, 7.0) / 8.0 + variation * 4.0;
            let sh6 = clip_kr(p.shift6, 0.0, 7.0) / 8.0 + variation * 5.0;

            let p1 = wrap_kr(phase * m1 + sh1, 0.0, 1.0);
            let p2 = wrap_kr(phase * m2 + sh2, 0.0, 1.0);
            let p3 = wrap_kr(phase * m3 + sh3, 0.0, 1.0);
            let p4 = wrap_kr(phase * m4 + sh4, 0.0, 1.0);
            let p5 = wrap_kr(phase * m5 + sh5, 0.0, 1.0);
            let p6 = wrap_kr(phase * m6 + sh6, 0.0, 1.0);

            let e1 = in_range_kr(delay1_kr(p1) - p1, 0.001, 2.0);
            let e2 = in_range_kr(delay1_kr(p2) - p2, 0.001, 2.0);
            let e3 = in_range_kr(delay1_kr(p3) - p3, 0.001, 2.0);
            let e4 = in_range_kr(delay1_kr(p4) - p4, 0.001, 2.0);
            let e5 = in_range_kr(delay1_kr(p5) - p5, 0.001, 2.0);
            let e6 = in_range_kr(delay1_kr(p6) - p6, 0.001, 2.0);

            let a1 = clip_kr(m1 * 1000.0, 0.0, 1.0);
            let a2 = clip_kr(m2 * 1000.0, 0.0, 1.0);
            let a3 = clip_kr(m3 * 1000.0, 0.0, 1.0);
            let a4 = clip_kr(m4 * 1000.0, 0.0, 1.0);
            let a5 = clip_kr(m5 * 1000.0, 0.0, 1.0);
            let a6 = clip_kr(m6 * 1000.0, 0.0, 1.0);

            let g1 = trig1_kr(e1, width) * 0.5 * a1 * (1.0 - clip_kr(p.mute1, 0.0, 1.0));
            let g2 = trig1_kr(e2, width) * 0.5 * a2 * (1.0 - clip_kr(p.mute2, 0.0, 1.0));
            let g3 = trig1_kr(e3, width) * 0.5 * a3 * (1.0 - clip_kr(p.mute3, 0.0, 1.0));
            let g4 = trig1_kr(e4, width) * 0.5 * a4 * (1.0 - clip_kr(p.mute4, 0.0, 1.0));
            let g5 = trig1_kr(e5, width) * 0.5 * a5 * (1.0 - clip_kr(p.mute5, 0.0, 1.0));
            let g6 = trig1_kr(e6, width) * 0.5 * a6 * (1.0 - clip_kr(p.mute6, 0.0, 1.0));

            [g1, g2, g3, g4, g5, g6]
        })
});

//
// # Usage: `tempi`
//
// ```rhai
// import "stdlib/instruments/eurorack/tempi.vibe" as tempi;
//
// let tempi = voice("doc_tempi")
//     .synth("tempi")
//     .set_param("bpm", 96.0)
//     .set_param("reset", 0.35)
//     .set_param("run", 1.0)
//     .set_param("reset_on_scene", 0.35);
// tempi.outputs(["ch1"]).mute();
// tempi.run();
// ```
