// Erica Synths Black Wavetable VCO - procedural wavetable oscillator.
//
// Approximation: the hardware stores 16 banks of 16 waves. This model builds
// those cells from additive harmonic recipes, with bank/wave CV surf, wave
// morph, bit-depth reduction, VCA level, and separate sub oscillator outputs.

fn _erica_wt_sub_shape(freq, shape) {
    let shape = clip(shape, 0.0, 1.0);
    let square = lf_pulse_ar(freq, 0.0, 0.5) * 2.0 - 1.0;
    let tri = lf_tri_ar(freq, 0.0);
    let sine = sin_osc_ar(freq);

    let square_w = clip(1.0 - shape * 2.0, 0.0, 1.0);
    let tri_w = 1.0 - clip(abs(shape - 0.5) * 2.0, 0.0, 1.0);
    let sine_w = clip(shape * 2.0 - 1.0, 0.0, 1.0);

    square * square_w + tri * tri_w + sine * sine_w
}

fn _erica_wt_bank_cell(freq, bank, wave) {
    let w = clip(wave, 0.0, 1.0);
    let inv_w = 1.0 - w;
    let bright = 0.15 + w * 0.85;

    let h1 = sin_osc_ar(freq);
    let h2 = sin_osc_ar(freq * 2.0);
    let h3 = sin_osc_ar(freq * 3.0);
    let h4 = sin_osc_ar(freq * 4.0);
    let h5 = sin_osc_ar(freq * 5.0);
    let h6 = sin_osc_ar(freq * 6.0);
    let h7 = sin_osc_ar(freq * 7.0);
    let h8 = sin_osc_ar(freq * 8.0);
    let h9 = sin_osc_ar(freq * 9.0);
    let h10 = sin_osc_ar(freq * 10.0);
    let h11 = sin_osc_ar(freq * 11.0);
    let h12 = sin_osc_ar(freq * 12.0);

    let sine_bank = h1 * (0.92 - w * 0.10)
                  + h2 * (0.05 + w * 0.18)
                  + h3 * w * 0.10
                  + h4 * w * 0.06;

    let saw_bank = h1 * 0.82
                 + h2 * 0.41 * bright
                 + h3 * 0.27 * bright
                 + h4 * 0.20 * bright
                 + h5 * 0.16 * bright
                 + h6 * 0.13 * w
                 + h7 * 0.11 * w
                 + h8 * 0.10 * w;

    let pwm = lf_pulse_ar(freq, 0.0, clip(0.5 + (w - 0.5) * 0.82, 0.06, 0.94)) * 2.0 - 1.0;
    let square_bank = pwm * (0.68 + w * 0.12)
                    + (h1 + h3 * 0.33 + h5 * 0.20 * bright + h7 * 0.14 * w + h9 * 0.11 * w) * 0.28;

    let tri_bank = lf_tri_ar(freq, 0.0) * (0.82 - w * 0.18)
                 + h3 * (0.08 + w * 0.12)
                 + h5 * w * 0.07
                 + h7 * w * 0.04;

    let bank4 = h1 * 0.72 + h2 * 0.16 * inv_w + h3 * 0.34 * bright + h5 * 0.24 * w + h7 * 0.16 * w;
    let bank5 = h1 * 0.50 + h2 * 0.36 + h4 * 0.30 * bright + h6 * 0.22 * w + h8 * 0.18 * w + h10 * 0.12 * w;
    let bank6 = h1 * (0.36 + inv_w * 0.28) + h2 * 0.46 + h3 * 0.18 + h4 * 0.30 * bright + h8 * 0.18 * w;
    let bank7 = h1 * 0.42 + h3 * 0.24 + h6 * (0.18 + w * 0.20) + h9 * 0.18 * bright + h12 * 0.15 * w;
    let bank8 = h1 * 0.54 + h2 * 0.14 * inv_w + h4 * 0.36 * bright + h7 * 0.20 + h11 * 0.18 * w;
    let bank9 = h1 * 0.46 + h2 * 0.30 * bright + h5 * 0.34 + h8 * 0.16 * w + h10 * 0.20 * bright;
    let bank10 = (lf_saw_ar(freq * (0.996 + w * 0.006), 0.0) + lf_saw_ar(freq * (1.004 - w * 0.003), 0.0)) * 0.32
                + h1 * 0.32 + h2 * 0.20 * bright + h3 * 0.16 * bright;
    let bank11 = h1 * 0.35 + h2 * 0.12 + h3 * 0.28 * inv_w + h5 * 0.34 + h9 * 0.22 * bright + h12 * 0.16 * w;
    let bank12 = h1 * 0.32 + h2 * 0.44 * inv_w + h4 * 0.34 + h8 * 0.24 * bright + h12 * 0.18 * w;
    let bank13 = tanh_ar((h1 * 0.50 + h2 * 0.42 + h3 * 0.32 + h6 * 0.28 * bright + h12 * 0.22 * w) * (1.4 + w * 2.2));
    let bank14 = h1 * 0.28 + h3 * 0.26 + h4 * 0.18 + h7 * 0.34 * bright + h10 * 0.26 * bright + h12 * 0.24 * w;
    let bank15 = tanh_ar((saw_bank + square_bank * 0.55 + h9 * 0.25 * w + h12 * 0.25 * w) * (1.0 + w * 3.5));

    let m0 = (1.0 - abs(bank - 0.0)).max(0.0);
    let m1 = (1.0 - abs(bank - 1.0)).max(0.0);
    let m2 = (1.0 - abs(bank - 2.0)).max(0.0);
    let m3 = (1.0 - abs(bank - 3.0)).max(0.0);
    let m4 = (1.0 - abs(bank - 4.0)).max(0.0);
    let m5 = (1.0 - abs(bank - 5.0)).max(0.0);
    let m6 = (1.0 - abs(bank - 6.0)).max(0.0);
    let m7 = (1.0 - abs(bank - 7.0)).max(0.0);
    let m8 = (1.0 - abs(bank - 8.0)).max(0.0);
    let m9 = (1.0 - abs(bank - 9.0)).max(0.0);
    let m10 = (1.0 - abs(bank - 10.0)).max(0.0);
    let m11 = (1.0 - abs(bank - 11.0)).max(0.0);
    let m12 = (1.0 - abs(bank - 12.0)).max(0.0);
    let m13 = (1.0 - abs(bank - 13.0)).max(0.0);
    let m14 = (1.0 - abs(bank - 14.0)).max(0.0);
    let m15 = (1.0 - abs(bank - 15.0)).max(0.0);

    m0 * sine_bank + m1 * saw_bank + m2 * square_bank + m3 * tri_bank
        + m4 * bank4 + m5 * bank5 + m6 * bank6 + m7 * bank7
        + m8 * bank8 + m9 * bank9 + m10 * bank10 + m11 * bank11
        + m12 * bank12 + m13 * bank13 + m14 * bank14 + m15 * bank15
}

define_synthdef("erica_wavetable_vco", |builder| {
    builder
        .output("main", 1)
        .output("sub1", 1)
        .output("sub2", 1)
        .param("freq", 110.0)
        .param("voct", 0.0)
        .param("bank", 0.0)
        .param("wave", 0.0)
        .param("morph", 0.0)
        .param("bitcrush", 0.0)
        .param("vca", 1.0)
        .param("sub_shape", 0.0)
        .param("sub1_level", 0.3)
        .param("sub2_level", 0.2)
        .param("bank_cv_amt", 0.0)
        .param("bank_cv", 0.0)
        .param("wave_cv_amt", 0.0)
        .param("wave_cv", 0.0)
        .param("bitcrush_cv_amt", 0.0)
        .param("bitcrush_cv", 0.0)
        .body_map(|p| {
            let freq_hz = clip(p.freq, 0.001, 20000.0);
            let voct_on = clip(p.voct * 1000.0, 0.0, 1.0);
            let voct_hz = 8.175799 * pow(2.0, clip(p.voct, 0.0, 144.0) / 12.0);
            let base_freq = freq_hz * (1.0 - voct_on) + voct_hz * voct_on;
            let effective_freq = clip(base_freq, 0.001, 20000.0);

            let bank_pos = clip(p.bank + clip(p.bank_cv, -1.0, 1.0) * clip(p.bank_cv_amt, 0.0, 1.0) * 15.0, 0.0, 15.0);
            let bank_i = floor(bank_pos);
            let bank_next = clip(bank_i + 1.0, 0.0, 15.0);
            let bank_frac = bank_pos - bank_i;

            let wave_pos = clip(p.wave + clip(p.wave_cv, -1.0, 1.0) * clip(p.wave_cv_amt, 0.0, 1.0) * 15.0, 0.0, 15.0);
            let wave_i = floor(wave_pos);
            let wave_next = clip(wave_i + 1.0, 0.0, 15.0);
            let morph = clip(p.morph + wave_pos - wave_i, 0.0, 1.0);

            let wave_a = wave_i / 15.0;
            let wave_b = wave_next / 15.0;

            let bank_a0 = _erica_wt_bank_cell(effective_freq, bank_i, wave_a);
            let bank_a1 = _erica_wt_bank_cell(effective_freq, bank_i, wave_b);
            let bank_b0 = _erica_wt_bank_cell(effective_freq, bank_next, wave_a);
            let bank_b1 = _erica_wt_bank_cell(effective_freq, bank_next, wave_b);

            let cell_a = bank_a0 * (1.0 - morph) + bank_a1 * morph;
            let cell_b = bank_b0 * (1.0 - morph) + bank_b1 * morph;
            let raw = (cell_a * (1.0 - bank_frac) + cell_b * bank_frac) * 0.82;

            let bitcrush = clip(p.bitcrush + clip(p.bitcrush_cv, -1.0, 1.0) * clip(p.bitcrush_cv_amt, 0.0, 1.0), 0.0, 1.0);
            let crush_levels = pow(2.0, 16.0 - bitcrush * 12.0);
            let crushed = round(raw * crush_levels) / crush_levels;

            let vca = clip(p.vca, 0.0, 1.0);
            let main = clip_ar(leak_dc_ar(crushed * vca, 0.995), -1.0, 1.0);

            let sub_shape = clip(p.sub_shape, 0.0, 1.0);
            let sub1 = clip_ar(_erica_wt_sub_shape(effective_freq * 0.5, sub_shape) * clip(p.sub1_level, 0.0, 1.0) * vca, -1.0, 1.0);
            let sub2 = clip_ar(_erica_wt_sub_shape(effective_freq * 0.25, sub_shape) * clip(p.sub2_level, 0.0, 1.0) * vca, -1.0, 1.0);

            [main, sub1, sub2]
        })
});
