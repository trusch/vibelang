// Spectraphon — SAM/SAO analyzer plus additive bank.
//
// One public synthdef covers all three operating modes of one hardware-style
// side, switched at instantiation time via the `mode` param:
//
//   mode = 0.0   SAM live      analyze `analyze` and read live magnitudes
//   mode = 1.0   SAM capture   analyze `analyze`, read live magnitudes, and
//                              write them into
//                              `array_buf` at the (slide, focus, array_idx)
//                              cell, so a later SAO pass can play them back
//   mode = 2.0   SAO playback  read `array_buf` with bilinear interpolation
//                              across (slide, focus)
//
// For SAM and SAM-capture patches, route audio into `.input("analyze")`.
// Script-allocated `fft_buf` and `mag_buf` buffers are optional but useful:
// `fft_buf` avoids using local FFT memory, and `mag_buf` lets live magnitudes
// survive hot reload. SAO mode can leave `analyze` unpatched and only needs
// `array_buf`.
//
// Outputs: sine (clean fundamental), sub (saw at 0.5×freq, only in SAO),
// odd / even (partial banks split as on hardware).

fn _spectraphon_write_mag(k, chain, f0_analyze, focus, mag_buf, active) {
    let bin_per_hz = 2048.0 / 44100.0;
    let mag_scale = 0.001953125;
    let bin_max = 1023.0;
    let lag_t = 0.02;
    let bin_width = 0.5 + focus * 3.5;
    let centre_bin = clip(k * f0_analyze * bin_per_hz, 1.0, bin_max);
    let mag_centre = channels(bin_data_kr(chain, centre_bin, bin_width), 2)[0];
    let mag = lag_kr(mag_centre * mag_scale, lag_t) * active;
    buf_wr_kr(mag, mag_buf, k - 1.0, 0);
}

fn _spectraphon_mag_norm(mag_buf) {
    let k = 1.0;
    let mag_sum = buf_rd_kr(1, mag_buf, k - 1.0, 0, 1);
    for i in 2..65 {
        let k = i.to_float();
        mag_sum = mag_sum + buf_rd_kr(1, mag_buf, k - 1.0, 0, 1);
    }
    return 3.5 / max(mag_sum, 1.0);
}

define_synthdef("spectraphon", |builder| {
    builder
        .input("analyze", 1)
        .output("sine")
        .output("sub")
        .output("odd")
        .output("even")
        .param("freq", 220.0)
        .param("v_oct", 0.0)
        .param("partials", 1.0)
        .param("slide", 0.5)
        .param("focus", 0.5)
        .param("amp", 0.3)
        .param("gate", 1.0)
        .param("mode", 0.0)
        .param("array_idx", 0.0)
        .param("f0_analyze", 200.0)
        .param("fft_buf", 0.0)
        .param("mag_buf", 0.0)
        .param("array_buf", 0.0)
        .param("active", 1.0)
        .body_map(|p| {
            let analyze_in = p.inputs["analyze"];
            // `freq` is the base/tuning frequency in Hz. `v_oct` is a
            // 1V/oct exponential transposition input (default 0 = no shift)
            // so any rack CV in volts-per-octave (e.g. rene's `cv`) can
            // drive pitch directly without magic-number linear scaling.
            let freq = p.freq * pow(2.0, p.v_oct);
            let partials = p.partials;
            let slide = p.slide;
            let focus = p.focus;
            let amp = p.amp;
            let gate = p.gate;
            let mode = clip(p.mode, 0.0, 2.0);
            let array_idx = p.array_idx;
            let f0_analyze = p.f0_analyze;
            let fft_buf = p.fft_buf;
            let mag_buf = p.mag_buf;
            let array_buf = p.array_buf;
            let active = clip(p.active, 0.0, 1.0) * clip(gate, 0.0, 1.0);

            let env = envelope()
                .asr(0.01, 1.0, 0.3)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Discrete mode masks. mode is expected to be set at create time,
            // not modulated — the masks snap rather than crossfade so a SAM
            // patch never accidentally bleeds into SAO playback.
            let is_sao = clip((mode - 1.5) * 1000.0, 0.0, 1.0);
            let is_sam = 1.0 - is_sao;
            let mode_off_capture = (mode - 1.0) * (mode - 1.0);
            let is_capture = clip(1.0 - mode_off_capture * 1000.0, 0.0, 1.0);
            let analyze_active = active * is_sam;

            let has_fft = clip((fft_buf - 1.0) * 1000.0, 0.0, 1.0);
            let fallback_fft_buf = local_buf_ir(1.0, 2048.0);
            let fft_mem = fft_buf * has_fft
                        + fallback_fft_buf * (1.0 - has_fft);
            let has_mag = clip((mag_buf - 1.0) * 1000.0, 0.0, 1.0);
            let fallback_mag_buf = local_buf_ir(1.0, 64.0);
            let mag_mem = mag_buf * has_mag
                        + fallback_mag_buf * (1.0 - has_mag);

            // Gate the FFT chain on SAM modes so SAO playback (mode=2)
            // doesn't run BinData on whatever's at an unpatched `analyze`
            // input — that was crashing scsynth in JoshPVUGens.
            let chain = fft_kr(fft_mem, analyze_in * is_sam, 0.5, 1.0, is_sam, 0.0);
            let analyze_focus = clip(focus, 0.0, 1.0);
            let analyze_k = 1.0;
            _spectraphon_write_mag(analyze_k, chain, f0_analyze, analyze_focus, mag_mem, analyze_active);
            for i in 2..65 {
                let k = i.to_float();
                _spectraphon_write_mag(k, chain, f0_analyze, analyze_focus, mag_mem, analyze_active);
            }

            let n = 64.0;
            let scale = partials * n;
            let mag_norm = _spectraphon_mag_norm(mag_mem);

            let has_array = clip((array_buf - 1.0) * 1000.0, 0.0, 1.0);
            let fallback_array_buf = local_buf_ir(1.0, 1.0);
            let array_mem = array_buf * has_array
                          + fallback_array_buf * (1.0 - has_array);

            let slide_pos = clip(slide, 0.0, 0.99999) * 8.0;
            let focus_pos = clip(focus, 0.0, 0.99999) * 8.0;
            let slide_lo = slide_pos - wrap_kr(slide_pos, 0.0, 1.0);
            let focus_lo = focus_pos - wrap_kr(focus_pos, 0.0, 1.0);
            let slide_hi = clip(slide_lo + 1.0, 0.0, 7.0);
            let focus_hi = clip(focus_lo + 1.0, 0.0, 7.0);
            let s_frac = slide_pos - slide_lo;
            let f_frac = focus_pos - focus_lo;
            let w00 = (1.0 - s_frac) * (1.0 - f_frac);
            let w01 = (1.0 - s_frac) * f_frac;
            let w10 = s_frac * (1.0 - f_frac);
            let w11 = s_frac * f_frac;

            let arr_base = clip(array_idx, 0.0, 15.0) * 4096.0;
            let base00 = arr_base + slide_lo * 512.0 + focus_lo * 64.0;
            let base01 = arr_base + slide_lo * 512.0 + focus_hi * 64.0;
            let base10 = arr_base + slide_hi * 512.0 + focus_lo * 64.0;
            let base11 = arr_base + slide_hi * 512.0 + focus_hi * 64.0;

            // SAM-capture writes magnitudes back into array_mem; suppress
            // the write entirely with a huge offset whenever capture mask
            // is 0 (i.e. modes other than sam_capture, or no array buffer).
            let cap_base = arr_base + slide_lo * 512.0 + focus_lo * 64.0;
            let cap_offset = (1.0 - is_capture * has_array) * 1.0e9;

            // Partial bank assembly. Each partial pays:
            //   1× buf_rd_kr (live SAM mag)
            //   4× buf_rd_kr (SAO bilinear)
            //   1× buf_wr_kr (SAM-capture write, masked off when unused)
            //   1× sin_osc_ar
            // ×64 partials. With the FFT-chain-buffer pre-allocation from
            // commit 161c052, scsynth no longer wedges on /s_new for this
            // graph.
            let k = 1.0;
            let mag_live = buf_rd_kr(1, mag_mem, k - 1.0, 0, 1) * mag_norm;
            let mag_sao_buf = w00 * buf_rd_kr(1, array_mem, base00 + (k - 1.0), 0, 1)
                            + w01 * buf_rd_kr(1, array_mem, base01 + (k - 1.0), 0, 1)
                            + w10 * buf_rd_kr(1, array_mem, base10 + (k - 1.0), 0, 1)
                            + w11 * buf_rd_kr(1, array_mem, base11 + (k - 1.0), 0, 1);
            let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
            let mag_k = mag_live * is_sam + mag_sao * is_sao;
            buf_wr_kr(mag_live, array_mem, cap_base + (k - 1.0) + cap_offset, 0);
            let odd_bank = sin_osc_ar(freq * k) * mag_k
                * clip(scale - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * i + 1).to_float();
                let mag_live = buf_rd_kr(1, mag_mem, k - 1.0, 0, 1) * mag_norm;
                let mag_sao_buf = w00 * buf_rd_kr(1, array_mem, base00 + (k - 1.0), 0, 1)
                                + w01 * buf_rd_kr(1, array_mem, base01 + (k - 1.0), 0, 1)
                                + w10 * buf_rd_kr(1, array_mem, base10 + (k - 1.0), 0, 1)
                                + w11 * buf_rd_kr(1, array_mem, base11 + (k - 1.0), 0, 1);
                let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
                let mag_k = mag_live * is_sam + mag_sao * is_sao;
                buf_wr_kr(mag_live, array_mem, cap_base + (k - 1.0) + cap_offset, 0);
                odd_bank = odd_bank + sin_osc_ar(freq * k) * mag_k
                    * clip(scale - (k - 1.0), 0.0, 1.0);
            }

            let k = 2.0;
            let mag_live = buf_rd_kr(1, mag_mem, k - 1.0, 0, 1) * mag_norm;
            let mag_sao_buf = w00 * buf_rd_kr(1, array_mem, base00 + (k - 1.0), 0, 1)
                            + w01 * buf_rd_kr(1, array_mem, base01 + (k - 1.0), 0, 1)
                            + w10 * buf_rd_kr(1, array_mem, base10 + (k - 1.0), 0, 1)
                            + w11 * buf_rd_kr(1, array_mem, base11 + (k - 1.0), 0, 1);
            let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
            let mag_k = mag_live * is_sam + mag_sao * is_sao;
            buf_wr_kr(mag_live, array_mem, cap_base + (k - 1.0) + cap_offset, 0);
            let even_bank = sin_osc_ar(freq * k) * mag_k
                * clip(scale - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * (i + 1)).to_float();
                let mag_live = buf_rd_kr(1, mag_mem, k - 1.0, 0, 1) * mag_norm;
                let mag_sao_buf = w00 * buf_rd_kr(1, array_mem, base00 + (k - 1.0), 0, 1)
                                + w01 * buf_rd_kr(1, array_mem, base01 + (k - 1.0), 0, 1)
                                + w10 * buf_rd_kr(1, array_mem, base10 + (k - 1.0), 0, 1)
                                + w11 * buf_rd_kr(1, array_mem, base11 + (k - 1.0), 0, 1);
                let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
                let mag_k = mag_live * is_sam + mag_sao * is_sao;
                buf_wr_kr(mag_live, array_mem, cap_base + (k - 1.0) + cap_offset, 0);
                even_bank = even_bank + sin_osc_ar(freq * k) * mag_k
                    * clip(scale - (k - 1.0), 0.0, 1.0);
            }

            let sine_signal = sin_osc_ar(freq);
            let sub_sao = saw_ar(freq * 0.5) * 0.5 * is_sao;
            let odd_raw = odd_bank * partials;
            let even_raw = even_bank * partials;

            let sine_out = leak_dc_ar(sine_signal, 0.995) * env * amp;
            let sub_out = leak_dc_ar(sub_sao, 0.995) * env * amp;
            let odd_out = leak_dc_ar(odd_raw, 0.995) * env * amp;
            let even_out = leak_dc_ar(even_raw, 0.995) * env * amp;

            [sine_out, sub_out, odd_out, even_out]
        })
});
