// Spectraphon dual public helper.
//
// Pure-Rhai composite over two split Spectraphon sides. Re-exports the
// side-module helpers so rack authors who `import this_file as spectraphon`
// have the full surface (set_param / input / output / run / etc.) available
// under a single namespace.

import "stdlib/instruments/spectral/spectraphon_side.vibe" as side;

fn spectraphon_dual(name, mode_a, mode_b) {
    let side_a = side::spectraphon_side(name + "__a", mode_a);
    let side_b = side::spectraphon_side(name + "__b", mode_b);

    side_a = side::spectraphon_set_param(side_a, "freq", 220.0);
    side_b = side::spectraphon_set_param(side_b, "freq", 220.0);

    return #{
        kind: "spectraphon_dual",
        name: name,
        side_a: side_a,
        side_b: side_b,
        analyzer_a: side_a.analyzer,
        analyzer_b: side_b.analyzer,
        oscillator_a: side_a.oscillator,
        oscillator_b: side_b.oscillator,
        mag_buf_a: side_a.mag_buf,
        mag_buf_b: side_b.mag_buf,
        array_buf_a: side_a.array_buf,
        array_buf_b: side_b.array_buf,
        freq_a: 220.0,
        freq_b: 220.0,
        routing_mode: 0.0,
        a_fm_index: 0.0,
        b_fm_index: 0.0,
    };
}

// Re-export single-side constructor so users who import this module under
// a single alias don't need a second `as` for sides.
fn spectraphon_side(name, mode) {
    return side::spectraphon_side(name, mode);
}

fn spectraphon_set_param(spec, param, value) {
    return side::spectraphon_set_param(spec, param, value);
}

fn spectraphon_input(spec, name) {
    return side::spectraphon_input(spec, name);
}

fn spectraphon_output(spec, name) {
    return side::spectraphon_output(spec, name);
}

fn spectraphon_outputs_to_current_group(spec, names) {
    return side::spectraphon_outputs_to_current_group(spec, names);
}

fn spectraphon_outputs_to_main(spec, names) {
    return side::spectraphon_outputs_to_main(spec, names);
}

fn spectraphon_outputs_to(spec, names, dest) {
    return side::spectraphon_outputs_to(spec, names, dest);
}

fn spectraphon_outputs_mute(spec, names) {
    return side::spectraphon_outputs_mute(spec, names);
}

fn spectraphon_gain(spec, value) {
    return side::spectraphon_gain(spec, value);
}

fn spectraphon_group(spec, name) {
    return side::spectraphon_group(spec, name);
}

fn spectraphon_run(spec) {
    return side::spectraphon_run(spec);
}

fn spectraphon_start(spec) {
    return side::spectraphon_start(spec);
}

fn spectraphon_param(spec, name) {
    return side::spectraphon_param(spec, name);
}
