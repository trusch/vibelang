// Spectraphon Dual - Story D FM/Follow plus side-parity SAO/SAM/Capture/Chaos/Noise.
//
// Two Spectraphon sides (A, B) wired into one synthdef with the FM bus and
// Follow routing per kb/spectraphon-synthdef-plan.md §3.f + §6.D + §7.
//
// Each side keeps the public four-jack dual surface: `odd_a`, `even_a`,
// `odd_b`, `even_b`. The named analyser inputs remain `analyze_a` and
// `analyze_b`.
//
// Per-side modes use the same table as spectraphon_side.vibe:
//   0 = SAO playback
//   1 = SAM, no capture
//   2 = Chaos
//   3 = Noise
//   4 = SAM with capture
//
// The dual historically exposed `mode_a` / `mode_b`; those params remain as
// compatibility aliases. New scripts should prefer `sam_capture_a` /
// `sam_capture_b`, matching the single-side synthdef's naming. The effective
// mode is the higher of the legacy and new param values, so existing
// `mode_x=1` scripts continue to select SAM.
//
// Array memory:
//   This synthdef uses one shared script-allocated buffer supplied by `bufnum`.
//   Side A occupies frames 0..65535 and side B occupies frames 65536..131071.
//   Within each side, the layout matches spectraphon_side.vibe exactly:
//   16 Arrays * 8 slide cells * 8 focus cells * 64 partials = 65536 floats.
//   Allocate 131072 frames x 1 channel and wire it with:
//     voice.set_param("bufnum", allocate_buffer("spec_dual_arrays", 131072, 1).bufnum);
//
// Sync approximation:
//   When `sync_b_to_a >= 0.5`, side B's additive-bank oscillator phases are
//   generated by resettable Phasor oscillators. They reset on side A's
//   fundamental cycle trigger (`impulse_ar(freq_a)`). This models the requested
//   shared cycle reset but does not attempt the hardware's richer per-partial
//   sync behavior. The documented control is named `sync_b_to_a` because
//   `sync` is a Rhai keyword. A deprecated `sync` compatibility alias remains
//   for string-based `set_param("sync", ...)` callers and existing surface
//   tests; internally it is read as `p["sync"]`, never as keyword syntax.
//
// FM bus (audio rate, internal):
//   * `sin_a_pre = sin_osc_ar(freq_a)` and `sin_b_pre = sin_osc_ar(freq_b_eff)`
//     are clean reference sines used as the FM modulators (matches hardware
//     where the FM bus picks up each side's Sine output, not the modulated
//     bank). Open-loop, no feedback path.
//   * Modulation depth follows kb plan §4a: `index in [0,1] -> depth in [0,f0] Hz`.
//   * Convention: `b_fm_index` modulates A; `a_fm_index` modulates B.
//
// Routing modes (`routing_mode`, quantised to nearest integer 0..4):
//   0 = independent - B uses freq_b directly.
//   1 = follow, unison        (B = freq_a)
//   2 = follow, +7 semitones  (B = freq_a * 1.4983)
//   3 = follow, +12 semitones (B = freq_a * 2.0)
//   4 = follow, +19 semitones (B = freq_a * 2.9966)
//
// Output ports: `odd_a`, `even_a`, `odd_b`, `even_b`. Route all four when
// using both sides; the default multi-output route sends the first two ports
// to the voice group and leaves the rest muted.

define_synthdef("spectraphon_dual", |builder| {
    builder
        .input("analyze_a", 1)      // 1ch - side A SAM analyzer source
        .input("analyze_b", 1)      // 1ch - side B SAM analyzer source
        .output("odd_a")            // 1ch - side A odd-bank summed
        .output("even_a")           // 1ch - side A even-bank summed
        .output("odd_b")            // 1ch - side B odd-bank summed
        .output("even_b")           // 1ch - side B even-bank summed
        .param("freq_a", 220.0)
        .param("freq_b", 220.0)
        .param("amp", 0.3)
        .param("gate", 1.0)
        .param("a_fm_index", 0.0)   // A's sine into B (depth scaled by f0_b Hz)
        .param("b_fm_index", 0.0)   // B's sine into A (depth scaled by f0_a Hz)
        .param("routing_mode", 0.0) // 0=indep, 1=unison, 2=+5, 3=+8, 4=+5+8
        .param("sync", 0.0)         // deprecated alias; use sync_b_to_a in scripts
        .param("sync_b_to_a", 0.0)  // >=0.5 resets side B phase from side A cycle
        .param("partials_a", 1.0)
        .param("partials_b", 1.0)
        .param("slide_a", 0.5)
        .param("slide_b", 0.5)
        .param("focus_a", 0.5)
        .param("focus_b", 0.5)
        .param("mode_a", 0.0)       // legacy alias for sam_capture_a
        .param("mode_b", 0.0)       // legacy alias for sam_capture_b
        .param("sam_capture_a", 0.0)
        .param("sam_capture_b", 0.0)
        .param("array_idx_a", 0.0)
        .param("array_idx_b", 0.0)
        .param("bufnum", 0.0)       // shared 131072-frame Array buffer; see header
        .body_map(|p| {
            let freq_a       = p.freq_a;
            let freq_b       = p.freq_b;
            let amp          = p.amp;
            let gate         = p.gate;
            let a_fm_index   = p.a_fm_index;
            let b_fm_index   = p.b_fm_index;
            let routing_mode = p.routing_mode;
            let sync_alias   = p["sync"];
            let sync_b_to_a  = p.sync_b_to_a;
            let partials_a   = p.partials_a;
            let partials_b   = p.partials_b;
            let slide_a      = p.slide_a;
            let slide_b      = p.slide_b;
            let focus_a      = p.focus_a;
            let focus_b      = p.focus_b;
            let mode_a       = p.mode_a;
            let mode_b       = p.mode_b;
            let sam_capture_a = p.sam_capture_a;
            let sam_capture_b = p.sam_capture_b;
            let array_idx_a  = p.array_idx_a;
            let array_idx_b  = p.array_idx_b;
            let array_buf    = p.bufnum;

            let env = envelope()
                .asr(0.01, 1.0, 0.3)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // === Routing mode decode ======================================
            let r_clip = clip(routing_mode, 0.0, 4.0);
            let r_int = (r_clip + 0.5) - wrap_kr(r_clip + 0.5, 0.0, 1.0);
            let dr0 = r_int - 0.0;
            let dr1 = r_int - 1.0;
            let dr2 = r_int - 2.0;
            let dr3 = r_int - 3.0;
            let dr4 = r_int - 4.0;
            let eq0 = clip(1.0 - dr0 * dr0 * 1000.0, 0.0, 1.0);
            let eq1 = clip(1.0 - dr1 * dr1 * 1000.0, 0.0, 1.0);
            let eq2 = clip(1.0 - dr2 * dr2 * 1000.0, 0.0, 1.0);
            let eq3 = clip(1.0 - dr3 * dr3 * 1000.0, 0.0, 1.0);
            let eq4 = clip(1.0 - dr4 * dr4 * 1000.0, 0.0, 1.0);
            let follow_ratio = eq1 * 1.0 + eq2 * 1.4983 + eq3 * 2.0 + eq4 * 2.9966;
            let freq_b_eff = freq_b * eq0 + freq_a * follow_ratio;

            // === FM bus ====================================================
            let sin_a_pre = sin_osc_ar(freq_a);
            let sin_b_pre = sin_osc_ar(freq_b_eff);
            let freq_a_fm = freq_a     + b_fm_index * sin_b_pre * freq_a;
            let freq_b_fm = freq_b_eff + a_fm_index * sin_a_pre * freq_b_eff;

            let n = 64.0;
            let scale_a = partials_a * n;
            let scale_b = partials_b * n;

            // Effective per-side modes. `max(legacy_mode, sam_capture)` using
            // clip-only math so it stays UGen-compatible.
            let mode_a_clip = clip(mode_a, 0.0, 4.0);
            let mode_b_clip = clip(mode_b, 0.0, 4.0);
            let sam_a_clip = clip(sam_capture_a, 0.0, 4.0);
            let sam_b_clip = clip(sam_capture_b, 0.0, 4.0);
            let mode_eff_a = mode_a_clip + clip(sam_a_clip - mode_a_clip, 0.0, 4.0);
            let mode_eff_b = mode_b_clip + clip(sam_b_clip - mode_b_clip, 0.0, 4.0);

            // sam_capture decode per side (same table as spectraphon_side).
            let m_le_0_a = clip(1.0 - mode_eff_a, 0.0, 1.0);
            let m_le_1_a = clip(2.0 - mode_eff_a, 0.0, 1.0);
            let m_le_2_a = clip(3.0 - mode_eff_a, 0.0, 1.0);
            let m_le_3_a = clip(4.0 - mode_eff_a, 0.0, 1.0);
            let sao_mix_a    = m_le_0_a;
            let sam_only_a   = m_le_1_a - m_le_0_a;
            let chaos_mix_a  = m_le_2_a - m_le_1_a;
            let noise_mix_a  = m_le_3_a - m_le_2_a;
            let sam_cap_a    = 1.0 - m_le_3_a;
            let sam_mix_a    = sam_only_a + sam_cap_a;
            let cap_active_a = sam_cap_a;

            let m_le_0_b = clip(1.0 - mode_eff_b, 0.0, 1.0);
            let m_le_1_b = clip(2.0 - mode_eff_b, 0.0, 1.0);
            let m_le_2_b = clip(3.0 - mode_eff_b, 0.0, 1.0);
            let m_le_3_b = clip(4.0 - mode_eff_b, 0.0, 1.0);
            let sao_mix_b    = m_le_0_b;
            let sam_only_b   = m_le_1_b - m_le_0_b;
            let chaos_mix_b  = m_le_2_b - m_le_1_b;
            let noise_mix_b  = m_le_3_b - m_le_2_b;
            let sam_cap_b    = 1.0 - m_le_3_b;
            let sam_mix_b    = sam_only_b + sam_cap_b;
            let cap_active_b = sam_cap_b;

            let has_array  = clip((array_buf - 1.0) * 1000.0, 0.0, 1.0);
            let fallback_array_buf = local_buf_ir(1.0, 1.0);
            let array_mem = array_buf * has_array
                          + fallback_array_buf * (1.0 - has_array);

            // === SAM analyser =============================================
            let analyze_in_a = p.inputs["analyze_a"];
            let analyze_in_b = p.inputs["analyze_b"];
            let fft_buf_a    = local_buf_ir(1.0, 2048.0);
            let fft_buf_b    = local_buf_ir(1.0, 2048.0);
            let chain_a      = fft_kr(fft_buf_a, analyze_in_a, 0.5, 1.0, 1.0, 0.0);
            let chain_b      = fft_kr(fft_buf_b, analyze_in_b, 0.5, 1.0, 1.0, 0.0);

            let f0_analyze_a = 50.0 * pow(16.0, clip(slide_a, 0.0, 1.0));
            let f0_analyze_b = 50.0 * pow(16.0, clip(slide_b, 0.0, 1.0));
            let bin_per_hz = 2048.0 / 44100.0;
            let mag_scale  = 0.001953125;
            let lag_t      = 0.02;
            let bin_max    = 1023.0;

            // === Shared Array grid: same bilinear lookup as spectraphon_side ===
            let slide_pos_a = clip(slide_a, 0.0, 0.99999) * 8.0;
            let focus_pos_a = clip(focus_a, 0.0, 0.99999) * 8.0;
            let slide_lo_a = slide_pos_a - wrap_kr(slide_pos_a, 0.0, 1.0);
            let focus_lo_a = focus_pos_a - wrap_kr(focus_pos_a, 0.0, 1.0);
            let slide_hi_a = clip(slide_lo_a + 1.0, 0.0, 7.0);
            let focus_hi_a = clip(focus_lo_a + 1.0, 0.0, 7.0);
            let s_frac_a = slide_pos_a - slide_lo_a;
            let f_frac_a = focus_pos_a - focus_lo_a;
            let w00_a = (1.0 - s_frac_a) * (1.0 - f_frac_a);
            let w01_a = (1.0 - s_frac_a) * f_frac_a;
            let w10_a = s_frac_a * (1.0 - f_frac_a);
            let w11_a = s_frac_a * f_frac_a;
            let arr_base_a = clip(array_idx_a, 0.0, 15.0) * 4096.0;
            let base00_a = arr_base_a + slide_lo_a * 512.0 + focus_lo_a * 64.0;
            let base01_a = arr_base_a + slide_lo_a * 512.0 + focus_hi_a * 64.0;
            let base10_a = arr_base_a + slide_hi_a * 512.0 + focus_lo_a * 64.0;
            let base11_a = arr_base_a + slide_hi_a * 512.0 + focus_hi_a * 64.0;
            let cap_base_a = arr_base_a + slide_lo_a * 512.0 + focus_lo_a * 64.0;
            let cap_offset_a = (1.0 - cap_active_a * has_array) * 1.0e9;

            let side_b_offset = 65536.0;
            let slide_pos_b = clip(slide_b, 0.0, 0.99999) * 8.0;
            let focus_pos_b = clip(focus_b, 0.0, 0.99999) * 8.0;
            let slide_lo_b = slide_pos_b - wrap_kr(slide_pos_b, 0.0, 1.0);
            let focus_lo_b = focus_pos_b - wrap_kr(focus_pos_b, 0.0, 1.0);
            let slide_hi_b = clip(slide_lo_b + 1.0, 0.0, 7.0);
            let focus_hi_b = clip(focus_lo_b + 1.0, 0.0, 7.0);
            let s_frac_b = slide_pos_b - slide_lo_b;
            let f_frac_b = focus_pos_b - focus_lo_b;
            let w00_b = (1.0 - s_frac_b) * (1.0 - f_frac_b);
            let w01_b = (1.0 - s_frac_b) * f_frac_b;
            let w10_b = s_frac_b * (1.0 - f_frac_b);
            let w11_b = s_frac_b * f_frac_b;
            let arr_base_b = side_b_offset + clip(array_idx_b, 0.0, 15.0) * 4096.0;
            let base00_b = arr_base_b + slide_lo_b * 512.0 + focus_lo_b * 64.0;
            let base01_b = arr_base_b + slide_lo_b * 512.0 + focus_hi_b * 64.0;
            let base10_b = arr_base_b + slide_hi_b * 512.0 + focus_lo_b * 64.0;
            let base11_b = arr_base_b + slide_hi_b * 512.0 + focus_hi_b * 64.0;
            let cap_base_b = arr_base_b + slide_lo_b * 512.0 + focus_lo_b * 64.0;
            let cap_offset_b = (1.0 - cap_active_b * has_array) * 1.0e9;

            let sync_eff = sync_alias + clip(sync_b_to_a - sync_alias, 0.0, 1.0);
            let sync_mix = clip((sync_eff - 0.5) * 1000.0, 0.0, 1.0);
            let sync_trig_b = impulse_ar(freq_a, 0.0);
            let two_pi = 6.283185307179586;

            // === Side A - Odd bank ========================================
            let k = 1.0;
            let mag_sao_buf = w00_a * buf_rd_kr(1, array_mem, base00_a + (k - 1.0), 0, 1)
                            + w01_a * buf_rd_kr(1, array_mem, base01_a + (k - 1.0), 0, 1)
                            + w10_a * buf_rd_kr(1, array_mem, base10_a + (k - 1.0), 0, 1)
                            + w11_a * buf_rd_kr(1, array_mem, base11_a + (k - 1.0), 0, 1);
            let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
            let centre_bin = clip(k * f0_analyze_a * bin_per_hz, 1.0, bin_max);
            let mag_sam = lag_kr(channels(bin_data_kr(chain_a, centre_bin, 0.5), 2)[0]
                                 * mag_scale, lag_t);
            buf_wr_kr(mag_sam, array_mem, cap_base_a + (k - 1.0) + cap_offset_a, 0);
            let mag_k = mag_sao * sao_mix_a + mag_sam * sam_mix_a;
            let odd_a = sin_osc_ar(freq_a_fm * k) * mag_k
                * clip(scale_a - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * i + 1).to_float();
                let mag_sao_buf = w00_a * buf_rd_kr(1, array_mem, base00_a + (k - 1.0), 0, 1)
                                + w01_a * buf_rd_kr(1, array_mem, base01_a + (k - 1.0), 0, 1)
                                + w10_a * buf_rd_kr(1, array_mem, base10_a + (k - 1.0), 0, 1)
                                + w11_a * buf_rd_kr(1, array_mem, base11_a + (k - 1.0), 0, 1);
                let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
                let centre_bin = clip(k * f0_analyze_a * bin_per_hz, 1.0, bin_max);
                let mag_sam = lag_kr(channels(bin_data_kr(chain_a, centre_bin, 0.5), 2)[0]
                                     * mag_scale, lag_t);
                buf_wr_kr(mag_sam, array_mem, cap_base_a + (k - 1.0) + cap_offset_a, 0);
                let mag_k = mag_sao * sao_mix_a + mag_sam * sam_mix_a;
                odd_a = odd_a + sin_osc_ar(freq_a_fm * k) * mag_k
                    * clip(scale_a - (k - 1.0), 0.0, 1.0);
            }

            // === Side A - Even bank =======================================
            let k = 2.0;
            let mag_sao_buf = w00_a * buf_rd_kr(1, array_mem, base00_a + (k - 1.0), 0, 1)
                            + w01_a * buf_rd_kr(1, array_mem, base01_a + (k - 1.0), 0, 1)
                            + w10_a * buf_rd_kr(1, array_mem, base10_a + (k - 1.0), 0, 1)
                            + w11_a * buf_rd_kr(1, array_mem, base11_a + (k - 1.0), 0, 1);
            let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
            let centre_bin = clip(k * f0_analyze_a * bin_per_hz, 1.0, bin_max);
            let mag_sam = lag_kr(channels(bin_data_kr(chain_a, centre_bin, 0.5), 2)[0]
                                 * mag_scale, lag_t);
            buf_wr_kr(mag_sam, array_mem, cap_base_a + (k - 1.0) + cap_offset_a, 0);
            let mag_k = mag_sao * sao_mix_a + mag_sam * sam_mix_a;
            let even_a = sin_osc_ar(freq_a_fm * k) * mag_k
                * clip(scale_a - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * (i + 1)).to_float();
                let mag_sao_buf = w00_a * buf_rd_kr(1, array_mem, base00_a + (k - 1.0), 0, 1)
                                + w01_a * buf_rd_kr(1, array_mem, base01_a + (k - 1.0), 0, 1)
                                + w10_a * buf_rd_kr(1, array_mem, base10_a + (k - 1.0), 0, 1)
                                + w11_a * buf_rd_kr(1, array_mem, base11_a + (k - 1.0), 0, 1);
                let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
                let centre_bin = clip(k * f0_analyze_a * bin_per_hz, 1.0, bin_max);
                let mag_sam = lag_kr(channels(bin_data_kr(chain_a, centre_bin, 0.5), 2)[0]
                                     * mag_scale, lag_t);
                buf_wr_kr(mag_sam, array_mem, cap_base_a + (k - 1.0) + cap_offset_a, 0);
                let mag_k = mag_sao * sao_mix_a + mag_sam * sam_mix_a;
                even_a = even_a + sin_osc_ar(freq_a_fm * k) * mag_k
                    * clip(scale_a - (k - 1.0), 0.0, 1.0);
            }

            // === Side B - Odd bank ========================================
            let k = 1.0;
            let mag_sao_buf = w00_b * buf_rd_kr(1, array_mem, base00_b + (k - 1.0), 0, 1)
                            + w01_b * buf_rd_kr(1, array_mem, base01_b + (k - 1.0), 0, 1)
                            + w10_b * buf_rd_kr(1, array_mem, base10_b + (k - 1.0), 0, 1)
                            + w11_b * buf_rd_kr(1, array_mem, base11_b + (k - 1.0), 0, 1);
            let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
            let centre_bin = clip(k * f0_analyze_b * bin_per_hz, 1.0, bin_max);
            let mag_sam = lag_kr(channels(bin_data_kr(chain_b, centre_bin, 0.5), 2)[0]
                                 * mag_scale, lag_t);
            buf_wr_kr(mag_sam, array_mem, cap_base_b + (k - 1.0) + cap_offset_b, 0);
            let mag_k = mag_sao * sao_mix_b + mag_sam * sam_mix_b;
            let phase = phasor_ar(sync_trig_b, freq_b_fm * k / 44100.0, 0.0, 1.0, 0.0);
            let osc_synced = sin_osc_ar(0.0, phase * two_pi);
            let osc_free = sin_osc_ar(freq_b_fm * k);
            let osc_b = osc_free * (1.0 - sync_mix) + osc_synced * sync_mix;
            let odd_b = osc_b * mag_k
                * clip(scale_b - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * i + 1).to_float();
                let mag_sao_buf = w00_b * buf_rd_kr(1, array_mem, base00_b + (k - 1.0), 0, 1)
                                + w01_b * buf_rd_kr(1, array_mem, base01_b + (k - 1.0), 0, 1)
                                + w10_b * buf_rd_kr(1, array_mem, base10_b + (k - 1.0), 0, 1)
                                + w11_b * buf_rd_kr(1, array_mem, base11_b + (k - 1.0), 0, 1);
                let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
                let centre_bin = clip(k * f0_analyze_b * bin_per_hz, 1.0, bin_max);
                let mag_sam = lag_kr(channels(bin_data_kr(chain_b, centre_bin, 0.5), 2)[0]
                                     * mag_scale, lag_t);
                buf_wr_kr(mag_sam, array_mem, cap_base_b + (k - 1.0) + cap_offset_b, 0);
                let mag_k = mag_sao * sao_mix_b + mag_sam * sam_mix_b;
                let phase = phasor_ar(sync_trig_b, freq_b_fm * k / 44100.0, 0.0, 1.0, 0.0);
                let osc_synced = sin_osc_ar(0.0, phase * two_pi);
                let osc_free = sin_osc_ar(freq_b_fm * k);
                let osc_b = osc_free * (1.0 - sync_mix) + osc_synced * sync_mix;
                odd_b = odd_b + osc_b * mag_k
                    * clip(scale_b - (k - 1.0), 0.0, 1.0);
            }

            // === Side B - Even bank =======================================
            let k = 2.0;
            let mag_sao_buf = w00_b * buf_rd_kr(1, array_mem, base00_b + (k - 1.0), 0, 1)
                            + w01_b * buf_rd_kr(1, array_mem, base01_b + (k - 1.0), 0, 1)
                            + w10_b * buf_rd_kr(1, array_mem, base10_b + (k - 1.0), 0, 1)
                            + w11_b * buf_rd_kr(1, array_mem, base11_b + (k - 1.0), 0, 1);
            let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
            let centre_bin = clip(k * f0_analyze_b * bin_per_hz, 1.0, bin_max);
            let mag_sam = lag_kr(channels(bin_data_kr(chain_b, centre_bin, 0.5), 2)[0]
                                 * mag_scale, lag_t);
            buf_wr_kr(mag_sam, array_mem, cap_base_b + (k - 1.0) + cap_offset_b, 0);
            let mag_k = mag_sao * sao_mix_b + mag_sam * sam_mix_b;
            let phase = phasor_ar(sync_trig_b, freq_b_fm * k / 44100.0, 0.0, 1.0, 0.0);
            let osc_synced = sin_osc_ar(0.0, phase * two_pi);
            let osc_free = sin_osc_ar(freq_b_fm * k);
            let osc_b = osc_free * (1.0 - sync_mix) + osc_synced * sync_mix;
            let even_b = osc_b * mag_k
                * clip(scale_b - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * (i + 1)).to_float();
                let mag_sao_buf = w00_b * buf_rd_kr(1, array_mem, base00_b + (k - 1.0), 0, 1)
                                + w01_b * buf_rd_kr(1, array_mem, base01_b + (k - 1.0), 0, 1)
                                + w10_b * buf_rd_kr(1, array_mem, base10_b + (k - 1.0), 0, 1)
                                + w11_b * buf_rd_kr(1, array_mem, base11_b + (k - 1.0), 0, 1);
                let mag_sao = mag_sao_buf * has_array + (1.0 / k) * (1.0 - has_array);
                let centre_bin = clip(k * f0_analyze_b * bin_per_hz, 1.0, bin_max);
                let mag_sam = lag_kr(channels(bin_data_kr(chain_b, centre_bin, 0.5), 2)[0]
                                     * mag_scale, lag_t);
                buf_wr_kr(mag_sam, array_mem, cap_base_b + (k - 1.0) + cap_offset_b, 0);
                let mag_k = mag_sao * sao_mix_b + mag_sam * sam_mix_b;
                let phase = phasor_ar(sync_trig_b, freq_b_fm * k / 44100.0, 0.0, 1.0, 0.0);
                let osc_synced = sin_osc_ar(0.0, phase * two_pi);
                let osc_free = sin_osc_ar(freq_b_fm * k);
                let osc_b = osc_free * (1.0 - sync_mix) + osc_synced * sync_mix;
                even_b = even_b + osc_b * mag_k
                    * clip(scale_b - (k - 1.0), 0.0, 1.0);
            }

            // === Chaos / Noise side A =====================================
            let slide_c_a = clip(slide_a, 0.0, 1.0);
            let focus_c_a = clip(focus_a, 0.0, 1.0);
            let chaos_ratio_a = 1.0 + focus_c_a * 3.0;
            let chaos_im_a    = 0.5 + slide_c_a * 3.5;
            let chaos_fb_a    = slide_c_a * 0.5;
            let chaos_voice_a = fb_sine_l_ar(freq_a_fm, chaos_im_a, chaos_fb_a,
                                             1.1, 0.5, 0.1, 0.1);
            let chaos_a_carrier = sin_osc_ar(freq_a_fm);
            let chaos_a_carrier_b = sin_osc_ar(freq_a_fm * chaos_ratio_a);
            let chaos_am_a = 1.0 + chaos_voice_a * partials_a;
            let chaos_odd_a_raw  = chaos_a_carrier * chaos_am_a * 0.5;
            let chaos_even_a_raw = chaos_a_carrier_b * chaos_am_a * 0.5;

            let slide_cut_a = lin_exp_kr(slide_c_a, 0.0, 1.0, 100.0, 16000.0);
            let focus_cut_a = lin_exp_kr(focus_c_a, 0.0, 1.0, 20.0, 2000.0);
            let noise_src_a = pink_noise_ar();
            let noise_lp_a  = lpf_ar(noise_src_a, slide_cut_a);
            let noise_bp_a  = hpf_ar(noise_lp_a, focus_cut_a);
            let noise_odd_a_raw  = noise_bp_a * sin_osc_ar(freq_a_fm) * 0.5;
            let noise_even_a_raw = noise_bp_a * sin_osc_ar(freq_a_fm * 2.0) * 0.5;

            // === Chaos / Noise side B =====================================
            let slide_c_b = clip(slide_b, 0.0, 1.0);
            let focus_c_b = clip(focus_b, 0.0, 1.0);
            let chaos_ratio_b = 1.0 + focus_c_b * 3.0;
            let chaos_im_b    = 0.5 + slide_c_b * 3.5;
            let chaos_fb_b    = slide_c_b * 0.5;
            let chaos_voice_b = fb_sine_l_ar(freq_b_fm, chaos_im_b, chaos_fb_b,
                                             1.1, 0.5, 0.1, 0.1);
            let phase_b1 = phasor_ar(sync_trig_b, freq_b_fm / 44100.0, 0.0, 1.0, 0.0);
            let sync_sine_b1 = sin_osc_ar(0.0, phase_b1 * two_pi);
            let free_sine_b1 = sin_osc_ar(freq_b_fm);
            let sine_b1 = free_sine_b1 * (1.0 - sync_mix) + sync_sine_b1 * sync_mix;
            let phase_br = phasor_ar(sync_trig_b, freq_b_fm * chaos_ratio_b / 44100.0, 0.0, 1.0, 0.0);
            let sync_sine_br = sin_osc_ar(0.0, phase_br * two_pi);
            let free_sine_br = sin_osc_ar(freq_b_fm * chaos_ratio_b);
            let sine_br = free_sine_br * (1.0 - sync_mix) + sync_sine_br * sync_mix;
            let chaos_am_b = 1.0 + chaos_voice_b * partials_b;
            let chaos_odd_b_raw  = sine_b1 * chaos_am_b * 0.5;
            let chaos_even_b_raw = sine_br * chaos_am_b * 0.5;

            let slide_cut_b = lin_exp_kr(slide_c_b, 0.0, 1.0, 100.0, 16000.0);
            let focus_cut_b = lin_exp_kr(focus_c_b, 0.0, 1.0, 20.0, 2000.0);
            let noise_src_b = pink_noise_ar();
            let noise_lp_b  = lpf_ar(noise_src_b, slide_cut_b);
            let noise_bp_b  = hpf_ar(noise_lp_b, focus_cut_b);
            let phase_b2 = phasor_ar(sync_trig_b, freq_b_fm * 2.0 / 44100.0, 0.0, 1.0, 0.0);
            let sync_sine_b2 = sin_osc_ar(0.0, phase_b2 * two_pi);
            let free_sine_b2 = sin_osc_ar(freq_b_fm * 2.0);
            let sine_b2 = free_sine_b2 * (1.0 - sync_mix) + sync_sine_b2 * sync_mix;
            let noise_odd_b_raw  = noise_bp_b * sine_b1 * 0.5;
            let noise_even_b_raw = noise_bp_b * sine_b2 * 0.5;

            // === Mode-mixed outputs =======================================
            let bank_active_a = sao_mix_a + sam_mix_a;
            let bank_active_b = sao_mix_b + sam_mix_b;
            let odd_a_raw = odd_a * bank_active_a * partials_a
                          + chaos_odd_a_raw * chaos_mix_a
                          + noise_odd_a_raw * noise_mix_a;
            let even_a_raw = even_a * bank_active_a * partials_a
                           + chaos_even_a_raw * chaos_mix_a
                           + noise_even_a_raw * noise_mix_a;
            let odd_b_raw = odd_b * bank_active_b * partials_b
                          + chaos_odd_b_raw * chaos_mix_b
                          + noise_odd_b_raw * noise_mix_b;
            let even_b_raw = even_b * bank_active_b * partials_b
                           + chaos_even_b_raw * chaos_mix_b
                           + noise_even_b_raw * noise_mix_b;

            let out_odd_a  = leak_dc_ar(odd_a_raw,  0.995) * env * amp;
            let out_even_a = leak_dc_ar(even_a_raw, 0.995) * env * amp;
            let out_odd_b  = leak_dc_ar(odd_b_raw,  0.995) * env * amp;
            let out_even_b = leak_dc_ar(even_b_raw, 0.995) * env * amp;

            [out_odd_a, out_even_a, out_odd_b, out_even_b]
        })
});
