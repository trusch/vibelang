// Spectraphon side public helper.
//
// Importing this file registers the split synthdefs and provides a pure-Rhai
// helper that hides the analyzer/oscillator buffer wiring without adding any
// Rust surface area.

import "stdlib/instruments/spectral/spectraphon_analyzer.vibe";
import "stdlib/instruments/spectral/spectraphon_sam_oscillator.vibe";
import "stdlib/instruments/spectral/spectraphon_sao_oscillator.vibe";

fn _spectraphon_f0_from_slide(slide) {
    return 50.0 * 16.0.pow(slide.max(0.0).min(1.0));
}

fn _spectraphon_follow_freq(freq_a, freq_b, routing_mode) {
    let mode = (routing_mode.max(0.0).min(4.0) + 0.5).floor();
    if mode == 1.0 {
        return freq_a;
    } else if mode == 2.0 {
        return freq_a * 1.4983;
    } else if mode == 3.0 {
        return freq_a * 2.0;
    } else if mode == 4.0 {
        return freq_a * 2.9966;
    }
    return freq_b;
}

fn _spectraphon_dual_apply_freq_b(spec) {
    let freq_b_eff = _spectraphon_follow_freq(spec.freq_a, spec.freq_b, spec.routing_mode);
    spec.side_b.freq = freq_b_eff;
    spec.side_b.oscillator = spec.side_b.oscillator.set_param("freq", freq_b_eff);
    spec.oscillator_b = spec.side_b.oscillator;
    return spec;
}

fn _spectraphon_dual_refresh_a(spec, side_value) {
    spec.side_a = side_value;
    spec.analyzer_a = side_value.analyzer;
    spec.oscillator_a = side_value.oscillator;
    return spec;
}

fn _spectraphon_dual_refresh_b(spec, side_value) {
    spec.side_b = side_value;
    spec.analyzer_b = side_value.analyzer;
    spec.oscillator_b = side_value.oscillator;
    return spec;
}

fn _spectraphon_mode_from_capture(value) {
    if value >= 3.5 {
        return "sam_capture";
    } else if value >= 0.5 {
        return "sam";
    }
    return "sao";
}

fn _spectraphon_synth_for_mode(mode) {
    if mode == "sao" || mode == "chaos" || mode == "noise" {
        return "spectraphon_sao_oscillator";
    } else if mode == "sam" {
        return "spectraphon_sam_live_oscillator";
    }
    return "spectraphon_sam_oscillator";
}

fn _spectraphon_capture_for_mode(mode) {
    if mode == "sam_capture" || mode == "capture" {
        return 1.0;
    }
    return 0.0;
}

fn _spectraphon_build_oscillator(spec, mode) {
    let synth = _spectraphon_synth_for_mode(mode);
    let osc = voice(spec.name + "__oscillator")
        .synth(synth)
        .set_param("freq", spec.freq)
        .set_param("partials", spec.partials)
        .set_param("slide", spec.slide)
        .set_param("focus", spec.focus)
        .set_param("amp", spec.amp)
        .set_param("gate", spec.gate)
        .set_param("array_idx", spec.array_idx)
        .set_param("array_buf", spec.array_bufnum);

    if synth == "spectraphon_sam_live_oscillator" {
        osc = osc.set_param("mag_buf", spec.mag_bufnum);
    } else if synth == "spectraphon_sam_oscillator" {
        osc = osc
            .set_param("mag_buf", spec.mag_bufnum)
            .set_param("capture", _spectraphon_capture_for_mode(mode));
    }

    if spec.group_name != "" {
        osc = osc.group(spec.group_name);
    }
    osc = osc.gain(spec.gain_value);
    return osc;
}

fn _spectraphon_set_mode(spec, mode) {
    spec.mode = mode;
    spec.oscillator = _spectraphon_build_oscillator(spec, mode);
    return spec;
}

fn spectraphon_side(name, mode) {
    let mag = allocate_buffer(name + "__mag", 64, 1);
    let arrays = allocate_buffer(name + "__arrays", 65536, 1);

    let analyzer = voice(name + "__analyzer")
        .synth("spectraphon_analyzer")
        .set_param("mag_buf", mag.bufnum)
        .set_param("f0_analyze", _spectraphon_f0_from_slide(0.5));
    // The analyzer's only declared output is the kr 'noop' dummy that exists
    // solely to satisfy "synthdef must declare ≥1 output". Mute it so default
    // routing doesn't try to push a kr signal into an audio group.
    analyzer.output("noop").mute();

    let spec = #{
        kind: "spectraphon_side",
        name: name,
        analyzer: analyzer,
        oscillator: voice(name + "__oscillator"),
        mag_buf: mag,
        array_buf: arrays,
        mag_bufnum: mag.bufnum,
        array_bufnum: arrays.bufnum,
        mode: mode,
        freq: 220.0,
        partials: 1.0,
        slide: 0.5,
        focus: 0.5,
        amp: 0.3,
        gate: 1.0,
        array_idx: 0.0,
        group_name: "",
        gain_value: 1.0,
    };
    return _spectraphon_set_mode(spec, mode);
}

fn spectraphon_set_param(spec, param, value) {
    if spec.kind == "spectraphon_dual" {
        if param == "freq_a" {
            spec.freq_a = value;
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "freq", value));
            return _spectraphon_dual_apply_freq_b(spec);
        } else if param == "freq_b" {
            spec.freq_b = value;
            return _spectraphon_dual_apply_freq_b(spec);
        } else if param == "routing_mode" {
            spec.routing_mode = value;
            return _spectraphon_dual_apply_freq_b(spec);
        } else if param == "partials_a" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "partials", value));
        } else if param == "partials_b" {
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, "partials", value));
        } else if param == "slide_a" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "slide", value));
        } else if param == "slide_b" {
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, "slide", value));
        } else if param == "focus_a" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "focus", value));
        } else if param == "focus_b" {
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, "focus", value));
        } else if param == "mode_a" || param == "sam_capture_a" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "sam_capture", value));
        } else if param == "mode_b" || param == "sam_capture_b" {
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, "sam_capture", value));
        } else if param == "array_idx_a" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "array_idx", value));
        } else if param == "array_idx_b" {
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, "array_idx", value));
        } else if param == "amp" || param == "gate" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, param, value));
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, param, value));
        } else if param == "bufnum" || param == "array_buf" {
            spec = _spectraphon_dual_refresh_a(spec, spectraphon_set_param(spec.side_a, "array_buf", value));
            spec = _spectraphon_dual_refresh_b(spec, spectraphon_set_param(spec.side_b, "array_buf", value));
        } else {
            spec[param] = value;
        }
        return spec;
    }

    if param == "mode" {
        spec = _spectraphon_set_mode(spec, value);
    } else if param == "sam_capture" {
        spec = _spectraphon_set_mode(spec, _spectraphon_mode_from_capture(value));
    } else if param == "freq" {
        spec.freq = value;
        spec.oscillator = spec.oscillator.set_param(param, value);
    } else if param == "partials" {
        spec.partials = value;
        spec.oscillator = spec.oscillator.set_param(param, value);
    } else if param == "amp" {
        spec.amp = value;
        spec.oscillator = spec.oscillator.set_param(param, value);
    } else if param == "gate" {
        spec.gate = value;
        spec.analyzer = spec.analyzer.set_param(param, value);
        spec.oscillator = spec.oscillator.set_param(param, value);
    } else if param == "array_idx" {
        spec.array_idx = value;
        spec.oscillator = spec.oscillator.set_param(param, value);
    } else if param == "slide" {
        spec.slide = value;
        spec.oscillator = spec.oscillator.set_param("slide", value);
        spec.analyzer = spec.analyzer.set_param("f0_analyze", _spectraphon_f0_from_slide(value));
    } else if param == "focus" {
        spec.focus = value;
        spec.oscillator = spec.oscillator.set_param("focus", value);
        spec.analyzer = spec.analyzer.set_param("focus", value);
    } else if param == "bufnum" || param == "array_buf" {
        spec.array_bufnum = value;
        spec.oscillator = spec.oscillator.set_param("array_buf", value);
    } else if param == "mag_buf" {
        spec.mag_bufnum = value;
        spec.oscillator = spec.oscillator.set_param("mag_buf", value);
        spec.analyzer = spec.analyzer.set_param("mag_buf", value);
    } else if param == "f0_analyze" || param == "active" {
        spec.analyzer = spec.analyzer.set_param(param, value);
    } else {
        spec.oscillator = spec.oscillator.set_param(param, value);
    }
    return spec;
}

fn spectraphon_input(spec, name) {
    if spec.kind == "spectraphon_dual" {
        if name == "analyze_b" {
            return spec.analyzer_b.input("analyze");
        }
        return spec.analyzer_a.input("analyze");
    }
    return spec.analyzer.input(name);
}

fn spectraphon_output(spec, name) {
    if spec.kind == "spectraphon_dual" {
        if name == "odd_b" {
            return spec.oscillator_b.output("odd");
        } else if name == "even_b" {
            return spec.oscillator_b.output("even");
        } else if name == "even_a" {
            return spec.oscillator_a.output("even");
        }
        return spec.oscillator_a.output("odd");
    }
    return spec.oscillator.output(name);
}

fn spectraphon_outputs_to_current_group(spec, names) {
    for name in names {
        spectraphon_output(spec, name).to_current_group();
    }
    return spec;
}

fn spectraphon_outputs_to_main(spec, names) {
    for name in names {
        spectraphon_output(spec, name).to_main();
    }
    return spec;
}

fn spectraphon_outputs_to(spec, names, dest) {
    for name in names {
        spectraphon_output(spec, name).to(dest);
    }
    return spec;
}

fn spectraphon_outputs_mute(spec, names) {
    for name in names {
        spectraphon_output(spec, name).mute();
    }
    return spec;
}

fn spectraphon_gain(spec, value) {
    if spec.kind == "spectraphon_dual" {
        spec.oscillator_a = spec.oscillator_a.gain(value);
        spec.oscillator_b = spec.oscillator_b.gain(value);
        spec.side_a.gain_value = value;
        spec.side_b.gain_value = value;
    } else {
        spec.gain_value = value;
        spec.oscillator = spec.oscillator.gain(value);
    }
    return spec;
}

fn spectraphon_group(spec, name) {
    if spec.kind == "spectraphon_dual" {
        spec.oscillator_a = spec.oscillator_a.group(name);
        spec.oscillator_b = spec.oscillator_b.group(name);
        spec.side_a.group_name = name;
        spec.side_b.group_name = name;
    } else {
        spec.group_name = name;
        spec.oscillator = spec.oscillator.group(name);
    }
    return spec;
}

fn spectraphon_run(spec) {
    if spec.kind == "spectraphon_dual" {
        spec.analyzer_a = spec.analyzer_a.run();
        spec.analyzer_b = spec.analyzer_b.run();
        spec.oscillator_a = spec.oscillator_a.run();
        spec.oscillator_b = spec.oscillator_b.run();
    } else {
        spec.analyzer = spec.analyzer.run();
        spec.oscillator = spec.oscillator.run();
    }
    return spec;
}

fn spectraphon_start(spec) {
    return spectraphon_run(spec);
}

fn spectraphon_param(spec, name) {
    if spec.kind == "spectraphon_dual" {
        if name == "freq_b" {
            return spec.oscillator_b.param("freq");
        } else if name == "partials_b" {
            return spec.oscillator_b.param("partials");
        } else if name == "slide_b" {
            return spec.oscillator_b.param("slide");
        } else if name == "focus_b" {
            return spec.oscillator_b.param("focus");
        } else if name == "sam_capture_b" || name == "mode_b" {
            if spec.side_b.mode == "sao" || spec.side_b.mode == "chaos" || spec.side_b.mode == "noise" {
                return spec.oscillator_b.param("array_idx");
            }
            return spec.oscillator_b.param("capture");
        } else if name == "array_idx_b" {
            return spec.oscillator_b.param("array_idx");
        } else if name == "freq_a" {
            return spec.oscillator_a.param("freq");
        } else if name == "partials_a" {
            return spec.oscillator_a.param("partials");
        } else if name == "slide_a" {
            return spec.oscillator_a.param("slide");
        } else if name == "focus_a" {
            return spec.oscillator_a.param("focus");
        } else if name == "sam_capture_a" || name == "mode_a" {
            if spec.side_a.mode == "sao" || spec.side_a.mode == "chaos" || spec.side_a.mode == "noise" {
                return spec.oscillator_a.param("array_idx");
            }
            return spec.oscillator_a.param("capture");
        } else if name == "array_idx_a" {
            return spec.oscillator_a.param("array_idx");
        }
        return spec.oscillator_a.param(name);
    }
    if name == "f0_analyze" || name == "active" {
        return spec.analyzer.param(name);
    } else if name == "sam_capture" || name == "mode" {
        if spec.mode == "sao" || spec.mode == "chaos" || spec.mode == "noise" {
            return spec.oscillator.param("array_idx");
        }
        return spec.oscillator.param("capture");
    }
    return spec.oscillator.param(name);
}
