// Spectraphon Side - Story A core synthdef (single-side SAO foundation)
//
// Single-side spectral oscillator using a hardcoded saw-like spectrum
// (mag[k] = 1/k for k = 1..64), split across an Odd bank (k = 1, 3, ..., 63)
// and an Even bank (k = 2, 4, ..., 64). Each bank is built from 32 parallel
// sin_osc_ar voices summed together — klang_ar would require a 32+32-element
// signal array which exceeds Rhai's 16-arity limit, so the additive bank
// is unrolled per the plan §7 fallback.
//
// Output convention (stereo channels mirror the hardware jacks):
//   L = Odd  jack — odd partials. With merge_even=1 (default), Even folds
//                   into Odd so unpatched-Even users hear all harmonics on L.
//   R = secondary jack, selected per side:
//       sub_cv_out=1  → Sub/CV: saw_ar(freq * 0.5) * 0.5 (Side A SAO sub-osc).
//                       Wins over sine_out when both are set.
//       sine_out=1    → Sine jack: clean sin_osc_ar(freq) at k=1.
//                       Never gated by Partials — survives at partials=0,
//                       per hardware §5 ("Sine output is the only path that
//                       survives at Partials=0").
//       both 0 (def)  → Even jack: even bank (or odd if merge_even=1),
//                       gated by Partials like the hardware Even out.
//
// Story A scope only: NO SAM analyzer, NO Array memory, NO FM bus —
// those land in Stories B / C / D. See kb/spectraphon-synthdef-plan.md
// §3 (DSP arch), §4 (UGen mapping), §6.A (this story's scope).

define_synthdef("spectraphon_side", |builder| {
    builder
        .param("freq", 220.0)
        .param("partials", 1.0)
        .param("slide", 0.5)        // reserved for SAO Array X-axis (Story C)
        .param("focus", 0.5)        // reserved for SAO Array Y-axis (Story C)
        .param("amp", 0.3)
        .param("gate", 1.0)
        .param("merge_even", 1.0)   // 1 = even folds into odd (mono); 0 = odd-L / even-R split
        .param("sine_out", 0.0)     // 1 = R becomes clean sine (k=1, ungated by Partials)
        .param("sub_cv_out", 0.0)   // 1 = R becomes sub-osc saw at f0/2; wins over sine_out
        .body(|freq, partials, slide, focus, amp, gate, merge_even, sine_out, sub_cv_out| {

            let env = envelope()
                .asr(0.01, 1.0, 0.3)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Default saw-like spectrum: mag[k] = 1/k for k = 1..64.
            // The per-partial gate g[k] = clamp(partials*N - (k-1), 0, 1)
            // reveals harmonics low-to-high as `partials` sweeps CCW → CW;
            // CCW (partials=0) → silent, CW (partials=1) → full spectrum.
            let n = 64.0;
            let scale = partials * n;

            // --- Odd bank: k = 1, 3, 5, ..., 63 ---------------------------
            let k = 1.0;
            let odd_bank = sin_osc_ar(freq * k) * (1.0 / k)
                * clip(scale - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * i + 1).to_float();
                odd_bank = odd_bank + sin_osc_ar(freq * k) * (1.0 / k)
                    * clip(scale - (k - 1.0), 0.0, 1.0);
            }

            // --- Even bank: k = 2, 4, 6, ..., 64 --------------------------
            let k = 2.0;
            let even_bank = sin_osc_ar(freq * k) * (1.0 / k)
                * clip(scale - (k - 1.0), 0.0, 1.0);
            for i in 1..32 {
                let k = (2 * (i + 1)).to_float();
                even_bank = even_bank + sin_osc_ar(freq * k) * (1.0 / k)
                    * clip(scale - (k - 1.0), 0.0, 1.0);
            }

            // Hardware "Even-into-Odd" normalization: when Even is unpatched
            // (merge_even = 1), even partials sum into the Odd jack and the
            // Even jack falls silent.
            let odd_out  = odd_bank + even_bank * merge_even;
            let even_out = even_bank * (1.0 - merge_even);

            // Left = Odd jack (always). Partials-gated.
            let left_raw = odd_out;

            // Right channel: 3-way selector via 0/1 floats.
            //   sub_cv_out wins over sine_out (matches ticket spec)
            //   sub/sine paths bypass the Partials gate (hardware Sub/CV
            //   and Sine outs are independent of the Partials knob).
            let default_right = (even_out * (1.0 - merge_even)
                                  + odd_out * merge_even) * partials;
            let sine_signal = sin_osc_ar(freq);
            let sub_signal  = saw_ar(freq * 0.5) * 0.5;

            let active_sub     = sub_cv_out;
            let active_sine    = sine_out * (1.0 - sub_cv_out);
            let active_default = (1.0 - sine_out) * (1.0 - sub_cv_out);

            let right_raw = default_right * active_default
                          + sine_signal   * active_sine
                          + sub_signal    * active_sub;

            // Per-channel DC block, then global VCA + envelope + amp.
            // Partials gating is already baked into left_raw and default_right;
            // the sine/sub bypass paths intentionally skip it.
            let left  = leak_dc_ar(left_raw,  0.995) * env * amp * partials;
            let right = leak_dc_ar(right_raw, 0.995) * env * amp;

            [left, right]
        })
});
