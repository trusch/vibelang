// Spectraphon analyzer - startup-safe harmonic envelope follower.
//
// This synthdef is intentionally only the SAM analyzer half of Spectraphon.
// It writes the first 16 harmonic magnitudes into the 64-frame `mag_buf`;
// the oscillator synthdef consumes that control buffer. The live SAM path uses
// filter-bank envelope followers here because even a one-bin FFT analyzer can
// exceed scsynth's startup sync budget when instantiated as a helper child.

define_synthdef("spectraphon_analyzer", |builder| {
    builder
        .input("analyze", 1)
        .output_kr("noop")
        .param("f0_analyze", 200.0)
        .param("focus", 0.5)
        .param("mag_buf", 0.0)
        .param("active", 1.0)
        .param("gate", 1.0)
        .body_map(|p| {
            let analyze_in = p.inputs["analyze"];
            let f0_analyze = p.f0_analyze;
            let focus = clip(p.focus, 0.0, 1.0);
            let mag_buf = p.mag_buf;
            let active = clip(p.active, 0.0, 1.0) * clip(p.gate, 0.0, 1.0);

            let rq = 0.03 + focus * 0.22;
            let mag_scale = 8.0;
            let attack = 0.01;
            let release = 0.08;

            let k = 1.0;
            let centre_hz = clip(k * f0_analyze, 20.0, 18000.0);
            let band = bpf_ar(analyze_in, centre_hz, rq);
            let mag = clip(amplitude_kr(band, attack, release) * mag_scale, 0.0, 1.0) * active;
            buf_wr_kr(mag, mag_buf, k - 1.0, 0);

            for i in 2..17 {
                let k = i.to_float();
                let centre_hz = clip(k * f0_analyze, 20.0, 18000.0);
                let band = bpf_ar(analyze_in, centre_hz, rq);
                let mag = clip(amplitude_kr(band, attack, release) * mag_scale, 0.0, 1.0) * active;
                buf_wr_kr(mag, mag_buf, k - 1.0, 0);
            }

            [dc_kr(0.0)]
        })
});
