// Genre: Disco, Nu-Disco | Character: Octave-jumping disco bass
define_synthdef("bass_disco")
    .param("freq", 70.0) // units: Hz, range: 20..20000, default: 70.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.003, 1.0, 0.06)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Body with octave
        let body = sin_osc_ar(freq) * 0.5;
        let octave = sin_osc_ar(freq * 2.0) * 0.3;
        let harm = sin_osc_ar(freq * 3.0) * 0.1;

        // Quick attack
        let attack = envelope()
            .perc(0.001, 0.015)
            .build();
        let click = hpf_ar(white_noise_ar(), 3000.0) * attack * 0.15;

        let sig = body + octave + harm + click;

        lpf_ar(sig, 4000.0) * env * amp
    });

//
// # Usage: bass_disco
//
// ```rhai
// import "stdlib/bass/genre/bass_disco.vibe" as bass_disco;
//
// let doc_bass_disco = voice("doc_bass_disco")
//     .synth("bass_disco")
//     .set_param("freq", 70.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_disco.output("out").to_main();
// doc_bass_disco.run();
// ```
