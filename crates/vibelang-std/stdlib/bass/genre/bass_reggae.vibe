// Genre: Reggae, Dub | Character: Deep reggae bass with round tone
define_synthdef("bass_reggae")
    .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.85) // units: linear, range: 0..1, default: 0.85. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.02, 1.0, 0.15)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Deep, round tone
        let body = sin_osc_ar(freq) * 0.6;
        let sub = sin_osc_ar(freq * 0.5) * 0.3;

        // Slight warmth from second harmonic
        let warm = sin_osc_ar(freq * 2.0) * 0.08;

        let sig = body + sub + warm;

        // Very warm filtering
        lpf_ar(sig, 800.0) * env * amp
    });

//
// # Usage: bass_reggae
//
// ```rhai
// import "stdlib/bass/genre/bass_reggae.vibe" as bass_reggae;
//
// let doc_bass_reggae = voice("doc_bass_reggae")
//     .synth("bass_reggae")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.85)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_reggae.output("out").to_main();
// doc_bass_reggae.run();
// ```
