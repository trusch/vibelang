// Genre: Techno, Industrial | Character: Driving techno bass - punchy and relentless
define_synthdef("bass_techno")
    .param("freq", 50.0) // units: Hz, range: 20..20000, default: 50.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.002, 1.0, 0.08)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.002, 0.15)
            .build();

        // Aggressive saw
        let osc = saw_ar(freq) * 0.5;
        let sub = sin_osc_ar(freq) * 0.4;

        let mix = osc + sub;

        // Punchy filter
        let cutoff = 300.0 + filt_env * 2000.0;
        rlpf_ar(mix, cutoff, 0.35) * env * amp
    });

//
// # Usage: bass_techno
//
// ```rhai
// import "stdlib/bass/genre/bass_techno.vibe" as bass_techno;
//
// let doc_bass_techno = voice("doc_bass_techno")
//     .synth("bass_techno")
//     .set_param("freq", 50.0)
//     .set_param("amp", 0.9)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_techno.output("out").to_main();
// doc_bass_techno.run();
// ```
