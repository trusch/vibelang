//     .set_param("freq", 110.0)
//     .set_param("wobble_rate", 4.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_wobble_classic.output("out").to_main();
// doc_wobble_classic.run();
// ```
