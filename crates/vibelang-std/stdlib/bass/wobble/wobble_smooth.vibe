// Genre: Melodic Dubstep, Chillstep | Character: Smooth, liquid wobble
define_synthdef("wobble_smooth", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("wobble_rate", 2.0) // units: Hz, range: 0..100, default: 2.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, wobble_rate, amp, gate| {

            // Smooth envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Saw oscillator
            let osc = saw_ar(freq);

            // Slow, smooth wobble
            let wobble_lfo = sin_osc_ar(wobble_rate) * 0.5 + 0.5;
            let mod_cutoff = 400.0 + (wobble_lfo * 1800.0);

            // Less resonance for smoothness
            let filtered = rlpf_ar(osc, mod_cutoff, 0.4);

            filtered * env * amp
        })
});

//
// # Usage: wobble_smooth
//
// ```rhai
// import "stdlib/bass/wobble/wobble_smooth.vibe" as wobble_smooth;
//
// let doc_wobble_smooth = voice("doc_wobble_smooth")
//     .synth("wobble_smooth")
//     .set_param("freq", 110.0)
//     .set_param("wobble_rate", 2.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_wobble_smooth.output("out").to_main();
// doc_wobble_smooth.run();
// ```
