// Genre: Deep Dubstep, 140 | Character: Deep, sub-heavy wobble
define_synthdef("wobble_deep", |builder| {
    builder
        .param("freq", 75.0) // units: Hz, range: 20..20000, default: 75.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("wobble_rate", 2.5) // units: Hz, range: 0..100, default: 2.5. Clock or modulation rate in Hz; higher values make motion faster.
        .param("amp", 0.65) // units: linear, range: 0..1, default: 0.65. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, wobble_rate, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.015, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Saw plus sub
            let saw = saw_ar(freq) * 0.6;
            let sub = sin_osc_ar(freq * 0.5) * 0.4;
            let mix = saw + sub;

            // Slow, deep wobble
            let wobble_lfo = sin_osc_ar(wobble_rate) * 0.5 + 0.5;
            let mod_cutoff = 150.0 + (wobble_lfo * 1200.0);

            // Moderate resonance
            let filtered = rlpf_ar(mix, mod_cutoff, 0.25);

            filtered * env * amp
        })
});

//
// # Usage: wobble_deep
//
// ```rhai
// import "stdlib/bass/wobble/wobble_deep.vibe" as wobble_deep;
//
// let doc_wobble_deep = voice("doc_wobble_deep")
//     .synth("wobble_deep")
//     .set_param("freq", 75.0)
//     .set_param("wobble_rate", 2.5)
//     .set_param("amp", 0.65)
//     .set_param("gate", 1.0)
//     ;
// doc_wobble_deep.output("out").to_main();
// doc_wobble_deep.run();
// ```
