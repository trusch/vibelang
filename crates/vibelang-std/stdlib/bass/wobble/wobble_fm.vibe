// Genre: Experimental Dubstep | Character: FM wobble with complex harmonics
define_synthdef("wobble_fm", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("wobble_rate", 5.0) // units: Hz, range: 0..100, default: 5.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, wobble_rate, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // FM synthesis for complex timbre
            let modulator = sin_osc_ar(freq * 1.5) * freq * 2.0;
            let carrier = saw_ar(freq + modulator);

            // Wobble LFO
            let wobble_lfo = sin_osc_ar(wobble_rate) * 0.5 + 0.5;
            let mod_cutoff = 250.0 + (wobble_lfo * 2800.0);

            // Filter with resonance
            let filtered = rlpf_ar(carrier, mod_cutoff, 0.15);

            filtered * env * amp
        })
});

//
// # Usage: wobble_fm
//
// ```rhai
// import "stdlib/bass/wobble/wobble_fm.vibe" as wobble_fm;
//
// let doc_wobble_fm = voice("doc_wobble_fm")
//     .synth("wobble_fm")
//     .set_param("freq", 110.0)
//     .set_param("wobble_rate", 5.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_wobble_fm.output("out").to_main();
// doc_wobble_fm.run();
// ```
