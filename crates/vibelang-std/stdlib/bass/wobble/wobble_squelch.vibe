// Genre: Dubstep, Riddim | Character: Squelchy, talking wobble
define_synthdef("wobble_squelch", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("wobble_rate", 8.0) // units: Hz, range: 0..100, default: 8.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, wobble_rate, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Pulse wave for different timbre
            let osc = saw_ar(freq);

            // Fast wobble with extreme modulation
            let wobble_lfo = sin_osc_ar(wobble_rate) * 0.5 + 0.5;
            let mod_cutoff = 100.0 + (wobble_lfo * 4000.0);

            // Very high resonance for squelch
            let filtered = rlpf_ar(osc, mod_cutoff, 0.05);

            filtered * env * amp
        })
});

//
// # Usage: wobble_squelch
//
// ```rhai
// import "stdlib/bass/wobble/wobble_squelch.vibe" as wobble_squelch;
//
// let doc_wobble_squelch = voice("doc_wobble_squelch")
//     .synth("wobble_squelch")
//     .set_param("freq", 110.0)
//     .set_param("wobble_rate", 8.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_wobble_squelch.output("out").to_main();
// doc_wobble_squelch.run();
// ```
