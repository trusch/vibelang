// Genre: Rock, Pop, R&B | Character: Fingerstyle electric bass
define_synthdef("bass_fingered")
    .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        // Natural envelope
        let env = envelope()
            .asr(0.008, 1.0, 0.3)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Warm body
        let body = sin_osc_ar(freq) * 0.5;
        let harm1 = sin_osc_ar(freq * 2.0) * 0.22;
        let harm2 = sin_osc_ar(freq * 3.0) * 0.1;

        // Finger attack
        let finger = envelope()
            .perc(0.001, 0.03)
            .build();
        let attack = bpf_ar(white_noise_ar(), 1800.0, 0.5) * finger * 0.18;

        let sig = body + harm1 + harm2 + attack;
        lpf_ar(sig, 3500.0) * env * amp
    });

//
// # Usage: bass_fingered
//
// ```rhai
// import "stdlib/bass/acoustic/bass_fingered.vibe" as bass_fingered;
//
// let doc_bass_fingered = voice("doc_bass_fingered")
//     .synth("bass_fingered")
//     .set_param("freq", 80.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_fingered.output("out").to_main();
// doc_bass_fingered.run();
// ```
