// Genre: Jazz, Fusion, R&B | Character: Fretless electric bass with smooth slides
define_synthdef("bass_fretless")
    .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        // Smooth envelope
        let env = envelope()
            .asr(0.02, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Subtle vibrato
        let vib = sin_osc_ar(5.0) * freq * 0.008;

        // Warm, mwah-y tone
        let body = sin_osc_ar(freq + vib) * 0.45;
        let harm1 = sin_osc_ar((freq + vib) * 2.0) * 0.28;
        let harm2 = sin_osc_ar((freq + vib) * 3.0) * 0.15;
        let harm3 = sin_osc_ar((freq + vib) * 4.0) * 0.08;

        // Mwah characteristic (filter sweep on attack)
        let mwah = envelope()
            .perc(0.01, 0.2)
            .build();
        let cutoff = 800.0 + mwah * 2000.0;

        let sig = body + harm1 + harm2 + harm3;
        lpf_ar(sig, cutoff) * env * amp
    });

//
// # Usage: bass_fretless
//
// ```rhai
// import "stdlib/bass/acoustic/bass_fretless.vibe" as bass_fretless;
//
// let doc_bass_fretless = voice("doc_bass_fretless")
//     .synth("bass_fretless")
//     .set_param("freq", 80.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_fretless.output("out").to_main();
// doc_bass_fretless.run();
// ```
