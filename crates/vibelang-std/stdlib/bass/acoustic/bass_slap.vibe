// Genre: Funk, Disco, R&B | Character: Slap bass with percussive attack
define_synthdef("bass_slap")
    .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Punchy envelope
        let amp_env = envelope()
            .perc(0.001, 0.35)
            .cleanup_on_finish()
            .build();

        // Body with harmonics
        let body = sin_osc_ar(freq) * 0.4;
        let harm1 = sin_osc_ar(freq * 2.0) * 0.25;
        let harm2 = sin_osc_ar(freq * 3.0) * 0.15;
        let harm3 = sin_osc_ar(freq * 4.0) * 0.1;

        // Slap transient - very prominent
        let slap_env = envelope()
            .perc(0.0001, 0.02)
            .build();
        let slap = bpf_ar(white_noise_ar(), 2500.0, 0.3) * slap_env * 0.5;

        // String pop
        let pop_env = envelope()
            .perc(0.0001, 0.008)
            .build();
        let pop = hpf_ar(white_noise_ar(), 4000.0) * pop_env * 0.3;

        let sig = body + harm1 + harm2 + harm3 + slap + pop;
        sig * amp_env * amp
    });

//
// # Usage: bass_slap
//
// ```rhai
// import "stdlib/bass/acoustic/bass_slap.vibe" as bass_slap;
//
// let doc_bass_slap = voice("doc_bass_slap")
//     .synth("bass_slap")
//     .set_param("freq", 80.0)
//     .set_param("amp", 0.9)
//     ;
// doc_bass_slap.output("out").to_main();
// doc_bass_slap.run();
// ```
