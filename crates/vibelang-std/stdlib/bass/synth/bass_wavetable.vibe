// Genre: Modern Electronic, EDM | Character: Wavetable-style bass with morphing character
define_synthdef("bass_wavetable")
    .param("freq", 60.0) // units: Hz, range: 20..20000, default: 60.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("morph", 0.5) // units: ratio, range: 0..1, default: 0.5. Morph macro; higher values move the model toward its brighter or more complex side.
    .body(|freq, amp, gate, morph| {
        let env = envelope()
            .asr(0.005, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Simulate wavetable morphing with crossfading waveforms
        let sine = sin_osc_ar(freq);
        let tri = lf_tri_ar(freq);
        let saw = saw_ar(freq);
        let pulse = pulse_ar(freq, 0.3);

        // Crossfade based on morph parameter
        let mix1 = sine * (1.0 - morph * 2.0).max(0.0);
        let mix2 = tri * (1.0 - (morph - 0.25).abs() * 4.0).max(0.0);
        let mix3 = saw * (1.0 - (morph - 0.5).abs() * 4.0).max(0.0);
        let mix4 = pulse * (1.0 - (morph - 0.75).abs() * 4.0).max(0.0);

        let mix = (mix1 + mix2 + mix3 + mix4) * 0.5;

        // Sub layer
        let sub = sin_osc_ar(freq * 0.5) * 0.3;

        // Filter
        let cutoff = 800.0 + morph * 2000.0;
        let filtered = lpf_ar(mix + sub, cutoff);

        filtered * env * amp
    });

//
// # Usage: bass_wavetable
//
// ```rhai
// import "stdlib/bass/synth/bass_wavetable.vibe" as bass_wavetable;
//
// let doc_bass_wavetable = voice("doc_bass_wavetable")
//     .synth("bass_wavetable")
//     .set_param("freq", 60.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     .set_param("morph", 0.5)
//     ;
// doc_bass_wavetable.output("out").to_main();
// doc_bass_wavetable.run();
// ```
