// Genre: 80s Pop, R&B, Electronic | Character: DX7 FM bass - punchy and clear
define_synthdef("bass_dx7")
    .param("freq", 60.0) // units: Hz, range: 20..20000, default: 60.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.08)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // FM index envelope
        let mod_env = envelope()
            .perc(0.001, 0.15)
            .build();

        // FM synthesis - carrier and modulator
        let mod_ratio = 1.0;
        let mod_index = 2.0 + mod_env * 5.0;
        let modulator = sin_osc_ar(freq * mod_ratio) * mod_index * freq;
        let carrier = sin_osc_ar(freq + modulator);

        // Second operator for more harmonics
        let mod2 = sin_osc_ar(freq * 2.0) * mod_env * freq * 0.5;
        let carrier2 = sin_osc_ar(freq + mod2) * 0.3;

        let sig = (carrier + carrier2) * 0.5;

        sig * env * amp
    });

//
// # Usage: bass_dx7
//
// ```rhai
// import "stdlib/bass/synth/bass_dx7.vibe" as bass_dx7;
//
// let doc_bass_dx7 = voice("doc_bass_dx7")
//     .synth("bass_dx7")
//     .set_param("freq", 60.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_dx7.output("out").to_main();
// doc_bass_dx7.run();
// ```
