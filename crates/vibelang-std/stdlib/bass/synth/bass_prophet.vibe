// Genre: Synth-pop, Electronic | Character: Prophet-5 style bass - punchy and rich
define_synthdef("bass_prophet")
    .param("freq", 60.0) // units: Hz, range: 20..20000, default: 60.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.005, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.005, 0.25)
            .build();

        // Two oscillators
        let osc1 = saw_ar(freq);
        let osc2 = pulse_ar(freq * 1.003, 0.4);

        let mix = (osc1 + osc2) * 0.4;

        // Punchy filter
        let cutoff = 500.0 + filt_env * 2000.0;
        let filtered = rlpf_ar(mix, cutoff, 0.25);

        filtered * env * amp
    });

//
// # Usage: bass_prophet
//
// ```rhai
// import "stdlib/bass/synth/bass_prophet.vibe" as bass_prophet;
//
// let doc_bass_prophet = voice("doc_bass_prophet")
//     .synth("bass_prophet")
//     .set_param("freq", 60.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_prophet.output("out").to_main();
// doc_bass_prophet.run();
// ```
