// Genre: House, Disco, Synthwave | Character: Roland Juno-style bass - warm and punchy
define_synthdef("bass_juno")
    .param("freq", 60.0) // units: Hz, range: 20..20000, default: 60.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.008, 1.0, 0.1)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.008, 0.2)
            .build();

        // PWM oscillator characteristic of Juno
        let pwm = sin_osc_ar(0.5) * 0.2 + 0.5;
        let osc = pulse_ar(freq, pwm);

        // Sub oscillator
        let sub = pulse_ar(freq * 0.5, 0.5) * 0.4;

        let mix = (osc + sub) * 0.45;

        // Warm filter
        let cutoff = 600.0 + filt_env * 1500.0;
        let filtered = rlpf_ar(mix, cutoff, 0.2);

        filtered * env * amp
    });

//
// # Usage: bass_juno
//
// ```rhai
// import "stdlib/bass/synth/bass_juno.vibe" as bass_juno;
//
// let doc_bass_juno = voice("doc_bass_juno")
//     .synth("bass_juno")
//     .set_param("freq", 60.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_juno.output("out").to_main();
// doc_bass_juno.run();
// ```
