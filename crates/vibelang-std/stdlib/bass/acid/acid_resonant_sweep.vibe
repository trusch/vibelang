// Genre: Acid Techno | Character: Extreme resonance sweep
define_synthdef("acid_resonant_sweep", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.004, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope with extended range
            let filter_env = envelope()
                .asr(0.006, 1.0, 0.1)
                .gate(gate)
                .build();

            // Sawtooth
            let osc = saw_ar(freq);

            // Extreme resonance sweep
            let mod_cutoff = 250.0 + (filter_env * 5000.0);
            let filtered = rlpf_ar(osc, mod_cutoff, 0.08);

            filtered * env * amp
        })
});

//
// # Usage: acid_resonant_sweep
//
// ```rhai
// import "stdlib/bass/acid/acid_resonant_sweep.vibe" as acid_resonant_sweep;
//
// let doc_acid_resonant_sweep = voice("doc_acid_resonant_sweep")
//     .synth("acid_resonant_sweep")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_resonant_sweep.output("out").to_main();
// doc_acid_resonant_sweep.run();
// ```
