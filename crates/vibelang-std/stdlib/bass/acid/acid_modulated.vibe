// Genre: Techno, Experimental | Character: Frequency modulated acid
define_synthdef("acid_modulated", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filter_env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .build();

            // Pitch modulation envelope
            let pitch_env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .build();
            let pitch_mod = pitch_env * freq * 0.5;

            // Modulated sawtooth
            let osc = saw_ar(freq + pitch_mod);

            // Filter sweep
            let mod_cutoff = 700.0 + (filter_env * 2200.0);
            let filtered = rlpf_ar(osc, mod_cutoff, 0.3);

            filtered * env * amp
        })
});

//
// # Usage: acid_modulated
//
// ```rhai
// import "stdlib/bass/acid/acid_modulated.vibe" as acid_modulated;
//
// let doc_acid_modulated = voice("doc_acid_modulated")
//     .synth("acid_modulated")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_modulated.output("out").to_main();
// doc_acid_modulated.run();
// ```
