// Genre: Minimal Techno | Character: Subtle, minimal filter movement
define_synthdef("acid_minimal", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Clean envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Gentle filter envelope
            let filter_env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .build();

            // Sawtooth
            let osc = saw_ar(freq);

            // Subtle filter movement
            let mod_cutoff = 800.0 + (filter_env * 1200.0);
            let filtered = rlpf_ar(osc, mod_cutoff, 0.5);

            filtered * env * amp
        })
});

//
// # Usage: acid_minimal
//
// ```rhai
// import "stdlib/bass/acid/acid_minimal.vibe" as acid_minimal;
//
// let doc_acid_minimal = voice("doc_acid_minimal")
//     .synth("acid_minimal")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_minimal.output("out").to_main();
// doc_acid_minimal.run();
// ```
