// Genre: Industrial, Hard Techno | Character: Distorted, aggressive acid
define_synthdef("acid_distorted", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filter_env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .build();

            // Sawtooth with extra gain
            let osc = saw_ar(freq) * 2.5;

            // Clip for distortion
            let distorted = clip(osc, -0.9, 0.9);

            // Resonant filter
            let mod_cutoff = 600.0 + (filter_env * 2000.0);
            let filtered = rlpf_ar(distorted, mod_cutoff, 0.2);

            filtered * env * amp * 0.5
        })
});

//
// # Usage: acid_distorted
//
// ```rhai
// import "stdlib/bass/acid/acid_distorted.vibe" as acid_distorted;
//
// let doc_acid_distorted = voice("doc_acid_distorted")
//     .synth("acid_distorted")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_distorted.output("out").to_main();
// doc_acid_distorted.run();
// ```
