// Genre: Acid Techno | Character: Square wave with resonant filter
define_synthdef("acid_filtered_square", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.006, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filter_env = envelope()
                .asr(0.012, 1.0, 0.1)
                .gate(gate)
                .build();

            // Square wave (pulse with 0.5 width)
            let osc = saw_ar(freq);

            // Filter sweep
            let mod_cutoff = 600.0 + (filter_env * 2000.0);
            let filtered = rlpf_ar(osc, mod_cutoff, 0.35);

            filtered * env * amp
        })
});

//
// # Usage: acid_filtered_square
//
// ```rhai
// import "stdlib/bass/acid/acid_filtered_square.vibe" as acid_filtered_square;
//
// let doc_acid_filtered_square = voice("doc_acid_filtered_square")
//     .synth("acid_filtered_square")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_filtered_square.output("out").to_main();
// doc_acid_filtered_square.run();
// ```
