// Genre: Acid House, Techno | Character: Detuned oscillators for thickness
define_synthdef("acid_detuned", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Filter envelope
            let filter_env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .build();

            // Detuned sawtooths
            let osc1 = saw_ar(freq * 0.997);
            let osc2 = saw_ar(freq * 1.003);
            let mix = (osc1 + osc2) * 0.5;

            // Filter sweep
            let mod_cutoff = 900.0 + (filter_env * 2500.0);
            let filtered = rlpf_ar(mix, mod_cutoff, 0.4);

            filtered * env * amp
        })
});

//
// # Usage: acid_detuned
//
// ```rhai
// import "stdlib/bass/acid/acid_detuned.vibe" as acid_detuned;
//
// let doc_acid_detuned = voice("doc_acid_detuned")
//     .synth("acid_detuned")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_detuned.output("out").to_main();
// doc_acid_detuned.run();
// ```
