// Genre: Hard Acid, Industrial | Character: Aggressive, fast sweep
define_synthdef("acid_aggressive", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Sharp envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Fast, aggressive filter sweep
            let filter_env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .build();

            // Sawtooth
            let osc = saw_ar(freq);

            // Wide, fast sweep with high resonance
            let mod_cutoff = 300.0 + (filter_env * 4000.0);
            let filtered = rlpf_ar(osc, mod_cutoff, 0.1);

            filtered * env * amp
        })
});

//
// # Usage: acid_aggressive
//
// ```rhai
// import "stdlib/bass/acid/acid_aggressive.vibe" as acid_aggressive;
//
// let doc_acid_aggressive = voice("doc_acid_aggressive")
//     .synth("acid_aggressive")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.6)
//     .set_param("gate", 1.0)
//     ;
// doc_acid_aggressive.output("out").to_main();
// doc_acid_aggressive.run();
// ```
