// Genre: Neurofunk, Techno | Character: Aggressive FM bass with high modulation
define_synthdef("fm_bass_aggressive", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("fm_amount", 5.0) // units: ratio, range: 0..10, default: 5.0. FM modulation depth; higher values add stronger sidebands and brightness.
        .param("amp", 0.65) // units: linear, range: 0..1, default: 0.65. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, fm_amount, amp, gate| {

            // Punchy envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Aggressive FM envelope
            let fm_env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .build();

            // High FM amount for aggression
            let modulator = sin_osc_ar(freq * 2.0) * fm_env * freq * fm_amount;
            let carrier = sin_osc_ar(freq + modulator);

            // Clip for extra aggression
            let driven = clip(carrier, -0.9, 0.9);

            driven * env * amp
        })
});

//
// # Usage: fm_bass_aggressive
//
// ```rhai
// import "stdlib/bass/fm/fm_bass_aggressive.vibe" as fm_bass_aggressive;
//
// let doc_fm_bass_aggressive = voice("doc_fm_bass_aggressive")
//     .synth("fm_bass_aggressive")
//     .set_param("freq", 110.0)
//     .set_param("fm_amount", 5.0)
//     .set_param("amp", 0.65)
//     .set_param("gate", 1.0)
//     ;
// doc_fm_bass_aggressive.output("out").to_main();
// doc_fm_bass_aggressive.run();
// ```
