// Genre: IDM, Experimental | Character: Metallic, inharmonic FM bass
define_synthdef("fm_bass_metallic", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("fm_amount", 4.0) // units: ratio, range: 0..10, default: 4.0. FM modulation depth; higher values add stronger sidebands and brightness.
        .param("amp", 0.65) // units: linear, range: 0..1, default: 0.65. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, fm_amount, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // FM envelope
            let fm_env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .build();

            // Inharmonic ratio for metallic character
            let modulator = sin_osc_ar(freq * 2.3) * fm_env * freq * fm_amount;
            let carrier = sin_osc_ar(freq + modulator);

            carrier * env * amp
        })
});

//
// # Usage: fm_bass_metallic
//
// ```rhai
// import "stdlib/bass/fm/fm_bass_metallic.vibe" as fm_bass_metallic;
//
// let doc_fm_bass_metallic = voice("doc_fm_bass_metallic")
//     .synth("fm_bass_metallic")
//     .set_param("freq", 110.0)
//     .set_param("fm_amount", 4.0)
//     .set_param("amp", 0.65)
//     .set_param("gate", 1.0)
//     ;
// doc_fm_bass_metallic.output("out").to_main();
// doc_fm_bass_metallic.run();
// ```
