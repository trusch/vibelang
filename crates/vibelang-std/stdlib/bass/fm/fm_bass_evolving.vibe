// Genre: Techno, Experimental | Character: Evolving FM bass with changing timbre
define_synthdef("fm_bass_evolving", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("fm_amount", 3.5) // units: ratio, range: 0..10, default: 3.5. FM modulation depth; higher values add stronger sidebands and brightness.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, fm_amount, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.012, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Long FM envelope for evolution
            let fm_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();

            // FM synthesis
            let modulator = sin_osc_ar(freq * 1.7) * fm_env * freq * fm_amount;
            let carrier = sin_osc_ar(freq + modulator);

            // Filter envelope for additional movement
            let filter_env = envelope()
                .asr(0.08, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 400.0 + (filter_env * 1800.0);

            let filtered = lpf_ar(carrier, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: fm_bass_evolving
//
// ```rhai
// import "stdlib/bass/fm/fm_bass_evolving.vibe" as fm_bass_evolving;
//
// let doc_fm_bass_evolving = voice("doc_fm_bass_evolving")
//     .synth("fm_bass_evolving")
//     .set_param("freq", 110.0)
//     .set_param("fm_amount", 3.5)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_fm_bass_evolving.output("out").to_main();
// doc_fm_bass_evolving.run();
// ```
