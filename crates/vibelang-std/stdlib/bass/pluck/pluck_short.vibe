// Genre: House, Techno | Character: Short, tight pluck bass
define_synthdef("bass_pluck_short", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Very short envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sawtooth for brightness
            let osc = saw_ar(freq);

            // Quick filter envelope
            let filter_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 800.0 + (filter_env * 2000.0);

            let filtered = lpf_ar(osc, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: bass_pluck_short
//
// ```rhai
// import "stdlib/bass/pluck/pluck_short.vibe" as pluck_short;
//
// let doc_bass_pluck_short = voice("doc_bass_pluck_short")
//     .synth("bass_pluck_short")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_pluck_short.output("out").to_main();
// doc_bass_pluck_short.run();
// ```
