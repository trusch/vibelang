// Genre: Techno, Minimal | Character: Dark, muted pluck
define_synthdef("pluck_dark", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Medium envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sine for darker character
            let osc = sin_osc_ar(freq);
            let harmonic = sin_osc_ar(freq * 2.0) * 0.2;
            let mix = osc + harmonic;

            // Low filter for darkness
            let filter_env = envelope()
                .asr(0.003, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 300.0 + (filter_env * 800.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: pluck_dark
//
// ```rhai
// import "stdlib/bass/pluck/pluck_dark.vibe" as pluck_dark;
//
// let doc_pluck_dark = voice("doc_pluck_dark")
//     .synth("pluck_dark")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_pluck_dark.output("out").to_main();
// doc_pluck_dark.run();
// ```
