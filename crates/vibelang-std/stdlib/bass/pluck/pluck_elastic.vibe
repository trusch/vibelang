// Genre: Electro, Experimental | Character: Elastic, bouncy pluck
define_synthdef("pluck_elastic", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Bouncy envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Pitch envelope for elastic character
            let pitch_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let pitch_mod = pitch_env * freq * 0.8;

            // Sawtooth with pitch bend
            let osc = saw_ar(freq + pitch_mod);

            // Filter sweep
            let filter_env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 700.0 + (filter_env * 1800.0);

            let filtered = lpf_ar(osc, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: pluck_elastic
//
// ```rhai
// import "stdlib/bass/pluck/pluck_elastic.vibe" as pluck_elastic;
//
// let doc_pluck_elastic = voice("doc_pluck_elastic")
//     .synth("pluck_elastic")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_pluck_elastic.output("out").to_main();
// doc_pluck_elastic.run();
// ```
