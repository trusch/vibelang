// Genre: Lo-fi, Jazz | Character: Muted, soft pluck
define_synthdef("bass_pluck_muted", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Soft envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.005, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sine and triangle mix
            let sine = sin_osc_ar(freq) * 0.7;
            let triangle = (sin_osc_ar(freq) + sin_osc_ar(freq * 3.0) * 0.111) * 0.3;
            let mix = sine + triangle;

            // Very low filter
            let filtered = lpf_ar(mix, 500.0);

            filtered * env * amp
        })
});

//
// # Usage: bass_pluck_muted
//
// ```rhai
// import "stdlib/bass/pluck/pluck_muted.vibe" as pluck_muted;
//
// let doc_bass_pluck_muted = voice("doc_bass_pluck_muted")
//     .synth("bass_pluck_muted")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_pluck_muted.output("out").to_main();
// doc_bass_pluck_muted.run();
// ```
