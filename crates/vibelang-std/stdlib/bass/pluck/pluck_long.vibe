// Genre: Dubstep, Bass Music | Character: Longer pluck with sustain
define_synthdef("bass_pluck_long", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Medium decay
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Saw and pulse mix
            let saw = saw_ar(freq) * 0.6;
            let pulse = saw_ar(freq) * 0.4;
            let mix = saw + pulse;

            // Filter envelope
            let filter_env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 600.0 + (filter_env * 1800.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: bass_pluck_long
//
// ```rhai
// import "stdlib/bass/pluck/pluck_long.vibe" as pluck_long;
//
// let doc_bass_pluck_long = voice("doc_bass_pluck_long")
//     .synth("bass_pluck_long")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_pluck_long.output("out").to_main();
// doc_bass_pluck_long.run();
// ```
