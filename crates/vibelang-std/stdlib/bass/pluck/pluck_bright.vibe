// Genre: House, Funk | Character: Bright, cutting pluck
define_synthdef("bass_pluck_bright", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Quick envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sawtooth with harmonics
            let osc = saw_ar(freq);

            // Wide filter sweep for brightness
            let filter_env = envelope()
                .asr(0.001, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 1500.0 + (filter_env * 3500.0);

            let filtered = lpf_ar(osc, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: bass_pluck_bright
//
// ```rhai
// import "stdlib/bass/pluck/pluck_bright.vibe" as pluck_bright;
//
// let doc_bass_pluck_bright = voice("doc_bass_pluck_bright")
//     .synth("bass_pluck_bright")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_pluck_bright.output("out").to_main();
// doc_bass_pluck_bright.run();
// ```
