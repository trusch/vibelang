// Genre: Funk, Disco | Character: Funky, percussive pluck
define_synthdef("pluck_funky", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.75) // units: linear, range: 0..1, default: 0.75. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {
            // Use gate parameter to control note duration
            let env = envelope()
                .adsr(0.001, 0.05, 0.7, 0.15)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sawtooth wave for funk character (pulse_ar not available)
            let osc = saw_ar(freq);

            // Snappy filter sweep
            let filter_env = envelope()
                .perc(0.001, 0.08)
                .build();
            let mod_cutoff = 800.0 + (filter_env * 2000.0);

            let filtered = lpf_ar(osc, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: pluck_funky
//
// ```rhai
// import "stdlib/bass/pluck/pluck_funky.vibe" as pluck_funky;
//
// let doc_pluck_funky = voice("doc_pluck_funky")
//     .synth("pluck_funky")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.75)
//     .set_param("gate", 1.0)
//     ;
// doc_pluck_funky.output("out").to_main();
// doc_pluck_funky.run();
// ```
