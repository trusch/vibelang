// Genre: Ambient, Experimental | Character: Bell-like pluck bass
define_synthdef("bass_pluck_bell", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Medium-long envelope for bell character
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.002, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Inharmonic frequencies for bell timbre
            let osc1 = sin_osc_ar(freq) * 0.5;
            let osc2 = sin_osc_ar(freq * 2.3) * 0.25;
            let osc3 = sin_osc_ar(freq * 3.7) * 0.15;
            let osc4 = sin_osc_ar(freq * 5.1) * 0.1;

            let mix = osc1 + osc2 + osc3 + osc4;

            // Gentle filter
            let filtered = lpf_ar(mix, 2500.0);

            filtered * env * amp
        })
});

//
// # Usage: bass_pluck_bell
//
// ```rhai
// import "stdlib/bass/pluck/pluck_bell.vibe" as pluck_bell;
//
// let doc_bass_pluck_bell = voice("doc_bass_pluck_bell")
//     .synth("bass_pluck_bell")
//     .set_param("freq", 110.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_bass_pluck_bell.output("out").to_main();
// doc_bass_pluck_bell.run();
// ```
