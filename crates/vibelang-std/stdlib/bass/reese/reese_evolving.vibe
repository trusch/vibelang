// Genre: Drum & Bass | Character: Evolving Reese with phase movement
define_synthdef("reese_evolving", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Long envelope for evolution
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.015, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Wide detuning for movement
            let saw1 = saw_ar(freq * 0.982);
            let saw2 = saw_ar(freq * 0.991);
            let saw3 = saw_ar(freq);
            let saw4 = saw_ar(freq * 1.009);
            let saw5 = saw_ar(freq * 1.018);

            let mix = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.2;

            // Evolving filter with resonance
            let filter_env = envelope()
                .asr(0.04, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 350.0 + (filter_env * 1800.0);

            let filtered = rlpf_ar(mix, mod_cutoff, 0.5);

            filtered * env * amp
        })
});

//
// # Usage: reese_evolving
//
// ```rhai
// import "stdlib/bass/reese/reese_evolving.vibe" as reese_evolving;
//
