// Genre: Liquid DnB, Ambient DnB | Character: Smooth, rolling Reese
define_synthdef("reese_smooth", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Smooth envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.02, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Subtle detuning for smoothness
            let saw1 = saw_ar(freq * 0.992);
            let saw2 = saw_ar(freq * 0.996);
            let saw3 = saw_ar(freq);
            let saw4 = saw_ar(freq * 1.004);
            let saw5 = saw_ar(freq * 1.008);

            let mix = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.2;

            // Gentle filter sweep
            let filter_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 500.0 + (filter_env * 1500.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: reese_smooth
//
// ```rhai
// import "stdlib/bass/reese/reese_smooth.vibe" as reese_smooth;
//
// let doc_reese_smooth = voice("doc_reese_smooth")
//     .synth("reese_smooth")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_reese_smooth.output("out").to_main();
// doc_reese_smooth.run();
// ```
