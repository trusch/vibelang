// Genre: Neurofunk, Techstep | Character: Aggressive, gritty Reese
define_synthdef("reese_aggressive", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.65) // units: linear, range: 0..1, default: 0.65. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Punchy envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Wide detuning for aggression
            let saw1 = saw_ar(freq * 0.975);
            let saw2 = saw_ar(freq * 0.988);
            let saw3 = saw_ar(freq);
            let saw4 = saw_ar(freq * 1.012);
            let saw5 = saw_ar(freq * 1.025);

            let mix = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.25;

            // Clip for distortion
            let driven = clip(mix, -0.85, 0.85);

            // Aggressive filter
            let filter_env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 500.0 + (filter_env * 2000.0);

            let filtered = rlpf_ar(driven, mod_cutoff, 0.3);

            filtered * env * amp
        })
});

//
// # Usage: reese_aggressive
//
// ```rhai
// import "stdlib/bass/reese/reese_aggressive.vibe" as reese_aggressive;
//
// let doc_reese_aggressive = voice("doc_reese_aggressive")
//     .synth("reese_aggressive")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.65)
//     .set_param("gate", 1.0)
//     ;
// doc_reese_aggressive.output("out").to_main();
// doc_reese_aggressive.run();
// ```
