// Genre: Drum & Bass, Dubstep | Character: Deep, sub-heavy Reese
define_synthdef("reese_deep", |builder| {
    builder
        .param("freq", 45.0) // units: Hz, range: 20..20000, default: 45.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.015, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Detuned saws
            let saw1 = saw_ar(freq * 0.980);
            let saw2 = saw_ar(freq * 0.990);
            let saw3 = saw_ar(freq);
            let saw4 = saw_ar(freq * 1.010);
            let saw5 = saw_ar(freq * 1.020);

            // Add sub octave for depth
            let sub = sin_osc_ar(freq * 0.5) * 0.4;

            let mix = (saw1 + saw2 + saw3 + saw4 + saw5) * 0.16 + sub;

            // Dark filtering
            let filter_env = envelope()
                .asr(0.03, 1.0, 0.1)
                .gate(gate)
                .build();
            let mod_cutoff = 300.0 + (filter_env * 900.0);

            let filtered = lpf_ar(mix, mod_cutoff);

            filtered * env * amp
        })
});

//
// # Usage: reese_deep
//
// ```rhai
// import "stdlib/bass/reese/reese_deep.vibe" as reese_deep;
//
// let doc_reese_deep = voice("doc_reese_deep")
//     .synth("reese_deep")
//     .set_param("freq", 45.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
