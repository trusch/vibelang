// Genre: Techno, House | Character: Sub with rich harmonic series
define_synthdef("sub_harmonic", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Build harmonic series
            let fundamental = sin_osc_ar(freq);
            let harmonic2 = sin_osc_ar(freq * 2.0) * 0.25;
            let harmonic3 = sin_osc_ar(freq * 3.0) * 0.15;
            let harmonic4 = sin_osc_ar(freq * 4.0) * 0.1;
            let harmonic5 = sin_osc_ar(freq * 5.0) * 0.05;

            let sig = fundamental + harmonic2 + harmonic3 + harmonic4 + harmonic5;

            // Filter to control brightness
            let filtered = lpf_ar(sig, 400.0);

            filtered * env * amp * 0.7
        })
});

//
// # Usage: sub_harmonic
//
// ```rhai
// import "stdlib/bass/sub/sub_harmonic.vibe" as sub_harmonic;
//
// let doc_sub_harmonic = voice("doc_sub_harmonic")
//     .synth("sub_harmonic")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_sub_harmonic.output("out").to_main();
// doc_sub_harmonic.run();
// ```
