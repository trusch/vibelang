// Genre: Ambient, Experimental | Character: Wide stereo sub with slight detuning
define_synthdef("sub_stereo", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.015, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Slightly detuned sines for width
            let left = sin_osc_ar(freq * 0.998);
            let right = sin_osc_ar(freq * 1.002);

            // Mix for stereo width (using left + right creates subtle movement)
            let sig = left + right;

            sig * env * amp * 0.7
        })
});

//
// # Usage: sub_stereo
//
// ```rhai
// import "stdlib/bass/sub/sub_stereo.vibe" as sub_stereo;
//
// let doc_sub_stereo = voice("doc_sub_stereo")
//     .synth("sub_stereo")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_sub_stereo.output("out").to_main();
// doc_sub_stereo.run();
// ```
