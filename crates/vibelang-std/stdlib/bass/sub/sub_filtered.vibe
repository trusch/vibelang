// Genre: House, Techno | Character: Filtered sine with slight movement
define_synthdef("sub_filtered", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("cutoff", 300.0) // units: Hz, range: 20..20000, default: 300.0. Filter cutoff or tone point; higher keeps more high-frequency brightness.
        .body(|freq, amp, gate, cutoff| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.008, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Sine with slight harmonic content
            let sig = sin_osc_ar(freq);
            let harmonic = sin_osc_ar(freq * 2.0) * 0.15;
            let mix = sig + harmonic;

            // Gentle low-pass filter
            let filtered = lpf_ar(mix, cutoff);

            filtered * env * amp
        })
});

//
// # Usage: sub_filtered
//
// ```rhai
// import "stdlib/bass/sub/sub_filtered.vibe" as sub_filtered;
//
// let doc_sub_filtered = voice("doc_sub_filtered")
//     .synth("sub_filtered")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     .set_param("cutoff", 300.0)
//     ;
// doc_sub_filtered.output("out").to_main();
// doc_sub_filtered.run();
// ```
