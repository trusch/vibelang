// Genre: Dubstep, Drum & Bass | Character: Layered octaves for massive sub
define_synthdef("sub_octave", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Fundamental
            let fundamental = sin_osc_ar(freq);

            // Octave down for extra depth
            let sub = sin_osc_ar(freq * 0.5) * 0.6;

            // Octave up for harmonics
            let harmonic = sin_osc_ar(freq * 2.0) * 0.2;

            let sig = fundamental + sub + harmonic;

            sig * env * amp * 0.7
        })
});

//
// # Usage: sub_octave
//
// ```rhai
// import "stdlib/bass/sub/sub_octave.vibe" as sub_octave;
//
// let doc_sub_octave = voice("doc_sub_octave")
//     .synth("sub_octave")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.7)
//     .set_param("gate", 1.0)
//     ;
// doc_sub_octave.output("out").to_main();
// doc_sub_octave.run();
// ```
