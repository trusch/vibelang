// Genre: Techno, Minimal | Character: Phase-modulated sub with movement
define_synthdef("sub_modulated", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Modulator for subtle phase modulation
            let mod_env = envelope()
                .asr(0.05, 1.0, 0.1)
                .gate(gate)
                .build();
            let modulator = sin_osc_ar(freq * 0.5) * mod_env * 0.3;

            // Carrier with modulation
            let carrier = sin_osc_ar(freq + modulator);

            carrier * env * amp
        })
});

//
// # Usage: sub_modulated
//
// ```rhai
// import "stdlib/bass/sub/sub_modulated.vibe" as sub_modulated;
//
// let doc_sub_modulated = voice("doc_sub_modulated")
//     .synth("sub_modulated")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_sub_modulated.output("out").to_main();
// doc_sub_modulated.run();
// ```
