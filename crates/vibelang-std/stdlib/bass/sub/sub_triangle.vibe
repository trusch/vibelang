// Genre: House, Techno | Character: Triangle wave sub with odd harmonics
define_synthdef("sub_triangle", |builder| {
    builder
        .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.8) // units: linear, range: 0..1, default: 0.8. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .body(|freq, amp, gate| {

            // Smooth envelope
            // Gate-controlled ASR envelope for proper note-on/note-off behavior
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Approximate triangle with sine and harmonics
            let fundamental = sin_osc_ar(freq);
            let harmonic3 = sin_osc_ar(freq * 3.0) * 0.111;
            let harmonic5 = sin_osc_ar(freq * 5.0) * 0.04;

            let sig = fundamental + harmonic3 + harmonic5;

            sig * env * amp * 0.8
        })
});

//
// # Usage: sub_triangle
//
// ```rhai
// import "stdlib/bass/sub/sub_triangle.vibe" as sub_triangle;
//
// let doc_sub_triangle = voice("doc_sub_triangle")
//     .synth("sub_triangle")
//     .set_param("freq", 55.0)
//     .set_param("amp", 0.8)
//     .set_param("gate", 1.0)
//     ;
// doc_sub_triangle.output("out").to_main();
// doc_sub_triangle.run();
// ```
