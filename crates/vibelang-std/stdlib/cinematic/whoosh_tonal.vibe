// Genre: Sound Design, Trailer | Character: Tonal whoosh/flyby
define_synthdef("whoosh_tonal")
    .param("freq", 200.0) // units: Hz, range: 20..20000, default: 200.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .param("length", 0.5) // units: seconds, range: 0..30, default: 0.5. Step count or loop length; higher values increase quantization or memory resolution.
    .body(|freq, amp, length| {
        // Whoosh envelope
        let amp_env = envelope()
            .perc(0.3, 0.7)
            .time_scale(length)
            .cleanup_on_finish()
            .build();

        // Pitch sweep
        let pitch_env = envelope()
            .perc(0.01, 1.0)
            .time_scale(length)
            .build();
        let sweep_freq = freq * 0.5 + pitch_env * freq * 2.0;

        // Tonal component
        let tone = sin_osc_ar(sweep_freq) * 0.4;

        // Noise whoosh
        let noise = bpf_ar(white_noise_ar(), sweep_freq * 2.0, 0.3) * 0.5;

        (tone + noise) * amp_env * amp
    });

//
// # Usage: `whoosh_tonal`
//
// ```rhai
// import "stdlib/cinematic/whoosh_tonal.vibe" as whoosh_tonal;
//
// let whoosh_tonal = voice("doc_whoosh_tonal")
//     .synth("whoosh_tonal")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("length", 0.5);
// whoosh_tonal.output("out").to_main();
// whoosh_tonal.run();
// ```
