// Genre: Horror, Thriller | Character: Tension drone
define_synthdef("drone_tension")
    .param("freq", 55.0) // units: Hz, range: 20..20000, default: 55.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(1.0, 1.0, 1.0)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Slow, unsettling modulation
        let mod1 = sin_osc_ar(0.1) * freq * 0.02;
        let mod2 = sin_osc_ar(0.07) * freq * 0.015;

        // Dissonant tones
        let tone1 = sin_osc_ar(freq + mod1) * 0.3;
        let tone2 = sin_osc_ar(freq * 1.05 + mod2) * 0.2;
        let tone3 = sin_osc_ar(freq * 0.98) * 0.25;

        // Rumble
        let rumble = lpf_ar(pink_noise_ar(), 80.0) * 0.15;

        let sig = tone1 + tone2 + tone3 + rumble;

        lpf_ar(sig, 800.0) * env * amp
    });

//
// # Usage: `drone_tension`
//
// ```rhai
// import "stdlib/cinematic/drone_tension.vibe" as drone_tension;
//
// let drone_tension = voice("doc_drone_tension")
//     .synth("drone_tension")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// drone_tension.output("out").to_main();
// drone_tension.run();
// ```
