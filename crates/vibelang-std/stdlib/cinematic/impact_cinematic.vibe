// Genre: Trailer, Film | Character: Massive cinematic impact hit
define_synthdef("impact_cinematic")
    .param("freq", 40.0) // units: Hz, range: 20..20000, default: 40.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 1.0) // units: linear, range: 0..1, default: 1.0. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Impact envelope
        let amp_env = envelope()
            .perc(0.001, 1.5)
            .cleanup_on_finish()
            .build();

        // Pitch drop
        let pitch_env = envelope()
            .perc(0.001, 0.2)
            .build();
        let freq_mod = pitch_env * freq * 3.0;

        // Sub impact
        let sub = sin_osc_ar(freq + freq_mod) * 0.6;

        // Noise burst
        let noise_env = envelope()
            .perc(0.001, 0.3)
            .build();
        let noise = lpf_ar(white_noise_ar(), 500.0) * noise_env * 0.4;

        // Metallic ring
        let ring = sin_osc_ar(freq * 4.0) * 0.15;

        (sub + noise + ring) * amp_env * amp
    });

//
// # Usage: `impact_cinematic`
//
// ```rhai
// import "stdlib/cinematic/impact_cinematic.vibe" as impact_cinematic;
//
// let impact_cinematic = voice("doc_impact_cinematic")
//     .synth("impact_cinematic")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// impact_cinematic.output("out").to_main();
// impact_cinematic.run();
// ```
