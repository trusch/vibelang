// Vocal Chop Synth
// Genre: EDM, Future Bass | Character: Stuttery, choppy vocal
//
// Creates short, stuttery vocal-like sounds.
// Perfect for vocal chop style leads.

define_synthdef("vocal_chop", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("vowel", 0.5) // units: normalized, range: 0..1, default: 0.5. Vowel/formant position; higher values move the resonant vowels forward.
        .body(|freq, amp, gate, vowel| {
            // Short percussive envelope for chops
            let env = envelope()
                .asr(0.01, 1.0, 0.1)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Bright harmonically rich source
            let saw = saw_ar(freq);
            let pulse = saw_ar(freq * 1.001);
            let source = (saw + pulse) * 0.5;

            // Vowel formants (simplified)
            let f1 = 300.0 + vowel * 500.0;
            let f2 = 900.0 + (1.0 - vowel) * 700.0;

            let formant1 = rlpf_ar(source, f1, 0.12);
            let formant2 = rlpf_ar(source, f2, 0.1) * 0.6;

            let vocal = formant1 + formant2;

            // Slight pitch envelope for attack character
            let pitch_env = envelope()
                .perc(0.001, 0.05)
                .build();
            let pitched = sin_osc_ar(freq * (1.0 + pitch_env * 0.05)) * 0.1;

            (vocal + pitched) * env * amp
        })
});

//
// # Usage: `vocal_chop`
//
// ```rhai
// import "stdlib/vocals/vocal_chop.vibe" as vocal_chop;
//
// let vocal_chop = voice("doc_vocal_chop")
//     .synth("vocal_chop")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("vowel", 0.5);
// vocal_chop.output("out").to_main();
// vocal_chop.run();
// ```
