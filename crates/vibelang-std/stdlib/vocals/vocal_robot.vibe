// Genre: Electronic, Experimental | Character: Robot voice effect
define_synthdef("vocal_robot")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.001, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Metallic carrier
        let carrier = pulse_ar(freq, 0.5) * 0.3;

        // Ring modulation for robot effect
        let ring_freq = 200.0;
        let ring = carrier * sin_osc_ar(ring_freq);

        // Formant-like filtering
        let f1 = bpf_ar(ring, 800.0, 0.2) * 0.5;
        let f2 = bpf_ar(ring, 2000.0, 0.25) * 0.35;

        let sig = f1 + f2;

        sig * env * amp
    });

//
// # Usage: `vocal_robot`
//
// ```rhai
// import "stdlib/vocals/vocal_robot.vibe" as vocal_robot;
//
// let vocal_robot = voice("doc_vocal_robot")
//     .synth("vocal_robot")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// vocal_robot.output("out").to_main();
// vocal_robot.run();
// ```
