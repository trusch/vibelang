// Genre: Ambient, Cinematic | Character: "Aaah" choir voice
define_synthdef("vocal_aaah")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.2, 1.0, 0.25)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.5) * freq * 0.008;

        // Vocal source
        let source = saw_ar(freq + vib) * 0.4;

        // "Aaah" formants
        let f1 = bpf_ar(source, 700.0, 0.12) * 0.5;
        let f2 = bpf_ar(source, 1200.0, 0.15) * 0.3;
        let f3 = bpf_ar(source, 2500.0, 0.2) * 0.15;

        let sig = f1 + f2 + f3;

        sig * env * amp
    });

//
// # Usage: `vocal_aaah`
//
// ```rhai
// import "stdlib/vocals/vocal_aaah.vibe" as vocal_aaah;
//
// let vocal_aaah = voice("doc_vocal_aaah")
//     .synth("vocal_aaah")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// vocal_aaah.output("out").to_main();
// vocal_aaah.run();
// ```
