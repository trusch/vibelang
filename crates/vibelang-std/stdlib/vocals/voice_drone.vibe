// Voice Drone
// Genre: Ambient, Dark | Character: Haunting vocal drone
//
// Dark, evolving voice-like drone with slow modulation.

define_synthdef("voice_drone", |builder| {
    builder
        .param("freq", 110.0) // units: Hz, range: 20..20000, default: 110.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("darkness", 0.5) // units: normalized, range: 0..1, default: 0.5. Darkness amount; higher values reduce high-frequency brightness.
        .body(|freq, amp, gate, darkness| {
            // Very slow attack for drone
            let env = envelope()
                .asr(2.0, 1.0, 1.0)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Deep oscillator base
            let osc1 = saw_ar(freq);
            let osc2 = saw_ar(freq * 0.998);
            let sub = sin_osc_ar(freq * 0.5) * 0.4;

            let source = (osc1 + osc2) * 0.5 + sub;

            // Slow modulating formant
            let mod_speed = 0.1;
            let formant_mod = sin_osc_ar(mod_speed) * 0.5 + 0.5;
            let formant_freq = 300.0 + formant_mod * 400.0;

            // Apply formant with modulation
            let formant = rlpf_ar(source, formant_freq, 0.2);

            // Darkness control
            let cutoff = 2000.0 - darkness * 1500.0;
            let dark = lpf_ar(formant, cutoff);

            // Add breath noise
            let breath_mod = sin_osc_ar(0.15) * 0.5 + 0.5;
            let breath = white_noise_ar() * 0.02 * breath_mod;
            let breath_filtered = lpf_ar(hpf_ar(breath, 1000.0), 4000.0);

            (dark + breath_filtered) * env * amp
        })
});

//
// # Usage: `voice_drone`
//
// ```rhai
// import "stdlib/vocals/voice_drone.vibe" as voice_drone;
//
// let voice_drone = voice("doc_voice_drone")
//     .synth("voice_drone")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("darkness", 0.5);
// voice_drone.output("out").to_main();
// voice_drone.run();
// ```
