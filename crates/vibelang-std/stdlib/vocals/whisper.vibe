// Whisper Synth
// Genre: Ambient, ASMR | Character: Breathy, whispered
//
// Creates whisper-like textures with filtered noise.

define_synthdef("whisper", |builder| {
    builder
        .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
        .param("amp", 0.4) // units: linear, range: 0..1, default: 0.4. Output level multiplier; higher is louder.
        .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
        .param("breathiness", 0.7) // units: normalized, range: 0..1, default: 0.7. Breathiness amount; higher values add more airy noise.
        .body(|freq, amp, gate, breathiness| {
            // Soft envelope
            let env = envelope()
                .asr(0.1, 1.0, 0.3)
                .gate(gate)
                .cleanup_on_finish()
                .build();

            // Mostly noise with hint of pitch
            let noise = white_noise_ar();
            let pitched = sin_osc_ar(freq) * 0.2;

            // Formant filtering on noise for whisper character
            let whisper_band1 = rlpf_ar(noise, freq * 2.0, 0.2);
            let whisper_band2 = rlpf_ar(noise, freq * 4.0, 0.15) * 0.5;

            let whisper = whisper_band1 + whisper_band2;

            // Mix pitched and noise based on breathiness
            let mix = pitched * (1.0 - breathiness) + whisper * breathiness;

            // Shape the output
            let shaped = lpf_ar(mix, 6000.0);

            shaped * env * amp
        })
});

//
// # Usage: `whisper`
//
// ```rhai
// import "stdlib/vocals/whisper.vibe" as whisper;
//
// let whisper = voice("doc_whisper")
//     .synth("whisper")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0)
//     .set_param("breathiness", 0.7);
// whisper.output("out").to_main();
// whisper.run();
// ```
