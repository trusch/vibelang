// Genre: Pop, R&B | Character: Breathy vocal texture
define_synthdef("vocal_breathy")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.15, 1.0, 0.25)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Soft vibrato
        let vib = sin_osc_ar(4.5) * freq * 0.005;

        // Pitched component
        let pitched = saw_ar(freq + vib) * 0.25;

        // Breath noise
        let breath = bpf_ar(pink_noise_ar(), freq * 2.0, 0.3) * 0.35;

        // Formants
        let mix = pitched + breath;
        let f1 = bpf_ar(mix, 600.0, 0.12) * 0.4;
        let f2 = bpf_ar(mix, 1200.0, 0.15) * 0.3;

        let sig = f1 + f2;

        sig * env * amp
    });

//
// # Usage: `vocal_breathy`
//
// ```rhai
// import "stdlib/vocals/vocal_breathy.vibe" as vocal_breathy;
//
// let vocal_breathy = voice("doc_vocal_breathy")
//     .synth("vocal_breathy")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// vocal_breathy.output("out").to_main();
// vocal_breathy.run();
// ```
