// Genre: Soul, Pop | Character: Light falsetto voice
define_synthdef("vocal_falsetto")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.45) // units: linear, range: 0..1, default: 0.45. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.1, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Light vibrato
        let vib = sin_osc_ar(6.0) * freq * 0.01;

        // Pure tone with slight breathiness
        let pure = sin_osc_ar(freq + vib) * 0.5;
        let breath = bpf_ar(pink_noise_ar(), freq * 3.0, 0.25) * 0.15;

        // Light formants
        let mix = pure + breath;
        let f1 = bpf_ar(mix, 800.0, 0.15) * 0.35;
        let f2 = bpf_ar(mix, 1800.0, 0.18) * 0.25;

        let sig = f1 + f2 + pure * 0.3;

        sig * env * amp
    });

//
// # Usage: `vocal_falsetto`
//
// ```rhai
// import "stdlib/vocals/vocal_falsetto.vibe" as vocal_falsetto;
//
// let vocal_falsetto = voice("doc_vocal_falsetto")
//     .synth("vocal_falsetto")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// vocal_falsetto.output("out").to_main();
// vocal_falsetto.run();
// ```
