// Genre: Classical, Cinematic | Character: Operatic voice
define_synthdef("vocal_operatic")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.6) // units: linear, range: 0..1, default: 0.6. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.25, 1.0, 0.4)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Strong vibrato
        let vib = sin_osc_ar(6.0) * freq * 0.02;

        // Rich harmonic source
        let source = saw_ar(freq + vib) * 0.5;

        // Operatic formants - strong singer's formant
        let f1 = bpf_ar(source, 700.0, 0.1) * 0.35;
        let f2 = bpf_ar(source, 1500.0, 0.12) * 0.3;
        let f3 = bpf_ar(source, 2500.0, 0.15) * 0.25;
        let singers_formant = bpf_ar(source, 3000.0, 0.1) * 0.35;

        let sig = f1 + f2 + f3 + singers_formant;

        sig * env * amp
    });

//
// # Usage: `vocal_operatic`
//
// ```rhai
// import "stdlib/vocals/vocal_operatic.vibe" as vocal_operatic;
//
// let vocal_operatic = voice("doc_vocal_operatic")
//     .synth("vocal_operatic")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// vocal_operatic.output("out").to_main();
// vocal_operatic.run();
// ```
