// Genre: Pop, Electronic | Character: "Eee" vowel sound
define_synthdef("vocal_eee")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        let env = envelope()
            .asr(0.15, 1.0, 0.2)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.5) * freq * 0.008;

        // Vocal source
        let source = saw_ar(freq + vib) * 0.4;

        // "Eee" formants (high front vowel)
        let f1 = bpf_ar(source, 270.0, 0.08) * 0.35;
        let f2 = bpf_ar(source, 2300.0, 0.15) * 0.45;
        let f3 = bpf_ar(source, 3000.0, 0.2) * 0.15;

        let sig = f1 + f2 + f3;

        sig * env * amp
    });

//
// # Usage: `vocal_eee`
//
// ```rhai
// import "stdlib/vocals/vocal_eee.vibe" as vocal_eee;
//
// let vocal_eee = voice("doc_vocal_eee")
//     .synth("vocal_eee")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// vocal_eee.output("out").to_main();
// vocal_eee.run();
// ```
