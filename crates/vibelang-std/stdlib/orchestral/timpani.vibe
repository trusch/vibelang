// Genre: Orchestral, Cinematic | Character: Timpani drum with resonant tone
define_synthdef("timpani")
    .param("freq", 80.0) // units: Hz, range: 20..20000, default: 80.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.9) // units: linear, range: 0..1, default: 0.9. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Long resonant decay
        let amp_env = envelope()
            .perc(0.002, 1.2)
            .cleanup_on_finish()
            .build();

        // Pitch envelope
        let pitch_env = envelope()
            .perc(0.001, 0.05)
            .build();
        let freq_mod = pitch_env * freq * 0.8;

        // Main body
        let body = sin_osc_ar(freq + freq_mod) * 0.6;
        let harm1 = sin_osc_ar((freq + freq_mod) * 1.5) * 0.2;
        let harm2 = sin_osc_ar((freq + freq_mod) * 2.0) * 0.1;

        // Mallet attack
        let attack_env = envelope()
            .perc(0.001, 0.025)
            .build();
        let attack = lpf_ar(white_noise_ar(), 2000.0) * attack_env * 0.3;

        (body + harm1 + harm2 + attack) * amp_env * amp
    });

//
// # Usage: `timpani`
//
// ```rhai
// import "stdlib/orchestral/timpani.vibe" as timpani;
//
// let timpani = voice("doc_timpani")
//     .synth("timpani")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// timpani.output("out").to_main();
// timpani.run();
// ```
