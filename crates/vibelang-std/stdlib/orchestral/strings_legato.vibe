// Genre: Orchestral, Cinematic | Character: Smooth legato string section
define_synthdef("strings_legato")
    .param("freq", 440.0) // units: Hz, range: 20..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.55) // units: linear, range: 0..1, default: 0.55. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|freq, amp, gate| {
        // Smooth legato envelope
        let env = envelope()
            .asr(0.15, 1.0, 0.25)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Vibrato
        let vib = sin_osc_ar(5.5) * freq * 0.006;

        // String section
        let v1 = saw_ar(freq * 0.997 + vib) * 0.22;
        let v2 = saw_ar(freq + vib * 0.8) * 0.25;
        let v3 = saw_ar(freq * 1.003 + vib * 1.1) * 0.22;
        let v4 = saw_ar(freq * 1.006) * 0.18;

        let mix = v1 + v2 + v3 + v4;

        lpf_ar(mix, 5000.0) * env * amp
    });

//
// # Usage: `strings_legato`
//
// ```rhai
// import "stdlib/orchestral/strings_legato.vibe" as strings_legato;
//
// let strings_legato = voice("doc_strings_legato")
//     .synth("strings_legato")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5)
//     .set_param("gate", 1.0);
// strings_legato.output("out").to_main();
// strings_legato.run();
// ```
