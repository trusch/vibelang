// Genre: Orchestral, Cinematic | Character: Punchy brass stab
define_synthdef("brass_stab")
    .param("freq", 220.0) // units: Hz, range: 20..20000, default: 220.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .body(|freq, amp| {
        // Punchy brass envelope
        let amp_env = envelope()
            .perc(0.01, 0.3)
            .cleanup_on_finish()
            .build();

        // Filter envelope
        let filt_env = envelope()
            .perc(0.01, 0.2)
            .build();

        // Brass section
        let osc1 = saw_ar(freq * 0.998) * 0.3;
        let osc2 = saw_ar(freq) * 0.35;
        let osc3 = saw_ar(freq * 1.002) * 0.3;

        let mix = osc1 + osc2 + osc3;

        // Brass filter character
        let cutoff = 1000.0 + filt_env * 4000.0;
        rlpf_ar(mix, cutoff, 0.2) * amp_env * amp
    });

//
// # Usage: `brass_stab`
//
// ```rhai
// import "stdlib/orchestral/brass_stab.vibe" as brass_stab;
//
// let brass_stab = voice("doc_brass_stab")
//     .synth("brass_stab")
//     .set_param("freq", 440.0)
//     .set_param("amp", 0.5);
// brass_stab.output("out").to_main();
// brass_stab.run();
// ```
