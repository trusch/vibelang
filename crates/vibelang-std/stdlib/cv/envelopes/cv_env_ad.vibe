// kind=cv | category=envelope | flavor=ad | range=0..+10V | params=gate,attack_ms,decay_ms,peak_v
//
// Attack-decay envelope, single-shot. On a rising edge of `gate` the output
// rises exponentially from 0 V to `peak_v` over `attack_ms`, then decays
// exponentially back to 0 V over `decay_ms`. While `gate` stays high after
// the rise, the output continues to decay — there is no sustain phase.
//
// Implementation uses `decay2_kr`, which runs an exponential AD shape with
// independent attack and decay time constants. Because the times are control-
// rate inputs, both `attack_ms` and `decay_ms` are fully runtime-modulatable.
// The 60 dB time constant of `decay2` matches the perceptual attack/decay
// length, so the param values map directly to "how long the rise / fall
// sounds".
//
// Voltage scaling: the unit-amplitude AD shape from `decay2_kr` is multiplied
// by `peak_v / 10` so that an audio peak of `peak_v / 10` lands at `peak_v` V
// at the jack. Default `peak_v = 8.0` (= +8 V, i.e. 0.8 audio) — the standard
// Eurorack envelope swing.
//
// **Self-frees on gate falling edge** via a `linen_kr` watchdog with
// `doneAction=2` and a release stage equal to `decay_ms` (so the AD shape
// completes before the synth dies). Without this, pattern/melody-driven use
// leaks zombie synths and exhausts scsynth's node pool.
//
// CV contract: 0..+10 V output (no negative excursion), mono, hard ±1.0 clip,
// no leak_dc / soft-sat. See kb/stdlib-cv-spec.md.

define_synthdef("cv_env_ad")
    .param("gate", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("attack_ms", 5.0) // units: ms, range: 0..10000, default: 5.0. Attack Ms in milliseconds; higher values make that time interval longer.
    .param("decay_ms", 200.0) // units: ms, range: 0..10000, default: 200.0. Decay Ms in milliseconds; higher values make that time interval longer.
    .param("peak_v", 8.0) // units: volts, range: -10..10, default: 8.0. Envelope peak voltage; higher values raise the CV output level.
    .body(|gate, attack_ms, decay_ms, peak_v| {
        let attack_s = attack_ms * 0.001;
        let decay_s = decay_ms * 0.001;

        // Exponential AD shape, peak amplitude ~1.0 on a unit trigger.
        let env = decay2_kr(gate, attack_s, decay_s);

        // Scale unit envelope to peak_v volts (audio = volts / 10).
        let cv = env * (peak_v * 0.1);

        // ASR watchdog: holds at 1.0 while gate>0, on gate=0 takes decay_s
        // (the full decay tail) before doneAction=2 frees the synth. Carrier
        // is multiplied into the output at unity-gain sustain — the AD has
        // already decayed to ~0 by the time the watchdog releases, so the
        // multiplication doesn't shape the audible curve.
        let watchdog = linen_kr(gate, 0.0001, 1.0, decay_s, 2.0);

        let clipped = clip_ar(cv * watchdog, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_env_ad`
//
// ```rhai
// import "stdlib/cv/envelopes/cv_env_ad.vibe" as cv_env_ad;
//
// let cv_env_ad = voice("doc_cv_env_ad")
//     .synth("cv_env_ad")
//     .set_param("gate", 1.0)
//     .set_param("attack_ms", 80.0)
//     .set_param("decay_ms", 80.0)
//     .set_param("peak_v", 4.0);
// cv_env_ad.output("out").to_main();
// cv_env_ad.run();
// ```
