// kind=cv | category=lfo | flavor=chaos | range=-10..+10 V | params=rate,depth_v,bipolar
//
// Chaos LFO — Lorenz strange attractor as a slowly evolving, never-repeating
// modulation source. Unlike `cv_lfo_smooth_random` which is uncorrelated
// noise, the Lorenz output has structure — it traces orbits around two
// "wings" with the occasional jump between them. The result feels like a
// living analog modulation source: drifty when it sits on a wing, eventful
// when it crosses over.
//
// `rate` here is the iteration frequency of the Lorenz solver in Hz.
// Sub-audio values (1–20 Hz) keep the attractor in slow-motion mode and
// make the output suitable as a CV modulation source. The default is 4 Hz.
//
// Implementation notes:
//   - `lorenz_l_ar` is audio-rate (LorenzL has no kr sibling). Direct kr-param
//     input works: `lorenz_l_ar(rate)` re-reads freq per block.
//   - Note: SC's LorenzL initializes its internal phase counter once at
//     synth start. Mid-life rate changes ARE honoured for new iterations,
//     but the orbit has already been advancing at the previous rate, so
//     dramatic changes can take a moment to "catch up" in perceived feel.
//   - Lorenz x runs at roughly ±20–30 in raw form (s=10, r=28, b=2.667
//     defaults). A `1/25` pre-scale brings it into the [-1, +1] space the
//     CV pipeline expects; the final `clip_ar` rail catches the rare
//     excursions beyond.
//
// Output:
//   bipolar = 1.0 → ±depth_v volts (centred chaotic wander)
//   bipolar = 0.0 → 0 V .. +depth_v volts
//
// CV contract: mono, hard-clipped to ±1.0, no leak_dc, no soft-sat.

define_synthdef("cv_lfo_chaos")
    .param("rate", 4.0) // units: Hz, range: 0..100, default: 4.0. Clock or modulation rate in Hz; higher values make motion faster.
    .param("depth_v", 5.0) // units: volts, range: -10..10, default: 5.0. Modulation depth; higher values make the movement more pronounced.
    .param("bipolar", 1.0) // units: normalized, range: 0..1, default: 1.0. Bipolar switch; rounded values turn that mode off or on.
    .body(|rate, depth_v, bipolar| {
        // Slow Lorenz orbit. Defaults s=10, r=28, b=2.667, h=0.05 give the
        // classic two-wing butterfly.
        let chaos = lorenz_l_ar(rate);
        // Lorenz x peaks around ±25; pre-scale into the ±1 CV space.
        let normalized = chaos * (1.0 / 25.0);
        let shaped = normalized * (0.5 + 0.5 * bipolar) + (0.5 - 0.5 * bipolar);
        let cv = shaped * (depth_v / 10.0);
        let clipped = clip_ar(cv, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_lfo_chaos`
//
// ```rhai
// import "stdlib/cv/lfo/cv_lfo_chaos.vibe" as cv_lfo_chaos;
//
// let cv_lfo_chaos = voice("doc_cv_lfo_chaos")
//     .synth("cv_lfo_chaos")
//     .set_param("rate", 2.0)
//     .set_param("depth_v", 4.0)
//     .set_param("bipolar", 0.5);
// cv_lfo_chaos.output("out").to_main();
// cv_lfo_chaos.run();
// ```
