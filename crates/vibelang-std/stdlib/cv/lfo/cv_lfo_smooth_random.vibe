// kind=cv | category=lfo | flavor=smooth_random | range=-10..+10 V | params=rate,depth_v,bipolar
//
// Smooth random LFO — chooses a new target value every `1/rate` seconds and
// quadratically interpolates toward it. The result is a continuously
// wandering, never-repeating curve with no audible stepping. Drop-in
// replacement for sample-and-hold random (`cv_lfo_random`) where you want
// the modulation to feel more "analogue-organic" — vibrato wobble, slow
// filter drift, voltage-sag emulation.
//
// Output:
//   bipolar = 1.0 → ±depth_v volts
//   bipolar = 0.0 → 0 V .. +depth_v volts
//
// `rate` (Hz) controls how fast the underlying random walk picks new
// targets. The actual signal is much smoother than `rate` suggests because
// of the quadratic interpolation between targets.
//
// Runs at audio rate (`lf_noise2_ar`) — kr variants don't re-read freq per
// block in vibelang's wiring; ar works correctly.
//
// CV contract: mono, hard-clipped to ±1.0, no leak_dc, no soft-sat.

define_synthdef("cv_lfo_smooth_random")
    .param("rate", 1.0) // units: Hz, range: 0..100, default: 1.0. Clock or modulation rate in Hz; higher values make motion faster.
    .param("depth_v", 5.0) // units: volts, range: -10..10, default: 5.0. Modulation depth; higher values make the movement more pronounced.
    .param("bipolar", 1.0) // units: normalized, range: 0..1, default: 1.0. Bipolar switch; rounded values turn that mode off or on.
    .body(|rate, depth_v, bipolar| {
        let noise = lf_noise2_ar(rate);
        let shaped = noise * (0.5 + 0.5 * bipolar) + (0.5 - 0.5 * bipolar);
        let cv = shaped * (depth_v / 10.0);
        let clipped = clip_ar(cv, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_lfo_smooth_random`
//
// ```rhai
// import "stdlib/cv/lfo/cv_lfo_smooth_random.vibe" as cv_lfo_smooth_random;
//
// let cv_lfo_smooth_random = voice("doc_cv_lfo_smooth_random")
//     .synth("cv_lfo_smooth_random")
//     .set_param("rate", 2.0)
//     .set_param("depth_v", 4.0)
//     .set_param("bipolar", 0.5);
// cv_lfo_smooth_random.output("out").to_main();
// cv_lfo_smooth_random.run();
// ```
