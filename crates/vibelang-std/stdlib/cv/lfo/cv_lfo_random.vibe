// kind=cv | category=lfo | flavor=random | range=-10..+10 V | params=rate,depth_v,bipolar
//
// Sample-and-hold random LFO — picks a new random value every `1/rate`
// seconds and holds it. Stepped, not interpolated; the output looks like a
// staircase. Classic "random voltage" character — perfect for arpeggio-style
// filter modulation, generative VCA gating, or anywhere a `RandomSource`
// label would appear on a Eurorack module.
//
// Output:
//   bipolar = 1.0 → ±depth_v volts
//   bipolar = 0.0 → 0 V .. +depth_v volts
//
// `rate` (Hz) is the step frequency — how often a new random value is
// chosen. `depth_v` is the peak amplitude in volts (0..10 V). Runs at
// audio rate (`lf_noise0_ar`) — kr variants don't re-read freq per block
// in vibelang's wiring; ar works correctly.
//
// CV contract: mono, hard-clipped to ±1.0, no leak_dc, no soft-sat.

define_synthdef("cv_lfo_random")
    .param("rate", 1.0) // units: Hz, range: 0..100, default: 1.0. Clock or modulation rate in Hz; higher values make motion faster.
    .param("depth_v", 5.0) // units: volts, range: -10..10, default: 5.0. Modulation depth; higher values make the movement more pronounced.
    .param("bipolar", 1.0) // units: normalized, range: 0..1, default: 1.0. Bipolar switch; rounded values turn that mode off or on.
    .body(|rate, depth_v, bipolar| {
        let noise = lf_noise0_ar(rate);
        let shaped = noise * (0.5 + 0.5 * bipolar) + (0.5 - 0.5 * bipolar);
        let cv = shaped * (depth_v / 10.0);
        let clipped = clip_ar(cv, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_lfo_random`
//
// ```rhai
// import "stdlib/cv/lfo/cv_lfo_random.vibe" as cv_lfo_random;
//
// let cv_lfo_random = voice("doc_cv_lfo_random")
//     .synth("cv_lfo_random")
//     .set_param("rate", 2.0)
//     .set_param("depth_v", 4.0)
//     .set_param("bipolar", 0.5);
// cv_lfo_random.output("out").to_main();
// cv_lfo_random.run();
// ```
