// kind=cv | category=lfo | flavor=sine | range=-10..+10 V | params=rate,depth_v,bipolar
//
// Sine LFO — smooth continuous modulation source. Output:
//   bipolar = 1.0 → swings ±depth_v volts around 0 V (true AC modulation)
//   bipolar = 0.0 → swings 0 V .. +depth_v volts (unipolar, raised to positive only)
//
// `rate` (Hz) is the LFO frequency. `depth_v` is the peak amplitude in volts
// (0..10 V); under the standard 1.0 = +10 V convention this scales the audio
// sample by `depth_v / 10`. `bipolar` is a 0.0 / 1.0 switch — values in between
// give a continuous mix of the two polarities.
//
// The implementation runs at audio rate (`sin_osc_ar`). Earlier versions used
// `sin_osc_kr`, but vibelang's kr-rate Control wire to SC's `SinOsc.kr` doesn't
// re-read freq each block — output stuck near-DC regardless of the `rate` param
// value. Audio rate works correctly with kr-rate inputs and the CV contract
// delivers ar to the ES-3 anyway, so there's no penalty.
//
// CV contract (kb/stdlib-cv-spec.md): mono, hard-clipped to ±1.0, no
// leak_dc, no soft-sat, no envelope on the carrier.

define_synthdef("cv_lfo_sine")
    .param("rate", 1.0) // units: Hz, range: 0..100, default: 1.0. Clock or modulation rate in Hz; higher values make motion faster.
    .param("depth_v", 5.0) // units: volts, range: -10..10, default: 5.0. Modulation depth; higher values make the movement more pronounced.
    .param("bipolar", 1.0) // units: normalized, range: 0..1, default: 1.0. Bipolar switch; rounded values turn that mode off or on.
    .body(|rate, depth_v, bipolar| {
        let osc = sin_osc_ar(rate, 0.0);
        // Mix bipolar [-1,+1] vs unipolar [0,+1]:
        //   bipolar=1 → osc                          (peak ±1)
        //   bipolar=0 → osc * 0.5 + 0.5              (peak  0..+1)
        let shaped = osc * (0.5 + 0.5 * bipolar) + (0.5 - 0.5 * bipolar);
        let cv = shaped * (depth_v / 10.0);
        let clipped = clip_ar(cv, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_lfo_sine`
//
// ```rhai
// import "stdlib/cv/lfo/cv_lfo_sine.vibe" as cv_lfo_sine;
//
// let cv_lfo_sine = voice("doc_cv_lfo_sine")
//     .synth("cv_lfo_sine")
//     .set_param("rate", 2.0)
//     .set_param("depth_v", 4.0)
//     .set_param("bipolar", 0.5);
// cv_lfo_sine.output("out").to_main();
// cv_lfo_sine.run();
// ```
