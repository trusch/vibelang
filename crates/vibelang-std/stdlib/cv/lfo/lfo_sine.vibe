// Sine wave LFO synthdef
// Outputs: Smooth, continuous sinusoidal modulation
// Use for: Vibrato, subtle filter modulation, tremolo
define_synthdef("lfo_sine", |builder| {
    builder
        .output_kr("out")     // 1ch — kr CV (sine LFO)
        .param("rate", 1.0) // units: Hz, range: 0..100, default: 1.0. Clock or modulation rate in Hz; higher values make motion faster.
        .param("lo", 0.0) // units: volts, range: -10..10, default: 0.0. Sets the output minimum.
        .param("hi", 1.0) // units: volts, range: -10..10, default: 1.0. Sets the output maximum.
        .param("phase", 0.0) // units: cycles, range: 0..1, default: 0.0. Oscillator phase offset; higher values shift the waveform start point.
        .body_map(|p| {
            // sin_osc_kr stuck-output bug — compute at ar internally.
            let osc = sin_osc_ar(p.rate, p.phase);
            // Map from bipolar (-1 to 1) to user-specified range using basic math
            let normalized = osc * 0.5 + 0.5;  // Map to 0-1
            let out = normalized * (p.hi - p.lo) + p.lo; // Map to lo-hi range
            [a2k_kr(out)]
        })
});

//
// # Usage: `lfo_sine`
//
// ```rhai
// import "stdlib/cv/lfo/lfo_sine.vibe" as lfo_sine;
//
// let lfo_sine = voice("doc_lfo_sine")
//     .synth("lfo_sine")
//     .set_param("rate", 2.0)
//     .set_param("lo", 0.5)
//     .set_param("hi", 0.5)
//     .set_param("phase", 0.5);
// lfo_sine.outputs(["out"]).mute();
// lfo_sine.run();
// ```
