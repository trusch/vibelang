// kind=cv | category=lfo | flavor=square | range=-10..+10 V | params=rate,depth_v,pulse_width,bipolar
//
// Square / pulse LFO — instantaneous switch between two levels. Useful as a
// rhythmic gate-like modulation source (binary tremolo, hard filter clicks)
// or as a slow PWM source when `pulse_width` is modulated.
//
// `pulse_width` (0..1) is the duty cycle: 0.5 = symmetric square, smaller
// values produce a narrow positive pulse, larger values a narrow negative
// pulse.
//
// Output:
//   bipolar = 1.0 → switches between -depth_v and +depth_v volts
//   bipolar = 0.0 → switches between  0 V and +depth_v volts
//
// `rate` (Hz) is the LFO frequency. Runs at audio rate (`lf_pulse_ar`).
// `lf_pulse_ar` outputs unipolar 0..1; the bipolar mix re-centres it.
//
// Why ar and not kr? `LFPulse.kr` with a kr-rate `width` input crashes
// scsynth (segfault in LFUGens.so). `lf_pulse_ar` accepts a kr-modulated
// width without issue and produces the same musical result for sub-audio
// modulation rates. The CV contract requires audio-rate output anyway
// (the ES-3 demands it), so this is the right rate too.
//
// CV contract: mono, hard-clipped to ±1.0, no leak_dc, no soft-sat.

define_synthdef("cv_lfo_square")
    .param("rate", 1.0) // units: Hz, range: 0..100, default: 1.0. Clock or modulation rate in Hz; higher values make motion faster.
    .param("depth_v", 5.0) // units: volts, range: -10..10, default: 5.0. Modulation depth; higher values make the movement more pronounced.
    .param("pulse_width", 0.5) // units: ratio, range: 0..1, default: 0.5. Pulse width or duty cycle; higher values widen the high portion of the wave.
    .param("bipolar", 1.0) // units: normalized, range: 0..1, default: 1.0. Bipolar switch; rounded values turn that mode off or on.
    .body(|rate, depth_v, pulse_width, bipolar| {
        // LFPulse output is unipolar 0..1.
        let pulse = lf_pulse_ar(rate, 0.0, pulse_width);
        // Mix unipolar [0,+1] vs bipolar [-1,+1]:
        //   bipolar=1 → pulse * 2 - 1                (range -1..+1)
        //   bipolar=0 → pulse                        (range  0..+1)
        let shaped = pulse * (1.0 + bipolar) - bipolar;
        let cv = shaped * (depth_v / 10.0);
        let clipped = clip_ar(cv, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_lfo_square`
//
// ```rhai
// import "stdlib/cv/lfo/cv_lfo_square.vibe" as cv_lfo_square;
//
// let cv_lfo_square = voice("doc_cv_lfo_square")
//     .synth("cv_lfo_square")
//     .set_param("rate", 2.0)
//     .set_param("depth_v", 4.0)
//     .set_param("pulse_width", 0.5)
//     .set_param("bipolar", 0.5);
// cv_lfo_square.output("out").to_main();
// cv_lfo_square.run();
// ```
