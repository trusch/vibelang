// kind=cv | category=sequencer | flavor=step | range=±10V | params=clock_in,length,mode,note0..note7
//
// Explicit N-step pattern sequencer with selectable V/oct or gate output.
//
// `clock_in`: rising edge advances the step counter.
// `length`  : number of active steps before wrapping (1..8).
// `mode`    : 0 = V/oct stream (current step's note as V/oct around C4),
//             1 = gate stream (5 ms +5V pulse on every clock edge).
// `note0..note7`: per-step MIDI note (default 60 = C4 on inactive slots).
//
// Spawn two voices on the same `clock_in` and `note*` set — one with
// `mode=0` and one with `mode=1` — to feed a hardware VCO + envelope from a
// single shared pattern.
//
// Step selection uses overlapping triangular masks so the output is sample-
// accurate at the trigger boundary (the Stepper jumps in one block and the
// masks resolve to a clean integer index — no zipper from fractional select).
// Mode selection uses the same mask trick on `mode` so swapping modes at
// runtime crossfades cleanly between V/oct and gate signals.
//
// CV contract: hard-clipped to ±1.0; mono; no leak_dc, no soft-sat.
define_synthdef("cv_seq_step")
    .param("clock_in", 0.0)
    .param("length", 8.0)
    .param("mode", 0.0)
    .param("note0", 60.0)
    .param("note1", 62.0)
    .param("note2", 64.0)
    .param("note3", 67.0)
    .param("note4", 60.0)
    .param("note5", 62.0)
    .param("note6", 64.0)
    .param("note7", 67.0)
    .body(|clock_in, length, mode,
           note0, note1, note2, note3,
           note4, note5, note6, note7| {
        // Stepper wraps at max_idx = length-1, so changing `length` at
        // runtime still yields a valid integer index within [0, length).
        let max_idx = (length - 1.0).max(0.0);
        let idx = stepper_kr(clock_in, 0.0, 0.0, max_idx, 1.0, 0.0);

        // Triangular kernel: m_k = max(1 - |idx - k|, 0). For integer
        // idx, exactly one mask is 1.0 and the rest are 0.0.
        let m0 = (1.0 - abs(idx - 0.0)).max(0.0);
        let m1 = (1.0 - abs(idx - 1.0)).max(0.0);
        let m2 = (1.0 - abs(idx - 2.0)).max(0.0);
        let m3 = (1.0 - abs(idx - 3.0)).max(0.0);
        let m4 = (1.0 - abs(idx - 4.0)).max(0.0);
        let m5 = (1.0 - abs(idx - 5.0)).max(0.0);
        let m6 = (1.0 - abs(idx - 6.0)).max(0.0);
        let m7 = (1.0 - abs(idx - 7.0)).max(0.0);

        let midi = m0 * note0 + m1 * note1 + m2 * note2 + m3 * note3
                 + m4 * note4 + m5 * note5 + m6 * note6 + m7 * note7;

        // V/oct branch: (midi - 60) / 12 — same scaling as cv_voct_seq, so
        // 1 octave = 1.0 audio. Clipped to ±12 octaves around C4.
        let voct_kr = (midi - 60.0) / 12.0;
        let voct = k2a_ar(voct_kr);

        // Gate branch: stretch each clock edge to a 5 ms +5V pulse.
        // 0.5 audio = +5V at the jack.
        let gate = trig1_ar(clock_in, 0.005) * 0.5;

        // Mode masks. With integer mode, exactly one is 1.0.
        let mv = (1.0 - abs(mode - 0.0)).max(0.0);
        let mg = (1.0 - abs(mode - 1.0)).max(0.0);

        let out = voct * mv + gate * mg;
        let clipped = clip_ar(out, -1.0, 1.0);
        [clipped]
    });
