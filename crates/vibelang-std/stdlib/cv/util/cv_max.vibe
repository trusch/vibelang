// kind=cv | category=utility | flavor=max | range=-10..+10 V | params=a,b
//
// Maximum of two CVs — sample-by-sample `max(a, b)`. Equivalent to the
// Maths "max" output: useful for combining two envelopes into an upper-envelope
// follower, OR-style trigger merging, or floor-clamping one CV against another.
//
// CV contract: hard-clipped to ±1.0; mono; no leak_dc, no soft-sat.

define_synthdef("cv_max")
    .param("a", 0.0) // units: normalized, range: 0..1, default: 0.0. A macro; higher moves that model axis toward its brighter or more open setting.
    .param("b", 0.0) // units: normalized, range: 0..1, default: 0.0. B macro; higher moves that model axis toward its brighter or more open setting.
    .body(|a, b| {
        let out = max(a, b);
        let clipped = clip_ar(out, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_max`
//
// ```rhai
// import "stdlib/cv/util/cv_max.vibe" as cv_max;
//
// let cv_max = voice("doc_cv_max")
//     .synth("cv_max")
//     .set_param("a", 0.5)
//     .set_param("b", 0.5);
// cv_max.output("out").to_main();
// cv_max.run();
// ```
