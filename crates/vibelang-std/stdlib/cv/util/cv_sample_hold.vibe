// kind=cv | category=utility | flavor=sample_hold | range=-10..+10 V | params=cv_in,gate
//
// Sample & hold. On each rising edge of `gate`, capture the instantaneous
// value of `cv_in` and hold it on the output until the next trigger. Between
// triggers the output sits at the last captured sample — so a slowly drifting
// CV becomes a stepped sequence, locked to whatever clock you feed in.
//
// Pair this with `cv_lfo_random` or any noise source on `cv_in` and a clock
// on `gate` to get the classic stepped-random / Buchla-source-of-uncertainty
// CV that makes a quantized-melody patch feel alive without any extra logic.
//
// SuperCollider `Latch` does the work; it samples on positive-going zero
// crossings of the trigger input. Initial output (before the first trigger)
// is whatever `cv_in` happens to be at start, which is fine for our use.
//
// CV contract: hard-clipped to ±1.0; mono; no leak_dc, no soft-sat.

define_synthdef("cv_sample_hold")
    .param("cv_in", 0.0) // units: volts, range: -10..10, default: 0.0. Sets the incoming CV value.
    .param("gate", 0.0) // units: trigger, range: 0..1, default: 0.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .body(|cv_in, gate| {
        let held = latch_ar(cv_in, gate);
        let clipped = clip_ar(held, -1.0, 1.0);
        [clipped]
    });

//
// # Usage: `cv_sample_hold`
//
// ```rhai
// import "stdlib/cv/util/cv_sample_hold.vibe" as cv_sample_hold;
//
// let cv_sample_hold = voice("doc_cv_sample_hold")
//     .synth("cv_sample_hold")
//     .set_param("gate", 1.0)
//     .set_param("cv_in", 0.5);
// cv_sample_hold.output("out").to_main();
// cv_sample_hold.run();
// ```
