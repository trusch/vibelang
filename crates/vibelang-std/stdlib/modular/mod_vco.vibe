// Genre: Modular, Experimental | Character: Basic VCO module
define_synthdef("mod_vco")
    .param("freq", 440.0) // units: Hz, range: 0..20000, default: 440.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.7) // units: linear, range: 0..1, default: 0.7. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("wave", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or step count.
    .body(|freq, amp, gate, wave| {
        let env = envelope()
            .asr(0.001, 1.0, 0.001)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Crossfade between waveforms
        let saw_wave = saw_ar(freq) * (1.0 - wave * 2.0).max(0.0);
        let pulse_wave = pulse_ar(freq, 0.5) * (1.0 - (wave - 0.5).abs() * 2.0).max(0.0);
        let sine_wave = sin_osc_ar(freq) * ((wave - 0.5) * 2.0).max(0.0);

        let mix = saw_wave + pulse_wave + sine_wave;

        mix * env * amp
    });

//
// # Usage: `mod_vco`
//
// ```rhai
// import "stdlib/modular/mod_vco.vibe" as mod_vco;
//
// let mod_vco = voice("doc_mod_vco")
//     .synth("mod_vco")
//     .set_param("freq", 220.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5)
//     .set_param("wave", 1.0);
// mod_vco.output("out").to_main();
// mod_vco.run();
// ```
