// Genre: Modular, Experimental | Character: LFO module (as audio rate for AM effects)
define_synthdef("mod_lfo")
    .param("freq", 5.0) // units: Hz, range: 0..20000, default: 5.0. Pitch frequency in Hz; higher raises the note or resonator center.
    .param("amp", 0.5) // units: linear, range: 0..1, default: 0.5. Output level multiplier; higher is louder.
    .param("gate", 1.0) // units: trigger, range: 0..1, default: 1.0. Gate or trigger input; positive edges fire the event or advance the clock.
    .param("wave", 0.0) // units: selector, range: 0..N, default: 0.0. Selects mode, table, or step count.
    .body(|freq, amp, gate, wave| {
        let env = envelope()
            .asr(0.01, 1.0, 0.01)
            .gate(gate)
            .cleanup_on_finish()
            .build();

        // Crossfade LFO shapes
        let sine_wave = sin_osc_ar(freq) * (1.0 - wave * 2.0).max(0.0);
        let tri_wave = lf_tri_ar(freq) * (1.0 - (wave - 0.5).abs() * 2.0).max(0.0);
        let saw_wave = saw_ar(freq) * ((wave - 0.5) * 2.0).max(0.0);

        let mix = (sine_wave + tri_wave + saw_wave) * 0.5 + 0.5;

        mix * env * amp
    });

//
// # Usage: `mod_lfo`
//
// ```rhai
// import "stdlib/modular/mod_lfo.vibe" as mod_lfo;
//
// let mod_lfo = voice("doc_mod_lfo")
//     .synth("mod_lfo")
//     .set_param("freq", 220.0)
//     .set_param("gate", 1.0)
//     .set_param("amp", 0.5)
//     .set_param("wave", 1.0);
// mod_lfo.output("out").to_main();
// mod_lfo.run();
// ```
