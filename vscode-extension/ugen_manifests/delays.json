  {
    "name": "DelayN",
    "description": "Simple delay line with no interpolation. Most efficient but can cause aliasing.",
    "rates": [
      "ar",
      "kr"
    ],
    "inputs": [
      {
        "name": "in",
        "type": "signal",
        "default": 0,
        "description": "Input signal"
      },
      {
        "name": "maxdelaytime",
        "type": "float",
        "default": 0.2,
        "description": "Maximum delay time in seconds. Sets buffer size, cannot be modulated"
      },
      {
        "name": "delaytime",
        "type": "float",
        "default": 0.2,
        "description": "Delay time in seconds. Can be modulated"
      }
    ],
    "outputs": 1,
    "category": "Delays",
    "functions": [
      "delay_n_ar",
      "delay_n_kr"
    ]
  },
