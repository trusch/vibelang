// Morphagene micromontage — tape-cut style splice sequencing.
//
// Demonstrates Organize-based splice selection over an evenly divided Reel.
// The synthdef commits Organize changes at EOS, so quick edits do not click in
// the middle of a splice.
//
// Drop a stereo loop at `samples/loop.wav` (any length up to ~2.9 min,
// 48 kHz preferred). With no sample present this script still runs but
// outputs silence.

import "stdlib/instruments/sampler/morphagene.vibe";
import "stdlib/effects/reverbs/plate_reverb.vibe";

set_tempo(110);

let reel = sample("reel", "samples/loop.wav").loop_mode(true);

// Four equal-splice regions from an 8-splice Reel. Arbitrary marker positions
// and WAV cue chunks are deferred; the current synthdef divides the Reel evenly.
let splices = define_group("Splices", || {
    let a = voice("splice_a")
        .synth("morphagene")
        .set_param("bufnum", reel.bufnum)
        .set_param("num_splices", 8.0)
        .set_param("organize", 0.00)
        .set_param("vari_speed", 0.7937)         // ≈ unity rate (cube root of 0.5)
        .set_param("slide", 0.0)
        .set_param("amp", 0.55)
        .gain(db(-6));

    let b = voice("splice_b")
        .synth("morphagene")
        .set_param("bufnum", reel.bufnum)
        .set_param("num_splices", 8.0)
        .set_param("organize", 0.25)
        .set_param("vari_speed", 0.63)           // ≈ -12 ST (rate ≈ 0.5)
        .set_param("slide", 0.25)
        .set_param("amp", 0.55)
        .gain(db(-6));

    let c = voice("splice_c")
        .synth("morphagene")
        .set_param("bufnum", reel.bufnum)
        .set_param("num_splices", 8.0)
        .set_param("organize", 0.62)
        .set_param("vari_speed", -0.5)            // gentle reverse
        .set_param("slide", 0.5)
        .set_param("amp", 0.55)
        .gain(db(-6));

    let d = voice("splice_d")
        .synth("morphagene")
        .set_param("bufnum", reel.bufnum)
        .set_param("num_splices", 8.0)
        .set_param("organize", 0.87)
        .set_param("vari_speed", 1.0)             // top forward (+12 ST)
        .set_param("slide", 0.0)
        .set_param("amp", 0.55)
        .gain(db(-6));

    // One short note per splice voice. The synthdef's EOS-hold means the
    // selected Organize region is committed at the first wrap.
    melody("cut_a").on(a).notes("C3").apply();
    melody("cut_b").on(b).notes("C3").apply();
    melody("cut_c").on(c).notes("C3").apply();
    melody("cut_d").on(d).notes("C3").apply();

    fx("splice_verb")
        .synth("plate_reverb")
        .param("size", 0.5)
        .param("decay", 0.4)
        .param("damping", 0.5)
        .param("mix", 0.25);
});

// Sequence the splices like a tape-cut score. Each clip is a single bar.
sequence("micromontage")
    .loop_bars(8)
    .clip(bars(0)..bars(1), melody("cut_a"))
    .clip(bars(1)..bars(2), melody("cut_c"))
    .clip(bars(2)..bars(3), melody("cut_b"))
    .clip(bars(3)..bars(4), melody("cut_d"))
    .clip(bars(4)..bars(5), melody("cut_b"))
    .clip(bars(5)..bars(6), melody("cut_a"))
    .clip(bars(6)..bars(7), melody("cut_d"))
    .clip(bars(7)..bars(8), melody("cut_c"))
    .start();
