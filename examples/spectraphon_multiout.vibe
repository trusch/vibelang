// Spectraphon multi-output routing demo (Multi-output Story 12)
// + script-allocated Array buffer (hot-reload-safe Story C memory).
//
// Demonstrates the four named output ports on `spectraphon_side` and the
// `voice.output(name).to(group)` / `.to_main()` Rhai routing surface
// (Story 8 of the multi-output / CV-routing epic), plus the
// `allocate_buffer(name, frames, channels)` API that gives the synthdef
// 65,536 floats of Array memory whose contents survive hot-reload.
//
// Topology:
//
//   sine ─────────────────────────────────► main bus  (raw fundamental)
//   sub  ─────────────────────────────────► main bus  (DC-coupled CV path)
//   odd  ──► leads (mix bus)               ─► main bus
//   even ──► fx_evens (reverb_jpverb)      ─► main bus
//
// Why this layout: with the Spectraphon hardware-style decomposition, the
// even-bank harmonics are the "shimmery" partials that benefit from heavy
// reverb, while the odd bank stays present and articulated. Sending only
// `even` through the reverb bus keeps the fundamental tight and lets the
// reverb wash decorate the upper-spectrum content.
//
// The `sine` and `sub` ports route straight to the main hardware output
// (bypassing any group-level FX) so the clean fundamental and CV-style
// sub stay un-coloured.
//
// Array memory: `allocate_buffer("spec_arrays", 65536, 1)` registers a
// top-level mono buffer with the runtime. The same call in a future
// reload returns the same `bufnum` (deterministic name → ID mapping in
// the Rhai layer), so SC does NOT free the buffer between reloads —
// any captured magnitudes (SAM mode, sam_capture=4) stay readable in
// SAO mode after editing the synthdef body.

import "stdlib/instruments/spectral/spectraphon_side.vibe";
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

set_tempo(72);

// Mix-only group for the odd-bank summed signal. No group-level FX —
// the odd partials stay dry and articulated.
define_group("leads", || { });

// FX group for the even-bank: a long, lush jpverb wash.
define_group("fx_evens", || {
    fx("evens_verb")
        .synth("reverb_jpverb")
        .param("time", 4.0)
        .param("size", 0.85)
        .param("mix", 0.55)
        .apply();
});

// Allocate the shared Array memory. 16 arrays × 8×8 grid × 64 partials
// = 65,536 floats. The buffer survives hot-reload as long as this call
// stays in the script — captured Arrays persist across synthdef edits.
let arr = allocate_buffer("spec_arrays", 65536, 1);

// One spectraphon_side voice driving all four ports. `.group("leads")` sets
// the *default* group for any port that isn't explicitly routed; we then
// override per-port below.
let v = voice("spec")
    .synth("spectraphon_side")
    .group("leads")
    .set_param("partials", 0.85)
    .set_param("slide", 0.55)
    .set_param("focus", 0.45)
    .set_param("sam_capture", 0.0)        // SAO mode for a stable bank
    .set_param("amp", 0.25)
    .set_param("bufnum", arr.bufnum)      // wire script-allocated Array buffer
    .gain(db(-9));

// Per-port routing. `odd` reuses the voice's current group ("leads") via
// `to_current_group()` — saves a redundant `group(...)` handle lookup when
// the destination is the same group already set on the voice.
v.output("sine").to_main();
v.output("sub").to_main();
v.output("odd").to_current_group();
v.output("even").to(group("fx_evens"));

// Hold a 3-note arpeggio through the multi-bus topology.
melody("spec_arp")
    .on(v)
    .notes("A3 C4 E4")
    .start();
