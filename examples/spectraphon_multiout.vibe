// Spectraphon multi-output routing demo.
//
// Demonstrates the four named output ports on `spectraphon`
// (sine, sub, odd, even) and the `voice.output(name).to(group)` /
// `.to_main()` per-port routing surface, plus the `allocate_buffer(name,
// frames, channels)` API that gives the synthdef Array memory whose
// contents survive hot-reload.
//
// Topology:
//
//   sine ─────────────────────────────────► main bus  (raw fundamental)
//   sub  ─────────────────────────────────► main bus  (saw at 0.5×freq,
//                                                      only audible in SAO)
//   odd  ──► leads (mix bus)               ─► main bus
//   even ──► fx_evens (reverb_jpverb)      ─► main bus
//
// Why this layout: with the Spectraphon hardware-style decomposition, the
// even-bank harmonics are the "shimmery" partials that benefit from heavy
// reverb, while the odd bank stays present and articulated. Sending only
// `even` through the reverb bus keeps the fundamental tight and lets the
// reverb wash decorate the upper-spectrum content. `sine` and `sub` route
// straight to main so the clean fundamental and the saw sub stay
// un-coloured by group-level FX.
//
// Array memory: `allocate_buffer("spec_arrays", 65536, 1)` registers a
// top-level mono buffer with the runtime. The same call in a future
// reload returns the same `bufnum`, so SC does NOT free the buffer
// between reloads — any captured magnitudes (SAM-capture mode) stay
// readable in SAO mode after editing the synthdef body.

import "stdlib/instruments/spectral/spectraphon.vibe";
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

set_tempo(72);

define_group("leads", || { });

define_group("fx_evens", || {
    fx("evens_verb")
        .synth("reverb_jpverb")
        .param("time", 4.0)
        .param("size", 0.85)
        .param("mix", 0.55)
        .apply();
});

let arr = allocate_buffer("spec_arrays", 65536, 1);

let v = voice("spec")
    .synth("spectraphon")
    .group("leads")
    .set_param("partials", 0.85)
    .set_param("slide", 0.55)
    .set_param("focus", 0.45)
    .set_param("freq", 220.0)
    .set_param("amp", 0.25)
    .set_param("mode", 2.0)
    .set_param("array_buf", arr.bufnum)
    .gain(db(-9));

v.output("sine").to_main();
v.output("sub").to_main();
v.output("odd").to_current_group();
v.output("even").to(group("fx_evens"));

v.run();
