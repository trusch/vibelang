// ReSynthesizer demo — explicit two-synthdef Spectraphon patch.
//
// Two stdlib synthdefs make up the Spectraphon side of this rack:
//
//   spectraphon_analyzer    real-FFT magnitude tap; one BinData read per
//                           harmonic, output written to a shared mag buffer
//   spectraphon_oscillator  64-partial additive bank with three operating
//                           modes selected at create time via `mode`:
//                             mode = 0.0  SAM live      reads mag buffer
//                             mode = 1.0  SAM capture   live read + writes
//                                                       into array buffer
//                             mode = 2.0  SAO playback  bilinear read from
//                                                       array buffer
//
// Side A runs SAO (no analyzer). Side B runs SAM live and is analyzed from
// side A's clean sine output — that is the resynthesis chain.
//
// Morphagene SOS/granular leg reads side A's sine for grain content; its
// direct playback path is muted because the worktree's Morphagene buffer
// reader still fails standalone.
//
// CV: TEMPI clocks Rene/MATHS, Wogglebug roams, all of them shape side A,
// side B, Morphagene, X-PAN, QPAS, DXG and Mimeophon params via scaled
// kr-to-param routes.

import "stdlib/instruments/sampler/morphagene.vibe";
import "stdlib/instruments/eurorack/tempi.vibe";
import "stdlib/instruments/eurorack/rene.vibe";
import "stdlib/instruments/eurorack/maths.vibe";
import "stdlib/instruments/eurorack/wogglebug.vibe";
import "stdlib/processors/mixers/x_pan.vibe";
import "stdlib/processors/filters/qpas.vibe";
import "stdlib/processors/dynamics/dxg.vibe";
import "stdlib/processors/delays/mimeophon.vibe";
import "stdlib/instruments/spectral/spectraphon_analyzer.vibe";
import "stdlib/instruments/spectral/spectraphon_oscillator.vibe";

set_tempo(96);

define_group("rack", || { });
group("rack").gain(db(-16));

let morph_reel = allocate_buffer("resynth_morph_reel", 96000, 1);

// ----- CV chain -----

let tempi = voice("clk")
    .synth("tempi")
    .group("rack")
    .set_param("bpm", get_tempo())
    .set_param("width", 0.05)
    .set_param("mult1", 1.0)
    .set_param("mult2", 0.5)
    .set_param("mult3", 2.0)
    .set_param("mult4", 0.25)
    .set_param("mult5", 0.125)
    .set_param("mult6", 3.0)
    .set_param("shift2", 2.0)
    .set_param("shift4", 4.0);

let rene = voice("seq")
    .synth("rene")
    .group("rack")
    .set_param("quantize", 1.0)
    .set_param("scale_mask", 1453.0)
    .set_param("mode", 1.0)
    .set_param("memory", 0.18)
    .set_param("note00", 60.0).set_param("note01", 64.0)
    .set_param("note02", 67.0).set_param("note03", 72.0)
    .set_param("note10", 62.0).set_param("note11", 65.0)
    .set_param("note12", 69.0).set_param("note13", 74.0)
    .set_param("note20", 55.0).set_param("note21", 60.0)
    .set_param("note22", 67.0).set_param("note23", 76.0)
    .set_param("note30", 57.0).set_param("note31", 62.0)
    .set_param("note32", 69.0).set_param("note33", 79.0);

let maths = voice("env")
    .synth("maths")
    .group("rack")
    .set_param("rise1", 0.004).set_param("fall1", 0.28)
    .set_param("shape1", 0.72).set_param("cycle1", 0.0)
    .set_param("rise4", 0.018).set_param("fall4", 0.82)
    .set_param("shape4", 0.42).set_param("cycle4", 0.0)
    .set_param("ch2", 0.32).set_param("ch2_scale", 0.85)
    .set_param("ch3", -0.18).set_param("ch3_scale", 0.35);

let woggle = voice("wog")
    .synth("wogglebug")
    .group("rack")
    .set_param("rate", 1.9)
    .set_param("depth_v", 4.5)
    .set_param("chaos", 0.62)
    .set_param("heart", 0.82)
    .set_param("bipolar", 1.0);

tempi.output("ch1").to_param(rene, "clock_x");
tempi.output("ch2").to_param(rene, "clock_y");
tempi.output("ch3").to_param(maths, "trig1");
tempi.output("ch4").to_param(maths, "trig4");

// ----- Spectraphon side A: SAO playback -----
//
// Side A runs from a fixed Array buffer (filled to the SAO fallback 1/k
// spectrum on first cell, no live capture). No analyzer voice is needed in
// SAO mode.

let spec_a_array = allocate_buffer("spec_a_arrays", 65536, 1);

let spec_a_osc = voice("spec_a_osc")
    .synth("spectraphon_oscillator")
    .group("rack")
    .set_param("freq", 92.5)
    .set_param("partials", 0.58)
    .set_param("slide", 0.46)
    .set_param("focus", 0.54)
    .set_param("amp", 0.42)
    .set_param("mode", 2.0)
    .set_param("array_buf", spec_a_array.bufnum)
    .gain(db(-24));

// ----- Spectraphon side B: SAM live, fed by side A's clean sine -----
//
// Side B's analyzer needs three shared buffers: the FFT chain buffer (pre-
// allocated to avoid the scsynth /s_new wedge on fft_kr graphs), the per-
// partial magnitude buffer (written by analyzer, read by oscillator), and
// an Array buffer (unused in SAM live but the synthdef still expects a
// valid bufnum).

let spec_b_fft = allocate_buffer("spec_b_fft", 2048, 1);
let spec_b_mag = allocate_buffer("spec_b_mag", 64, 1);
let spec_b_array = allocate_buffer("spec_b_arrays", 65536, 1);

let spec_b_analyzer = voice("spec_b_analyzer")
    .synth("spectraphon_analyzer")
    .group("rack")
    .set_param("fft_buf", spec_b_fft.bufnum)
    .set_param("mag_buf", spec_b_mag.bufnum)
    .set_param("f0_analyze", 100.0);
spec_b_analyzer.output("noop").mute();

// routing_mode=2 from the old rack maps to side B = side A * 1.4983
// (perfect-fifth follow). Compute it once here; the .scale/.offset routes
// below modulate around this baseline.
let spec_b_freq = 92.5 * 1.4983;

let spec_b_osc = voice("spec_b_osc")
    .synth("spectraphon_oscillator")
    .group("rack")
    .set_param("freq", spec_b_freq)
    .set_param("partials", 0.72)
    .set_param("slide", 0.58)
    .set_param("focus", 0.42)
    .set_param("amp", 0.42)
    .set_param("mode", 0.0)
    .set_param("mag_buf", spec_b_mag.bufnum)
    .set_param("array_buf", spec_b_array.bufnum)
    .gain(db(-24));

spec_b_analyzer.input("analyze").from(spec_a_osc, "sine");

rene.output("cv").to_param(spec_a_osc, "freq").scale(105.0).offset(120.0);
rene.output("cv").to_param(spec_b_osc, "freq").scale(92.0).offset(180.0);
woggle.output("stepped").to_param(spec_a_osc, "partials").scale(0.34).offset(0.58);
woggle.output("woggle").to_param(spec_b_osc, "partials").scale(0.30).offset(0.56);
maths.output("ch1").to_param(spec_a_osc, "slide").scale(0.44).offset(0.32);
maths.output("ch4").to_param(spec_b_osc, "focus").scale(0.48).offset(0.28);
maths.output("ch1").to_param(spec_a_osc, "amp").scale(0.55).offset(0.20);
maths.output("ch4").to_param(spec_b_osc, "amp").scale(0.45).offset(0.16);

// ----- Morphagene SOS/granular leg -----

let morph = voice("morph")
    .synth("morphagene")
    .group("rack")
    .modulator_only()
    .set_param("bufnum", morph_reel.bufnum)
    .set_param("num_splices", 1.0)
    .set_param("organize", 0.0)
    .set_param("sos", 0.5)
    .set_param("vari_speed", 0.7937)
    .set_param("slide", 0.0)
    .set_param("gene_size", 0.10)
    .set_param("morph", 0.38)
    .set_param("amp", 0.0)
    .set_param("auto_level", 0.0);

morph.input("sos").from(spec_a_osc, "sine");

rene.output("cv").to_param(morph, "organize").scale(0.16).offset(0.22);
woggle.output("smooth").to_param(morph, "slide").scale(0.38).offset(0.22);
maths.output("ch1").to_param(morph, "gene_size").scale(0.42).offset(0.18);
maths.output("ch4").to_param(morph, "morph").scale(0.32).offset(0.52);
tempi.output("ch5").to_param(morph, "clk");

// ----- X-PAN granular/spectral blend -----

let xpan = voice("blend")
    .synth("x_pan")
    .group("rack")
    .set_param("ch1_gain", 15.0)
    .set_param("ch2_gain", 15.0)
    .set_param("aux_gain", 0.0)
    .set_param("ch1_fade", 0.38)
    .set_param("ch2_fade", 0.56)
    .set_param("ch1_pan", -1.0)
    .set_param("ch2_pan", 1.0)
    .set_param("level", 6.3);
xpan.input("ch1_a").from(spec_a_osc, "odd");
xpan.input("ch1_b").from(spec_b_osc, "odd");
xpan.input("ch2_a").from(spec_a_osc, "even");
xpan.input("ch2_b").from(spec_b_osc, "even");

woggle.output("smooth").to_param(xpan, "ch1_fade").scale(0.35).offset(0.34);
maths.output("ch1").to_param(xpan, "ch2_fade").scale(0.45).offset(0.42);

morph.output("eosg").mute();

// ----- QPAS filter -----

let qpas = voice("filt")
    .synth("qpas")
    .group("rack")
    .set_param("cutoff", 1700.0)
    .set_param("q", 0.34)
    .set_param("radiate", 0.42)
    .set_param("smile", 0.62)
    .set_param("frown", -0.22)
    .set_param("mode", 0.0)
    .set_param("input_gain", 0.86)
    .set_param("mix", 0.88)
    .set_param("level", 0.10);
qpas.input("in").from(xpan, "out");

woggle.output("smooth").to_param(qpas, "cutoff").scale(3600.0).offset(1200.0);
maths.output("ch1").to_param(qpas, "q").scale(0.46).offset(0.20);
rene.output("x_gate").to_param(qpas, "radiate").scale(0.58).offset(0.18);

// ----- DXG low-pass gate, configured but skipped in the audible route -----

let dxg = voice("vca")
    .synth("dxg")
    .group("rack")
    .set_param("ctrl1", 0.02)
    .set_param("ctrl2", 0.01)
    .set_param("strike_level", 0.0)
    .set_param("strike_decay", 0.36)
    .set_param("ch1_gain", 12.0)
    .set_param("ch2_gain", 3.0)
    .set_param("aux_gain", 0.0)
    .set_param("level", 4.0);
dxg.input("ch1").from(qpas, "out");
dxg.input("ch2").from(xpan, "out");

maths.output("ch1").to_param(dxg, "ctrl1").scale(1.0).offset(0.02);
maths.output("ch4").to_param(dxg, "ctrl2").scale(0.76).offset(0.01);

// ----- Mimeophon delay with audible halos -----

let echo = voice("echo")
    .synth("mimeophon")
    .group("rack")
    .set_param("time", 0.40)
    .set_param("zone", 0.0)
    .set_param("repeats", 0.94)
    .set_param("skew", 0.75)
    .set_param("color", -0.18)
    .set_param("halo", 0.90)
    .set_param("halftime", 0.0)
    .set_param("mix", 1.0)
    .set_param("level", 16.0);
echo.input("in").from(qpas, "out");
echo.output("out").to_current_group();

rene.output("y_gate").to_param(echo, "skew").scale(0.44).offset(0.12);
woggle.output("smooth").to_param(echo, "color").scale(0.44).offset(-0.20);
tempi.output("ch6").to_param(echo, "repeats").scale(0.06).offset(0.86);

// ----- Run -----

// Spectraphon pitch and articulation come from the rene/maths CV chain
// (kr-to-param routes above); these voices run as sustained instances, NOT
// per-note `/s_new` spawns. Do not layer a `melody(...).on(spec_a_osc)` on
// top — it would clobber the run() instance.

tempi.run();
rene.run();
maths.run();
woggle.run();
morph.run();
spec_a_osc.run();
spec_b_analyzer.run();
spec_b_osc.run();
xpan.run();
qpas.run();
echo.run();
