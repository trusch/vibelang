// Spectraphon Array capture — capture an Array from audio input, then play
// it back as SAO.
//
// Walks through the full Spectraphon Array workflow on a single side using
// the explicit two-synthdef surface:
//
//   Bars 0–7   Capture: `cap_analyzer` (FFT + BinData) writes the magnitude
//              spectrum of JACK input ch 0 into `mag_buf`. `cap_osc` runs
//              in `mode = 1.0` (SAM capture) so it reads the live magnitudes
//              AND writes them into the shared array buffer at the
//              (slide, focus, array_idx) cell. Two slow fades sweep
//              `slide` across [0, 1] (one full pass) and `focus` across
//              [0, 1] (two passes), filling the 8×8 grid in a serpentine
//              pattern over 8 bars.
//
//   Bar 8      Voice swap: `cap_osc` fades its amp to 0 AND its mode from
//              1.0 (sam_capture) to 0.0 (sam_live), so the array writes
//              stop and the captured spectrum is frozen. `play_osc`
//              (mode = 2.0, SAO) fades its amp from 0 to 0.25.
//
//   Bars 8–15  SAO playback: `play_osc` reads the captured array via
//              bilinear interpolation across (slide, focus). A second
//              pair of fades scans the captured Array in a different
//              trajectory than the capture — diagonal vs. serpentine — so
//              each cell is revisited from new directions and the bilinear
//              interpolation between cells becomes audible.
//
// Hardware-input requirement: this example only produces interesting
// output if there is audible signal on JACK input ch 0 during bars 0–7.
// Patch a synth, voice, or microphone in. With silence on the input the
// captured Array stores `mag[k] ≈ 0`, and SAO playback is silent — that
// is the correct "no input → no spectrum" behaviour, not a bug.
//
// Array memory uses a script-allocated buffer wired into `array_buf`, so
// captures survive hot-reload as long as the `allocate_buffer` call stays
// in the script.

import "stdlib/instruments/spectral/spectraphon_analyzer.vibe";
import "stdlib/instruments/spectral/spectraphon_oscillator.vibe";
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

set_tempo(80);

let arr = allocate_buffer("array_capture_arrays", 65536, 1);

let capture_demo = define_group("ArrayCapture", || {
    // Capture leg: analyzer + oscillator in SAM-capture mode share mag_buf
    // and write into the SAO array buffer.
    let cap_fft = allocate_buffer("cap_fft", 2048, 1);
    let cap_mag = allocate_buffer("cap_mag", 64, 1);

    let cap_analyzer = voice("cap_analyzer")
        .synth("spectraphon_analyzer")
        .set_param("fft_buf", cap_fft.bufnum)
        .set_param("mag_buf", cap_mag.bufnum)
        .set_param("f0_analyze", 50.0);
    cap_analyzer.output("noop").mute();

    let cap_osc = voice("cap_osc")
        .synth("spectraphon_oscillator")
        .set_param("freq", 110.0)
        .set_param("partials", 0.85)
        .set_param("amp", 0.25)
        .set_param("mode", 1.0)
        .set_param("mag_buf", cap_mag.bufnum)
        .set_param("array_buf", arr.bufnum)
        .set_param("slide", 0.0)
        .set_param("focus", 0.0)
        .set_param("array_idx", 0.0)
        .gain(db(-9));

    // Playback leg: pure SAO read of the captured array buffer.
    let play_osc = voice("play_osc")
        .synth("spectraphon_oscillator")
        .set_param("freq", 110.0)
        .set_param("partials", 0.85)
        .set_param("amp", 0.0)
        .set_param("mode", 2.0)
        .set_param("array_buf", arr.bufnum)
        .set_param("slide", 0.0)
        .set_param("focus", 0.0)
        .set_param("array_idx", 0.0)
        .gain(db(-9));

    cap_osc.output("sine").to_current_group();
    cap_osc.output("odd").to_current_group();
    cap_osc.output("even").to_current_group();
    cap_osc.output("sub").mute();
    play_osc.output("sine").to_current_group();
    play_osc.output("odd").to_current_group();
    play_osc.output("even").to_current_group();
    play_osc.output("sub").mute();

    cap_analyzer.run();
    cap_osc.run();
    play_osc.run();

    // ---- Capture phase fades (bars 0–7) -----------------------------
    //
    // Slide does one slow pass 0 → 1 across all 8 bars of capture so
    // every column of the 8×8 grid gets visited.
    fade("cap_slide")
        .on_voice("cap_osc")
        .param("slide")
        .from(0.0)
        .to(1.0)
        .over_bars(8)
        .curve("linear")
        .apply();

    fade("cap_f0")
        .on_voice("cap_analyzer")
        .param("f0_analyze")
        .from(50.0)
        .to(800.0)
        .over_bars(8)
        .curve("linear")
        .apply();

    // Focus does two faster passes (0 → 1, 0 → 1) over the same 8 bars
    // so every cell in the 8×8 grid is hit at least once.
    fade("cap_focus_a")
        .on_voice("cap_osc")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();
    fade("cap_focus_b")
        .on_voice("cap_osc")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();
    fade("cap_analyze_focus_a")
        .on_voice("cap_analyzer")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();
    fade("cap_analyze_focus_b")
        .on_voice("cap_analyzer")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();

    // Voice swap at bar 8: silence the capture leg AND switch its mode
    // from sam_capture (1.0) to sam_live (0.0) so the array writes stop.
    fade("cap_amp_off")
        .on_voice("cap_osc")
        .param("amp")
        .from(0.25)
        .to(0.0)
        .over_bars(1)
        .curve("step")
        .apply();
    fade("cap_mode_off")
        .on_voice("cap_osc")
        .param("mode")
        .from(1.0)
        .to(0.0)
        .over_bars(1)
        .curve("step")
        .apply();
    fade("play_amp_on")
        .on_voice("play_osc")
        .param("amp")
        .from(0.0)
        .to(0.25)
        .over_bars(1)
        .curve("step")
        .apply();

    // ---- Playback phase fades (bars 8–15) ---------------------------
    fade("play_slide_up")
        .on_voice("play_osc")
        .param("slide")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();
    fade("play_slide_down")
        .on_voice("play_osc")
        .param("slide")
        .from(1.0)
        .to(0.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();

    fade("play_focus_up")
        .on_voice("play_osc")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();
    fade("play_focus_down")
        .on_voice("play_osc")
        .param("focus")
        .from(1.0)
        .to(0.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();

    fx("capture_verb")
        .synth("reverb_jpverb")
        .param("time", 3.5)
        .param("size", 0.7)
        .param("damping", 0.4)
        .param("mix", 0.35);
});

// 16-bar arrangement: capture in the first half, play back in the second.
// The voice swap at bar 8 is a set of 1-bar step fades; the playback fades
// start at bar 8 so the SAO scan begins immediately after the swap lands.
sequence("array_capture")
    .loop_bars(16)
    // Capture phase
    .clip(bars(0)..bars(8),  fade("cap_slide"))
    .clip(bars(0)..bars(8),  fade("cap_f0"))
    .clip(bars(0)..bars(4),  fade("cap_focus_a"))
    .clip(bars(4)..bars(8),  fade("cap_focus_b"))
    .clip(bars(0)..bars(4),  fade("cap_analyze_focus_a"))
    .clip(bars(4)..bars(8),  fade("cap_analyze_focus_b"))
    // Voice swap
    .clip(bars(8)..bars(9),  fade("cap_amp_off"))
    .clip(bars(8)..bars(9),  fade("cap_mode_off"))
    .clip(bars(8)..bars(9),  fade("play_amp_on"))
    // Playback phase
    .clip(bars(8)..bars(12), fade("play_slide_up"))
    .clip(bars(12)..bars(16),fade("play_slide_down"))
    .clip(bars(8)..bars(12), fade("play_focus_up"))
    .clip(bars(12)..bars(16),fade("play_focus_down"))
    .start();
