// Spectraphon Array capture — capture an Array from audio input, then play
// it back as SAO.
//
// Walks through the full Spectraphon Array workflow on a single side:
//
//   Bars 0–7   SAM + capture (`mode = "sam_capture"`)
//              Real-time FFT analyses JACK audio input ch 0; the per-frame
//              `mag[1..64]` is written into the Array cell at
//              (floor(slide·8), floor(focus·8)). Two slow fades sweep
//              `slide` across [0, 1] (one full pass) and `focus` across
//              [0, 1] (two passes), filling the 8×8 grid in a serpentine
//              pattern over 8 bars.
//
//   Bar 8      Voice swap from the SAM-capture helper to an SAO helper.
//              The SAO bank reads the captured Array via bilinear interpolation
//              across (slide, focus) instead of the live FFT.
//
//   Bars 8–15  SAO playback. A second pair of fades scans the captured
//              Array in a different trajectory than the capture — diagonal
//              vs. serpentine — so each cell is revisited from new
//              directions and the bilinear interpolation between cells
//              becomes audible.
//
// Hardware-input requirement: this example only produces interesting
// output if there is audible signal on JACK input ch 0 during bars 0–7.
// Patch a synth, voice, or microphone in. With silence on the input the
// captured Array stores `mag[k] ≈ 0`, and SAO playback is silent — that
// is the correct "no input → no spectrum" behaviour, not a bug.
//
// Array memory uses a script-allocated buffer wired into `bufnum`, so captures
// survive hot-reload as long as the `allocate_buffer` call stays in the script.
//
// References: kb/spectraphon-howto.md ("spectraphon_side", "Array memory")
//             and kb/spectraphon-synthdef-plan.md §3.b, §6.C.

import "stdlib/instruments/spectral/spectraphon_side.vibe" as spectraphon;
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

set_tempo(80);

let arr = allocate_buffer("array_capture_spec_arrays", 65536, 1);

// Two helper voices share one Array buffer. `spec_cap` owns the SAM capture
// path for bars 0-7; `spec_play` owns SAO playback from bar 8 onward.
let capture_demo = define_group("ArrayCapture", || {
    let cap = spectraphon::spectraphon_side("spec_cap", "sam_capture");
    cap = spectraphon::spectraphon_set_param(cap, "freq", 110.0);
    cap = spectraphon::spectraphon_set_param(cap, "partials", 0.85);
    cap = spectraphon::spectraphon_set_param(cap, "bufnum", arr.bufnum);
    cap = spectraphon::spectraphon_set_param(cap, "array_idx", 0.0);
    cap = spectraphon::spectraphon_set_param(cap, "slide", 0.0);
    cap = spectraphon::spectraphon_set_param(cap, "focus", 0.0);
    cap = spectraphon::spectraphon_set_param(cap, "amp", 0.25);
    cap = spectraphon::spectraphon_gain(cap, db(-9));
    cap = spectraphon::spectraphon_run(cap);

    let play = spectraphon::spectraphon_side("spec_play", "sao");
    play = spectraphon::spectraphon_set_param(play, "freq", 110.0);
    play = spectraphon::spectraphon_set_param(play, "partials", 0.85);
    play = spectraphon::spectraphon_set_param(play, "bufnum", arr.bufnum);
    play = spectraphon::spectraphon_set_param(play, "array_idx", 0.0);
    play = spectraphon::spectraphon_set_param(play, "slide", 0.0);
    play = spectraphon::spectraphon_set_param(play, "focus", 0.0);
    play = spectraphon::spectraphon_set_param(play, "amp", 0.0);
    play = spectraphon::spectraphon_gain(play, db(-9));
    play = spectraphon::spectraphon_run(play);

    spectraphon::spectraphon_outputs_to_current_group(cap, ["sine", "odd", "even"]);
    spectraphon::spectraphon_output(cap, "sub").mute();
    spectraphon::spectraphon_outputs_to_current_group(play, ["sine", "odd", "even"]);
    spectraphon::spectraphon_output(play, "sub").mute();

    melody("hold_cap").on(cap.oscillator).notes("A2").apply();
    melody("hold_play").on(play.oscillator).notes("A2").apply();

    // ---- Capture phase fades (bars 0–7) -----------------------------
    //
    // Slide does one slow pass 0 → 1 across all 8 bars of capture so
    // every column of the 8×8 grid gets visited.
    fade("cap_slide")
        .on_voice("spec_cap__oscillator")
        .param("slide")
        .from(0.0)
        .to(1.0)
        .over_bars(8)
        .curve("linear")
        .apply();

    fade("cap_f0")
        .on_voice("spec_cap__analyzer")
        .param("f0_analyze")
        .from(50.0)
        .to(800.0)
        .over_bars(8)
        .curve("linear")
        .apply();

    // Focus does two faster passes (0 → 1, 0 → 1) over the same 8 bars
    // so every cell in the 8×8 grid is hit at least once. (The serpentine
    // doesn't quite cover all 64 cells uniformly — corners and the
    // diagonal get more frames than the centre — but every cell index
    // is reached.)
    fade("cap_focus_a")
        .on_voice("spec_cap__oscillator")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();
    fade("cap_focus_b")
        .on_voice("spec_cap__oscillator")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();
    fade("cap_analyze_focus_a")
        .on_voice("spec_cap__analyzer")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();
    fade("cap_analyze_focus_b")
        .on_voice("spec_cap__analyzer")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("linear")
        .apply();

    fade("cap_amp_off")
        .on_voice("spec_cap__oscillator")
        .param("amp")
        .from(0.25)
        .to(0.0)
        .over_bars(1)
        .curve("step")
        .apply();
    fade("capture_off")
        .on_voice("spec_cap__oscillator")
        .param("capture")
        .from(1.0)
        .to(0.0)
        .over_bars(1)
        .curve("step")
        .apply();
    fade("play_amp_on")
        .on_voice("spec_play__oscillator")
        .param("amp")
        .from(0.0)
        .to(0.25)
        .over_bars(1)
        .curve("step")
        .apply();

    // ---- Playback phase fades (bars 8–15) ---------------------------
    //
    // Diagonal scan across the captured Array — slide and focus both
    // sweep 0 → 1 → 0 over 8 bars. Different trajectory than the capture
    // so the bilinear interpolation between cells is audible (each cell
    // is approached from a new corner).
    fade("play_slide_up")
        .on_voice("spec_play__oscillator")
        .param("slide")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();
    fade("play_slide_down")
        .on_voice("spec_play__oscillator")
        .param("slide")
        .from(1.0)
        .to(0.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();

    fade("play_focus_up")
        .on_voice("spec_play__oscillator")
        .param("focus")
        .from(0.0)
        .to(1.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();
    fade("play_focus_down")
        .on_voice("spec_play__oscillator")
        .param("focus")
        .from(1.0)
        .to(0.0)
        .over_bars(4)
        .curve("sine_in_out")
        .apply();

    fx("capture_verb")
        .synth("reverb_jpverb")
        .param("time", 3.5)
        .param("size", 0.7)
        .param("damping", 0.4)
        .param("mix", 0.35);
});

// 16-bar arrangement: capture in the first half, play back in the second.
// The voice swap at bar 8 is a set of 1-bar step fades; the playback fades
// start at bar 8 so the SAO scan begins immediately after the swap lands.
sequence("array_capture")
    .loop_bars(16)
    .clip(bars(0)..bars(16), melody("hold_cap"))
    .clip(bars(0)..bars(16), melody("hold_play"))
    // Capture phase
    .clip(bars(0)..bars(8),  fade("cap_slide"))
    .clip(bars(0)..bars(8),  fade("cap_f0"))
    .clip(bars(0)..bars(4),  fade("cap_focus_a"))
    .clip(bars(4)..bars(8),  fade("cap_focus_b"))
    .clip(bars(0)..bars(4),  fade("cap_analyze_focus_a"))
    .clip(bars(4)..bars(8),  fade("cap_analyze_focus_b"))
    // Voice swap
    .clip(bars(8)..bars(9),  fade("cap_amp_off"))
    .clip(bars(8)..bars(9),  fade("capture_off"))
    .clip(bars(8)..bars(9),  fade("play_amp_on"))
    // Playback phase
    .clip(bars(8)..bars(12), fade("play_slide_up"))
    .clip(bars(12)..bars(16),fade("play_slide_down"))
    .clip(bars(8)..bars(12), fade("play_focus_up"))
    .clip(bars(12)..bars(16),fade("play_focus_down"))
    .start();
