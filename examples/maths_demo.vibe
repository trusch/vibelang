// Maths demo — kr-port CV routing from Make Noise Maths.
//
// The Maths synthdef exposes control-rate ports (`ch1`, `ch4`, `sum`, `eor1`,
// and friends). This patch maps three of them into a held tb303 voice:
//
//   sum  -> bass.cutoff    via source-first `.to_param(...)`
//   ch4  -> bass.freq      via target-first `.modulate_by(...)`
//   eor1 -> bass.resonance via target-first `.modulate_by(...)`
//
// `.scale(...)` and `.offset(...)` shape the kr bus before it reaches the
// target param, so the Maths unit envelopes become useful musical ranges.

import "stdlib/instruments/eurorack/maths.vibe";
import "stdlib/synths/tb303.vibe";

set_tempo(120);

define_group("ctrl", || { });
define_group("bass", || { });

let m = voice("maths")
    .synth("maths")
    .group("ctrl")
    .param("rise1", 0.05)
    .param("fall1", 0.45)
    .param("rise4", 0.10)
    .param("fall4", 1.20)
    .param("cycle1", 1.0)
    .param("cycle4", 1.0);

let bass = voice("maths_bass")
    .synth("tb303_bass")
    .group("bass")
    .set_param("freq", 55.0)
    .set_param("amp", 0.45)
    .set_param("cutoff", 800.0)
    .set_param("resonance", 0.45)
    .set_param("env_mod", 0.0)
    .set_param("decay", 0.45);

m.output("sum")
    .to_param(bass, "cutoff")
    .scale(2600.0)
    .offset(500.0);

bass.param("freq")
    .modulate_by(m, "ch4")
    .scale(35.0)
    .offset(0.0);

bass.param("resonance")
    .modulate_by(m, "eor1")
    .scale(0.35)
    .offset(0.0);

m.outputs(["ch1", "ch2", "ch3", "or", "inv", "eoc1", "eor4", "eoc4"]).mute();

melody("bass_drone")
    .on(bass)
    .notes("A1 A1 A1 A1")
    .start();
