// Spectraphon dual-side chord patch.
//
// Two SAO oscillators tuned a perfect fifth apart (B = A · 1.4983),
// fed by separate Array buffers and summed into a reverb wash. With the
// previous `routing_mode` follow-helper gone, side B's frequency is
// computed explicitly from side A's at script time. No analyzers needed
// in SAO mode.

import "stdlib/instruments/spectral/spectraphon_oscillator.vibe";
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

set_tempo(72);

let freq_a = 110.0;                  // A2
let freq_b = freq_a * 1.4983;        // ~perfect fifth above

let chord = define_group("SpectraChord", || {
    let arr_a = allocate_buffer("chord_array_a", 65536, 1);
    let arr_b = allocate_buffer("chord_array_b", 65536, 1);

    let osc_a = voice("chord_a")
        .synth("spectraphon_oscillator")
        .set_param("freq", freq_a)
        .set_param("partials", 0.85)
        .set_param("slide", 0.6)
        .set_param("focus", 0.7)
        .set_param("amp", 0.22)
        .set_param("mode", 2.0)
        .set_param("array_buf", arr_a.bufnum)
        .gain(db(-9));

    let osc_b = voice("chord_b")
        .synth("spectraphon_oscillator")
        .set_param("freq", freq_b)
        .set_param("partials", 0.85)
        .set_param("slide", 0.6)
        .set_param("focus", 0.7)
        .set_param("amp", 0.22)
        .set_param("mode", 2.0)
        .set_param("array_buf", arr_b.bufnum)
        .gain(db(-9));

    osc_a.output("odd").to_current_group();
    osc_a.output("even").to_current_group();
    osc_a.output("sine").mute();
    osc_a.output("sub").mute();
    osc_b.output("odd").to_current_group();
    osc_b.output("even").to_current_group();
    osc_b.output("sine").mute();
    osc_b.output("sub").mute();

    osc_a.run();
    osc_b.run();

    fx("chord_verb")
        .synth("reverb_jpverb")
        .param("time", 5.5)
        .param("size", 0.85)
        .param("damping", 0.3)
        .param("mix", 0.45);
});

sequence("chord_main")
    .loop_bars(16)
    .start();
