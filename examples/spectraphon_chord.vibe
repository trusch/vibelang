// Spectraphon Story F1 — dual-side chord patch with FM and Follow.
//
// Demonstrates `spectraphon_dual`'s two distinguishing features over
// stacking two `spectraphon_side` voices:
//
//   1. The audio-rate FM bus between the two sides — each side's clean
//      reference sine modulates the other side's f0 with depth scaled
//      by the carrier (`a_fm_index`, `b_fm_index`).
//   2. The Follow-mode pitch ratio menu (`routing_mode`) — sets B's
//      pitch as a fixed musical interval above A.
//
// The four named outputs (`odd_a`, `even_a`, `odd_b`, `even_b`) are routed
// into the group together for a summed chord texture. With `routing_mode=2`
// (perfect fifth) and a touch of FM index,
// the sides produce the spectral chord families described in
// `kb/spectraphon-synthdef-plan.md` §3.e.
//
// See also: kb/spectraphon-howto.md §6, §7, §8c.

import "stdlib/instruments/spectral/spectraphon_dual.vibe" as spectraphon;
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

set_tempo(72);

// Side A drives the chord root. Side B follows A at +7 semitones
// (`routing_mode = 2.0`); freq_b is unused while Follow is engaged.
// `partials = 0.85` reveals 54 of 64 partials at the per-partial mask;
// `focus = 0.7` then multiplies the reveal scale by 1.55× (denser
// timbre) per the dual synthdef's focus_scale mapping.
let chord = define_group("SpectraChord", || {
    let v = spectraphon::spectraphon_dual("dual", "sao", "sao");
    v = spectraphon::spectraphon_set_param(v, "freq_a", 110.0);        // A2
    v = spectraphon::spectraphon_set_param(v, "partials_a", 0.85);
    v = spectraphon::spectraphon_set_param(v, "partials_b", 0.85);
    v = spectraphon::spectraphon_set_param(v, "slide_a", 0.6);         // tilt toward odd partials
    v = spectraphon::spectraphon_set_param(v, "slide_b", 0.6);
    v = spectraphon::spectraphon_set_param(v, "focus_a", 0.7);         // moderately dense
    v = spectraphon::spectraphon_set_param(v, "focus_b", 0.7);
    v = spectraphon::spectraphon_set_param(v, "routing_mode", 2.0);    // B = A · 1.4983 (perfect fifth)
    v = spectraphon::spectraphon_set_param(v, "amp", 0.22);
    v = spectraphon::spectraphon_gain(v, db(-9));
    v = spectraphon::spectraphon_run(v);

    spectraphon::spectraphon_outputs_to_current_group(v, ["odd_a", "even_a", "odd_b", "even_b"]);

    fx("chord_verb")
        .synth("reverb_jpverb")
        .param("time", 5.5)
        .param("size", 0.85)
        .param("damping", 0.3)
        .param("mix", 0.45);
});

sequence("chord_main")
    .loop_bars(16)
    .start();
