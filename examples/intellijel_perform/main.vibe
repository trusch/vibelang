// Intellijel performance rack patch.
//
// Signal chain:
//   Steppy clocks four Plonk percussion voices at 120 BPM.
//   Quadrax envelopes fan out into Plonk pitch/X/Y/mod CV destinations.
//   Plonk outs pass through a Mixup-style stereo stage, then mono fold into uFold.
//   uFold returns to stereo for Rainmaker's 16-tap dub rhythm delay.
//   Tetrapad pressure controls filter cutoff, Rainmaker feedback, and reverse.

import "stdlib/instruments/eurorack/plonk.vibe";
import "stdlib/instruments/eurorack/quadrax.vibe";
import "stdlib/instruments/eurorack/steppy.vibe";
import "stdlib/instruments/eurorack/tetrapad.vibe";
import "stdlib/processors/distortion/ufold.vibe";
import "stdlib/processors/delays/rainmaker.vibe";
import "stdlib/processors/filters/lowpass_stereo.vibe";
import "stdlib/processors/mixers/mixer4_stereo.vibe";
import "stdlib/effects/modulation/chorus.vibe";

set_tempo(120);

define_synthdef("intellijel_mono_to_stereo", |builder| {
    builder
        .input("in", 1)
        .param("pan", 0.0)
        .param("level", 1.0)
        .body_map(|p| {
            let sig = p.inputs["in"] * p.level;
            let pan = clip(p.pan, -1.0, 1.0);
            let left = sig * (1.0 - pan) * 0.5;
            let right = sig * (1.0 + pan) * 0.5;

            [left, right]
        })
});

define_synthdef("intellijel_stereo_to_fold", |builder| {
    builder
        .input("in", 2)
        .output("out")
        .param("balance", 0.0)
        .param("level", 1.0)
        .body_map(|p| {
            let bal = clip(p.balance, -1.0, 1.0);
            let left_gain = (1.0 - bal) * 0.5;
            let right_gain = (1.0 + bal) * 0.5;
            let mono = p.inputs["in"][0] * left_gain + p.inputs["in"][1] * right_gain;

            [softclip(mono * p.level)]
        })
});

define_group("ctrl", || { });
define_group("plonk_raw", || { });
define_group("mixup_bus", || { });
define_group("fold_bus", || { });
define_group("delay_bus", || { });
define_group("perform_out", || {
    fx("tetrapad_chorus")
        .synth("chorus")
        .param("rate", 0.45)
        .param("depth", 0.008)
        .param("mix", 0.22)
        .param("level", 0.92)
        .apply();
});

group("ctrl").gain(0.0);
group("plonk_raw").gain(0.0);
group("mixup_bus").gain(0.0);
group("fold_bus").gain(0.0);
group("delay_bus").gain(0.0);
group("perform_out").gain(db(-8));

let steppy_seq = voice("steppy_120bpm")
    .synth("steppy")
    .group("ctrl")
    .modulator_only()
    .set_param("bpm", 120.0)
    .set_param("track_a_steps", 16.0)
    .set_param("track_a_pattern", 4369.0)
    .set_param("track_a_gate_len", 0.28)
    .set_param("track_b_steps", 16.0)
    .set_param("track_b_pattern", 17476.0)
    .set_param("track_b_gate_len", 0.22)
    .set_param("track_c_steps", 16.0)
    .set_param("track_c_pattern", 65535.0)
    .set_param("track_c_gate_len", 0.12)
    .set_param("track_d_steps", 16.0)
    .set_param("track_d_pattern", 18504.0)
    .set_param("track_d_gate_len", 0.18)
    .set_param("track_d_probability", 0.82)
    .set_param("track_d_rotate", 1.0);

let quadrax_env = voice("quadrax_percussion_mod")
    .synth("quadrax")
    .group("ctrl")
    .modulator_only()
    .set_param("rise_1", 0.006)
    .set_param("fall_1", 0.22)
    .set_param("shape_1", -0.40)
    .set_param("mode_1", 0.0)
    .set_param("level_1", 0.62)
    .set_param("rise_2", 0.018)
    .set_param("fall_2", 0.34)
    .set_param("shape_2", 0.35)
    .set_param("mode_2", 0.0)
    .set_param("level_2", 0.58)
    .set_param("rise_3", 0.002)
    .set_param("fall_3", 0.075)
    .set_param("shape_3", 0.70)
    .set_param("mode_3", 0.0)
    .set_param("level_3", 0.46)
    .set_param("rise_4", 0.010)
    .set_param("fall_4", 0.52)
    .set_param("shape_4", -0.20)
    .set_param("mode_4", 0.0)
    .set_param("level_4", 0.72);

let touch = voice("tetrapad_live_surface")
    .synth("tetrapad")
    .group("ctrl")
    .modulator_only()
    .set_param("pressure_1", 0.62)
    .set_param("position_1", 0.50)
    .set_param("encoder_1", 0.34)
    .set_param("mode_1", 6.0)
    .set_param("slew_1", 0.18)
    .set_param("pressure_2", 0.58)
    .set_param("position_2", 0.68)
    .set_param("encoder_2", 0.52)
    .set_param("mode_2", 3.0)
    .set_param("slew_2", 0.22)
    .set_param("pressure_3", 0.74)
    .set_param("position_3", 0.72)
    .set_param("encoder_3", 0.56)
    .set_param("mode_3", 3.0)
    .set_param("slew_3", 0.15)
    .set_param("pressure_4", 0.88)
    .set_param("position_4", 0.90)
    .set_param("encoder_4", 0.50)
    .set_param("mode_4", 4.0)
    .set_param("slew_4", 0.02)
    .set_param("threshold", 0.08);

let plonk_kick = voice("plonk_kick_drumhead")
    .synth("plonk")
    .group("plonk_raw")
    .set_param("pitch", 38.0)
    .set_param("vel", 0.53)
    .set_param("x", 0.28)
    .set_param("y", 0.34)
    .set_param("exciter_mode", 1.0)
    .set_param("exciter_decay", 0.020)
    .set_param("object_mode", 3.0)
    .set_param("saturation", 0.22)
    .set_param("pitch_cv_amt", 0.36);

let plonk_snare = voice("plonk_snare_marimba")
    .synth("plonk")
    .group("plonk_raw")
    .set_param("pitch", 53.0)
    .set_param("vel", 0.40)
    .set_param("x", 0.52)
    .set_param("y", 0.70)
    .set_param("exciter_mode", 2.0)
    .set_param("exciter_decay", 0.012)
    .set_param("object_mode", 2.0)
    .set_param("saturation", 0.12)
    .set_param("x_cv_amt", 0.48);

let plonk_hat = voice("plonk_hat_beam")
    .synth("plonk")
    .group("plonk_raw")
    .set_param("pitch", 82.0)
    .set_param("vel", 0.25)
    .set_param("x", 0.78)
    .set_param("y", 0.88)
    .set_param("exciter_mode", 2.0)
    .set_param("exciter_decay", 0.006)
    .set_param("object_mode", 1.0)
    .set_param("saturation", 0.08)
    .set_param("bitcrush", 0.12)
    .set_param("y_cv_amt", 0.40);

let plonk_plate = voice("plonk_sync_plate")
    .synth("plonk")
    .group("plonk_raw")
    .set_param("pitch", 65.0)
    .set_param("vel", 0.36)
    .set_param("x", 0.42)
    .set_param("y", 0.58)
    .set_param("exciter_mode", 0.0)
    .set_param("exciter_decay", 0.018)
    .set_param("object_mode", 5.0)
    .set_param("saturation", 0.18)
    .set_param("mod_cv_amt", 0.44);

steppy_seq.output("gate_a").to_param(plonk_kick, "trig");
steppy_seq.output("gate_b").to_param(plonk_snare, "trig");
steppy_seq.output("gate_c").to_param(plonk_hat, "trig");
steppy_seq.output("gate_d").to_param(plonk_plate, "trig");
steppy_seq.output("gate_a").to_param(quadrax_env, "trig_1");
steppy_seq.output("gate_b").to_param(quadrax_env, "trig_2");
steppy_seq.output("gate_c").to_param(quadrax_env, "trig_3");
steppy_seq.output("gate_d").to_param(quadrax_env, "trig_4");
steppy_seq.output("clock").mute();

quadrax_env.output("env1").to_param(plonk_kick, "pitch_cv").scale(0.9).offset(0.0);
quadrax_env.output("env2").to_param(plonk_snare, "x_cv").scale(0.8).offset(0.0);
quadrax_env.output("env3").to_param(plonk_hat, "y_cv").scale(0.9).offset(0.0);
quadrax_env.output("env4").to_param(plonk_plate, "mod_cv").scale(0.85).offset(0.0);
quadrax_env.outputs([
    "eor1", "eof1", "eor2", "eof2", "eor3", "eof3", "eor4", "eof4"
]).mute();

let kick_stereo = voice("kick_mixup_channel")
    .synth("intellijel_mono_to_stereo")
    .group("mixup_bus")
    .set_param("pan", -0.18)
    .set_param("level", 1.00);
kick_stereo.input("in").from(plonk_kick);
kick_stereo.output("out").mute();

let snare_stereo = voice("snare_mixup_channel")
    .synth("intellijel_mono_to_stereo")
    .group("mixup_bus")
    .set_param("pan", 0.12)
    .set_param("level", 0.82);
snare_stereo.input("in").from(plonk_snare);
snare_stereo.output("out").mute();

let hat_stereo = voice("hat_mixup_channel")
    .synth("intellijel_mono_to_stereo")
    .group("mixup_bus")
    .set_param("pan", 0.58)
    .set_param("level", 0.48);
hat_stereo.input("in").from(plonk_hat);
hat_stereo.output("out").mute();

let plate_stereo = voice("plate_mixup_channel")
    .synth("intellijel_mono_to_stereo")
    .group("mixup_bus")
    .set_param("pan", -0.52)
    .set_param("level", 0.64);
plate_stereo.input("in").from(plonk_plate);
plate_stereo.output("out").mute();

let mixup = voice("mixup_percussion_sum")
    .synth("mixer4_stereo")
    .group("mixup_bus")
    .set_param("ch1_gain", 0.92)
    .set_param("ch2_gain", 0.86)
    .set_param("ch3_gain", 0.58)
    .set_param("ch4_gain", 0.74)
    .set_param("level", 0.50);
mixup.input("ch1").from(kick_stereo);
mixup.input("ch2").from(snare_stereo);
mixup.input("ch3").from(hat_stereo);
mixup.input("ch4").from(plate_stereo);
mixup.output("out").mute();

let fold_send = voice("mixup_to_ufold")
    .synth("intellijel_stereo_to_fold")
    .group("fold_bus")
    .set_param("balance", -0.08)
    .set_param("level", 0.64);
fold_send.input("in").from(mixup);
fold_send.output("out").mute();

let folder = voice("ufold_harmonic_enrichment")
    .synth("ufold")
    .group("fold_bus")
    .set_param("folds", 0.42)
    .set_param("symmetry", -0.08)
    .set_param("stages", 4.0)
    .set_param("level", 0.46);
folder.input("in").from(fold_send);
folder.output("out").mute();

let folded_stereo = voice("ufold_to_rainmaker_stereo")
    .synth("intellijel_mono_to_stereo")
    .group("delay_bus")
    .set_param("pan", 0.0)
    .set_param("level", 0.56);
folded_stereo.input("in").from(folder);
folded_stereo.output("out").mute();

let rainmaker_dub = voice("rainmaker_16tap_dub")
    .synth("rainmaker")
    .group("delay_bus")
    .set_param("time", 375.0)
    .set_param("grid", 16.0)
    .set_param("feedback", 0.26)
    .set_param("feedback_pitch", -5.0)
    .set_param("feedback_tone", 0.42)
    .set_param("wet_dry", 0.35)
    .set_param("tap_level_1", 0.44)
    .set_param("tap_level_2", 0.07)
    .set_param("tap_level_3", 0.20)
    .set_param("tap_level_4", 0.12)
    .set_param("tap_level_5", 0.30)
    .set_param("tap_level_6", 0.10)
    .set_param("tap_level_7", 0.17)
    .set_param("tap_level_8", 0.25)
    .set_param("tap_level_9", 0.35)
    .set_param("tap_level_10", 0.06)
    .set_param("tap_level_11", 0.19)
    .set_param("tap_level_12", 0.13)
    .set_param("tap_level_13", 0.27)
    .set_param("tap_level_14", 0.11)
    .set_param("tap_level_15", 0.18)
    .set_param("tap_level_16", 0.24)
    .set_param("tap_pitch_5", 7.0)
    .set_param("tap_pitch_9", -12.0)
    .set_param("tap_pitch_13", 5.0)
    .set_param("tap_filter_cutoff_1", 7800.0)
    .set_param("tap_filter_cutoff_5", 5200.0)
    .set_param("tap_filter_cutoff_9", 3600.0)
    .set_param("tap_filter_cutoff_13", 2500.0)
    .set_param("comb_size", 148.0)
    .set_param("comb_feedback", 0.29)
    .set_param("comb_taps", 18.0)
    .set_param("comb_density", 0.64)
    .set_param("comb_nonlinear", 0.18)
    .set_param("comb_mix", 0.16);
rainmaker_dub.input("in").from(folded_stereo);
rainmaker_dub.output("out").mute();

let performance_filter = voice("tetrapad_filter_cutoff")
    .synth("lowpass_stereo")
    .group("perform_out")
    .set_param("cutoff", 4200.0)
    .set_param("resonance", 0.36)
    .set_param("mix", 0.82)
    .set_param("level", 0.54);
performance_filter.input("in").from(rainmaker_dub);
performance_filter.output("out").to_current_group();

touch.output("pad2_b").to_param(performance_filter, "cutoff").scale(2800.0).offset(4200.0);
touch.output("pad3_a").to_param(rainmaker_dub, "feedback").scale(0.34).offset(0.36);
touch.output("pad3_b").to_param(rainmaker_dub, "comb_feedback").scale(0.20).offset(0.48);
touch.output("pad4_a").to_param(rainmaker_dub, "reverse").scale(2.0).offset(0.0);
touch.outputs(["pad1_a", "pad1_b", "pad2_a", "pad4_b"]).mute();

plonk_kick.output("out").mute();
plonk_snare.output("out").mute();
plonk_hat.output("out").mute();
plonk_plate.output("out").mute();

steppy_seq.run();
quadrax_env.run();
touch.run();
plonk_kick.run();
plonk_snare.run();
plonk_hat.run();
plonk_plate.run();
kick_stereo.run();
snare_stereo.run();
hat_stereo.run();
plate_stereo.run();
mixup.run();
fold_send.run();
folder.run();
folded_stereo.run();
rainmaker_dub.run();
performance_filter.run();
