// Marbles multi-output demo — six-port routing topology.
//
// Wires the `marbles` synthdef (six audio-rate CV-style output ports:
// t1/t2/t3, x1/x2/x3) into the current routing surface:
//
//   t1 -> monitor group for hardware / scope routing
//   x1 -> bass.freq through `.to_param_audio(...)`
//   x2 -> bass.cutoff through `.to_param_audio(...)`
//   x3 -> monitor group for hardware / scope routing
//
// Topology (read top-down — first three rows are marbles fan-out, last
// three are the audible-context patch):
//
//   marbles.t1 ──► trig_bus group
//   marbles.x1 ──► bass.freq       (linear Hz demo, not calibrated V/oct)
//   marbles.x2 ──► bass.cutoff
//   marbles.x3 ──► pitch_cv group
//   marbles.{t2,t3} ──► muted
//
//   kick (kick_techno_deep) ──► main      [retriggered by a 4 Hz cv_clock
//                                          melody for audible context]
//   bass (bass_moog)        ──► main      [modulated by x1/x2]

import "stdlib/instruments/eurorack/marbles.vibe";
import "stdlib/drums/kicks/kick_techno_deep.vibe";
import "stdlib/bass/synth/bass_moog.vibe";

set_tempo(120);

// One mix-only group per CV destination. On real hardware you'd pin each
// to an ES-3 jack pair via `.output([N, N+1])`, matching the
// `examples/cv_calibration.vibe` pattern; we leave that step out so the
// demo runs on a default 2-channel JACK setup.
define_group("trig_bus", || { });
define_group("pitch_cv", || { });

// === Marbles generator ====================================================
// One voice driving all six ports. Params chosen for an audible "natural
// rhythm" feel: 4 Hz master, moderately dense T-section, ±0.6 octave
// pitch spread, length=8 for a strong "deja vu" pattern recall.
let m = voice("marbles")
    .synth("marbles")
    .set_param("clock", 0.25)         // 4 Hz master clock
    .set_param("bias_t", 0.65)        // ~65% of clock ticks fire
    .set_param("spread_t", 0.45)      // moderate rhythmic spread
    .set_param("bias_x", 0.5)         // centred at 0V (=C4)
    .set_param("spread_x", 0.6)       // ±0.6 octave gaussian width
    .set_param("length", 8.0)         // strong Markov memory
    .set_param("quant_steps", 12.0)   // chromatic
    .gain(db(-12));

// === Audible context — kick + bass =======================================
// Kick: kick_techno_deep is a percussive one-shot, so we drive it with a
// melody at the master rate to give the Marbles patch audible context.
let k = voice("kick")
    .synth("kick_techno_deep")
    .set_param("freq", 50.0)
    .set_param("amp", 0.9)
    .gain(db(-3));

melody("kick_pulse")
    .on(k)
    .notes("C2 - - -")                // 4 Hz at 120 BPM = quarter notes
    .start();

// Bass: x1 bends frequency linearly around A1, and x2 sweeps the ladder
// cutoff. For calibrated V/oct pitch, route x1 to hardware or add a
// dedicated V/oct-to-Hz shaping stage.
let b = voice("bass")
    .synth("bass_moog")
    .set_param("freq", 55.0)          // A1
    .set_param("cutoff", 600.0)
    .set_param("res", 0.5)
    .gain(db(-9));

m.output("t1").to(group("trig_bus"));
m.output("x1").to_param_audio(b, "freq").scale(35.0).offset(55.0);
m.output("x2").to_param_audio(b, "cutoff").scale(1200.0).offset(1200.0);
m.output("x3").to(group("pitch_cv"));
m.outputs(["t2", "t3"]).mute();

melody("bass_drone").on(b).notes("A1").start();

// Kick off the marbles generator. It continues running until reload —
// its routed signals fan out to the three CV groups defined above.
voice("marbles").start();
