// Tutorial: Filesystem Extension (ext-fs)
// Difficulty: intermediate | Duration: 5 min
// Description: Use file system operations in your VibeLang scripts.
//
// NOTE: This extension must be enabled with the `ext-fs` feature flag.
// Run with: vibelang run --ext-fs example.vibe
//
// This tutorial is self-contained: every file and directory it reads,
// copies, renames, or removes is created by the script first, and a
// cleanup section at the end removes everything so repeated runs stay
// clean.

// ============================================================
// WRITING FILES
// ============================================================

// Write content to a file (creates or overwrites)
write_file("my_notes.txt", "Remember: the bridge needs more cowbell.\n");

// Append content to a file
append_file("my_notes.txt", "Also: try a half-time feel in the outro.\n");

// Write a multi-line file we'll read back line by line
write_file("song_list.txt", "Midnight Drive\nNeon Rain\nLast Train Home\n");

// ============================================================
// READING FILES
// ============================================================

// Read entire file as a string
let content = read_file("my_notes.txt");
print("File contents: " + content);

// Read file as array of lines
let lines = read_lines("song_list.txt");
for line in lines {
    print("Song: " + line);
}

// ============================================================
// FILE INFORMATION
// ============================================================

// Check if a file exists
if file_exists("my_notes.txt") {
    print("Notes file found!");
}

// Check if path is a directory (negative branch is harmless)
if is_dir("samples") {
    print("Samples directory exists");
}

// Check if path is a file
if is_file("song_list.txt") {
    print("Song list is a regular file");
}

// Get file size in bytes
let size = file_size("my_notes.txt");
print("Notes file size: " + size + " bytes");

// ============================================================
// DIRECTORY OPERATIONS
// ============================================================

// Create a directory
create_dir("fs_demo");

// Create nested directories in one call
create_dir_all("fs_demo/renders/2024");

// List directory contents
let entries = list_dir("fs_demo");
for entry in entries {
    print("Found in fs_demo: " + entry);
}

// Remove an empty directory (only works when it's empty)
create_dir("fs_demo/temp_folder");
remove_dir("fs_demo/temp_folder");

// ============================================================
// FILE OPERATIONS
// ============================================================

// Copy a file
let bytes_copied = copy_file("my_notes.txt", "fs_demo/notes_backup.txt");
print("Copied " + bytes_copied + " bytes");

// Rename or move a file
rename_file("fs_demo/notes_backup.txt", "fs_demo/notes_archive.txt");

// Remove a file
write_file("fs_demo/temp_file.txt", "scratch data");
remove_file("fs_demo/temp_file.txt");

// ============================================================
// GLOB PATTERN MATCHING
// ============================================================

// Find all .txt files in the current directory
let txt_files = glob("*.txt");
for f in txt_files {
    print("Text file: " + f);
}

// Find all .vibe files in the current directory
let all_vibes = glob("*.vibe");
print("Found " + all_vibes.len() + " vibe files");

// Patterns can also reach into subdirectories,
// e.g. glob("stems/**/*.wav") for a recursive search below stems/.

// Find files with wildcards (an empty result is fine)
let tracks = glob("track_??.wav");  // Matches track_01.wav, track_02.wav, etc.
print("Matched " + tracks.len() + " track files");

// ============================================================
// PATH UTILITIES
// ============================================================

// Join path components
let full_path = path_join("samples", "kicks/kick_01.wav");
print("Full path: " + full_path);

// Get parent directory
let parent = path_parent("/home/user/music/song.vibe");
print("Parent: " + parent);  // /home/user/music

// Get filename
let name = path_filename("/path/to/my_sample.wav");
print("Filename: " + name);  // my_sample.wav

// Get file extension
let ext = path_extension("song.vibe");
print("Extension: " + ext);  // vibe

// Get filename without extension (stem)
let stem = path_stem("my_song.vibe");
print("Stem: " + stem);  // my_song

// ============================================================
// PRACTICAL EXAMPLE: Load samples from a directory
// ============================================================

import "stdlib/drums/kicks/kick_808.vibe";

set_tempo(120);

// Find all kick samples in a directory and load them.
// (If the directory doesn't exist, glob simply returns no matches.)
let kick_files = glob("samples/kicks/*.wav");

for file in kick_files {
    let name = path_stem(file);
    print("Loading kick: " + name);

    // Create a sample from each file
    let smp = sample(name, file);

    // Create a voice for it
    voice(name)
        .on(smp)
        .gain(db(-6))
        .group("kicks");
}

// ============================================================
// PRACTICAL EXAMPLE: Save session state to JSON
// ============================================================

let session = #{
    tempo: 120,
    time_signature: "4/4",
    tracks: ["drums", "bass", "lead"],
    last_modified: "2024-01-15"
};

// Convert to JSON and save
let json = json_stringify(session);
write_file("session.json", json);

// Later, load it back
if file_exists("session.json") {
    let loaded = json_parse(read_file("session.json"));
    print("Loaded session at tempo: " + loaded.tempo);
}

// ============================================================
// CLEANUP
// ============================================================

// Remove everything this tutorial created so re-runs start fresh.
remove_file("my_notes.txt");
remove_file("song_list.txt");
remove_file("session.json");
remove_file("fs_demo/notes_archive.txt");

// remove_dir only removes empty directories, so delete innermost first.
remove_dir("fs_demo/renders/2024");
remove_dir("fs_demo/renders");
remove_dir("fs_demo");

print("Filesystem tutorial complete, demo files cleaned up.");
