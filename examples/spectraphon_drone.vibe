// Spectraphon drone — single-side SAO hello-world.
// Uses the built-in SAO fallback spectrum so the patch makes sound without
// hardware input, then routes the odd/even banks through a long jpverb tail.

import "stdlib/instruments/spectral/spectraphon_side.vibe";
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

let pad = voice("pad")
    .synth("spectraphon_side")
    .set_param("freq", 110.0)
    .set_param("partials", 0.7)
    .set_param("sam_capture", 0.0)
    .set_param("amp", 0.4);

pad.outputs(["odd", "even"]).to_current_group();
pad.outputs(["sine", "sub"]).mute();

voice("pad").fx("reverb_jpverb", #{ time: 4.0, mix: 0.5 });
pad.start();
