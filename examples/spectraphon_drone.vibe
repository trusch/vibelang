// Spectraphon drone — single SAO oscillator hello-world.
//
// Uses the built-in SAO fallback spectrum (1/k harmonic series when the
// array buffer is empty), then routes the odd/even banks through a long
// jpverb tail.
//
// SAO mode (mode = 2.0) reads from the array buffer with bilinear
// (slide, focus) interpolation. With no captured spectrum loaded the
// oscillator falls back to the 1/k partial weighting documented in
// spectraphon_oscillator.vibe — clean enough to drive a drone with.
// No analyzer voice is needed in SAO mode.

import "stdlib/instruments/spectral/spectraphon_oscillator.vibe";
import "stdlib/effects/reverbs/reverb_jpverb.vibe";

define_group("pad_wash", || {
    fx("pad_verb")
        .synth("reverb_jpverb")
        .param("time", 4.0)
        .param("mix", 0.5);
});

let pad_array = allocate_buffer("pad_arrays", 65536, 1);

let pad = voice("pad_osc")
    .synth("spectraphon_oscillator")
    .set_param("freq", 110.0)
    .set_param("partials", 0.7)
    .set_param("amp", 0.4)
    .set_param("mode", 2.0)
    .set_param("array_buf", pad_array.bufnum);

pad.output("odd").to(group("pad_wash"));
pad.output("even").to(group("pad_wash"));
pad.output("sine").mute();
pad.output("sub").mute();

pad.run();
