// Integration Test 21: Extended Fade Curve Types
// Tests: All curve types for fade automation
//
// This test verifies:
// - Linear curve (default)
// - Ease curves (ease_in, ease_out, ease_in_out)
// - Sine curves (sine_in, sine_out, sine_in_out)
// - Cubic curves (cubic_in, cubic_out, cubic_in_out)
// - Exponential curve with custom exponent
// - Logarithmic curve
// - Step curve
// - Custom spline curves with control points

test_start("curve_types");

set_tempo(120);
set_time_signature(4, 4);

// =============================================================================
// Test 1: Synthdef Setup
// =============================================================================

define_synthdef("curve_test")
    .param("freq", 440.0)
    .param("amp", 0.2)
    .param("gate", 1.0)
    .body(|freq, amp, gate| {
        let env = envelope()
            .perc("1ms", "50ms")
            .gate(gate)
            .cleanup_on_finish()
            .build();
        sin_osc_ar(freq) * env * amp
    });

// Effect for testing effect fades
define_synthdef("curve_reverb")
    .param("in_bus", 0.0)
    .param("mix", 0.3)
    .body(|in_bus, mix| {
        let input = in_ar(in_bus, 2);
        let reverb = free_verb_ar(input, mix, 0.5, 0.5);
        replace_out(in_bus, reverb)
    });

// =============================================================================
// Test 2: Linear Curve (Default)
// =============================================================================

let linear_group = define_group("LinearCurveGroup", || {
    let v = voice("linear_voice").synth("curve_test").gain(db(-18));
});

// Create a fade with linear curve (default)
let linear_fade = fade("linear_fade")
    .on_group("LinearCurveGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("linear");

assert_true(true, "linear curve fade created");

// =============================================================================
// Test 3: Ease-In Curve (t^2 - slow start)
// =============================================================================

let ease_in_group = define_group("EaseInGroup", || {
    let v = voice("ease_in_voice").synth("curve_test").gain(db(-18));
});

let ease_in_fade = fade("ease_in_fade")
    .on_group("EaseInGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("ease_in");

assert_true(true, "ease_in curve fade created");

// Test alternate syntax
let ease_in_fade2 = fade("ease_in_fade2")
    .on_group("EaseInGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over(16)
    .curve("easein");

assert_true(true, "easein alternate syntax works");

// =============================================================================
// Test 4: Ease-Out Curve (fast start, slow end)
// =============================================================================

let ease_out_group = define_group("EaseOutGroup", || {
    let v = voice("ease_out_voice").synth("curve_test").gain(db(-18));
});

let ease_out_fade = fade("ease_out_fade")
    .on_group("EaseOutGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("ease_out");

assert_true(true, "ease_out curve fade created");

// =============================================================================
// Test 5: Ease-In-Out Curve (smooth S-curve)
// =============================================================================

let ease_inout_group = define_group("EaseInOutGroup", || {
    let v = voice("ease_inout_voice").synth("curve_test").gain(db(-18));
});

let ease_inout_fade = fade("ease_inout_fade")
    .on_group("EaseInOutGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("ease_in_out");

assert_true(true, "ease_in_out curve fade created");

// Test "ease" shorthand
let ease_fade = fade("ease_fade")
    .on_group("EaseInOutGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("ease");

assert_true(true, "ease shorthand works");

