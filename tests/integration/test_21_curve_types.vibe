// =============================================================================
// Test 15: Cubic Spline with Flat Array
// =============================================================================

let spline_group = define_group("SplineGroup", || {
    let v = voice("spline_voice").synth("curve_test").gain(db(-18));
});

// Create spline with flat array of [t1, v1, t2, v2, ...]
let spline_fade = fade("spline_fade")
    .on_group("SplineGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(8)
    .spline([0.25, 0.1, 0.5, 0.9, 0.75, 0.3]);

assert_true(true, "spline curve with flat array created");

// =============================================================================
// Test 16: Cubic Spline with .point() Builder
// =============================================================================

let point_spline_group = define_group("PointSplineGroup", || {
    let v = voice("point_spline_voice").synth("curve_test").gain(db(-18));
});

// Build spline incrementally using .point()
let point_spline_fade = fade("point_spline_fade")
    .on_group("PointSplineGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(8)
    .point(0.2, 0.8)   // quick rise
    .point(0.4, 0.2)   // dip
    .point(0.6, 0.9)   // rise again
    .point(0.8, 0.5);  // settle

assert_true(true, "spline curve with .point() builder created");

// =============================================================================
// Test 17: Single Control Point Spline
// =============================================================================

let single_point_group = define_group("SinglePointGroup", || {
    let v = voice("single_point_voice").synth("curve_test").gain(db(-18));
});

// Single control point
let single_point_fade = fade("single_point_fade")
    .on_group("SinglePointGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .point(0.5, 0.8);  // Peak at midpoint

assert_true(true, "single point spline created");

// =============================================================================
// Test 18: Complex Multi-Point Spline
// =============================================================================

let complex_spline_group = define_group("ComplexSplineGroup", || {
    let v = voice("complex_spline_voice").synth("curve_test").gain(db(-18));
});

// Complex spline with many control points
let complex_spline_fade = fade("complex_spline_fade")
    .on_group("ComplexSplineGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(16)
    .point(0.1, 0.3)
    .point(0.2, 0.7)
    .point(0.3, 0.2)
    .point(0.4, 0.8)
    .point(0.5, 0.5)
    .point(0.6, 0.9)
    .point(0.7, 0.3)
    .point(0.8, 0.6)
    .point(0.9, 0.4);

assert_true(true, "complex multi-point spline created");

// =============================================================================
// Test 19: Fades on Voices
// =============================================================================

let voice_fade_group = define_group("VoiceFadeGroup", || {
    let v = voice("voice_fade_test").synth("curve_test").gain(db(-18));

    // Fade on voice with ease curve
    let voice_fade = fade("voice_ease")
        .on_voice("voice_fade_test")
        .param("freq")
        .from(220.0)
        .to(880.0)
        .over_bars(4)
        .curve("ease_in_out");

    assert_true(true, "ease_in_out fade on voice created");

    // Fade on voice with spline
    let voice_spline = fade("voice_spline")
        .on_voice("voice_fade_test")
        .param("amp")
        .from(0.0)
        .to(1.0)
        .over_bars(8)
        .point(0.3, 0.9)
        .point(0.7, 0.1);

    assert_true(true, "spline fade on voice created");
});

// =============================================================================
// Test 20: Fades on Effects
// =============================================================================

let effect_fade_group = define_group("EffectFadeGroup", || {
    let v = voice("effect_fade_voice").synth("curve_test").gain(db(-18));

    // Add effect
    fx("test_reverb_fx").synth("curve_reverb").param("mix", 0.0).apply();

    // Fade reverb mix with cubic curve
    let effect_fade = fade("effect_cubic")
        .on_effect("test_reverb_fx")
        .param("mix")
        .from(0.0)
        .to(0.8)
        .over_bars(8)
        .curve("cubic_in_out");

    assert_true(true, "cubic fade on effect created");

    // Fade with custom exponential
    let effect_exp = fade("effect_exp")
        .on_effect("test_reverb_fx")
        .param("mix")
        .from(0.0)
        .to(0.5)
        .over_bars(4)
        .exp(2.5);

    assert_true(true, "exponential fade on effect created");
});

// =============================================================================
// Test 21: Curve Names Case Insensitivity
// =============================================================================

let case_group = define_group("CaseGroup", || {
    let v = voice("case_voice").synth("curve_test").gain(db(-18));
});

// Test various case combinations
let case_fade1 = fade("case1").on_group("CaseGroup").param("amp").curve("EASE_IN");
let case_fade2 = fade("case2").on_group("CaseGroup").param("amp").curve("EaseIn");
let case_fade3 = fade("case3").on_group("CaseGroup").param("amp").curve("ease-in");
let case_fade4 = fade("case4").on_group("CaseGroup").param("amp").curve("eASe_iN");

assert_true(true, "curve names are case insensitive");

// =============================================================================
// Test 22: Hyphen and Underscore Variants
// =============================================================================

let variant_group = define_group("VariantGroup", || {
    let v = voice("variant_voice").synth("curve_test").gain(db(-18));
});

// Test underscore variants
let underscore_fade = fade("underscore").on_group("VariantGroup").param("amp").curve("ease_in_out");

// Test hyphen variants
let hyphen_fade = fade("hyphen").on_group("VariantGroup").param("amp").curve("ease-in-out");

// Test no separator variants
let nosep_fade = fade("nosep").on_group("VariantGroup").param("amp").curve("easeinout");

assert_true(true, "curve name separator variants work");

// =============================================================================
// Test 23: Unknown Curve Defaults to Linear
// =============================================================================

let unknown_group = define_group("UnknownGroup", || {
    let v = voice("unknown_voice").synth("curve_test").gain(db(-18));
});

// Unknown curve name should default to linear
let unknown_fade = fade("unknown_fade")
    .on_group("UnknownGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("not_a_real_curve");

assert_true(true, "unknown curve defaults to linear");

// =============================================================================
// Test 24: Negative Direction Fades
// =============================================================================

let negative_group = define_group("NegativeGroup", || {
    let v = voice("negative_voice").synth("curve_test").gain(db(-18));
});

// Fade down with ease curve
let fade_down = fade("fade_down")
    .on_group("NegativeGroup")
    .param("amp")
    .from(1.0)
    .to(0.0)
    .over_bars(4)
    .curve("ease_out");  // Fast start, slow end for fade out

assert_true(true, "negative direction fade works with curves");

// Fade down with cubic
let fade_down_cubic = fade("fade_down_cubic")
    .on_group("NegativeGroup")
    .param("amp")
    .from(1.0)
    .to(0.0)
    .over_bars(4)
    .curve("cubic_out");

assert_true(true, "fade down with cubic_out works");

// =============================================================================
// Test 25: Chaining Multiple Curve Methods
// =============================================================================

let chain_group = define_group("ChainGroup", || {
    let v = voice("chain_voice").synth("curve_test").gain(db(-18));
});

// Last curve method should win
let chain_fade = fade("chain_fade")
    .on_group("ChainGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("linear")    // First set linear
    .curve("ease_in")   // Override to ease_in
    .exp(3.0);          // Override to exponential with exp=3

assert_true(true, "curve method chaining works (last wins)");

// Override spline with curve name
let chain_spline = fade("chain_spline")
    .on_group("ChainGroup")
    .param("amp")
    .point(0.5, 0.5)    // Start with spline
    .curve("sine");     // Override to sine

assert_true(true, "can override spline with curve name");

// Override curve with spline
let chain_to_spline = fade("chain_to_spline")
    .on_group("ChainGroup")
    .param("amp")
    .curve("sine")      // Start with sine
    .point(0.3, 0.7);   // Override to spline

assert_true(true, "can override curve with spline");

test_end_and_exit();
