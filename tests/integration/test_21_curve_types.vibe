// =============================================================================
// Test 12: Exponential Curve with Custom Exponent
// =============================================================================

let exp_group = define_group("ExponentialGroup", || {
    let v = voice("exp_voice").synth("curve_test").gain(db(-18));
});

// Default exponential (exponent = 2.0)
let exp_fade_default = fade("exp_default")
    .on_group("ExponentialGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .curve("exp");

assert_true(true, "default exponential curve created");

// Custom exponent using .exp() method
let exp_fade_custom = fade("exp_custom")
    .on_group("ExponentialGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(8)
    .exp(3.0);  // Cubic exponent

assert_true(true, "custom exponential (3.0) curve created");

// Higher exponent for more dramatic curve
let exp_fade_high = fade("exp_high")
    .on_group("ExponentialGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(16)
    .exp(5.0);

assert_true(true, "high exponential (5.0) curve created");

// Linear equivalent (exponent = 1.0)
let exp_fade_linear = fade("exp_linear")
    .on_group("ExponentialGroup")
    .param("amp")
    .from(0.0)
    .to(1.0)
    .over_bars(4)
    .exp(1.0);  // Should behave like linear

assert_true(true, "exponential (1.0) equals linear");

