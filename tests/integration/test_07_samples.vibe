// Integration Test 07: Samples
// Tests: sample loading, playback, rate, envelope, loop mode, warp mode
//
// This test verifies:
// - Samples load from file paths
// - Sample playback works with voices
// - Rate/pitch manipulation works
// - Envelope settings work
// - Loop mode works
//
// Note: This test requires sample files to exist in samples/ directory

test_start("samples");

set_tempo(120);

// Test 1: Basic sample loading and playback
// Using a placeholder path - replace with actual samples for testing
let kick_sample = sample("kick", "samples/kick.wav")
    .amp(0.8)
    .attack(0.001)
    .release(0.1);
assert_true(true, "kick sample loaded");

// Test 2: Sample with rate change (pitch shift)
let kick_pitched = sample("kick_pitched", "samples/kick.wav")
    .rate(1.5)  // Higher pitch
    .amp(0.7);
assert_true(true, "pitched sample configured");

// Test 3: Sample with loop mode
let loop_sample = sample("loop", "samples/loop.wav")
    .loop_mode(true)
    .amp(0.6);
assert_true(true, "loop sample configured");

// Test 4: Sample with warp mode (time-stretch)
let warped_sample = sample("warped", "samples/loop.wav")
    .warp(true)
    .speed(0.5)      // Half speed without pitch change
    .pitch(1.0)       // Keep original pitch
    .window_size(0.1)
    .overlaps(8.0);
assert_true(true, "warped sample configured");

// Test 5: Sample slice
let sliced_sample = sample("slice", "samples/loop.wav")
    .slice(0.5, 1.5)  // Play from 0.5s to 1.5s
    .amp(0.7);
assert_true(true, "sliced sample configured");

// Create voices using samples
let kick_voice = voice("kick_voice")
    .on_sample(kick_sample)
    .gain(db(-6));
assert_true(true, "kick voice created");

let kick_pitched_voice = voice("kick_pitched_voice")
    .on_sample(kick_pitched)
    .gain(db(-8));
assert_true(true, "pitched kick voice created");

// Test patterns with sample voices
pattern("kick_pattern")
    .on(kick_voice)
    .step("x... x... x... x...")
    .start();
assert_true(true, "kick pattern started");

pattern("pitched_pattern")
    .on(kick_pitched_voice)
    .step("..x. ..x. ..x. ..x.")
    .start();
assert_true(true, "pitched pattern started");

// Verify dB values for sample gain staging
assert_approx(db(-6), 0.501, 0.01, "-6 dB gain is ~0.5 linear");
assert_approx(db(-8), 0.398, 0.01, "-8 dB gain is ~0.4 linear");

test_end_and_exit();
