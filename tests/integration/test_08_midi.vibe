// Integration Test 08: MIDI Output
// Tests: MIDI device selection, note output, CC output, MIDI voice
//
// This test verifies:
// - MIDI devices are discovered
// - Notes are sent to MIDI output
// - CC messages are sent
// - Melodies trigger MIDI notes
//
// Note: This test requires a MIDI output device or virtual MIDI port

test_start("midi_output");

set_tempo(120);

// Test basic music theory functions (these work without MIDI hardware)
assert_eq(note("C4"), 60, "C4 is MIDI note 60");
assert_eq(note("A4"), 69, "A4 is MIDI note 69");
assert_eq(note("C5"), 72, "C5 is MIDI note 72");

// Test chord functions for MIDI use
let c_major = chord("C", 4);
assert_len(c_major, 3, "C major has 3 notes");
assert_contains(c_major, 60, "C major contains C4");
assert_contains(c_major, 64, "C major contains E4");
assert_contains(c_major, 67, "C major contains G4");

// Test velocity ranges (0.0-1.0 maps to 0-127 in MIDI)
let low_vel = 0.3;
let high_vel = 0.9;
assert_lt(low_vel, high_vel, "low velocity < high velocity");
assert_in_range(low_vel, 0.0, 1.0, "low velocity in valid range");
assert_in_range(high_vel, 0.0, 1.0, "high velocity in valid range");

// MIDI channel validation (1-16)
let channel = 1;
assert_in_range(channel, 1, 16, "MIDI channel in valid range");

// Test MIDI note number calculations
let octave_shift = 12;  // One octave
assert_eq(note("C4") + octave_shift, note("C5"), "C4 + 12 = C5");
assert_eq(note("A3") + octave_shift, note("A4"), "A3 + 12 = A4");

// Test MIDI velocity calculation (if needed)
// MIDI velocity is 0-127, our velocity is 0.0-1.0
let internal_vel = 0.5;
let midi_vel = (internal_vel * 127.0);
assert_approx(midi_vel, 63.5, 0.1, "0.5 velocity maps to ~64 MIDI velocity");

// Note: The following tests require actual MIDI hardware
// They are wrapped in comments but demonstrate the API

// -- MIDI Device Tests (require hardware) --
// let midi_out = midi_device_output("Virtual MIDI Port");
// let midi_voice = voice("midi_voice")
//     .midi_output(midi_out)
//     .midi_channel(1)
//     .poly(8);
// melody("midi_melody")
//     .on(midi_voice)
//     .notes("C4 D4 E4 F4 | G4 A4 B4 C5")
//     .start();

assert_true(true, "MIDI API functions exist");

test_end_and_exit();
