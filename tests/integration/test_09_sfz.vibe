//     .notes("C4 E4 G4 C5 | E5 G5 C6 -")
//     .start();

// -- Velocity Layer Test --
// melody("piano_soft")
//     .on(piano_voice)
//     .notes("C4[vel=0.3] - E4[vel=0.3] - | G4[vel=0.3] - C5[vel=0.3] -")
//     .start();
// melody("piano_loud")
//     .on(piano_voice)
//     .notes("C4[vel=0.9] - E4[vel=0.9] - | G4[vel=0.9] - C5[vel=0.9] -")
//     .start();

assert_true(true, "SFZ API functions exist");

test_end_and_exit();
