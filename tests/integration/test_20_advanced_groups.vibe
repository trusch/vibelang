// Integration Test 20: Advanced Group Features
// Tests: Comprehensive group hierarchy, mute/solo, parameters, nesting
//
// This test verifies:
// - Group creation and naming
// - Nested group hierarchies
// - Mute and unmute functionality
// - Solo functionality with multiple groups
// - Group parameter setting
// - Parent group access
// - Group handle properties
// - Effect management on groups

test_start("advanced_groups");

set_tempo(120);
set_time_signature(4, 4);

// =============================================================================
// Test 1: Basic Synthdef
// =============================================================================

define_synthdef("group_test")
    .param("freq", 440.0)
    .param("amp", 0.2)
    .param("gate", 1.0)
    .body(|freq, amp, gate| {
        let env = envelope()
            .perc("1ms", "50ms")
            .gate(gate)
            .cleanup_on_finish()
            .build();
        sin_osc_ar(freq) * env * amp
    });

// Effect for testing
define_synthdef("group_reverb")
    .param("in_bus", 0.0)
    .param("mix", 0.3)
    .body(|in_bus, mix| {
        let input = in_ar(in_bus, 2);
        let reverb = free_verb_ar(input, mix, 0.5, 0.5);
        replace_out(in_bus, reverb)
    });

// =============================================================================
// Test 2: Basic Group Creation
// =============================================================================

let basic_group = define_group("BasicGroup", || {
    let v = voice("basic_voice").synth("group_test").gain(db(-18));
});

// Verify group name
assert_eq(basic_group.name, "BasicGroup", "group name should match");
assert_true(true, "basic group created");

// =============================================================================
// Test 3: Group Path
// =============================================================================

// Group path should include full hierarchy
let path_group = define_group("PathGroup", || {
    let v = voice("path_voice").synth("group_test");
});

// The path should be "main/PathGroup"
assert_true(true, "group path accessible");

// =============================================================================
// Test 4: Parent Group Access
// =============================================================================

let parent_group = define_group("ParentGroup", || {
    // Nothing inside
});

let parent_path = parent_group.parent();
assert_eq(parent_path, "main", "parent of top-level group should be main");

// =============================================================================
// Test 5: Nested Groups
// =============================================================================

let outer_group = define_group("OuterGroup", || {
    let outer_voice = voice("outer_voice").synth("group_test").gain(db(-18));

    // Nested group
    let inner_group = define_group("InnerGroup", || {
        let inner_voice = voice("inner_voice").synth("group_test").gain(db(-18));
    });

    assert_true(true, "inner group created inside outer group");
});

assert_true(true, "nested groups work");

// =============================================================================
// Test 6: Deep Nesting
// =============================================================================

let level1 = define_group("Level1", || {
    let level2 = define_group("Level2", || {
        let level3 = define_group("Level3", || {
            let level4 = define_group("Level4", || {
                let v = voice("deep_voice").synth("group_test");
            });
        });
    });
});

assert_true(true, "deeply nested groups work (4 levels)");

// =============================================================================
// Test 7: Mute Group
// =============================================================================

let mute_group = define_group("MuteTestGroup", || {
    let v = voice("mute_voice").synth("group_test").gain(db(-18));
});

// Initially not muted
assert_eq(mute_group.is_muted(), false, "group should not be muted initially");

// Mute the group
mute_group.mute();
assert_eq(mute_group.is_muted(), true, "group should be muted after mute()");

// Unmute the group
mute_group.unmute();
assert_eq(mute_group.is_muted(), false, "group should not be muted after unmute()");

// =============================================================================
// Test 8: Unmute Initially Muted
// =============================================================================

let unmute_test = define_group("UnmuteTest", || {
    let v = voice("unmute_voice").synth("group_test");
});

// Mute then unmute
unmute_test.mute();
assert_eq(unmute_test.is_muted(), true, "should be muted");

unmute_test.unmute();
assert_eq(unmute_test.is_muted(), false, "should be unmuted");

// =============================================================================
// Test 9: Solo Group
// =============================================================================

let solo_group = define_group("SoloTestGroup", || {
    let v = voice("solo_voice").synth("group_test").gain(db(-18));
});

// Initially not soloed
assert_eq(solo_group.is_soloed(), false, "group should not be soloed initially");

// Solo the group
solo_group.solo(true);
assert_eq(solo_group.is_soloed(), true, "group should be soloed after solo(true)");

// Unsolo the group
solo_group.solo(false);
assert_eq(solo_group.is_soloed(), false, "group should not be soloed after solo(false)");

// =============================================================================
// Test 10: Multiple Groups Solo Interaction
// =============================================================================

let drums = define_group("DrumsSolo", || {
    let v = voice("drums_solo_voice").synth("group_test");
});

let bass = define_group("BassSolo", || {
    let v = voice("bass_solo_voice").synth("group_test");
});

let keys = define_group("KeysSolo", || {
    let v = voice("keys_solo_voice").synth("group_test");
});

// Solo drums only
drums.solo(true);
assert_eq(drums.is_soloed(), true, "drums should be soloed");
assert_eq(bass.is_soloed(), false, "bass should not be soloed");
assert_eq(keys.is_soloed(), false, "keys should not be soloed");

// Unsolo drums
drums.solo(false);
assert_eq(drums.is_soloed(), false, "drums should be unsoloed");

// Multiple solos
drums.solo(true);
bass.solo(true);
assert_eq(drums.is_soloed(), true, "drums still soloed");
assert_eq(bass.is_soloed(), true, "bass now soloed");

// Unsolo all
drums.solo(false);
bass.solo(false);

// =============================================================================
// Test 11: Group Gain
// =============================================================================

let gain_group = define_group("GainTestGroup", || {
    let v = voice("gain_voice").synth("group_test");
});

// Set gain using dB
gain_group.gain(db(-12));
assert_true(true, "group gain set via dB");

// Set gain using linear value
gain_group.gain(0.5);
assert_true(true, "group gain set via linear value");

// Extreme values
gain_group.gain(db(-96));  // Very quiet
assert_true(true, "very quiet gain set");

gain_group.gain(db(0));    // Unity
assert_true(true, "unity gain set");

// =============================================================================
// Test 12: Group Set Param
// =============================================================================

let param_group = define_group("ParamTestGroup", || {
    let v = voice("param_voice").synth("group_test");
});

// Set amp parameter
param_group.set_param("amp", 0.5);
assert_true(true, "amp parameter set on group");

// Set custom parameter
param_group.set_param("custom", 0.75);
assert_true(true, "custom parameter set on group");

// Set multiple parameters
param_group.set_param("param1", 0.1);
param_group.set_param("param2", 0.2);
param_group.set_param("param3", 0.3);
assert_true(true, "multiple parameters set on group");

// =============================================================================
// Test 13: Group Handle by Path
// =============================================================================

// Create a group
define_group("HandleTestGroup", || {
    let v = voice("handle_voice").synth("group_test");
});

// Get handle by path
let retrieved = group("HandleTestGroup");
assert_eq(retrieved.name, "HandleTestGroup", "retrieved group name should match");

// Full path retrieval
let full_path = group("main/HandleTestGroup");
assert_eq(full_path.name, "HandleTestGroup", "full path retrieval works");

// =============================================================================
// Test 14: Effect Count on Group
// =============================================================================

let effect_count_group = define_group("EffectCountGroup", || {
    let v = voice("ec_voice").synth("group_test");

    // Add some effects
    fx("ec_reverb1").synth("group_reverb").param("mix", 0.2).apply();
    fx("ec_reverb2").synth("group_reverb").param("mix", 0.3).apply();
});

let ec_handle = group("EffectCountGroup");
assert_eq(ec_handle.effect_count(), 2, "should have 2 effects");

// =============================================================================
// Test 15: Remove Effect from Group
// =============================================================================

let remove_effect_group = define_group("RemoveEffectGroup", || {
    let v = voice("re_voice").synth("group_test");

    fx("re_effect1").synth("group_reverb").apply();
    fx("re_effect2").synth("group_reverb").apply();
    fx("re_effect3").synth("group_reverb").apply();
});

let re_handle = group("RemoveEffectGroup");
assert_eq(re_handle.effect_count(), 3, "should start with 3 effects");

// Remove middle effect
re_handle.remove_effect("re_effect2");
assert_eq(re_handle.effect_count(), 2, "should have 2 effects after removal");

// Remove another
re_handle.remove_effect("re_effect1");
assert_eq(re_handle.effect_count(), 1, "should have 1 effect after removal");

// =============================================================================
// Test 16: Clear All Effects from Group
// =============================================================================

let clear_effect_group = define_group("ClearEffectGroup", || {
    let v = voice("ce_voice").synth("group_test");

    fx("ce_effect1").synth("group_reverb").apply();
    fx("ce_effect2").synth("group_reverb").apply();
    fx("ce_effect3").synth("group_reverb").apply();
    fx("ce_effect4").synth("group_reverb").apply();
});

let ce_handle = group("ClearEffectGroup");
assert_eq(ce_handle.effect_count(), 4, "should start with 4 effects");

// Clear all effects
ce_handle.clear_effects();
assert_eq(ce_handle.effect_count(), 0, "should have 0 effects after clear");

// =============================================================================
// Test 17: Muted Property Access
// =============================================================================

let muted_prop_group = define_group("MutedPropGroup", || {
    let v = voice("mp_voice").synth("group_test");
});

// Using is_muted method
assert_eq(muted_prop_group.is_muted(), false, "is_muted() should be false");

// After muting
muted_prop_group.mute();
assert_eq(muted_prop_group.is_muted(), true, "is_muted() should be true after mute");

// =============================================================================
// Test 18: Soloed Property Access
// =============================================================================

let soloed_prop_group = define_group("SoloedPropGroup", || {
    let v = voice("sp_voice").synth("group_test");
});

// Using is_soloed method
assert_eq(soloed_prop_group.is_soloed(), false, "is_soloed() should be false");

// After soloing
soloed_prop_group.solo(true);
assert_eq(soloed_prop_group.is_soloed(), true, "is_soloed() should be true after solo");

// =============================================================================
// Test 19: Complex Group Structure
// =============================================================================

let master = define_group("Master", || {
    // Master bus effects would go here

    let drums_bus = define_group("DrumsBus", || {
        let kick = define_group("KickGroup", || {
            let v = voice("kick_v").synth("group_test").param("freq", 60.0);
        });

        let snare = define_group("SnareGroup", || {
            let v = voice("snare_v").synth("group_test").param("freq", 180.0);
        });

        let hats = define_group("HatsGroup", || {
            let v = voice("hat_v").synth("group_test").param("freq", 8000.0);
        });
    });

    let synths_bus = define_group("SynthsBus", || {
        let leads = define_group("LeadsGroup", || {
            let v = voice("lead_v").synth("group_test").poly(4);
        });

        let pads = define_group("PadsGroup", || {
            let v = voice("pad_v").synth("group_test").poly(8);
        });
    });

    let fx_bus = define_group("FxBus", || {
        // Send effects
        fx("send_reverb").synth("group_reverb").param("mix", 1.0).apply();
    });
});

assert_true(true, "complex group structure created");

// =============================================================================
// Test 20: Builder Method Chaining
// =============================================================================

let chain_group = define_group("ChainGroup", || {
    let v = voice("chain_voice").synth("group_test");
});

// All methods should be chainable
chain_group
    .gain(db(-12))
    .set_param("test", 0.5);

// Mute returns self
chain_group.mute();

// Note: unmute() and solo() don't return Self in current impl
// so we test them separately
chain_group.unmute();
chain_group.solo(true);
chain_group.solo(false);

assert_true(true, "group builder methods work");

// =============================================================================
// Test 21: Empty Group
// =============================================================================

let empty_group = define_group("EmptyGroup", || {
    // No voices, no effects
});

assert_eq(empty_group.name, "EmptyGroup", "empty group name correct");
assert_eq(empty_group.effect_count(), 0, "empty group has no effects");
assert_eq(empty_group.is_muted(), false, "empty group not muted");
assert_eq(empty_group.is_soloed(), false, "empty group not soloed");

// =============================================================================
// Test 22: Group with Only Effects
// =============================================================================

let effects_only = define_group("EffectsOnlyGroup", || {
    // No voices, just effects
    fx("eo_reverb").synth("group_reverb").apply();
    fx("eo_delay").synth("group_reverb").apply();
});

assert_eq(effects_only.effect_count(), 2, "effects-only group has effects");

// =============================================================================
// Test 23: Mute Nested Groups
// =============================================================================

let mute_parent = define_group("MuteParent", || {
    let mute_child = define_group("MuteChild", || {
        let v = voice("mute_nested_voice").synth("group_test");
    });
});

// Mute parent
mute_parent.mute();
assert_eq(mute_parent.is_muted(), true, "parent is muted");

// Child is independent
let child_ref = group("MuteParent/MuteChild");
// Note: muting parent doesn't automatically mute children in current impl
// This tests current behavior

// =============================================================================
// Test 24: Group Name Characters
// =============================================================================

let underscore_group = define_group("Group_With_Underscores", || {
    let v = voice("underscore_voice").synth("group_test");
});
assert_eq(underscore_group.name, "Group_With_Underscores", "underscore in name works");

let number_group = define_group("Group123", || {
    let v = voice("number_voice").synth("group_test");
});
assert_eq(number_group.name, "Group123", "numbers in name work");

let mixed_group = define_group("MyGroup_01_Test", || {
    let v = voice("mixed_voice").synth("group_test");
});
assert_eq(mixed_group.name, "MyGroup_01_Test", "mixed characters work");

test_end_and_exit();
