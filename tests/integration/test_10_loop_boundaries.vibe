// Integration Test 10: Loop Boundary Edge Cases
// Tests: Pattern and melody behavior at loop boundaries
//
// This test verifies:
// - Notes/steps at beat 0 trigger correctly on first tick
// - Notes/steps at last beat of loop trigger correctly
// - Loop wrap-around triggers all expected events
// - No double-triggering or missed events

test_start("loop_boundaries");

set_tempo(120);
set_time_signature(4, 4);

// =============================================================================
// Test 1: Step at beat 0 should trigger on first tick
// =============================================================================

// Create a simple synth for testing
define_synthdef("test_beep")
    .param("freq", 440.0)
    .param("amp", 0.5)
    .param("gate", 1.0)
    .body(|freq, amp, gate| {
        let env = envelope()
            .perc("1ms", "10ms")
            .gate(gate)
            .cleanup_on_finish()
            .build();
        sin_osc_ar(freq) * env * amp
    });

define_group("TestGroup", || {
    let v = voice("test_voice").synth("test_beep").gain(db(-20)).poly(8);

    // Pattern with step at beat 0
    let p = pattern("beat_zero_pattern")
        .on(v)
        .step("x... .... .... ....")
        .apply();

    // Verify pattern configuration
    assert_true(true, "pattern with step at beat 0 created");
});

// =============================================================================
// Test 2: Note helper functions work correctly
// =============================================================================

// Test note names cover all octaves
let c0 = note("C0");
let c4 = note("C4");
let c8 = note("C8");
assert_eq(c0, 12, "C0 should be MIDI 12");
assert_eq(c4, 60, "C4 should be MIDI 60");
assert_eq(c8, 108, "C8 should be MIDI 108");

// Test accidentals
let csharp4 = note("C#4");
let dflat4 = note("Db4");
assert_eq(csharp4, 61, "C#4 should be MIDI 61");
assert_eq(dflat4, 61, "Db4 should be MIDI 61 (enharmonic)");

// =============================================================================
// Test 3: Bars helper with different time signatures
// =============================================================================

// In 4/4, 1 bar = 4 beats
set_time_signature(4, 4);
let bars_4_4 = bars(1);
assert_eq(bars_4_4, 4.0, "1 bar in 4/4 should be 4 beats");

// In 3/4, 1 bar = 3 beats
set_time_signature(3, 4);
let bars_3_4 = bars(1);
assert_eq(bars_3_4, 3.0, "1 bar in 3/4 should be 3 beats");

// In 6/8, 1 bar = 3 quarter-note beats (6 eighths = 3 quarters)
set_time_signature(6, 8);
let bars_6_8 = bars(1);
assert_eq(bars_6_8, 3.0, "1 bar in 6/8 should be 3 quarter-note beats");

// Reset to 4/4
set_time_signature(4, 4);

// =============================================================================
// Test 4: Pattern step notation parsing
// =============================================================================

define_group("StepParsing", || {
    let v = voice("step_voice").synth("test_beep").gain(db(-20));

    // Simple 16-step pattern
    let p1 = pattern("simple_16")
        .on(v)
        .step("x... x... x... x...")
        .apply();
    assert_true(true, "16-step pattern parsed");

    // Pattern with bar separator
    let p2 = pattern("with_bars")
        .on(v)
        .step("x... .... | .... x...")
        .apply();
    assert_true(true, "pattern with bar separator parsed");

    // Pattern with params
    let p3 = pattern("with_params")
        .on(v)
        .step("x[freq=200] ... x[freq=400] ...")
        .apply();
    assert_true(true, "pattern with params parsed");
});

// =============================================================================
// Test 5: Melody note parsing
// =============================================================================

define_group("NoteParsing", || {
    let v = voice("melody_voice").synth("test_beep").gain(db(-20)).poly(4);

    // Simple note sequence
    let m1 = melody("simple_melody")
        .on(v)
        .notes("C4 D4 E4 F4")
        .apply();
    assert_true(true, "simple melody parsed");

    // Notes with sustains
    let m2 = melody("with_sustains")
        .on(v)
        .notes("C4 - - . E4 - . .")
        .apply();
    assert_true(true, "melody with sustains parsed");

    // Notes with bar separators
    let m3 = melody("with_bars")
        .on(v)
        .notes("C4 D4 E4 F4 | G4 A4 B4 C5")
        .apply();
    assert_true(true, "melody with bar separators parsed");
});

// =============================================================================
// Test 6: Chord generation
// =============================================================================

// Major chords
let c_maj = chord("C", 4);
assert_len(c_maj, 3, "C major should have 3 notes");
assert_contains(c_maj, 60, "C major should contain C4");
assert_contains(c_maj, 64, "C major should contain E4");
assert_contains(c_maj, 67, "C major should contain G4");

// Minor chords
let a_min = chord("Am", 4);
assert_len(a_min, 3, "A minor should have 3 notes");
assert_contains(a_min, 69, "A minor should contain A4");
assert_contains(a_min, 72, "A minor should contain C5");
assert_contains(a_min, 76, "A minor should contain E5");

// Seventh chords
let g7 = chord("G7", 3);
assert_len(g7, 4, "G7 should have 4 notes");

// Diminished chords
let b_dim = chord("Bdim", 4);
assert_len(b_dim, 3, "B diminished should have 3 notes");

// =============================================================================
// Test 7: Scale generation
// =============================================================================

// Major scale
let c_major = scale("C", "major", 4);
assert_len(c_major, 7, "C major scale should have 7 notes");
assert_contains(c_major, 60, "C major should contain C4");
assert_contains(c_major, 62, "C major should contain D4");
assert_contains(c_major, 64, "C major should contain E4");
assert_contains(c_major, 65, "C major should contain F4");
assert_contains(c_major, 67, "C major should contain G4");
assert_contains(c_major, 69, "C major should contain A4");
assert_contains(c_major, 71, "C major should contain B4");

// Minor scale (natural)
let a_minor = scale("A", "minor", 4);
assert_len(a_minor, 7, "A minor scale should have 7 notes");

// Pentatonic scale
let c_penta = scale("C", "pentatonic", 4);
assert_len(c_penta, 5, "pentatonic scale should have 5 notes");

// Blues scale
let a_blues = scale("A", "blues", 3);
assert_len(a_blues, 6, "blues scale should have 6 notes");

// =============================================================================
// Test 8: Scale degree function
// =============================================================================

let deg1 = scale_degree("C", "major", 1);
assert_eq(deg1, 60, "degree 1 of C major should be C4 (60)");

let deg3 = scale_degree("C", "major", 3);
assert_eq(deg3, 64, "degree 3 of C major should be E4 (64)");

let deg5 = scale_degree("C", "major", 5);
assert_eq(deg5, 67, "degree 5 of C major should be G4 (67)");

// Octave wrapping
let deg8 = scale_degree("C", "major", 8);
assert_eq(deg8, 72, "degree 8 of C major should be C5 (72)");

// =============================================================================
// Test 9: dB conversion
// =============================================================================

assert_approx(db(0), 1.0, "0 dB should be unity gain");
assert_approx(db(-6), 0.501, 0.01, "-6 dB should be ~0.5");
assert_approx(db(-12), 0.251, 0.01, "-12 dB should be ~0.25");
assert_approx(db(-20), 0.1, 0.001, "-20 dB should be 0.1");
assert_approx(db(6), 1.995, 0.01, "+6 dB should be ~2.0");

// =============================================================================
// Test 10: Euclidean rhythm generation
// =============================================================================

define_group("Euclidean", || {
    let v = voice("euclid_voice").synth("test_beep").gain(db(-20));

    // Classic patterns
    let e_3_8 = pattern("e_3_8").on(v).euclid(3, 8).apply();
    assert_true(true, "euclidean 3/8 created");

    let e_5_8 = pattern("e_5_8").on(v).euclid(5, 8).apply();
    assert_true(true, "euclidean 5/8 created");

    let e_7_16 = pattern("e_7_16").on(v).euclid(7, 16).apply();
    assert_true(true, "euclidean 7/16 created");
});

test_end_and_exit();
