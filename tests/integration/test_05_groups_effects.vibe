// Integration Test 05: Groups and Effects
// Tests: group hierarchy, effects on groups, mute/solo, gain control
//
// This test verifies:
// - Groups organize voices hierarchically
// - Effects process group audio
// - Mute/solo work correctly
// - Gain staging works

test_start("groups_effects");

set_tempo(120);

// Simple click synth
define_synthdef("group_click")
    .param("freq", 500.0)
    .param("amp", 0.4)
    .param("gate", 1.0)
    .body(|freq, amp, gate| {
        let env = envelope()
            .perc("1ms", "50ms")
            .gate(gate)
            .cleanup_on_finish()
            .build();
        sin_osc_ar(freq) * env * amp
    });

// Pad synth
define_synthdef("group_pad")
    .param("freq", 220.0)
    .param("amp", 0.3)
    .param("gate", 1.0)
    .body(|freq, amp, gate| {
        let env = envelope()
            .adsr("50ms", "100ms", 0.7, "300ms")
            .gate(gate)
            .cleanup_on_finish()
            .build();
        (saw_ar(freq) + saw_ar(freq * 1.005)) * 0.3 * env * amp
    });

assert_true(true, "group_click synthdef created");
assert_true(true, "group_pad synthdef created");

// Define delay effect using define_fx (properly handles bus routing automatically)
// define_fx() provides:
// - input array as first closure parameter (stereo by default)
// - automatic __fx_bus_in/__fx_bus_out parameters
// - ReplaceOut wrapping for in-place processing
define_fx("test_delay")
    .param("delaytime", 0.25)
    .param("feedback", 0.4)
    .param("mix", 0.3)
    .body(|input, delaytime, feedback, mix| {
        // input is stereo array from In.ar(__fx_bus_in, 2)
        // Sum to mono for processing, then spread back to stereo
        let mono = (input[0] + input[1]) * 0.5;
        let delayed = comb_c_ar(mono, 2.0, delaytime, feedback * 4.0);
        let wet = [delayed, delayed];
        [
            (1.0 - mix) * input[0] + mix * wet[0],
            (1.0 - mix) * input[1] + mix * wet[1]
        ]
    });
assert_true(true, "test_delay effect defined with define_fx");

// Define reverb effect using define_fx
define_fx("test_reverb")
    .param("room", 0.7)
    .param("damp", 0.5)
    .param("mix", 0.3)
    .body(|input, room, damp, mix| {
        // input is stereo array
        let mono = (input[0] + input[1]) * 0.5;
        let reverbed = free_verb_ar(mono, 1.0, room, damp);
        let wet = [reverbed, reverbed];
        [
            (1.0 - mix) * input[0] + mix * wet[0],
            (1.0 - mix) * input[1] + mix * wet[1]
        ]
    });
assert_true(true, "test_reverb effect defined with define_fx");

// Test 1: Create a group with voices
let drums = define_group("Drums", || {
    let kick = voice("kick").synth("group_click").set_param("freq", 100.0).gain(db(-10));
    let snare = voice("snare").synth("group_click").set_param("freq", 300.0).gain(db(-12));
    let hat = voice("hat").synth("group_click").set_param("freq", 8000.0).gain(db(-15));

    pattern("kick_pat").on(kick).step("x... x... x... x...").start();
    pattern("snare_pat").on(snare).step(".... x... .... x...").start();
    pattern("hat_pat").on(hat).step("x.x. x.x. x.x. x.x.").start();
});
assert_true(true, "drums group with voices created");

// Test 2: Create another group with effects
let synths = define_group("Synths", || {
    let pad = voice("pad").synth("group_pad").gain(db(-15)).poly(8);

    melody("pad_melody")
        .on(pad)
        .notes("C3:maj - - - | Am - - - | F:maj - - - | G - - -")
        .start();

    // Add effects to this group
    fx("synth_delay").synth("test_delay")
        .param("delaytime", 0.375)  // Dotted eighth at 120 BPM
        .param("feedback", 0.3)
        .param("mix", 0.25);

    fx("synth_reverb").synth("test_reverb")
        .param("room", 0.8)
        .param("damp", 0.4)
        .param("mix", 0.35);
});
assert_true(true, "synths group with effects created");

// Test 3: Set group gain
drums.gain(db(-6));
synths.gain(db(-3));
assert_true(true, "group gain set successfully");

// Test 4: Verify dB calculation for gain staging
let minus6db = db(-6);
assert_approx(minus6db, 0.501, 0.01, "-6 dB should be ~0.5 linear");

let minus3db = db(-3);
assert_approx(minus3db, 0.708, 0.01, "-3 dB should be ~0.708 linear");

// Test 5: Verify groups can coexist without interference
assert_true(true, "multiple groups coexist");

test_end_and_exit();
