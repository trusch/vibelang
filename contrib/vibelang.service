[Unit]
Description=VibeLang Music Runtime
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/Music/vibelang
# The HTTP API binds to 127.0.0.1 by default. To reach it from other hosts,
# add --api-bind 0.0.0.0 (and consider --api-allow-extensions only if remote
# /eval code really needs fs/exec/net access).
ExecStart=%h/.cargo/bin/vibe run main.vibe
Restart=on-failure
RestartSec=3

# Audio environment
Environment=PIPEWIRE_LATENCY=256/48000

[Install]
WantedBy=default.target
